#HTH F5 Baseline

<check_type:"F5">

    <custom_item>
      description    : "IA - NetF5 - Configure Secure Password Policy - User Lockout"
      info           : "To assist users in maintaining strong passwords, ensure that passwords are changed at appropriate intervals and new passwords to be used"
      reference      : "NIST 800-53r5|IA-5(1)"
      see_also       : "HTH"
      f5_command     : "/tm/auth/password-policy"
      json_transform : ".lockoutDuration"
      expect         : "(30\d|3[1-9]\d|[4-9]\d{2}|[1-9]\d{3,5}|0)"
     </custom_item>

    <custom_item>
      description    : "CM - NetF5 - Authentication - Lock down Remote Role"
      info           : "The BIG-IP system provides a number of access control mechanisms to maintain secure access to the device, to ensure interoperability in a variety of environments with established requirements, and to assist in meeting industry standards, such as PCI compliance."
      reference      : "NIST 800-53r5|CM-5(1)"
      see_also       : "HTH"
      f5_command     : "/tm/auth/remote-role/role-info"
      json_transform : ".items"
      regex          : "\\"role\\" :"
      expect         : ".*"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Idle Session Timeout - SSH"
      info           : "A session lock is a temporary network device- or administrator-initiated action taken when the administrator stops work but does not log out of the SSH session."
      reference      : "NIST 800-53r5|AC-11a"
      see_also       : "HTH"
      f5_command     : "/tm/sys/sshd"
      json_transform : "\"SSH Idle Timeout: \(.inactivityTimeout)\""
      regex          : "SSH Idle Timeout:[\s]*"
      expect         : "^SSH Idle Timeout:[\s]*600$"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Idle Session Timeout - Console Sessions"
      info           : "A session lock is a temporary network device- or administrator-initiated action taken when the administrator stops work but does not log out of the console session."
      reference      : "NIST 800-53r5|AC-11a."
      see_also       : "HTH"
      f5_command     : "/tm/sys/global-settings"
      json_transform : "\"Console Idle Timeout: \(.consoleInactivityTimeout)\""
      regex          : "Console Idle Timeout:[\s]*"
      expect         : "^Console Idle Timeout:[\s]*600$"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Idle Session Timeout - TMSH"
      info           : "A session lock is a temporary network device- or administrator-initiated action taken when the administrator stops work but does not log out of the network device."
      reference      : "NIST 800-53r5|AC-11a"
      see_also       : "HTH"
      f5_command     : "/tm/cli/global-settings"
      json_transform : "\"TMSH Timeout: \(.idleTimeout)\""
      regex          : "TMSH Timeout:[\s]*"
      expect         : "^TMSH Timeout:[\s]*15$"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Banner - Enabled"
      info           : "The pre-login message banner sends a message to the remote user who attempts to log in to the system using SSH."
      reference      : "NIST 800-53r5|AC-8a"
      see_also       : "HTH"
      f5_command     : "/tm/sys/sshd"
      json_transform : ".banner"
      expect         : "enabled"
    </custom_item>


    <custom_item>
      description    : "SC - NetF5 - NTP - Configured"
      info           : "NTP is a protocol for synchronizing the clocks of computer systems over the network."
      reference      : "NIST 800-53r5|SC-45(1)"
      f5_command     : "/tm/sys/ntp"
      json_transform : ".servers"
      regex          : "[0-9.]+"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Configuring the BIG-IP system to exclude inode information from Etags"
      info           : "When connecting to the Configuration utility, responses from the Apache server contain an Etag HTTP header that includes the file's inode information."
      reference      : "NIST 800-53r5|AC-10"
      see_also       : "HTH"
      f5_command     : "/tm/sys/httpd"
      json_transform : ".include"
      expect         : "^[\s]*FileETag[\s]*MTime[\s]*Size[\s]*$"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Encryption - Ciphers Configured"
      info           : "You can configure the SSH service (also known as sshd) to use a desired set of encryption ciphers, KEX algorithms, and MAC algorithms to meet the security policy enforced in your environment."
      reference      : "NIST 800-53r5|AC-10"
      see_also       : "HTH"
      f5_command     : "/tm/sys/sshd"
      json_transform : ".include"
      regex          : ".*"
      not_expect     : "^none$"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Configuring CIDR Network Addresses for the BIG-IP packet filter - Unhandled Packet Action"
      info           : "You can use the BIG-IP packet filter functionality to enhance network security by enforcing an access policy on traffic ingressing or egressing a VLAN on the BIG-IP system."
      reference      : "NIST 800-53r5|AC-10"
      see_also       : "HTH"
      f5_command     : "/tm/sys/db"
      json_transform : '[.items.[] | select(.name=="packetfilter.defaultaction") |  .]'
      regex          : '"value" :'
      expect         : "discard"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Configuring CIDR Network Addresses for the BIG-IP packet filter - Filter established connections"
      info           : "You can use the BIG-IP packet filter functionality to enhance network security by enforcing an access policy on traffic ingressing or egressing a VLAN on the BIG-IP system."
      reference      : "NIST 800-53r5|AC-10"
      see_also       : "HTH"
      f5_command     : "/tm/sys/db"
      json_transform : '[.items.[] | select(.name=="packetfilter.established") |  .]'
      regex          : '"value" :'
      expect         : "enable"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Configuring CIDR Network Addresses for the BIG-IP packet filter - Send ICMP error on packet reject"
      info           : "You can use the BIG-IP packet filter functionality to enhance network security by enforcing an access policy on traffic ingressing or egressing a VLAN on the BIG-IP system."
      reference      : "NIST 800-53r5|AC-10"
      see_also       : "HTH"
      f5_command     : "/tm/sys/db"
      json_transform : '[.items.[] | select(.name=="packetfilter.sendicmperrors") |  .]'
      regex          : '"value" :'
      expect         : "enable"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Configuring CIDR Network Addresses for the BIG-IP packet filter - Always accept ARP"
      info           : "You can use the BIG-IP packet filter functionality to enhance network security by enforcing an access policy on traffic ingressing or egressing a VLAN on the BIG-IP system."
      reference      : "NIST 800-53r5|AC-10"
      see_also       : "HTH"
      f5_command     : "/tm/sys/db"
      json_transform : '[.items.[] | select(.name=="packetfilter.allow.arp") |  .]'
      regex          : '"value" :'
      expect         : "enable"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Configuring CIDR Network Addresses for the BIG-IP packet filter - Always accept important ICMP"
      info           : "You can use the BIG-IP packet filter functionality to enhance network security by enforcing an access policy on traffic ingressing or egressing a VLAN on the BIG-IP system."
      reference      : "NIST 800-53r5|AC-10"
      see_also       : "HTH"
      f5_command     : "/tm/sys/db"
      json_transform : '[.items.[] | select(.name=="packetfilter.allow.important.icmp") |  .]'
      regex          : '"value" :'
      expect         : "enable"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Configuring CIDR Network Addresses for the BIG-IP packet filter - Packet filter logging"
      info           : "You can use the BIG-IP packet filter functionality to enhance network security by enforcing an access policy on traffic ingressing or egressing a VLAN on the BIG-IP system."
      reference      : "NIST 800-53r5|AC-10"
      see_also       : "HTH"
      f5_command     : "/tm/sys/db"
      json_transform : '[.items.[] | select(.name=="packetfilter.defaultlog") |  .]'
      regex          : '"value" :'
      expect         : "enable"
    </custom_item>


    <custom_item>
      description    : "AC - NetF5 - Authentication - strict passwords"
      info           : "You can configure the BIG-IP system to use strict password checking for user accounts."
      reference      : "NIST 800-53r5|AC-10"
      see_also       : "HTH"
      f5_command     : "/tm/sys/db"
      json_transform : '[.items.[] | select(.name=="users.strictpasswords") |  .]'
      regex          : '"value" :'
      expect         : "enable"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Modifying the list of ciphers and MAC and key exchange algorithms used by the SSH service on the BIG-IP system or BIG-IQ system"
      info           : "You can configure the SSH service (also known as sshd) to use a desired set of encryption ciphers, KEX algorithms, and MAC algorithms to meet the security policy enforced in your environment."
      reference      : "NIST 800-53r5|AC-10"
      see_also       : "HTH"
      f5_command     : "/tm/sys/sshd"
      json_transform : ".include"
      regex          : ".*"
      not_expect     : "^none$"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Unable to limit Configuration utility access to clients using only TLSv1.1 or TLSv1.2"
      info           : "You are unable to limit Configuration utility access to clients that are configured to use only TLSv1.1 or TLSv1.2."
      reference      : "NIST 800-53r5|AC-10"
      see_also       : "HTH"
      f5_command     : "/tm/sys/httpd"
      json_transform : "\"SSL Protocol: \(.sslProtocol)\""
      regex          : "^[\s]*SSL[\s]*Protocol:[\s]*"
      expect         : "^[\s]*SSL[\s]*Protocol:[\s]*all[\s]*-SSLv2[\s]*-SSLv3[\s]*$"
    </custom_item>

    <custom_item>
      description    : "SC - NetF5 - Defining advanced NTP configurations on the BIG-IP system"
      info           : "NTP is a protocol for synchronizing the clocks of computer systems over the network."
      reference      : "NIST 800-53r5|SC-45(1)"
      see_also       : "HTH"
      f5_command     : "/tm/sys/ntp"
      json_transform : ".servers"
      regex          : "[0-9.]+"
    </custom_item>


    <custom_item>
      description    : "AC - NetF5 - Configuring a pre-login or post-login message banner for the BIG-IP or Enterprise Manager system - Banner Text"
      info           : "The pre-login message banner sends a message to the remote user who attempts to log in to the system using SSH."
      reference      : "NIST 800-53r5|AC-8a"
      see_also       : "HTH"
      f5_command     : "/tm/sys/sshd"
      json_transform : ".bannerText"
      regex          : ".*"
      expect         : "!! WARNING !!"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Mitigating risk from SSH brute force login attacks - Monitor login attempts"
      info           : "Beginning in BIG-IP 10.2.0, you can view the number of failed login attempts for each user by logging into the BIG-IP Configuration utility and browsing to the Account Security section of the System."
      reference      : "NIST 800-53r5|AC-11a"
      see_also       : "HTH"
      f5_command     : "/tm/auth/login-failures"
      json_transform : ".entries[] | \"Userame: \(.nestedStats.entries.username.description) - Login Failures: \(.nestedStats.entries.loginAttempts.value) \""
      not_expect     : ".*Login Failures: [1-9]\d*"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Overview of port lockdown behavior"
      info           : "The port lockdown feature allows you to secure the BIG-IP system from unwanted connection attempts by controlling the level of access to each self IP address defined on the system."
      reference      : "NIST 800-53r5|AC-11a"
      see_also       : "HTH"
      f5_command     : "/tm/net/self"
      json_transform : ".items[] | \"Name: \(.name) - Port Lockdown: \(.allowService) \""
      regex          : "Port Lockdown: .+"
      expect         : "null"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Configuring an automatic logout for idle sessions - SSH"
      info           : "A session lock is a temporary network device- or administrator-initiated action taken when the administrator stops work but does not log out of the SSH session. "
      reference      : "NIST 800-53r5|AC-11a"
      see_also       : "HTH"
      f5_command     : "/tm/sys/sshd"
      json_transform : "\"SSH Idle Timeout: \(.inactivityTimeout)\""
      regex          : "SSH Idle Timeout:[\s]*"
      expect         : "^SSH Idle Timeout:[\s]*([1-9]|[1-8][0-9]|9[0-9]|[1-5][0-9]{2}|600)$"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Configuring an automatic logout for idle sessions - Console Sessions"
      info           : "A session lock is a temporary network device- or administrator-initiated action taken when the administrator stops work but does not log out of the console session."
      info           : "/tm/sys/global-settings"
      reference      : "NIST 800-53r5|AC-11a"
      see_also       : "HTH"
      f5_command     : "/tm/sys/global-settings"
      json_transform : "\"Console Idle Timeout: \(.consoleInactivityTimeout)\""
      regex          : "Console Idle Timeout:[\s]*"
      expect         : "^Console Idle Timeout:[\s]*([1-9]|[1-8][0-9]|9[0-9]|[1-5][0-9]{2}|600)$"
    </custom_item>

    <custom_item>
      description    : "AC - NetF5 - Configuring an automatic logout for idle sessions - TMSH"
      info           : "A session lock is a temporary network device- or administrator-initiated action taken when the administrator stops work but does not log out of the network device."
      info           : "/tm/cli/global-settings"
      reference      : "NIST 800-53r5|AC-11a"
      see_also       : "HTH"
      f5_command     : "/tm/cli/global-settings"
      json_transform : "\"TMSH Timeout: \(.idleTimeout)\""
      regex          : "TMSH Timeout:[\s]*"
      expect         : "^TMSH Timeout:[\s]*15$"
    </custom_item>

    <custom_item>
      description    : "SC - NetF5 - Encryption - HTTP profile cookies"
      info           : "A virtual server with an associated HTTP profile processes connections using the BIG-IP system's full proxy architecture for the purpose of making requests on behalf of clients."
      info           : "/tm/ltm/profile/http"
      reference      : "NIST 800-53r5|SC-5"
      see_also       : "HTH"
      f5_command     : "/tm/ltm/profile/http"
      json_transform : ".items[] | \"HTTP Profile Name: \(.name) - Encrypted Cookies: \(.encryptCookies)\""
      regex          : "HTTP[\s]*Profile[\s]*Name:"
      not_expect     : "HTTP[\s]*Profile[\s]*Name:[\s]*@HTTP_PROFILE_NAME@[\s]*-[\s]*Encrypted[\s]*Cookies:[\s]*null[\s]*"
    </custom_item>

    <custom_item>
      description    : "AU - NetF5 - Ensure that Remote Syslog Servers are configured"
      info           : "To ensure that logs are sent to external servers."
      info           : "/tm/sys/syslog"
      reference      : "NIST 800-53r5|AU-6(3)"
      see_also       : "HTH"
      f5_command     : "/tm/sys/syslog"
      json_transform : ".remoteServers[] | \"Remote Syslog Server: \(.host)\""
      regex          : "Remote Syslog Server:[\s](\.*)"
      expect         : "Remote Syslog Server:[\s]10.*$"
    </custom_item>



<custom_item>
description    : "Check REST API for required special"
info           : "To assist users in changing default password for 'admin' account"
reference      : "NIST 800-53r5|IA-5(1)"
see_also       : "See HTH Policies and Standards"
solution       : "- Log in to the Configuration utility."
f5_command     : "/tm/auth/password-policy"
json_transform : ".requiredSpecial"
expect         : "^[1-9][0-9]*$"
</custom_item>

<custom_item>
description    : "Check REST API for required numeric"
info           : "To assist users in changing default password for 'admin' account"
reference      : "NIST 800-53r5|IA-5(1)"
see_also       : "See HTH Policies and Standards"
solution       : "- Log in to the Configuration utility."
f5_command     : "/tm/auth/password-policy"
json_transform : ".requiredNumeric"
expect         : "^[1-9][0-9]*$"
</custom_item>

<custom_item>
description    : "Check REST API for policy-enforcement"
info           : "To assist users in changing default password for 'admin' account"
reference      : "NIST 800-53r5|IA-5(1)"
see_also       : "See HTH Policies and Standards"
solution       : "- Log in to the Configuration utility."
f5_command     : "/tm/auth/password-policy"
json_transform : ".policyEnforcement"
expect         : "^enabled$"
</custom_item>

<custom_item>
description    : "Check REST API for expiration warning"
info           : "To assist users in changing default password for 'admin' account"
reference      : "NIST 800-53r5|IA-5(1)"
see_also       : "See HTH Policies and Standards"
solution       : "- Log in to the Configuration utility."
f5_command     : "/tm/auth/password-policy"
json_transform : ".expirationWarning"
expect         : "\b(1[4-9]|[2-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\b"
</custom_item>

<custom_item>
description    : "Check REST API for required uppercase"
info           : "To assist users in changing default password for 'admin' account"
reference      : "NIST 800-53r5|IA-5(1)"
see_also       : "See HTH Policies and Standards"
solution       : "- Log in to the Configuration utility."
f5_command     : "/tm/auth/password-policy"
json_transform : ".requiredUppercase"
expect         : "^[1-9][0-9]*$"
</custom_item>

<custom_item>
description    : "Check REST API for minimum length"
info           : "To assist users in changing default password for 'admin' account"
reference      : "NIST 800-53r5|IA-5(1)"
see_also       : "See HTH Policies and Standards"
solution       : "- Log in to the Configuration utility."
f5_command     : "/tm/auth/password-policy"
json_transform : ".minimumLength"
expect         : "\b(1[2-9]|[2-9][0-9]|[1-9]\d{2,})\b"
</custom_item>

<custom_item>
description    : "Check REST API for max login failures"
info           : "To assist users in changing default password for 'admin' account"
reference      : "NIST 800-53r5|IA-5(1)"
see_also       : "See HTH Policies and Standards"
solution       : "- Log in to the Configuration utility."
f5_command     : "/tm/auth/password-policy"
json_transform : ".maxLoginFailures"
expect         : "\b([1-3])\b"
</custom_item>

<custom_item>
description    : "Check REST API for password memory"
info           : "To assist users in changing default password for 'admin' account"
reference      : "NIST 800-53r5|IA-5(1)"
see_also       : "See HTH Policies and Standards"
solution       : "- Log in to the Configuration utility."
f5_command     : "/tm/auth/password-policy"
json_transform : ".passwordMemory"
expect         : "\b(2[4-9]|[3-9][0-9]|1[01][0-9]|12[0-7])\b"
</custom_item>

<custom_item>
description    : "Check REST API for required lowercase"
info           : "To assist users in changing default password for 'admin' account"
reference      : "NIST 800-53r5|IA-5(1)"
see_also       : "See HTH Policies and Standards"
solution       : "- Log in to the Configuration utility."
f5_command     : "/tm/auth/password-policy"
json_transform : ".requiredLowercase"
expect         : "^[1-9][0-9]*$"
</custom_item>

<custom_item>
description    : "Check REST API for max duration"
info           : "To assist users in changing default password for 'admin' account"
reference      : "NIST 800-53r5|IA-5(1)"
see_also       : "See HTH Policies and Standards"
solution       : "- Log in to the Configuration utility."
f5_command     : "/tm/auth/password-policy"
json_transform : ".maxDuration"
expect         : "\b([1-9]|[1-9][0-9]|1[0-7][0-9]|180)\b"
</custom_item>

<custom_item>
description    : "Check REST API for max duration"
info           : "To assist users in changing default password for 'admin' account"
reference      : "NIST 800-53r5|IA-5(1)"
see_also       : "See HTH Policies and Standards"
solution       : "- Log in to the Configuration utility."
f5_command     : "/tm/auth/password-policy"
json_transform : ".minDuration"
expect         : "\b([1-9]|[1-8][0-9]|90)\b"
</custom_item>

<custom_item>
description    : "Check REST API for default partition"
info           : "To assist users in maintaining strong passwords ,ensure that passwords are changed at appropriate intervals and new passwords to be used"
reference      : "NIST 800-53r5|IA-5(1)"
see_also       : "See HTH Policies and Standards"
solution       : "Configuring the password policy using the Configuration utility"
f5_command     : "/tm/auth/remote-user"
json_transform : ".defaultPartition"
expect         : "Common"
</custom_item>

<custom_item>
description    : "Check REST API for remote console access"
info           : "To limit access for remote users to needed partitions only granting a user access to All Partitions might provide the users unauthorized access."
reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
see_also       : "See HTH Policies and Standards"
solution       : "1. Log in to the Configuration utility."
f5_command     : "/tm/auth/remote-user"
json_transform : ".remoteConsoleAccess"
expect         : "disabled"
</custom_item>

<custom_item>
description    : "Check REST API for idle timeout"
info           : "To prevent remote users from gaining terminal access"
reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
see_also       : "See HTH Policies and Standards"
solution       : "1. Log in to the Configuration utility."
f5_command     : "/tm/sys/httpd"
json_transform : "\"Configuration Utility Timeout: \(.authPamIdleTimeout)\""
expect         : "^[\s]*Configuration Utility Timeout:[\s]*([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
</custom_item>

<custom_item>
description    : "Check REST API for access"
info           : "TLSv1.2 should be used for GUI connections"
reference      : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
see_also       : "See HTH Policies and Standards"
solution       : "If the value is different, execute the following command to modify the protocol used to access GUI:"
f5_command     : "/tm/sys/httpd"
json_transform : ".allow | join(\" \")"
expect         : "^192.168.0.1$"
</custom_item>

<custom_item>
description    : "Check REST API for kex algorithms"
info           : "To set strong Hashing algorithm"
reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
see_also       : "See HTH Policies and Standards"
solution       : "1-Log in to tmsh by typing the following command:tmsh"
f5_command     : "/tm/sys/sshd"
json_transform : ".include"
expect         : "^Manual Review Required$"
</custom_item>

<custom_item>
description    : "Check REST API for access"
info           : "To set strong Key Exchange algorithm"
reference      : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
see_also       : "See HTH Policies and Standards"
solution       : "1-Log in to tmsh by typing the following command:tmsh 2-To modify the sshd configuration, type the following command to start the vi editor:edit /sys sshd all-properties3-Set a Key-Exchange algorthem with key of size 256 or longer example diffie-hellman-group14-sha256)4-To change the list of ciphers, you can navigate to the line that starts with the include statement, and use the keyword KexAlgorithms ,and adding the list of desired KexAlgorithms to the 2-line include statement:include Ciphers aes128-cbc,aes128-ctr,aes192-ctr,aes256-ctr,arcfour128,arcfour256,arcfourMACs hmac-sha2-256KexAlgorithms diffie-hellman-group14-sha256"
f5_command     : "/tm/sys/sshd"
json_transform : ".allow"
not_expect     : "All"
</custom_item>

<custom_item>
description    : "5.4 Ensure to disable unused services in BIG-IP configuration"
info           : "To disable unused BIG-IP system daemons"
reference      : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
see_also       : "See HTH Policies and Standards"
solution       : "1- Log in to the Configuration utility."
f5_command     : "/tm/sys/service"
json_transform : ".items[] | \"Service Name: \(.name)\""
expect         : "^Manual Review Required$"
</custom_item>

<custom_item>
description    : "Check REST API for snmp access"
info           : "to secure the BIG-IP system from unwanted connection attempts on self-IP."
reference      : "NIST 800-53r5|CM-6 CM-7 SC-23"
see_also       : "See HTH Policies and Standards"
solution       : "1-Log in to the Configuration utility."
f5_command     : "/tm/sys/snmp"
json_transform : ".allowedAddresses | join(\" \")"
expect         : "^192.168.0.1$"
</custom_item>

</check_type>
