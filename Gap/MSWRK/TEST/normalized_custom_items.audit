      reg_item                 : "NoDriveTypeAutoRun"
      reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.9.1.1 Ensure 'Configure enhanced anti-spoofing' is set to 'Enabled'"
      info                     : "This policy setting determines whether enhanced anti-spoofing is configured for devices which support it."
      reference                : "NIST 800-53r5|SC-39 SI-16"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
