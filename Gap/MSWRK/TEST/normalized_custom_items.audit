      value_data               : "1" || "2"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "BackupDirectory"
      reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.3.1 Ensure 'Include command line in process creation events' is set to 'Enabled'"
      info                     : "This policy setting controls whether the process creation command line text is logged in security audit events when a new process has been created."
      reference                : "NIST 800-53r5|AU-2"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "ProcessCreationIncludeCmdLine_Enabled"
      reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System\Audit"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.53.1.1 Ensure 'Enable Windows NTP Client' is set to 'Enabled'"
      info                     : "This policy setting specifies whether the Windows NTP Client is enabled."
      reference                : "NIST 800-53r5|AU-7 AU-8"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "Enabled"
      reg_key                  : "HKLM\Software\Policies\Microsoft\W32Time\TimeProviders\NtpClient"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.53.1.2 Ensure 'Enable Windows NTP Server' is set to 'Disabled'"
      info                     : "This policy setting specifies whether the Windows NTP Server is enabled."
      reference                : "NIST 800-53r5|AU-7 AU-8"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "Enabled"
      reg_key                  : "HKLM\Software\Policies\Microsoft\W32Time\TimeProviders\NtpServer"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.7.1.1 Ensure 'Prevent installation of devices using drivers that match these device setup classes' is set to 'Enabled'"
      info                     : "This policy setting allows you to specify a list of device setup class globally unique identifiers (GUIDs) for device drivers that Windows is prevented from installing."
      reference                : "NIST 800-53r5|MP-7"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DenyDeviceClasses"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DeviceInstall\Restrictions"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.7.2 Ensure 'Prevent automatic download of applications associated with device metadata' is set to 'Enabled'"
      info                     : "This policy setting allows you to prevent Windows from retrieving device metadata from the Internet."
      reference                : "NIST 800-53r5|CM-7(5) CM-10 SI-16"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "PreventDeviceMetadataFromNetwork"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Device Metadata"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.11.1 Ensure 'Network security: Allow Local System to use computer identity for NTLM' is set to 'Enabled'"
      info                     : "This policy setting determines whether Local System services that use Negotiate when reverting to NTLM authentication can use the computer identity."
      reference                : "NIST 800-53r5|IA-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "UseMachineId"
      reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.11.7 Ensure 'Network security: LDAP client encryption requirements' is set to 'Negotiate sealing' or higher"
      info                     : "This policy setting determines the level of data encryption that is requested on behalf of clients that issue LDAP BIND requests."
      reference                : "NIST 800-53r5|IA-3(1)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1" || "2"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "LDAPClientConfidentiality"
      reg_key                  : "HKLM\System\CurrentControlSet\Services\LDAP"
</custom_item>

