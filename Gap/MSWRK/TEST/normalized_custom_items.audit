      reference                : "NIST 800-53r5|CM-7(5) CM-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "ManagePreviewBuildsPolicyValue"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.5.7 Ensure 'MSS: (NoNameReleaseOnDemand) Allow the computer to ignore NetBIOS name release requests except from WINS servers' is set to 'Enabled'"
      info                     : "NetBIOS over TCP/IP is a network protocol that among other things provides a way to easily resolve NetBIOS names that are registered on Windows-based systems to the IP addresses that are configured on those systems."
      reference                : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
