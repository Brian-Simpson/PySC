<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.10.3.13 Ensure 'Configure use of smart cards on removable data drives: Require use of smart cards on removable data drives' is set to 'Enabled: True'"
      info                     : "'This policy setting specifies whether smart cards must be used to authenticate user access to BitLocker-protected removable data drives on a computer."
      reference                : "NIST 800-53r5|IA-2(1) IA-2(2) SC-28(1) IA-5(11)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
