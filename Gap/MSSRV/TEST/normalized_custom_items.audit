<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.43.13.2 (L1) Ensure 'Scan packed executables' is set to 'Enabled'"
      info                     : "This policy setting manages whether or not Microsoft Defender Antivirus scans packed executables."
      reference                : "NIST 800-53r5|MP-7 SI-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DisablePackedExeScanning"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Scan"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.43.13.3 (L1) Ensure 'Scan removable drives' is set to 'Enabled'"
      info                     : "This policy setting manages whether or not to scan for malicious software and unwanted software in the contents of removable drives, such as USB flash drives, when running a full scan."
      reference                : "NIST 800-53r5|MP-7 SI-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DisableRemovableDriveScanning"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Scan"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.57.3.11.1 (L1) Ensure 'Do not delete temp folders upon exit' is set to 'Disabled'"
      info                     : "This policy setting specifies whether Remote Desktop Services retains a user's per-session temporary folders at logoff."
      reference                : "NIST 800-53r5|AU-11 SI-12"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DeleteTempDirsOnExit"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows NT\Terminal Services"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.57.3.11.2 (L1) Ensure 'Do not use temporary folders per session' is set to 'Disabled'"
      info                     : "By default, Remote Desktop Services creates a separate temporary folder on the RD Session Host server for each active session that a user maintains on the RD Session Host server."
      reference                : "NIST 800-53r5|AU-11 SI-12"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "PerSessionTempDir"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows NT\Terminal Services"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.57.3.9.1 (L1) Ensure 'Always prompt for password upon connection' is set to 'Enabled'"
      info                     : "This policy setting specifies whether Remote Desktop Services always prompts the client computer for a password upon connection."
      reference                : "NIST 800-53r5|AC-17(6) IA-2"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "fPromptForPassword"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows NT\Terminal Services"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.58.1 (L1) Ensure 'Prevent downloading of enclosures' is set to 'Enabled'"
      info                     : "This policy setting prevents the user from having enclosures (file attachments) downloaded from an RSS feed to the user's computer."
      reference                : "NIST 800-53r5|CM-10 CM-11 SC-18"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DisableEnclosureDownload"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Internet Explorer\Feeds"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.58.2 (L1) Ensure 'Turn on Basic feed authentication over HTTP' is set to 'Disabled'"
      info                     : "This policy setting controls whether RSS feeds can be authenticated using the Basic authentication scheme over an unencrypted HTTP connection."
      reference                : "NIST 800-53r5|CM-10 CM-11 SC-18"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "AllowBasicAuthInClear"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Internet Explorer\Feeds"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.8.1 (L1) Ensure 'Disallow Autoplay for non-volume devices' is set to 'Enabled'"
      info                     : "This policy setting disallows AutoPlay for MTP devices like cameras or phones."
      reference                : "NIST 800-53r5|MP-7"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NoAutoplayfornonVolume"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Explorer"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.8.2 (L1) Ensure 'Set the default behavior for AutoRun' is set to 'Enabled: Do not execute any autorun commands'"
      info                     : "This policy setting sets the default behavior for Autorun commands."
      reference                : "NIST 800-53r5|MP-7"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NoAutorun"
      reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.8.3 (L1) Ensure 'Turn off Autoplay' is set to 'Enabled: All drives'"
      info                     : "Autoplay starts to read from a drive as soon as you insert media in the drive, which causes the setup file for programs or audio media to start immediately."
      reference                : "NIST 800-53r5|MP-7"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "255"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NoDriveTypeAutoRun"
      reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.93.1.1 (L1) Ensure 'No auto-restart with logged on users for scheduled automatic updates installations' is set to 'Disabled'"
      info                     : "This policy setting specifies that Automatic Updates will wait for computers to be restarted by the users who are logged on to them to complete a scheduled installation."
      reference                : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NoAutoRebootWithLoggedOnUsers"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate\AU"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.93.2.1 (L1) Ensure 'Configure Automatic Updates' is set to 'Enabled'"
      info                     : "'This policy setting specifies whether computers in your environment will receive security updates from Windows Update or WSUS."
      reference                : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NoAutoUpdate"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate\AU"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.93.2.2 (L1) Ensure 'Configure Automatic Updates: Scheduled install day' is set to '0 - Every day'"
      info                     : "This policy setting specifies when computers in your environment will receive security updates from Windows Update or WSUS."
      reference                : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "ScheduledInstallDay"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate\AU"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.93.4.1 (L1) Ensure 'Manage preview builds' is set to 'Disabled'"
      info                     : "This policy setting manages which updates that are received prior to the update being released."
      reference                : "NIST 800-53r5|CM-7(5) CM-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "ManagePreviewBuildsPolicyValue"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.1.2.2 (L1) Ensure 'Allow users to enable online speech recognition services' is set to 'Disabled'"
      info                     : "This policy enables the automatic learning component of input personalization that includes speech, inking, and typing."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "AllowInputPersonalization"
      reg_key                  : "HKLM\SOFTWARE\Policies\Microsoft\InputPersonalization"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.4.6 (L1) Ensure 'LSA Protection' is set to 'Enabled'"
      info                     : "This policy setting controls whether the Local Security Authority Server Service (LSASS) process runs protected."
      reference                : "NIST 800-53r5|SI-16"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "RunAsPPL"
      reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.4.7 (L1) Ensure 'NetBT NodeType configuration' is set to 'Enabled: P-node (recommended)'"
      info                     : "This setting determines which method NetBIOS over TCP/IP (NetBT) uses to register and resolve names."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "2"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NodeType"
      reg_key                  : "HKLM\System\CurrentControlSet\Services\NetBT\Parameters"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.4.8 (L1) Ensure 'WDigest Authentication' is set to 'Disabled'"
      info                     : "'When WDigest authentication is enabled, Lsass.exe retains a copy of the user\'s plaintext password in memory, where it can be at risk of theft."
      reference                : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "UseLogonCredential"
      reg_key                  : "HKLM\SYSTEM\CurrentControlSet\Control\SecurityProviders\WDigest"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.5.4 (L1) Ensure 'MSS: (EnableICMPRedirect) Allow ICMP redirects to override OSPF generated routes' is set to 'Disabled'"
      info                     : "Internet Control Message Protocol (ICMP) redirects cause the IPv4 stack to plumb host routes."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "EnableICMPRedirect"
      reg_key                  : "HKLM\System\CurrentControlSet\Services\Tcpip\Parameters"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.6.11.2 (L1) Ensure 'Prohibit installation and configuration of Network Bridge on your DNS domain network' is set to 'Enabled'"
      info                     : "You can use this procedure to control a user's ability to install and configure a Network Bridge."
      reference                : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NC_AllowNetBridge_NLA"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Network Connections"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.6.21.1 (L1) Ensure 'Minimize the number of simultaneous connections to the Internet or a Windows Domain' is set to 'Enabled: 3 = Prevent Wi-Fi when on Ethernet'"
      info                     : "This policy setting prevents computers from establishing multiple simultaneous connections to either the Internet or to a Windows domain."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "3"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "fMinimizeConnections"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WcmSvc\GroupPolicy"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.6.8.1 (L1) Ensure 'Enable insecure guest logons' is set to 'Disabled'"
      info                     : "This policy setting determines if the SMB client will allow insecure guest logons to an SMB server."
      reference                : "NIST 800-53r5|CM-7b"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "AllowInsecureGuestAuth"
      reg_key                  : "HKLM\SOFTWARE\Policies\Microsoft\Windows\LanmanWorkstation"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.7.1 (L1) Ensure 'Allow Print Spooler to accept client connections' is set to 'Disabled'"
      info                     : "This policy setting controls whether the Print Spooler service will accept client connections."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "2"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "RegisterSpoolerRemoteRpcEndPoint"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows NT\Printers"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.7.10 (L1) Ensure 'Manage processing of Queue-specific files' is set to 'Enabled: Limit Queue-specific files to Color profiles'"
      info                     : "This policy setting manages how queue-specific files are processed during printer installation."
      reference                : "NIST 800-53r5|SI-16"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "CopyFilesPolicy"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows NT\Printers"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.7.6 (L1) Ensure 'Configure RPC listener settings: Authentication protocol to use for incoming RPC connections:' is set to 'Enabled: Negotiate' or higher"
      info                     : "This policy setting controls which protocols incoming Remote Procedure Call (RPC) connections to the print spooler are allowed to use."
      reference                : "NIST 800-53r5|IA-3(1)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0" || "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "ForceKerberosForRpc"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows NT\Printers\RPC"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.7.9 (L1) Ensure 'Limits print driver installation to Administrators' is set to 'Enabled'"
      info                     : "This policy setting controls whether users who aren't Administrators can install print drivers on the system."
      reference                : "NIST 800-53r5|SI-4"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "RestrictDriverInstallationToAdministrators"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows NT\Printers\PointAndPrint"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.19.2 (L1) Ensure 'Configure registry policy processing: Do not apply during periodic background processing' is set to 'Enabled: FALSE'"
      info                     : "'The \'Do not apply during periodic background processing\' option prevents the system from updating affected registry policies in the background while the computer is in use."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NoBackgroundPolicy"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Group Policy\{35378EAC-683F-11D2-A89A-00C04FBBCFA2}"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.19.3 (L1) Ensure 'Configure registry policy processing: Process even if the Group Policy objects have not changed' is set to 'Enabled: TRUE'"
      info                     : "'The \'Process even if the Group Policy objects have not changed\' option updates and reapplies registry policies even if the registry policies have not changed."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NoGPOListChanges"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Group Policy\{35378EAC-683F-11D2-A89A-00C04FBBCFA2}"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.19.4 (L1) Ensure 'Configure security policy processing: Do not apply during periodic background processing' is set to 'Enabled: FALSE'"
      info                     : "'The \'Do not apply during periodic background processing\' option prevents the system from updating affected security policies in the background while the computer is in use."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NoBackgroundPolicy"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Group Policy\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.19.5 (L1) Ensure 'Configure security policy processing: Process even if the Group Policy objects have not changed' is set to 'Enabled: TRUE'"
      info                     : "'The \'Process even if the Group Policy objects have not changed\' option updates and reapplies security policies even if the security policies have not changed."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NoGPOListChanges"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Group Policy\{827D319E-6EAC-11D2-A4EA-00C04F79F83A}"
</custom_item>

<custom_item>
      type                     : REG_CHECK
      description              : "18.9.19.7 (L1) Ensure 'Turn off background refresh of Group Policy' is set to 'Disabled'"
      info                     : "This policy setting prevents Group Policy from being updated while the computer is in use."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_TEXT
      value_data               : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
      reg_option               : MUST_NOT_EXIST
      key_item                 : "DisableBkGndGroupPolicy"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.20.1.1 (L1) Ensure 'Turn off downloading of print drivers over HTTP' is set to 'Enabled'"
      info                     : "This policy setting controls whether the computer can download print driver packages over HTTP."
      reference                : "NIST 800-53r5|CM-7(5) CM-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DisableWebPnPDownload"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows NT\Printers"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.24.1 (L1) Ensure 'Enumeration policy for external devices incompatible with Kernel DMA Protection' is set to 'Enabled: Block All'"
      info                     : "This policy is intended to provide additional security against external DMA-capable devices."
      reference                : "NIST 800-53r5|CM-8"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DeviceEnumerationPolicy"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Kernel DMA Protection"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.28.1 (L1) Ensure 'Block user from showing account details on sign-in' is set to 'Enabled'"
      info                     : "This policy prevents the user from showing account details (email address or user name) on the sign-in screen."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "BlockUserFromShowingAccountDetailsOnSignin"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\System"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.3.1 (L1) Ensure 'Include command line in process creation events' is set to 'Enabled'"
      info                     : "This policy setting controls whether the process creation command line text is logged in security audit events when a new process has been created."
      reference                : "NIST 800-53r5|AU-2"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "ProcessCreationIncludeCmdLine_Enabled"
      reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System\Audit"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.51.1.1 (L1) Ensure 'Enable Windows NTP Client' is set to 'Enabled'"
      info                     : "This policy setting specifies whether the Windows NTP Client is enabled."
      reference                : "NIST 800-53r5|AU-7 AU-8"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "Enabled"
      reg_key                  : "HKLM\Software\Policies\Microsoft\W32Time\TimeProviders\NtpClient"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.7.2 (L1) Ensure 'Prevent device metadata retrieval from the Internet' is set to 'Enabled'"
      info                     : "This policy setting allows you to prevent Windows from retrieving device metadata from the Internet."
      reference                : "NIST 800-53r5|CM-7(5) CM-10 SI-16"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "PreventDeviceMetadataFromNetwork"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Device Metadata"
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.1 (L1) Ensure 'Access Credential Manager as a trusted caller' is set to 'No One'"
      info                     : "This security setting is used by Credential Manager during Backup and Restore."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : ""
      right_type               : SeTrustedCredManAccessPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.11 (L1) Ensure 'Back up files and directories' is set to 'Administrators'"
      info                     : "'This policy setting allows users to circumvent file and directory permissions to back up the system."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeBackupPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.12 (L1) Ensure 'Change the system time' is set to 'Administrators, LOCAL SERVICE'"
      info                     : "This policy setting determines which users and groups can change the time and date on the internal clock of the computers in your environment."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators" && "LOCAL SERVICE"
      right_type               : SeSystemTimePrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.13 (L1) Ensure 'Change the time zone' is set to 'Administrators, LOCAL SERVICE'"
      info                     : "This setting determines which users can change the time zone of the computer."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators" && "LOCAL SERVICE"
      right_type               : SeTimeZonePrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.14 (L1) Ensure 'Create a pagefile' is set to 'Administrators'"
      info                     : "This policy setting allows users to change the size of the pagefile."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeCreatePagefilePrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.15 (L1) Ensure 'Create a token object' is set to 'No One'"
      info                     : "'This policy setting allows a process to create an access token, which may provide elevated rights to access sensitive data."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : ""
      right_type               : SeCreateTokenPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.16 (L1) Ensure 'Create global objects' is set to 'Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE'"
      info                     : "'This policy setting determines whether users can create global objects that are available to all sessions."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators" && "LOCAL SERVICE" && "NETWORK SERVICE" && "SERVICE"
      right_type               : SeCreateGlobalPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.17 (L1) Ensure 'Create permanent shared objects' is set to 'No One'"
      info                     : "This user right is useful to kernel-mode components that extend the object namespace."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : ""
      right_type               : SeCreatePermanentPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.18 (L1) Ensure 'Create symbolic links' is set to 'Administrators' (DC only)"
      info                     : "This policy setting determines which users can create symbolic links."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeCreateSymbolicLinkPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.2 (L1) Ensure 'Access this computer from the network' is set to 'Administrators, Authenticated Users, ENTERPRISE DOMAIN CONTROLLERS' (DC only)"
      info                     : "This policy setting allows other users on the network to connect to the computer and is required by various network protocols that include Server Message Block (SMB)-based protocols, NetBIOS, Common Internet File System (CIFS), and Component Object Model Plus (COM+)."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators" && "Authenticated Users" && "Enterprise Domain Controllers"
      right_type               : SeNetworkLogonRight
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.20 (L1) Ensure 'Debug programs' is set to 'Administrators'"
      info                     : "'This policy setting determines which user accounts will have the right to attach a debugger to any process or to the kernel, which provides complete access to sensitive and critical operating system components."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeDebugPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.21 (L1) Ensure 'Deny access to this computer from the network' to include 'Guests' (DC only)"
      info                     : "This policy setting prohibits users from connecting to a computer from across the network, which would allow users to access and potentially modify data remotely."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Guests"
      check_type               : CHECK_SUPERSET
      right_type               : SeDenyNetworkLogonRight
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.23 (L1) Ensure 'Deny log on as a batch job' to include 'Guests'"
      info                     : "This policy setting determines which accounts will not be able to log on to the computer as a batch job."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Guests"
      check_type               : CHECK_SUPERSET
      right_type               : SeDenyBatchLogonRight
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.24 (L1) Ensure 'Deny log on as a service' to include 'Guests'"
      info                     : "This security setting determines which service accounts are prevented from registering a process as a service."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Guests"
      check_type               : CHECK_SUPERSET
      right_type               : SeDenyServiceLogonRight
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.25 (L1) Ensure 'Deny log on locally' to include 'Guests'"
      info                     : "This security setting determines which users are prevented from logging on at the computer."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Guests"
      check_type               : CHECK_SUPERSET
      right_type               : SeDenyInteractiveLogonRight
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.26 (L1) Ensure 'Deny log on through Remote Desktop Services' to include 'Guests' (DC only)"
      info                     : "This policy setting determines whether users can log on as Remote Desktop clients."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Guests"
      check_type               : CHECK_SUPERSET
      right_type               : SeDenyRemoteInteractiveLogonRight
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.28 (L1) Ensure 'Enable computer and user accounts to be trusted for delegation' is set to 'Administrators' (DC only)"
      info                     : "'This policy setting allows users to change the Trusted for Delegation setting on a computer object in Active Directory."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeEnableDelegationPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.30 (L1) Ensure 'Force shutdown from a remote system' is set to 'Administrators'"
      info                     : "This policy setting allows users to shut down Windows Vista-based or newer computers from remote locations on the network."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeRemoteShutdownPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.31 (L1) Ensure 'Generate security audits' is set to 'LOCAL SERVICE, NETWORK SERVICE'"
      info                     : "'This policy setting determines which users or processes can generate audit records in the Security log."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "LOCAL SERVICE" && "NETWORK SERVICE"
      right_type               : SeAuditPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.32 (L1) Ensure 'Impersonate a client after authentication' is set to 'Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE' (DC only)"
      info                     : "'The policy setting allows programs that run on behalf of a user to impersonate that user (or another specified account) so that they can act on behalf of the user."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators" && "LOCAL SERVICE" && "NETWORK SERVICE" && "SERVICE"
      right_type               : SeImpersonatePrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.34 (L1) Ensure 'Increase scheduling priority' is set to 'Administrators, Window Manager\Window Manager Group'"
      info                     : "This policy setting determines whether users can increase the base priority class of a process."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : ("Administrators" && "Window Manager Group") || ("Administrators" && "Window Manager\Window Manager Group")
      right_type               : SeIncreaseBasePriorityPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.35 (L1) Ensure 'Load and unload device drivers' is set to 'Administrators'"
      info                     : "'This policy setting allows users to dynamically load a new device driver on a system."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeLoadDriverPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.36 (L1) Ensure 'Lock pages in memory' is set to 'No One'"
      info                     : "This policy setting allows a process to keep data in physical memory, which prevents the system from paging the data to virtual memory on disk."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : ""
      right_type               : SeLockMemoryPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.38 (L1) Ensure 'Manage auditing and security log' is set to 'Administrators' (DC only)"
      info                     : "'This policy setting determines which users can change the auditing options for files and directories and clear the Security log."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators" || ("Administrators" && "Exchange Servers")
      right_type               : SeSecurityPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.4 (L1) Ensure 'Act as part of the operating system' is set to 'No One'"
      info                     : "'This policy setting allows a process to assume the identity of any user and thus gain access to the resources that the user is authorized to access."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : ""
      right_type               : SeTcbPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.40 (L1) Ensure 'Modify an object label' is set to 'No One'"
      info                     : "This privilege determines which user accounts can modify the integrity label of objects, such as files, registry keys, or processes owned by other users."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : ""
      right_type               : SeReLabelPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.41 (L1) Ensure 'Modify firmware environment values' is set to 'Administrators'"
      info                     : "'This policy setting allows users to configure the system-wide environment variables that affect hardware configuration."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeSystemEnvironmentPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.42 (L1) Ensure 'Perform volume maintenance tasks' is set to 'Administrators'"
      info                     : "This policy setting allows users to manage the system's volume or disk configuration, which could allow a user to delete a volume and cause data loss as well as a denial-of-service condition."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeManageVolumePrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.43 (L1) Ensure 'Profile single process' is set to 'Administrators'"
      info                     : "This policy setting determines which users can use tools to monitor the performance of non-system processes."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeProfileSingleProcessPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.44 (L1) Ensure 'Profile system performance' is set to 'Administrators, NT SERVICE\WdiServiceHost'"
      info                     : "This policy setting allows users to use tools to view the performance of different system processes, which could be abused to allow attackers to determine a system's active processes and provide insight into the potential attack surface of the computer."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators" && ("NT SERVICE\WdiServiceHost" || "WdiServiceHost")
      right_type               : SeSystemProfilePrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.45 (L1) Ensure 'Replace a process level token' is set to 'LOCAL SERVICE, NETWORK SERVICE'"
      info                     : "'This policy setting allows one process or service to start another service or process with a different security access token, which can be used to modify the security access token of that sub-process and result in the escalation of privileges."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "LOCAL SERVICE" && "NETWORK SERVICE"
      right_type               : SeAssignPrimaryTokenPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.46 (L1) Ensure 'Restore files and directories' is set to 'Administrators'"
      info                     : "'This policy setting determines which users can bypass file, directory, registry, and other persistent object permissions when restoring backed up files and directories on computers that run Windows Vista (or newer) in your environment."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeRestorePrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.47 (L1) Ensure 'Shut down the system' is set to 'Administrators'"
      info                     : "This policy setting determines which users who are logged on locally to the computers in your environment can shut down the operating system with the Shut Down command."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeShutdownPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.48 (L1) Ensure 'Synchronize directory service data' is set to 'No One' (DC only)"
      info                     : "This security setting determines which users and groups have the authority to synchronize all directory service data."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : ""
      right_type               : SeSyncAgentPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.49 (L1) Ensure 'Take ownership of files or other objects' is set to 'Administrators'"
      info                     : "'This policy setting allows users to take ownership of files, folders, registry keys, processes, or threads."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeTakeOwnershipPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.5 (L1) Ensure 'Add workstations to domain' is set to 'Administrators' (DC only)"
      info                     : "This policy setting specifies which users can add computer workstations to the domain."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeMachineAccountPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.6 (L1) Ensure 'Adjust memory quotas for a process' is set to 'Administrators, LOCAL SERVICE, NETWORK SERVICE'"
      info                     : "This policy setting allows a user to adjust the maximum amount of memory that is available to a process."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators" && "LOCAL SERVICE" && "NETWORK SERVICE"
      right_type               : SeIncreaseQuotaPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.7 (L1) Ensure 'Allow log on locally' is set to 'Administrators, ENTERPRISE DOMAIN CONTROLLERS' (DC only)"
      info                     : "This policy setting determines which users can interactively log on to computers in your environment."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators" && "ENTERPRISE DOMAIN CONTROLLERS"
      right_type               : SeInteractiveLogonRight
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.9 (L1) Ensure 'Allow log on through Remote Desktop Services' is set to 'Administrators' (DC only)"
      info                     : "This policy setting determines which users or groups have the right to log on as a Remote Desktop Services client."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeRemoteInteractiveLogonRight
</custom_item>

<custom_item>
      type                     : ANONYMOUS_SID_SETTING
      description              : "2.3.10.1 (L1) Ensure 'Network access: Allow anonymous SID/Name translation' is set to 'Disabled'"
      info                     : "This policy setting determines whether an anonymous user can request security identifier (SID) attributes for another user, or use a SID to obtain its corresponding user name."
      reference                : "NIST 800-53r5|AC-6(10) IA-2(2)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_SET
      value_data               : "Disabled"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.10.6 (L1) Ensure 'Network access: Named Pipes that can be accessed anonymously' is configured (DC only)"
      info                     : "This policy setting determines which communication sessions, or pipes, will have attributes and permissions that allow anonymous access."
      reference                : "NIST 800-53r5|IA-2(2)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_MULTI_TEXT
      value_data               : ("LSARPC" && "NETLOGON" && "SAMR" && "Browser") || ("LSARPC" && "NETLOGON" && "SAMR")
      reg_item                 : "NullSessionPipes"
      reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.11.1 (L1) Ensure 'Network security: Allow Local System to use computer identity for NTLM' is set to 'Enabled'"
      info                     : "This policy setting determines whether Local System services that use Negotiate when reverting to NTLM authentication can use the computer identity."
      reference                : "NIST 800-53r5|IA-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "UseMachineId"
      reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.11.11 (L1) Ensure 'Network security: Restrict NTLM: Audit Incoming NTLM Traffic' is set to 'Enable auditing for all accounts'"
      info                     : "This policy setting allows the auditing of incoming NTLM traffic."
      reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "2"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "AuditReceivingNTLMTraffic"
      reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa\MSV1_0"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.11.12 (L1) Ensure 'Network security: Restrict NTLM: Audit NTLM authentication in this domain' is set to 'Enable all' (DC only)"
      info                     : "This policy setting allows auditing of NTLM authentication within the domain from the Domain Controller."
      reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "7"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "AuditNTLMInDomain"
      reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters\"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.11.13 (L1) Ensure 'Network security: Restrict NTLM: Outgoing NTLM traffic to remote servers' is set to 'Audit all' or higher"
      info                     : "This policy setting allows the auditing of outgoing NTLM traffic."
      reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1" || "2"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "RestrictSendingNTLMTraffic"
      reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa\MSV1_0"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.11.3 (L1) Ensure 'Network Security: Allow PKU2U authentication requests to this computer to use online identities' is set to 'Disabled'"
      info                     : "This setting determines if online identities are able to authenticate to this computer."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "AllowOnlineID"
      reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa\pku2u"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.11.5 (L1) Ensure 'Network security: Do not store LAN Manager hash value on next password change' is set to 'Enabled'"
      info                     : "This policy setting determines whether the LAN Manager (LM) hash value for the new password is stored when the password is changed."
      reference                : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NoLMHash"
      reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.11.7 (L1) Ensure 'Network security: LAN Manager authentication level' is set to 'Send NTLMv2 response only. Refuse LM & NTLM'"
      info                     : "LAN Manager (LM) was a family of early Microsoft client/server software (predating Windows NT) that allowed users to link personal computers together on a single network."
      reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "5"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "LMCompatibilityLevel"
      reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.15.2 (L1) Ensure 'System objects: Strengthen default permissions of internal system objects (e.g. Symbolic Links)' is set to 'Enabled'"
      info                     : "This policy setting determines the strength of the default discretionary access control list (DACL) for objects."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "ProtectionMode"
      reg_key                  : "HKLM\System\CurrentControlSet\Control\Session Manager"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.2.1 (L1) Ensure 'Audit: Force audit policy subcategory settings (Windows Vista or later) to override audit policy category settings' is set to 'Enabled'"
      info                     : "This policy setting allows administrators to enable the more precise auditing capabilities present in Windows Vista."
      reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "SCENoApplyLegacyAuditPolicy"
      reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.4.1 (L1) Ensure 'Devices: Prevent users from installing printer drivers' is set to 'Enabled'"
      info                     : "For a computer to print to a shared printer, the driver for that shared printer must be installed on the local computer."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "AddPrinterDrivers"
      reg_key                  : "HKLM\System\CurrentControlSet\Control\Print\Providers\LanMan Print Services\Servers"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.5.5 (L1) Ensure 'Domain controller: Refuse machine account password changes' is set to 'Disabled' (DC only)"
      info                     : "This security setting determines whether Domain Controllers will refuse requests from member computers to change computer account passwords."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : 0
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "RefusePasswordChange"
      reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.7.1 (L1) Ensure 'Interactive logon: Do not require CTRL+ALT+DEL' is set to 'Disabled'"
      info                     : "This policy setting determines whether users must press CTRL+ALT+DEL before they log on."
      reference                : "NIST 800-53r5|AC-7 AC-19"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DisableCAD"
      reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.7.2 (L1) Ensure 'Interactive logon: Don't display last signed-in' is set to 'Enabled'"
      info                     : "This policy setting determines whether the account name of the last user to log on to the client computers in your organization will be displayed in each computer's respective Windows logon screen."
      reference                : "NIST 800-53r5|AC-7 AC-19"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DontDisplayLastUserName"
      reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
</custom_item>

<custom_item>
      type                     : BANNER_CHECK
      description              : "2.3.7.4 (L1) Configure 'Interactive logon: Message text for users attempting to log on'"
      info                     : "This policy setting specifies a text message that displays to users when they log on."
      reference                : "NIST 800-53r5|AC-8"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_TEXT
      value_data               : "@LEGAL_NOTICE_TEXT@"
      reg_item                 : "LegalNoticeText"
      reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
</custom_item>

<custom_item>
      type                     : BANNER_CHECK
      description              : "2.3.7.5 (L1) Configure 'Interactive logon: Message title for users attempting to log on'"
      info                     : "This policy setting specifies the text displayed in the title bar of the window that users see when they log on to the system."
      reference                : "NIST 800-53r5|AC-8"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_TEXT
      value_data               : "@LEGAL_CAPTION_TEXT@"
      reg_item                 : "LegalNoticeCaption"
      reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.9.4 (L1) Ensure 'Microsoft network server: Disconnect clients when logon hours expire' is set to 'Enabled'"
      info                     : "This security setting determines whether to disconnect users who are connected to the local computer outside their user account's valid logon hours."
      reference                : "NIST 800-53r5|AC-2(12)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "EnableForcedLogoff"
      reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "9.1.6 (L1) Ensure 'Windows Firewall: Domain: Logging: Log dropped packets' is set to 'Yes'"
      info                     : "Use this option to log when Windows Firewall with Advanced Security discards an inbound packet for any reason."
      reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12 SC-7 SC-7(5)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "LogDroppedPackets"
      reg_key                  : "HKLM\Software\Policies\Microsoft\WindowsFirewall\DomainProfile\Logging"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "9.1.7 (L1) Ensure 'Windows Firewall: Domain: Logging: Log successful connections' is set to 'Yes'"
      info                     : "Use this option to log when Windows Firewall with Advanced Security allows an inbound connection."
      reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12 SC-7 SC-7(5)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "LogSuccessfulConnections"
      reg_key                  : "HKLM\Software\Policies\Microsoft\WindowsFirewall\DomainProfile\Logging"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "9.2.6 (L1) Ensure 'Windows Firewall: Private: Logging: Log dropped packets' is set to 'Yes'"
      info                     : "Use this option to log when Windows Firewall with Advanced Security discards an inbound packet for any reason."
      reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12 SC-7 SC-7(5)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "LogDroppedPackets"
      reg_key                  : "HKLM\Software\Policies\Microsoft\WindowsFirewall\PrivateProfile\Logging"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "9.2.7 (L1) Ensure 'Windows Firewall: Private: Logging: Log successful connections' is set to 'Yes'"
      info                     : "Use this option to log when Windows Firewall with Advanced Security allows an inbound connection."
      reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12 SC-7 SC-7(5)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "LogSuccessfulConnections"
      reg_key                  : "HKLM\Software\Policies\Microsoft\WindowsFirewall\PrivateProfile\Logging"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "9.3.8 (L1) Ensure 'Windows Firewall: Public: Logging: Log dropped packets' is set to 'Yes'"
      info                     : "Use this option to log when Windows Firewall with Advanced Security discards an inbound packet for any reason."
      reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12 SC-7 SC-7(5)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "LogDroppedPackets"
      reg_key                  : "HKLM\Software\Policies\Microsoft\WindowsFirewall\PublicProfile\Logging"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "9.3.9 (L1) Ensure 'Windows Firewall: Public: Logging: Log successful connections' is set to 'Yes'"
      info                     : "Use this option to log when Windows Firewall with Advanced Security allows an inbound connection."
      reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12 SC-7 SC-7(5)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "LogSuccessfulConnections"
      reg_key                  : "HKLM\Software\Policies\Microsoft\WindowsFirewall\PublicProfile\Logging"
</custom_item>

<custom_item>
      type                     : PASSWORD_POLICY
      description              : "1.2.3 (L1) Ensure 'Allow Administrator account lockout' is set to 'Enabled' (MS only)"
      info                     : "This policy setting determines whether the built-in Administrator account is subject to the following Account Lockout Policy settings: Account lockout duration , Account lockout threshold , and Reset account lockout counter ."
      reference                : "NIST 800-53r5|AC-7 AC-19"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_SET
      value_data               : "Enabled"
      password_policy          : LOCKOUT_ADMINS
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.25.1 (L1) Ensure 'Configure password backup directory' is set to 'Enabled: Active Directory' or 'Enabled: Azure Active Directory'"
      info                     : "This policy setting configures which directory Windows LAPS will use to back up the local admin account password."
      reference                : "NIST 800-53r5|CP-9"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1" || "2"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "BackupDirectory"
      reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.51.1.2 (L1) Ensure 'Enable Windows NTP Server' is set to 'Disabled' (MS only)"
      info                     : "This policy setting specifies whether the Windows NTP Server is enabled."
      reference                : "NIST 800-53r5|AU-7 AU-8"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "Enabled"
      reg_key                  : "HKLM\Software\Policies\Microsoft\W32Time\TimeProviders\NtpServer"
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.10 (L1) Ensure 'Allow log on through Remote Desktop Services' is set to 'Administrators, Remote Desktop Users' (MS only)"
      info                     : "This policy setting determines which users or groups have the right to log on as a Remote Desktop Services client."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators" && "Remote Desktop Users"
      right_type               : SeRemoteInteractiveLogonRight
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.19 (L1) Ensure 'Create symbolic links' is set to 'Administrators, NT VIRTUAL MACHINE\Virtual Machines' (MS only)"
      info                     : "This policy setting determines which users can create symbolic links."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : ("Administrators" || ("Administrators" && "Virtual Machines") || ("Administrators" && "NT VIRTUAL MACHINE\Virtual Machines"))
      right_type               : SeCreateSymbolicLinkPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.22 (L1) Ensure 'Deny access to this computer from the network' to include 'Guests, Local account and member of Administrators group' (MS only)"
      info                     : "This policy setting prohibits users from connecting to a computer from across the network, which would allow users to access and potentially modify data remotely."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Guests" && "Local account and member of Administrators group"
      check_type               : CHECK_SUPERSET
      right_type               : SeDenyNetworkLogonRight
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.27 (L1) Ensure 'Deny log on through Remote Desktop Services' is set to 'Guests, Local account' (MS only)"
      info                     : "This policy setting determines whether users can log on as Remote Desktop clients."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Guests" && "Local account"
      check_type               : CHECK_SUPERSET
      right_type               : SeDenyRemoteInteractiveLogonRight
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.29 (L1) Ensure 'Enable computer and user accounts to be trusted for delegation' is set to 'No One' (MS only)"
      info                     : "'This policy setting allows users to change the Trusted for Delegation setting on a computer object in Active Directory."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : ""
      right_type               : SeEnableDelegationPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.3 (L1) Ensure 'Access this computer from the network'  is set to 'Administrators, Authenticated Users' (MS only)"
      info                     : "This policy setting allows other users on the network to connect to the computer and is required by various network protocols that include Server Message Block (SMB)-based protocols, NetBIOS, Common Internet File System (CIFS), and Component Object Model Plus (COM+)."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators" && "Authenticated Users"
      right_type               : SeNetworkLogonRight
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.33 (L1) Ensure 'Impersonate a client after authentication' is set to 'Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE' and (when the Web Server (IIS) Role with Web Services Role Service is installed) 'IIS_IUSRS' (MS only)"
      info                     : "'The policy setting allows programs that run on behalf of a user to impersonate that user (or another specified account) so that they can act on behalf of the user."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : ("Administrators" && "Local Service" && "Network Service" && "Service") || ("Administrators" && "IIS_IUSRS" && "Local Service" && "Network Service" && "Service")
      right_type               : SeImpersonatePrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.39 (L1) Ensure 'Manage auditing and security log' is set to 'Administrators' (MS only)"
      info                     : "'This policy setting determines which users can change the auditing options for files and directories and clear the Security log."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeSecurityPrivilege
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.8 (L1) Ensure 'Allow log on locally' is set to 'Administrators' (MS only)"
      info                     : "This policy setting determines which users can interactively log on to computers in your environment."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators"
      right_type               : SeInteractiveLogonRight
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.10.7 (L1) Ensure 'Network access: Named Pipes that can be accessed anonymously' is configured (MS only)"
      info                     : "This policy setting determines which communication sessions, or pipes, will have attributes and permissions that allow anonymous access."
      reference                : "NIST 800-53r5|IA-2(2)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_MULTI_TEXT
      value_data               : "" || "Browser"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NullSessionPipes"
      reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "2.3.9.5 (L1) Ensure 'Microsoft network server: Server SPN target name validation level' is set to 'Accept if provided by client' or higher (MS only)"
      info                     : "This policy setting controls the level of validation a computer with shared folders or printers (the server) performs on the service principal name (SPN) that is provided by the client computer when it establishes a session using the server message block (SMB) protocol."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1" || "2"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "SMBServerNameHardeningLevel"
      reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
</custom_item>

<custom_item>
      type                     : PASSWORD_POLICY
      description              : "1.1.7 Ensure 'Store passwords using reversible encryption' is set to 'Disabled'"
      info                     : "This policy setting determines whether the operating system stores passwords in a way that uses reversible encryption, which provides support for application protocols that require knowledge of the user's password for authentication purposes."
      reference                : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_SET
      value_data               : "Disabled"
      password_policy          : REVERSIBLE_ENCRYPTION
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.42.10.4 Ensure 'Turn on behavior monitoring' is set to 'Enabled'"
      info                     : "This policy setting allows you to configure behavior monitoring for Microsoft Defender Antivirus."
      reference                : "NIST 800-53r5|SI-4"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DisableBehaviorMonitoring"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Real-Time Protection"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.42.10.5 Ensure 'Turn on script scanning' is set to 'Enabled'"
      info                     : "This policy setting allows script scanning to be turned on/off."
      reference                : "NIST 800-53r5|SI-4"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DisableScriptScanning"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Real-Time Protection"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.42.13.2 Ensure 'Scan packed executables' is set to 'Enabled'"
      info                     : "This policy setting manages whether or not Microsoft Defender Antivirus scans packed executables."
      reference                : "NIST 800-53r5|MP-7 SI-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DisablePackedExeScanning"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Scan"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.42.13.3 Ensure 'Scan removable drives' is set to 'Enabled'"
      info                     : "This policy setting manages whether to scan for malicious software and unwanted software in the contents of removable drives, such as USB flash drives, when running a full scan."
      reference                : "NIST 800-53r5|MP-7 SI-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DisableRemovableDriveScanning"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Scan"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.94.1.1 Ensure 'No auto-restart with logged on users for scheduled automatic updates installations' is set to 'Disabled'"
      info                     : "This policy setting specifies that Automatic Updates will wait for computers to be restarted by the users who are logged on to them to complete a scheduled installation."
      reference                : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NoAutoRebootWithLoggedOnUsers"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate\AU"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.94.2.1 Ensure 'Configure Automatic Updates' is set to 'Enabled'"
      info                     : "'This policy setting specifies whether computers in your environment will receive security updates from Windows Update or WSUS."
      reference                : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "NoAutoUpdate"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate\AU"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.94.2.2 Ensure 'Configure Automatic Updates: Scheduled install day' is set to '0 - Every day'"
      info                     : "This policy setting specifies when computers in your environment will receive security updates from Windows Update or WSUS."
      reference                : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "ScheduledInstallDay"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate\AU"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.94.4.1 Ensure 'Manage preview builds' is set to 'Disabled'"
      info                     : "This policy setting manages which updates that are received prior to the update being released."
      reference                : "NIST 800-53r5|CM-7(5) CM-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "ManagePreviewBuildsPolicyValue"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.6.7.1 Ensure 'Mandate the minimum version of SMB' is set to 'Enabled: 3.1.1'"
      info                     : "This policy settings controls the minimum version of Server Message Block (SMB) protocol that can be used on the system."
      reference                : "NIST 800-53r5|CM-6 CM-7"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "785"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "MinSmb2Dialect"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\LanmanServer"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.6.8.2 Ensure 'Require Encryption' is set to 'Enabled'"
      info                     : "This policy setting controls whether the SMB client will require encryption."
      reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "RequireEncryption"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\LanmanWorkstation"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.17.1 Ensure 'Enable / disable CLFS logfile authentication' is set to 'Enabled'"
      info                     : "This policy setting configures Common Log File System (CLFS) logfile authentication."
      reference                : "NIST 800-53r5|AU-9(3)"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "ClfsAuthenticationChecking"
      reg_key                  : "HKLM\System\CurrentControlSet\Policies"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.29.1 Ensure 'Block user from showing account details on sign-in' is set to 'Enabled'"
      info                     : "This policy prevents the user from showing account details (email address or user name) on the sign-in screen."
      reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "BlockUserFromShowingAccountDetailsOnSignin"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\System"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.41.1 Ensure 'Configure validation of ROCA-vulnerable WHfB keys during authentication' is set to 'Enabled: Block' (DC only)"
      info                     : "'This policy setting allows you to configure how Domain Controllers handle Windows Hello for Business (WHfB) keys that are vulnerable to the \'Return of Coppersmith\'s attack\' (ROCA) vulnerability."
      reference                : "NIST 800-53r5|SC-39 SI-16"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "2"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "SamNGCKeyROCAValidation"
      reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System\SAM"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.53.1.1 Ensure 'Enable Windows NTP Client' is set to 'Enabled'"
      info                     : "This policy setting specifies whether the Windows NTP Client is enabled."
      reference                : "NIST 800-53r5|AU-7 AU-8"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "Enabled"
      reg_key                  : "HKLM\Software\Policies\Microsoft\W32Time\TimeProviders\NtpClient"
</custom_item>

<custom_item>
      type                     : USER_RIGHTS_POLICY
      description              : "2.2.37 Ensure 'Manage auditing and security log' is set to 'Administrators' (DC only)"
      info                     : "'This policy setting determines which users can change the auditing options for files and directories and clear the Security log."
      reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4) AC-3"
      see_also                 : "See HTH Policies and Standards"
      value_type               : USER_RIGHT
      value_data               : "Administrators" || ("Administrators" && "Exchange Servers")
      right_type               : SeSecurityPrivilege
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.26.1 Ensure 'Configure password backup directory' is set to 'Enabled: Active Directory' or 'Enabled: Azure Active Directory'"
      info                     : "This policy setting configures which directory Windows LAPS will use to back up the local admin account password."
      reference                : "NIST 800-53r5|CP-9"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1" || "2"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "BackupDirectory"
      reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.9.53.1.2 Ensure 'Enable Windows NTP Server' is set to 'Disabled' (MS only)"
      info                     : "This policy setting specifies whether the Windows NTP Server is enabled."
      reference                : "NIST 800-53r5|AU-7 AU-8"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "0"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "Enabled"
      reg_key                  : "HKLM\Software\Policies\Microsoft\W32Time\TimeProviders\NtpServer"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.10.4.2 Ensure 'Not allow per-user unsigned packages to install by default (requires explicitly allow per install)' is set to 'Enabled'"
      info                     : "This setting manages a user's ability to install unsigned Windows App packages."
      reference                : "NIST 800-53r5|CM-7(5) CM-10"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "DisablePerUserUnsignedPackagesByDefault"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Appx"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.6.7.2 Ensure 'Audit client does not support signing' is set to 'Enabled'"
      info                     : "This policy setting determines whether the Server Message Block (SMB) server will log events when the SMB client doesn't support signing."
      reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "AuditClientDoesNotSupportSigning"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\LanmanServer"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.6.7.3 Ensure 'Audit insecure guest logon' is set to 'Enabled'"
      info                     : "This policy determines whether the Server Message Block (SMB) server will log events when the client is logged on as guest account."
      reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "AuditInsecureGuestLogon"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\LanmanServer"
</custom_item>

<custom_item>
      type                     : REGISTRY_SETTING
      description              : "18.6.8.3 Ensure 'Audit server does not support signing' is set to 'Enabled'"
      info                     : "This policy setting determines whether the Server Message Block (SMB) client will log events when the SMB server doesn't support signing."
      reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also                 : "See HTH Policies and Standards"
      value_type               : POLICY_DWORD
      value_data               : "1"
      reg_option               : CAN_NOT_BE_NULL
      reg_item                 : "AuditServerDoesNotSupportSigning"
      reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\LanmanWorkstation"
</custom_item>