# <custom_item>
#   type        : FILE_CONTENT_CHECK
#   description : "1.0017 - RHEL - Ensure at least one file named /etc/pam.d/password-auth exists and matches session pattern"
#   info        : "No additional information provided."
#   solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
#   reference   : ""
#   see_also    : "See HTH Policies and Standards"
#   expect      : "^\\h*session\\h+(required|requisite)\\h+pam_unix\\.so\\b"
#   regex       : "^\\h*session\\h+(required|requisite)\\h+pam_unix\\.so\\b"
#   system      : "Linux"
# </custom_item>

# <custom_item>
#   type        : FILE_CONTENT_CHECK
#   description : "1.0018 - RHEL - Ensure at least one file named /etc/pam.d/password-auth exists and matches auth pattern"
#   info        : "No additional information provided."
#   solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
#   reference   : ""
#   see_also    : "See HTH Policies and Standards"
