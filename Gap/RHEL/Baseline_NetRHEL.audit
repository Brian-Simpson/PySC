<custom_item>
  type        : RPM_CHECK
  description : "1.0086 - RHEL - Services - Ensure SELinux is installed"
  info        : "SELinux provides Mandatory Access Control."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53|AC-3 AC-5 AC-6 MP-2"
  see_also    : "See HTH Policies and Standards"
  rpm         : "libselinux-0.0.0-0"
  operator    : "gt"
  system      : "Linux"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "1.0087 - RHEL - Services - Ensure SELinux is not disabled in bootloader configuration"
  info        : "Configure SELINUX to be enabled at boot time and verify that it has not been overwritten by the grub boot parameters."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53|AC-3 AC-5 AC-6 MP-2"
  see_also    : "See HTH Policies and Standards"
  expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
  cmd         : "/sbin/grubby --info=ALL | /bin/grep -Po '(selinux|enforcing)=0' | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
  system      : "Linux"
</custom_item>

<custom_item>
  type        : RPM_CHECK
  description : "1.0088 - RHEL - Services - Ensure sudo is installed"
