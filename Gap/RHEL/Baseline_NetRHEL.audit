<custom_item>
  type        : FILE_CHECK
  description : "1.0293 - RHEL - Ensure permissions on /etc/passwd are configured"
  info        : "The /etc/passwd file contains user account information that is used by many system utilities and therefore must be readable for these utilities to operate."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
  see_also    : "See HTH Policies and Standards"
  system      : "Linux"
  mask        : "133"
</custom_item>

<custom_item>
  type        : FILE_CONTENT_CHECK
  description : "1.0294 - RHEL - Ensure SELinux policy is configured - /etc/selinux/config"
  info        : "Configure SELinux to meet or exceed the default targeted policy, which constrains daemons and system software only."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
  see_also    : "See HTH Policies and Standards"
  expect      : "^[\\s]*[sS][eE][lL][iI][nN][uU][xX][tT][yY][pP][eE][\\s]*=[\\s]*[Tt][Aa][Rr][Gg][Ee][Tt][Ee][Dd][\\s]*$"
  regex       : "^[\\s]*[sS][eE][lL][iI][nN][uU][xX][tT][yY][pP][eE][\\s]*="
  system      : "Linux"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "1.0295 - RHEL - Ensure SELinux policy is configured - sestatus"
  info        : "Configure SELinux to meet or exceed the default targeted policy, which constrains daemons and system software only."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
  see_also    : "See HTH Policies and Standards"
  expect      : "^[\\s]*Loaded policy name:[\\s]+([Tt][Aa][Rr][Gg][Ee][Tt][Ee][Dd]|[Mm][Ll][Ss])$"
  system      : "Linux"
  cmd         : "/usr/sbin/sestatus"
</custom_item>

<custom_item>
  type        : FILE_CONTENT_CHECK
  description : "1.0296 - RHEL - Ensure the SELinux mode is not disabled - /etc/selinux/config"
  info        : "SELinux can run in one of three modes: disabled, permissive, or enforcing."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
  see_also    : "See HTH Policies and Standards"
  expect      : "(^[\\s]*[sS][eE][lL][iI][nN][uU][xX][\\s]*=[\\s]*([eE][nN][fF][oO][rR][cC][iI][nN][gG]|[pP][eE][rR][mM][iI][sS][sS][iI][vV][eE])[\\s]*$)"
  system      : "Linux"
  regex       : "^[\\s]*[sS][eE][lL][iI][nN][uU][xX][\\s]*="
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "1.0297 - RHEL - Ensure the SELinux mode is not disabled - getenforce"
  info        : "SELinux can run in one of three modes: disabled, permissive, or enforcing."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
  see_also    : "See HTH Policies and Standards"
  expect      : "(Enforcing|Permissive)"
  system      : "Linux"
  cmd         : "/usr/sbin/getenforce"
</custom_item>

