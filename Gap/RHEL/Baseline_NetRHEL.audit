# <custom_item>
#   type        : CMD_EXEC
#   description : "1.0199 - RHEL - Ensure sshd IgnoreRhosts is enabled"
#   info        : "The IgnoreRhosts parameter specifies that."
#   solution    : "Edit the /etc/ssh/sshd_config file to set the IgnoreRhosts parameter to yes above any Include entry as follows: IgnoreRhosts yes"
#   reference   : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 IA-5"
#   see_also    : "See HTH Policies and Standards"
#   expect      : "^Pass$"
#   cmd         : "#!/bin/bash { ports=$(/bin/grep -s -P \"^(Port|Match)\" /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf | /bin/grep -P -o \"(Port|LocalPort)[\\s]+[\\d]+\" | /usr/bin/awk '{print $2}; END {if (NR == 0) print \"22\"}' | /usr/bin/uniq); for port in ${ports[@]}; do /usr/sbin/sshd -T -C user=root -C host=\"$(hostname)\" -C addr=\"$(/bin/grep $(hostname) /etc/hosts | /usr/bin/awk '{print $1}')\" -C lport=$port | echo \"port $port: $(/bin/grep -i ^ignorerhosts)\"; done | /usr/bin/awk 'BEGIN {f=0} /IgnoreRhosts/i { if ($NF == \"no\") f++; print $0} END {if (NR == 0) print \"Fail: no results returned\"; else if (f > 0) print \"Fail\"; else print \"Pass\" }' }"
