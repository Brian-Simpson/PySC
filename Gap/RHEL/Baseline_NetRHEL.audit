<custom_item>
  type        : CMD_EXEC
  description : "1.0255 - RHEL - Ensure nodev option set on /var partition"
  info        : "The nodev mount option specifies that the filesystem cannot contain special devices."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
  see_also    : "See HTH Policies and Standards"
  expect      : "([\\s]*[,]?nodev|not mounted)"
  system      : "Linux"
  cmd         : "/usr/bin/findmnt --kernel /var | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "1.0256 - RHEL - Ensure nosuid option set on /var partition"
