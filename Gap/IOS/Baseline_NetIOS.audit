# </custom_item>

# <custom_item>
#   type        : CONFIG_CHECK
#   description : "1.0140 - IOS - Create an access-list for use with SNMP - SNMP deny secured by ACL"
#   info        : "You can use access lists to control the transmission of packets on an interface, control Simple Network Management Protocol (SNMP) access, and restrict the contents of routing updates."
#   solution    : "Configure SNMP ACL for restricting access to the device from authorized management stations segmented in a trusted management zone. hostname(config)#access-list <snmp_acl_number> permit <snmp_access-list> hostname(config)#access-list deny any log"
#   reference   : "NIST 800-53r5|SC-7(5) SC-7(15)"
#   see_also    : "See HTH Policies and Standards"
#   item        : "access-list 1 deny[\\s]*any log"
# </custom_item>

# <custom_item>
#   type        : CONFIG_CHECK
#   description : "1.0141 - IOS - Create an access-list for use with SNMP - SNMP permit secured by ACL"
#   info        : "You can use access lists to control the transmission of packets on an interface, control Simple Network Management Protocol (SNMP) access, and restrict the contents of routing updates."
#   solution    : "Configure SNMP ACL for restricting access to the device from authorized management stations segmented in a trusted management zone. hostname(config)#access-list <snmp_acl_number> permit <snmp_access-list> hostname(config)#access-list deny any log"
#   reference   : "NIST 800-53r5|SC-7(15)"
#   see_also    : "See HTH Policies and Standards"
