<custom_item>
  type        : CONFIG_CHECK
  description : "1.0145 - IOS - Enable 'aaa new-model"
  info        : "This command enables the AAA access control system."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-2(1)"
  see_also    : "See HTH Policies and Standards"
  item        : "^aaa new-model$"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK_NOT
  description : "1.0146 - IOS - Set exec-timeout to less than or equal to 10 minutes for 'line aux 0"
  info        : "If no input is detected during the interval, the EXEC facility resumes the current connection."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
  see_also    : "See HTH Policies and Standards"
  item        : "exec-timeout (10|[1-9])$"
</custom_item>

<custom_item>
  type         : BANNER_CHECK
  description  : "1.0147 - IOS - Banner - Enabled"
  info         : "Follow the banner login command with one or more blank spaces and a delimiting character of your choice."
  solution     : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference    : "NIST 800-53r5|AC-2"
  see_also     : "See HTH Policies and Standards"
  item         : "banner login"
  is_substring : YES
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0148 - IOS - Ensure NTP Server Configured"
  info        : "No additional information provided."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53|AU-7 AU-8"
  see_also    : "See HTH Policies and Standards"
  regex       : "^(sntp|ntp)[\\s]+server([\\s]+vrf[\\s]+[a-zA-Z0-9_\\-]+)?[\\s]*10.248.232.10.*$"
  item        : "^(sntp|ntp) server.*10.248.232.10"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0149 - IOS - Ensure NTP Server Configured (2nd)"
  info        : "Check to confirm 10."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53|AU-7 AU-8"
  see_also    : "See HTH Policies and Standards"
  regex       : "^(sntp|ntp)[\\s]+server([\\s]+vrf[\\s]+[a-zA-Z0-9_\\-]+)?[\\s]*10.248.232.210.*$"
  item        : "^(sntp|ntp) server.*10.248.232.210"
</custom_item>

