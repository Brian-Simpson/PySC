#   solution    : "Configure the EXEC banner presented to a user when accessing the devices enable prompt. hostname(config)#banner exec c Enter TEXT message. End with the character 'c'. <banner-text> c Default Value: No banner is set by default"
#   reference   : "NIST 800-53r5|AC-2"
#   see_also    : "See HTH Policies and Standards"
#   item        : "banner exec"
# </custom_item>

