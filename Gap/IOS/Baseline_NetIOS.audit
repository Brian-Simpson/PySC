<custom_item>
  type        : CONFIG_CHECK
  description : "1.0052 - IOS - Enable 'aaa authentication enable default"
  info        : "Authenticates users who access privileged EXEC mode when they use the enable command."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-2(1)"
  see_also    : "See HTH Policies and Standards"
  item        : "^aaa authentication login .+"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK_NOT
  description : "1.0053 - IOS - Set privilege 1 Local users must not have privileged access"
  info        : "Local accounts must not be assigned elevated privilege levels."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|IA-2(2) IA-5(1)"
  see_also    : "See HTH Policies and Standards"
  item        : "^username\s+\S+\s+privilege\s+[2-9][0-9]?\s+secret\s+(5|8|9)\s+"
</custom_item>

