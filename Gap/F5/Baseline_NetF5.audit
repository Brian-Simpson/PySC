<custom_item>
  description    : "1.0053 - F5 - NetF5 - Overview of port lockdown behavior"
  info           : "The port lockdown feature allows you to secure the BIG-IP system from unwanted connection attempts by controlling the level of access to each self IP address defined on the system."
  solution       : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference      : "NIST 800-53r5|SC-7"
  see_also       : "See HTH Policies and Standards"
  expect         : "null"
  f5_command     : "/tm/net/self"
  json_transform : ".items[] | \"Name: \(.name) - Port Lockdown: \(.allowService) \""
  regex          : "Port Lockdown: .+"
</custom_item>

<custom_item>
  description    : "1.0054 - F5 - NetF5 - Configuring an automatic logout for idle sessions - Console Sessions"
  info           : "/tm/sys/global-settings."
  solution       : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference      : "NIST 800-53r5|AC-11(a)"
  see_also       : "See HTH Policies and Standards"
  expect         : "^Console Idle Timeout:[\s]*([1-9]|[1-8][0-9]|9[0-9]|[1-5][0-9]{2}|600)$"
  f5_command     : "/tm/sys/global-settings"
  json_transform : "\"Console Idle Timeout: \(.consoleInactivityTimeout)\""
  regex          : "Console Idle Timeout:[\s]*"
</custom_item>

<custom_item>
  description    : "1.0055 - F5 - NetF5 - Configuring an automatic logout for idle sessions - TMSH"
  info           : "/tm/cli/global-settings."
  solution       : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference      : "NIST 800-53r5|AC-11(a)"
  see_also       : "See HTH Policies and Standards"
  expect         : "^TMSH Timeout:[\s]*15$"
  f5_command     : "/tm/cli/global-settings"
  json_transform : "\"TMSH Timeout: \(.idleTimeout)\""
  regex          : "TMSH Timeout:[\s]*"
</custom_item>

<custom_item>
  description    : "1.0056 - F5 - NetF5 - Encryption - HTTP profile cookies"
  info           : "/tm/ltm/profile/http."
  solution       : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference      : "NIST 800-53r5|AC-11(a)"
  see_also       : "See HTH Policies and Standards"
  f5_command     : "/tm/ltm/profile/http"
  json_transform : ".items[] | \"HTTP Profile Name: \(.name) - Encrypted Cookies: \(.encryptCookies)\""
  regex          : "HTTP[\s]*Profile[\s]*Name:"
  not_expect     : "HTTP[\s]*Profile[\s]*Name:[\s]*@HTTP_PROFILE_NAME@[\s]*-[\s]*Encrypted[\s]*Cookies:[\s]*null[\s]*"
</custom_item>

