# generated_by: for-gap-combined-dedupe
<check_type:"Windows" version:"2">
<group_policy:"Windows Security Hardening Through Group Policy and Registry Settings">

<custom_item>
  description    : "1.0000 - F5 - NetF5 - Idle Session Timeout - SSH"
  info           : "A session lock is a temporary network device- or administrator-initiated action taken when the administrator stops work but does not log out of the SSH session."
  solution       : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference      : "NIST 800-53r5|AC-11a"
  see_also       : "See HTH Policies and Standards"
  expect         : "^SSH Idle Timeout:[\s]*600$"
  f5_command     : "/tm/sys/sshd"
  json_transform : "\"SSH Idle Timeout: \(.inactivityTimeout)\""
  regex          : "SSH Idle Timeout:[\s]*"
</custom_item>

<custom_item>
  description    : "1.0001 - F5 - NetF5 - Idle Session Timeout - Console Sessions"
  info           : "A session lock is a temporary network device- or administrator-initiated action taken when the administrator stops work but does not log out of the console session."
  solution       : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference      : "NIST 800-53r5|AC-11a"
  see_also       : "See HTH Policies and Standards"
  expect         : "^Console Idle Timeout:[\s]*600$"
  f5_command     : "/tm/sys/global-settings"
  json_transform : "\"Console Idle Timeout: \(.consoleInactivityTimeout)\""
  regex          : "Console Idle Timeout:[\s]*"
</custom_item>

<custom_item>
  description    : "1.0002 - F5 - NetF5 - Idle Session Timeout - TMSH"
  info           : "A session lock is a temporary network device- or administrator-initiated action taken when the administrator stops work but does not log out of the network device."
  solution       : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference      : "NIST 800-53r5|AC-11a"
