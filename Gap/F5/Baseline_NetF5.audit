<custom_item>
  description    : "1.0037 - F5 - NetF5 - Unable to limit Configuration utility access to clients using only TLSv1.1 or TLSv1.2"
  info           : "You are unable to limit Configuration utility access to clients that are configured to use only TLSv1."
  solution       : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference      : "NIST 800-53r5|AU-9"
  see_also       : "See HTH Policies and Standards"
  expect         : "^[\s]*SSL[\s]*Protocol:[\s]*all[\s]*-SSLv2[\s]*-SSLv3[\s]*$"
  f5_command     : "/tm/sys/httpd"
  json_transform : "\"SSL Protocol: \(.sslProtocol)\""
  regex          : "^[\s]*SSL[\s]*Protocol:[\s]*"
</custom_item>

<custom_item>
  description    : "1.0038 - F5 - NetF5 - Mitigating risk from SSH brute force login attacks - Monitor login attempts"
  info           : "Beginning in BIG-IP 10."
  solution       : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference      : "NIST 800-53r5|AC-7"
  see_also       : "See HTH Policies and Standards"
  f5_command     : "/tm/auth/login-failures"
  json_transform : ".entries[] | \"Userame: \(.nestedStats.entries.username.description) - Login Failures: \(.nestedStats.entries.loginAttempts.value) \""
  not_expect     : ".*Login Failures: [1-9]\d*"
</custom_item>

<custom_item>
  description    : "1.0039 - F5 - NetF5 - Mitigating risk from SSH brute force login attacks - Monitor login attempts"
  info           : "Beginning in BIG-IP 10."
  solution       : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference      : "NIST 800-53r5|AC-7"
  see_also       : "See HTH Policies and Standards"
  f5_command     : "/tm/auth/login-failures"
  json_transform : ".entries[] | \"Userame: \(.nestedStats.entries.username.description) - Login Failures: \(.nestedStats.entries.loginAttempts.value) \""
  not_expect     : ".*Login Failures: [1-9]\d*"
</custom_item>

<custom_item>
  description    : "1.0040 - F5 - NetF5 - Unable to limit Configuration utility access to clients using only TLSv1.1 or TLSv1.2"
  info           : "You are unable to limit Configuration utility access to clients that are configured to use only TLSv1."
  solution       : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference      : "NIST 800-53r5|AC-10"
  see_also       : "See HTH Policies and Standards"
  expect         : "^[\s]*SSL[\s]*Protocol:[\s]*all[\s]*-SSLv2[\s]*-SSLv3[\s]*$"
  f5_command     : "/tm/sys/httpd"
  json_transform : "\"SSL Protocol: \(.sslProtocol)\""
  regex          : "^[\s]*SSL[\s]*Protocol:[\s]*"
</custom_item>

