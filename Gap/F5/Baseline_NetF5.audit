  expect         : "^TMSH Timeout:[\s]*15$"
  f5_command     : "/tm/cli/global-settings"
  json_transform : "\"TMSH Timeout: \(.idleTimeout)\""
  regex          : "TMSH Timeout:[\s]*"
</custom_item>

<custom_item>
  description    : "1.0003 - F5 - NetF5 - Configuring an automatic logout for idle sessions - SSH"
  info           : "A session lock is a temporary network device- or administrator-initiated action taken when the administrator stops work but does not log out of the SSH session."
  solution       : "Configure this setting to the expected baseline value shown in the control description and value_data."
