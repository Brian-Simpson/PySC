#   xsl_stmt    : "</xsl:template>"
#   regex       : "isolation\.tools\.diskWiper\.disable : "
# </custom_item>

# <custom_item>
#   type        : AUDIT_VM
#   description : "1.0077 - VMWARE - (L1) Ensure the number of VM log files is configured properly"
#   info        : "Normally a new log file is created only when a host is rebooted, so the file can grow to be quite large."
#   solution    : "To set this configuration utilize the vSphere interface as follows: - Select the VM then select Actions followed by Edit Settings - Click on the VM Options tab then expand Advanced - Click on EDIT CONFIGURATION - Click on ADD CONFIGURATION PARAMS then input log.keepOld with a value of 10 - Click OK then OK again. To set the number of log files to be used to 10 run the following PowerCLI command: # Add the setting to all VMs Get-VM | New-AdvancedSetting -Name \"log.keepOld\" -value \"10\\\"
#   reference   : "NIST 800-53r5|AU-4"
#   see_also    : "See HTH Policies and Standards"
#   expect      : "log\.keepOld : (10|NOT found)$"
#   xsl_stmt    : "</xsl:template>"
#   regex       : "log\.keepOld : "
# </custom_item>

# <custom_item>
#   type        : AUDIT_VM
#   description : "1.0078 - VMWARE - (L1) Ensure VM log file size is limited"
#   info        : "Normally a new log file is created only when a host is rebooted, so the file can grow to be quite large."
#   solution    : "To set this configuration utilize the vSphere interface as follows: - Select the VM then select Actions followed by Edit Settings - Click on the VM Options tab then expand Advanced - Click on EDIT CONFIGURATION - Click on ADD CONFIGURATION PARAMS then input log.rotateSize with a value of 1024000 - Click OK then OK again. To properly limit the maximum log file size, run the following PowerCLI command: # Add the setting to all VMs Get-VM | New-AdvancedSetting -Name \"log.rotateSize\" -value \"1024000\\\"
#   reference   : "NIST 800-53r5|AU-4"
#   see_also    : "See HTH Policies and Standards"
#   expect      : "log\.rotateSize : ([0-9]{1,6}|10[0-1][0-9]{4}|10[0-2][0-3][0-9]{3}|1024000)$"
#   xsl_stmt    : "</xsl:template>"
#   regex       : "log\.rotateSize : "
# </custom_item>

</group_policy>
</check_type>
