<check_type:"Windows" version:"2">
<group_policy:"Windows Security Hardening Through Group Policy and Registry Settings">

# <custom_item>
#   type        : AUDIT_ESX
#   description : "1.0000 - VMWARE - ESXI-67-000002 - The ESXi host must verify the DCUI.Access list."
#   info        : "Lockdown mode disables direct host access, requiring that administrators manage hosts from vCenter Server."
#   solution    : "From the vSphere Client, select the ESXi host and go to Configure >> System >> Advanced System Settings. Click 'Edit', select the 'DCUI.Access' value, and configure it to root. or From a PowerCLI command prompt while connected to the ESXi host, run the following command: Get-VMHost | Get-AdvancedSetting -Name DCUI.Access | Set-AdvancedSetting -Value 'root"
#   reference   : "NIST 800-53r5|CM-6b."
#   see_also    : "See HTH Policies and Standards"
#   expect      : "DCUI.Access : root$"
#   xsl_stmt    : "</xsl:template>"
#   regex       : "DCUI.Access : "
# </custom_item>

# <custom_item>
#   type        : AUDIT_VM
#   description : "1.0001 - VMWARE - (L1) Ensure unauthorized modification and disconnection of devices is disabled"
#   info        : "In a virtual machine, users and processes without root or administrator privileges can disconnect devices, such as network adapters and CD-ROM drives, and modify device settings within the guest operating system."
#   solution    : "To prevent unauthorized device modifications and disconnections, run the following PowerCLI command: # Add the setting to all VMs Get-VM | New-AdvancedSetting -Name \"isolation.device.edit.disable\" -value $true"
#   reference   : "NIST 800-53r5|CM-6 CM-7"
#   see_also    : "See HTH Policies and Standards"
#   expect      : "isolation\.device\.edit\.disable : TRUE$"
#   xsl_stmt    : "</xsl:template>"
#   regex       : "isolation\.device\.edit\.disable :"
# </custom_item>

# <custom_item>
#   type        : AUDIT_VM
#   description : "1.0002 - VMWARE - (L1) Ensure unauthorized connection of devices is disabled"
#   info        : "In a virtual machine, users and processes without root or administrator privileges can connect devices, such as network adapters and CD-ROM drives."
