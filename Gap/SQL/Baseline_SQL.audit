<custom_item>
  type        : SQL_POLICY
  description : "1.0043 - SQL - MSSQL - The public role in the msdb database is not granted access to SQL Agent proxies"
  info        : "The public database role contains every user in the msdb database."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
  see_also    : "See HTH Policies and Standards"
  sql_request : "USE [msdb] SELECT sp.name AS proxyname FROM dbo.sysproxylogin spl JOIN sys.database_principals dp ON dp.sid = spl.sid JOIN sysproxies sp ON sp.proxy_id = spl.proxy_id WHERE principal_id = USER_ID('public');"
  sql_types   : NULL
  sql_expect  : "NULL"
</custom_item>

