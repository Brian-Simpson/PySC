  info        : "AUTO_CLOSE determines if a given database is closed or not after a connection terminates."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also    : "See HTH Policies and Standards"
  sql_request : "SELECT name, containment, containment_desc, is_auto_close_on FROM sys.databases WHERE containment <> 0 and is_auto_close_on = 1;"
  sql_types   : NULL, NULL, NULL, NULL
  sql_expect  : "NULL, NULL, NULL, NULL"
</custom_item>

