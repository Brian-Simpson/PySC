# <custom_item>
#   type        : SQL_POLICY
#   description : "1.0051 - SQL - Ensure Latest SQL Server Cumulative and Security Updates are Installed"
#   info        : "SQL Server patches contain program updates that fix security and product functionality issues found in the software."
#   solution    : "Identify the current version and patch level of your SQL Server instances and ensure they contain the latest security fixes. Make sure to test these fixes in your test environments before updating production instances. The most recent SQL Server patches can be found here:"
#   reference   : "NIST 800-53r5|SA-22"
#   see_also    : "See HTH Policies and Standards"
#   sql_request : "SELECT CAST(SERVERPROPERTY('ProductLevel') AS VARCHAR) as SP_installed, CAST(SERVERPROPERTY('ProductVersion') AS VARCHAR) as Version, CAST(SERVERPROPERTY('ProductUpdateLevel') AS VARCHAR) as 'ProductUpdate_Level', CAST(SERVERPROPERTY('ProductUpdateReference') AS VARCHAR) as 'KB_Number';"
#   sql_types   : STRING
#   sql_expect  : "^Manual Review Required$"
#   severity    : MEDIUM
# </custom_item>

<custom_item>
  type        : SQL_POLICY
  description : "1.0052 - SQL - MSSQL - Windows local groups are not SQL Logins"
  info        : "Local Windows groups should not be used as logins for SQL Server instances."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
  see_also    : "See HTH Policies and Standards"
  sql_request : "USE [master] SELECT pr.[name] AS LocalGroupName, pe.[permission_name], pe.[state_desc] FROM sys.server_principals pr JOIN sys.server_permissions pe ON pr.[principal_id] = pe.[grantee_principal_id] WHERE pr.[type_desc] = 'WINDOWS_GROUP' AND pr.[name] like CAST(SERVERPROPERTY('MachineName') AS nvarchar) + '%';"
  sql_types   : NULL, NULL, NULL
  sql_expect  : "NULL, NULL, NULL"
</custom_item>

<custom_item>
  type        : SQL_POLICY
  description : "1.0053 - SQL - MSSQL - AUTO_CLOSE is set to OFF on contained databases"
  info        : "AUTO_CLOSE determines if a given database is closed or not after a connection terminates."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also    : "See HTH Policies and Standards"
  sql_request : "SELECT name, containment, containment_desc, is_auto_close_on FROM sys.databases WHERE containment <> 0 and is_auto_close_on = 1;"
  sql_types   : NULL, NULL, NULL, NULL
  sql_expect  : "NULL, NULL, NULL, NULL"
</custom_item>

<custom_item>
  type        : SQL_POLICY
  description : "1.0054 - SQL - MSSQL - Ole Automation Procedures Server Configuration Option is set to 0"
  info        : "The Ole Automation Procedures option controls whether OLE Automation objects can be instantiated within Transact-SQL batches."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1)CM-9 SA-3 SA-8 SA-10"
  see_also    : "See HTH Policies and Standards"
  sql_request : "SELECT name, CAST(value as int) as value_configured, CAST(value_in_use as int) as value_in_use FROM sys.configurations WHERE name = 'Ole Automation Procedures';"
  sql_types   : STRING, STRING, STRING
  sql_expect  : "Ole Automation Procedures\", \"0\", \"0"
</custom_item>

