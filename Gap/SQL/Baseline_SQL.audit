  reference   : "NIST 800-53r5|IA-5(1)"
  see_also    : "See HTH Policies and Standards"
  sql_request : "SELECT name, is_disabled FROM sys.sql_logins WHERE is_policy_checked = 0;"
  sql_types   : NULL, NULL
  sql_expect  : "NULL, NULL"
</custom_item>

