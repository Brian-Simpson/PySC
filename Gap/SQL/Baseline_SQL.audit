<custom_item>
  type        : SQL_POLICY
  description : "1.0018 - SQL - MSSQL - CLR Assembly Permission Set is set to SAFE_ACCESS for All CLR Assemblies"
  info        : "Setting CLR Assembly Permission Sets to SAFE_ACCESS will hinder assemblies from accessing external system resources such as files, the network, environment variables, or the registry."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also    : "See HTH Policies and Standards"
  sql_request : "SELECT name, permission_set_desc FROM sys.assemblies where is_user_defined = 1 and name <> 'Microsoft.SqlServer.Types';"
  sql_types   : REGEX_OR_NULL, STRING_OR_NULL
  sql_expect  : ".*\", \"SAFE_ACCESS"
</custom_item>

