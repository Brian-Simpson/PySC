# generated_by: for-gap-combined-dedupe
<check_type:"Windows" version:"2">
<group_policy:"Windows Security Hardening Through Group Policy and Registry Settings">

<custom_item>
  type        : SQL_POLICY
  description : "1.0000 - SQL - MSSQL - Windows BUILTIN groups are not SQL Logins"
  info        : "Prior to SQL Server 2008, the BUILTIN\Administrators group was added as a SQL Server login with sysadmin privileges during installation by default."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
  see_also    : "See HTH Policies and Standards"
  sql_request : "SELECT pr.[name], pe.[permission_name], pe.[state_desc] FROM sys.server_principals pr JOIN sys.server_permissions pe ON pr.principal_id = pe.grantee_principal_id WHERE pr.name like 'BUILTIN%';"
  sql_types   : NULL, NULL, NULL
  sql_expect  : "NULL, NULL, NULL"
</custom_item>

