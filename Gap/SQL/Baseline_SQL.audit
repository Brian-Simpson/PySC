<custom_item>
  type        : SQL_POLICY
  description : "1.0006 - SQL - MSSQL - SQL Authentication is not used in contained databases"
  info        : "Contained databases do not enforce password complexity rules for SQL Authenticated users."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-2(1)"
  see_also    : "See HTH Policies and Standards"
  sql_request : "EXEC sp_MSforeachdb 'USE [?] SELECT name AS DBUser FROM sys.database_principals WHERE name NOT IN (''dbo'',''Information_Schema'',''sys'',''guest'') AND type IN (''U'',''S'',''G'') AND authentication_type = 2;'"
  sql_types   : NULL
  sql_expect  : "NULL"
</custom_item>

<custom_item>
  type        : SQL_POLICY
  description : "1.0007 - SQL - MSSQL - Ensure CHECK_POLICY Option is set to ON for All SQL Authenticated Logins"
  info        : "Ensure SQL authenticated login passwords comply with the secure password policy applied by the Windows Server Benchmark so that they cannot be easily compromised via brute force attack."
