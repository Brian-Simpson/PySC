</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0055 - ASA - NetASA - Ensure SSH session timeout is less than or equal to 5 minutes"
  info        : "Sets the idle timeout for an SSH session before the security appliance terminates it."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-2(5) AC-11 AC-12"
  see_also    : "See HTH Policies and Standards"
  item        : "^ssh timeout [1-5][\\s]*$"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0056 - ASA - NetASA - Ensure SSH source restriction is set to an authorized IP address"
  info        : "Determines the client IP addresses that are allowed to connect to the security appliance through SSH."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-2(1) AC-3 AC-17 AC-17(1) SC-7 SI-4"
  see_also    : "See HTH Policies and Standards"
  item        : "ssh [0-9]+.*"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0057 - ASA - NetASA -Timeout - SSH is less than 5 minutes"
  info        : "Sets the idle timeout for an SSH session before the security appliance terminates it."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53|CM-2"
  see_also    : "See HTH Policies and Standards"
  item        : "^ssh timeout [1-5][\\s]*$"
</custom_item>

