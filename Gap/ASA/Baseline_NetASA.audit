<custom_item>
  type        : CONFIG_CHECK
  description : "1.0089 - ASA - NetASA - Access Control - Ensure Domain Name is set"
  info        : "Sets the domain name for the security appliance."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-18 CM-1 CM-2 CM-6 CM-7 CM-9 SA-3 SA-8 SA-10"
  see_also    : "See HTH Policies and Standards"
  item        : "domain-name [^ ]+"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0090 - ASA - NetASA - Access Control - Ensure Failover is enabled"
  info        : "Enables failover between the security appliance and another security appliance in order to achieve high availability."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-18 CM-1 CM-2 CM-6 CM-7 CM-9 SA-3 SA-8 SA-10"
  see_also    : "See HTH Policies and Standards"
  item        : "^failover lan unit (primary|secondary)"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0091 - ASA - NetASA - Ensure aaa accounting for EXEC mode is configured correctly"
  info        : "Enables accounting of administrative access by specifying the start and stop of EXEC sessions."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-6(2) AC-18 CM-1 CM-2 CM-6 CM-7 CM-9 SA-3 SA-8 SA-10"
  see_also    : "See HTH Policies and Standards"
  item        : "aaa accounting enable console.*"
</custom_item>

<custom_item>
  type         : BANNER_CHECK
  description  : "1.0092 - ASA - NetASA - Ensure LOGIN banner is set"
  info         : "Sets the LOGIN banner for access to the Command Line Interface (CLI)."
  solution     : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference    : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
  see_also     : "See HTH Policies and Standards"
  item         : "banner login"
  is_substring : YES
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0093 - ASA - NetASA - Ensure snmp-server host is set to version 3"
  info        : "Sets the SNMP notification recipient or the NMS or SNMP manager that can connect to the ASA."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
  see_also    : "See HTH Policies and Standards"
  item        : "^snmp-server host [^ ]+ [^ ]+ version 3 [^ ]+"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0094 - ASA - NetASA - Ensure console session timeout is less than or equal to 5 minutes"
  info        : "Sets the idle timeout for a console session before the security appliance terminates it."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-2(5) AC-11 AC-12"
  see_also    : "See HTH Policies and Standards"
  item        : "console timeout [1-5][\\s]*$"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0095 - ASA - NetASA - Ensure explicit deny in access lists is configured correctly"
  info        : "Ensures that each access-list has an explicit deny statement."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|CA-9 CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7 SC-7(5)"
  see_also    : "See HTH Policies and Standards"
  item        : "^(access-group [^ ]+ [^ ]+ interface [^ ]+|access-list [^ ]+ [^ ]+ deny ip any any [^ ]+)"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0096 - ASA - NetASA - Ensure HTTP idle timeout is less than or equal to 5 minutes"
  info        : "Sets the timeout for an HTTP session idle before the security appliance terminates it."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|AC-2(5) AC-11 AC-12"
  see_also    : "See HTH Policies and Standards"
  item        : "^http server idle-timeout [1-5][\\s]*$"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0097 - ASA - NetASA - Ensure ICMP is restricted for untrusted interfaces"
  info        : "Allows ICMP traffic for specific hosts or subnets and denies ICMP traffic for all other sources."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|CM-6 CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7 SC-23"
  see_also    : "See HTH Policies and Standards"
  item        : "icmp deny any .+"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK_NOT
  description : "1.0098 - ASA - NetASA - Ensure intrusion prevention is enabled for untrusted interfaces is configured as CONFIG_CHECK_NOT"
  info        : "Enables the intrusion prevention with the IP audit feature on untrusted interfaces."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7 SI-4 SI-4(4)"
  see_also    : "See HTH Policies and Standards"
  item        : "^ip audit (name [^ ]+ attack|interface [^ ]+)"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK_NOT
  description : "1.0099 - ASA - NetASA - Ensure ip verify is set to reverse-path for untrusted interfaces is configured as CONFIG_CHECK_NOT"
  info        : "Enables the unicast Reverse-Path Forwarding (uRPF) on untrusted interfaces."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
  see_also    : "See HTH Policies and Standards"
  item        : "ip verify reverse-path interface [^ ]+"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK_NOT
  description : "1.0100 - ASA - NetASA - Ensure packet fragments are restricted for untrusted interfaces is configured as CONFIG_CHECK_NOT"
  info        : "Sets the security appliance to drop fragmented packets received on the untrusted interface."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|CM-6 CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7 SC-23"
  see_also    : "See HTH Policies and Standards"
  item        : "fragment chain [^ ]+ [^ ]+"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0101 - ASA - NetASA - Ensure SNMP traps is enabled"
  info        : "Enables SNMP traps to be sent to the NMS."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
  see_also    : "See HTH Policies and Standards"
  item        : "snmp-server enable traps.*"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0102 - ASA - NetASA - Timeout - Console is less than 5 minutes"
  info        : "Sets the idle timeout for a console session before the security appliance terminates it."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53|CM-2"
  see_also    : "See HTH Policies and Standards"
  item        : "console timeout [1-5][\\s]*$"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0103 - ASA - NetASA - Timeout - HTTP is less than 5 minutes"
  info        : "Sets the timeout for an HTTP session idle before the security appliance terminates it."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53|CM-2"
  see_also    : "See HTH Policies and Standards"
  item        : "^http server idle-timeout [1-5][\\s]*$"
</custom_item>

