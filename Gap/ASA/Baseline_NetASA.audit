<custom_item>
  type        : CONFIG_CHECK
  description : "1.0015 - ASA - NetASA - Authentication - Ensure Logon Password is set"
  info        : "Changes the default login password."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|IA-5(1)"
  see_also    : "See HTH Policies and Standards"
  item        : "(password|passwd) [^ ]+ encrypted"
</custom_item>

<custom_item>
  type        : CONFIG_CHECK
  description : "1.0016 - ASA - NetASA - Authentication - Local creds are set"
  info        : "Sets a local username and password for Emergency purposes."
  solution    : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference   : "NIST 800-53r5|IA-5(1)"
  see_also    : "See HTH Policies and Standards"
  item        : "username [^ ]+ password [^ ]+"
</custom_item>

