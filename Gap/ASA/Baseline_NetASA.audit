#   description : "1.0074 - ASA - Ensure logging with the device ID is configured correctly"
#   info        : "Includes the device ID in the logs generated Rationale: In an environment where logs are collected from many different sources, identifying the logs from a specific device is alleviated by doing a query including the device's hostname included in the logs and helps to quickly gather the expected results."
#   solution    : "Run the following to enable logging with the device hostname: hostname(config)#logging device-id hostname In a multi-context security appliance, run the following command: hostname(config)#logging device-id context-name"
#   reference   : "NIST 800-53r5|AU-2 AU-7 AU-12"
#   see_also    : "See HTH Policies and Standards"
#   item        : "logging device-id .+"
# </custom_item>

# <custom_item>
#   type        : CONFIG_CHECK
#   description : "1.0075 - ASA - Ensure logging history severity level is set to greater than or equal to 5"
#   info        : "Determines which syslog messages should be sent to the SNMP server."
#   solution    : "Step 1: Run the following command to set the logging level to 5: hostname(config)# logging history 5 The severity level can be chosen between 0 and 7 Default Value: The device does not log to simple network management protocol (SNMP) servers by default."
#   reference   : "NIST 800-53r5|AU-1 AU-2"
#   see_also    : "See HTH Policies and Standards"
#   item        : "logging history ([5-7]|notification(s)?|informational|debugging)[\\s]*$"
# </custom_item>

# <custom_item>
#   type        : CONFIG_CHECK
#   description : "1.0076 - ASA - Ensure logging with timestamps is enabled"
#   info        : "Allows the timestamp to logs generated Rationale: Enabling timestamps, to mark the generation time of log messages, reduces the complexity of correlating events and tracing network attacks across multiple devices by providing a holistic view of events thus enabling faster troubleshooting of issues and analysis of incidents."
#   solution    : "Run the following command to enable the logging timestamp hostname(config)#logging timestamp Default Value: By default, syslog messages do not include timestamp"
#   reference   : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
#   see_also    : "See HTH Policies and Standards"
#   item        : "logging timestamp"
# </custom_item>

# <custom_item>
#   type        : CONFIG_CHECK
#   description : "1.0077 - ASA - Ensure logging trap severity level is greater than or equal to 5"
#   info        : "Determines which syslog messages should be sent to the syslog server."
#   solution    : "Step 1: Run the following command to verify logging trap is equal to 5: hostname(config)# logging trap 5 The severity level can be chosen between 0 and 7"
#   reference   : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
#   see_also    : "See HTH Policies and Standards"
#   item        : "logging trap ([5-7]|notification(s)?|informational|debugging)[\\s]*$"
# </custom_item>

# <custom_item>
#   type        : CONFIG_CHECK
#   description : "1.0078 - ASA - Ensure local timezone is properly configured"
#   info        : "Sets the local time zone information so that the time displayed by the ASA is more relevant to those who are viewing it."
#   solution    : "Step 1: Acquire standard zone name (enterprise_zone_name) used by the enterprise (GMT, UTC, EDT, PST) Step 2: Run the following to configure the required value hostname(config)# clock timezone <enterprise_zone_name> <local_offset> Default Value: By default, the time zone is UTC"
#   reference   : "NIST 800-53r5|AU-7 AU-8"
#   see_also    : "See HTH Policies and Standards"
#   item        : "clock timezone ([A-Za-z0-9]+) (-[0-9]+|[0-9]+)"
# </custom_item>

# <custom_item>
#   type        : CONFIG_CHECK
#   description : "1.0079 - ASA - Ensure explicit deny in access lists is configured correctly"
#   info        : "Ensures that each access-list has an explicit deny statement Rationale: Configuring an explicit deny entry, with log option, at the end of access control lists enables monitoring and troubleshooting traffic flows that have been denied."
#   solution    : "Step 1: Acquire the name <access-list_name> of the access-list that is not compliant from the audit procedure Step 2: Run the following to configure the explicit deny. hostname(config)#<access-list_name> extended deny ip any any log The statement will be placed at the end of the access-list Default Value: Disabled by default."
#   reference   : "NIST 800-53r5|CA-9 CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7 SC-7(5)"
#   see_also    : "See HTH Policies and Standards"
#   item        : "^(access-group [^ ]+ [^ ]+ interface [^ ]+|access-list [^ ]+ [^ ]+ deny ip any any [^ ]+)"
#   severity    : MEDIUM
# </custom_item>

