<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  description : "port 53"
  request     : "listNetworkSecurityGroups"
      json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Name: \(.name), Protocol: \(.properties.protocol), Direction: \(.properties.direction), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
  not_expect  : 'Protocol: (UDP|\*), Direction: Inbound, Access: Allow, Destination Port Range: (53|([0-4]?[0-9]|5[0-3])-(5[3-9]|[6-9][0-9]|[1-9][0-9]{2,})), Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
</custom_item>

<custom_item>
  description : "port 123"
  request     : "listNetworkSecurityGroups"
      json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Name: \(.name), Protocol: \(.properties.protocol), Direction: \(.properties.direction), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
  not_expect  : 'Protocol: (UDP|\*), Direction: Inbound, Access: Allow, Destination Port Range: (123|([0-9]{1,2}|1[0-1][0-9]|12[0-3])-(12[3-9]|1[3-9][0-9]|[2-9][0-9]{2,})), Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
</custom_item>

<custom_item>
  description : "port 161"
  request     : "listNetworkSecurityGroups"
      json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Name: \(.name), Protocol: \(.properties.protocol), Direction: \(.properties.direction), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
  not_expect  : 'Protocol: (UDP|\*), Direction: Inbound, Access: Allow, Destination Port Range: (161|([0-9]{1,2}|1[0-5][0-9]|16[0-1])-(16[1-9]|1[7-9][0-9]|[2-9][0-9]{2,})), Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
</custom_item>

<custom_item>
  description : "port 389"
  request     : "listNetworkSecurityGroups"
      json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Name: \(.name), Protocol: \(.properties.protocol), Direction: \(.properties.direction), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
  not_expect  : 'Protocol: (UDP|\*), Direction: Inbound, Access: Allow, Destination Port Range: (389|([0-9]{1,2}|[1-2][0-9]{2}|3[0-7][0-9]|38[0-9])-(389|39[0-9]|[4-9][0-9]{2,})), Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
</custom_item>

<custom_item>
  description : "port 1900"
  request     : "listNetworkSecurityGroups"
      json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Name: \(.name), Protocol: \(.properties.protocol), Direction: \(.properties.direction), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
  not_expect  : 'Protocol: (UDP|\*), Direction: Inbound, Access: Allow, Destination Port Range: (1900|([0-9]{1,3}|1[0-8][0-9]{2}|1900)-(1900|190[1-9]|19[1-9][0-9]|[2-9][0-9]{3,})), Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
</custom_item>

<custom_item>
  description : "any port"
  request     : "listNetworkSecurityGroups"
      json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Name: \(.name), Protocol: \(.properties.protocol), Direction: \(.properties.direction), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
  not_expect  : 'Protocol: (UDP|\*), Direction: Inbound, Access: Allow, Destination Port Range: \*, Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description : "7.3 Ensure that UDP access from the Internet is evaluated and restricted"
  info        : "Network security groups should be periodically evaluated for port misconfigurations."
  solution    : "Remediate from Azure Portal

 - Go to Network security groups.
 - Click the name of a network security group.
 - Under Settings, click Inbound security rules.
 - Check the box next to any inbound security rule matching:
 - Port: Port: 53, 123, 161, 389, or 1900, or range including 53, 123, 161, 389, or 1900, or other vulnerable UDP-based services
 - Protocol: UDP or Any
 - Source: 0.0.0.0/0, Internet, or Any
 - Action: Allow

 - Click Delete.
 - Click Yes.
 - Repeat steps 1-6 for each network security group requiring remediation.

Remediate from Azure CLI

For each network security group rule requiring remediation, run the following command to delete the rule:

az network nsg rule delete --resource-group <resource-group> --nsg-name <network-security-group> --name <rule>"
  reference   : "NIST 800-53r5|CA-9 SC-7"
  see_also    : "See HTH Policies and Standards"
  show_output : YES
</report>
  </then>
</if>

