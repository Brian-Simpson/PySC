</custom_item>

<custom_item>
  description    : "1.0019 - CSF5 - Check REST API for Banner Enabled"
  f5_command     : "/tm/sys/sshd"
  json_transform : ".banner"
  expect         : "enabled"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "1.0020 - CSF5 - Ensure Prelogin 'Login Banner' is set"
  reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also       : "See HTH Policies and Standards"
  show_output    : YES
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0021 - CSF5 - Check offline config for inactivity timeout"
