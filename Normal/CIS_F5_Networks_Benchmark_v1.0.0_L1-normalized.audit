  expect         : "inactivity-timeout ([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
</custom_item>

<custom_item>
  description    : "1.0022 - CSF5 - Check REST API for inactivity timeout"
