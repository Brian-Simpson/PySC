  </condition>

  <then>
<report type:"PASSED">
  description    : "1.0047 - CSF5 - Ensure to exclude inode information from ETags HTTP Header"
  info           : "To prevent the disclosure of inode information when accessing Configuration utility (GUI)."
  reference      : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
  see_also       : "See HTH Policies and Standards"
  show_output    : YES
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0048 - CSF5 - Check offline config for port lockdown"
  context        : "net self "
  regex          : "allow-service"
  not_expect     : "\ball\b"
</custom_item>

<custom_item>
  description    : "1.0049 - CSF5 - Check REST API for port lockdown"
  f5_command     : "/tm/net/self"
  json_transform : ".items[] | \"Name: \(.name) - Port Lockdown: \(.allowService) \""
  not_expect     : "all"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "1.0050 - CSF5 - Ensure port lockdown for self IP is set"
  info           : "to secure the BIG-IP system from unwanted connection attempts on self-IP."
  reference      : "NIST 800-53r5|CM-6 CM-7 SC-23"
  see_also       : "See HTH Policies and Standards"
  show_output    : YES
</report>
  </then>
</if>

<custom_item>
  description    : "1.0051 - CSF5 - Ensure to disable unused services in BIG-IP configuration"
  info           : "To disable unused BIG-IP system daemons NOTE: Nessus has provided the target output to assist in reviewing the benchmark to ensure target compliance."
  reference      : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
  see_also       : "See HTH Policies and Standards"
  f5_command     : "/tm/sys/service"
  json_transform : ".items[] | \"Service Name: \(.name)\""
  expect         : "^Manual Review Required$"
  severity       : MEDIUM
</custom_item>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0052 - CSF5 - Check offline config for snmp access"
  context        : "sys snmp"
  regex          : "allowed-addresses"
  expect         : "allowed-addresses { 192.168.0.1 }"
</custom_item>

<custom_item>
  description    : "1.0053 - CSF5 - Check REST API for snmp access"
  f5_command     : "/tm/sys/snmp"
  json_transform : ".allowedAddresses | join(\" \")"
  expect         : "^192.168.0.1$"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "1.0054 - CSF5 - Ensure that SNMP access is allowed to trusted agents IPs only"
  info           : "To limit access to trusted SNMP agents only."
  reference      : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
  see_also       : "See HTH Policies and Standards"
  show_output    : YES
</report>
  </then>
</if>

<report type:"WARNING">
  description    : "1.0055 - CSF5 - Ensure minimum SNMP version is set to V3 for agent access"
  info           : "To disable the usage of weak SNMP protocols NOTE: Nessus has not performed this check."
  reference      : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
  see_also       : "See HTH Policies and Standards"
</report>

<report type:"WARNING">
  description    : "1.0056 - CSF5 - Ensure to lockdown access logs to \"Administrator , Resource Administrator and Auditor \" roles only"
  info           : "To restrict access to the system logs."
  reference      : "NIST 800-53r5|AU-1 AU-2"
  see_also       : "See HTH Policies and Standards"
</report>

<report type:"WARNING">
  description    : "1.0057 - CSF5 - Ensure that audit logging for \"MCP, tmsh and GUI\" is set to enabled"
  info           : "To enable audit logging on configuration changes that users or services make to the BIG-IP system."
  reference      : "NIST 800-53r5|AU-1 AU-2"
  see_also       : "See HTH Policies and Standards"
</report>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0058 - CSF5 - Check offline config for remote syslog servers"
  context        : "\w+"
  regex          : "host"
  expect         : "host \b192.168.0.2\b"
</custom_item>

<custom_item>
  description    : "1.0059 - CSF5 - Check REST API for remote syslog servers"
  f5_command     : "/tm/sys/syslog"
  json_transform : ".remoteServers[] | \"Remote Syslog Server: \(.host)\""
  expect         : "^[\s]*Remote Syslog Server:[\s]*192.168.0.2[\s]*$"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "1.0060 - CSF5 - Ensure that Remote Syslog Servers are configured"
  info           : "To ensure that logs are sent to external servers."
  reference      : "NIST 800-53r5|AU-6(3)"
  see_also       : "See HTH Policies and Standards"
  show_output    : YES
</report>
  </then>
</if>

</check_type>
