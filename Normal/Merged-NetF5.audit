# Merged Audit - NetF5

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "Check offline config for required special"
  context        : "auth password-policy"
  regex          : "required-special"
  expect         : "required-special \b[^0]+\b"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "Check offline config for lockout duration"
  context        : "auth password-policy"
  regex          : "lockout-duration"
  expect         : "lockout-duration \b(30\d|3[1-9]\d|[4-9]\d{2}|[1-9]\d{3,5}|0)\b"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "Check offline config for required numeric"
  context        : "auth password-policy"
  regex          : "required-numeric"
  expect         : "required-numeric \b[^0]+\b"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "Check offline config for policy-enforcement"
  context        : "auth password-policy"
  regex          : "policy-enforcement"
  expect         : "policy-enforcement enabled"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "Check offline config for expiration warning"
  context        : "auth password-policy"
  regex          : "expiration-warning"
  expect         : "expiration-warning \b(1[4-9]|[2-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\b"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "Check offline config for required uppercase"
  context        : "auth password-policy"
  regex          : "required-uppercase"
  expect         : "required-uppercase \b[^0]+\b"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "Check offline config for minimum length"
  context        : "auth password-policy"
  regex          : "minimum-length"
  expect         : "minimum-length \b(1[2-9]|[2-9][0-9]|[1-9]\d{2,})\b"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "Check offline config for max login failures"
  context        : "auth password-policy"
  regex          : "max-login-failures"
  expect         : "max-login-failures \b([1-3])\b"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "Check offline config for password memory"
  context        : "auth password-policy"
  regex          : "password-memory"
  expect         : "password-memory \b(2[4-9]|[3-9][0-9]|1[01][0-9]|12[0-7])\b"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "Check offline config for required lowercase"
  context        : "auth password-policy"
  regex          : "required-lowercase"
  expect         : "required-lowercase \b[^0]+\b"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "Check offline config for max duration"
  context        : "auth password-policy"
  regex          : "max-duration"
  expect         : "max-duration \b([1-9]|[1-9][0-9]|1[0-7][0-9]|180)\b"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "Check offline config for min duration"
  context        : "auth password-policy"
  regex          : "min-duration"
  expect         : "min-duration \b([1-9]|[1-8][0-9]|90)\b"
</custom_item>

<custom_item>
  description    : "Check REST API for required special"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".requiredSpecial"
  expect         : "\b[^0]+\b"
</custom_item>

<custom_item>
  description    : "Check REST API for lockout duration"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".lockoutDuration"
  expect         : "\b(30\d|3[1-9]\d|[4-9]\d{2}|[1-9]\d{3,5}|0)\b"
</custom_item>

<custom_item>
  description    : "Check REST API for required numeric"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".requiredNumeric"
  expect         : "\b[^0]+\b"
</custom_item>

<custom_item>
  description    : "Check REST API for policy-enforcement"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".policyEnforcement"
  expect         : "^enabled$"
</custom_item>

<custom_item>
  description    : "Check REST API for expiration warning"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".expirationWarning"
  expect         : "\b(1[4-9]|[2-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\b"
</custom_item>

<custom_item>
  description    : "Check REST API for required uppercase"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".requiredUppercase"
  expect         : "\b[^0]+\b"
</custom_item>

<custom_item>
  description    : "Check REST API for minimum length"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".minimumLength"
  expect         : "\b(1[2-9]|[2-9][0-9]|[1-9]\d{2,})\b"
</custom_item>

<custom_item>
  description    : "Check REST API for max login failures"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".maxLoginFailures"
  expect         : "\b([1-3])\b"
</custom_item>

<custom_item>
  description    : "Check REST API for password memory"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".passwordMemory"
  expect         : "\b(2[4-9]|[3-9][0-9]|1[01][0-9]|12[0-7])\b"
</custom_item>

<custom_item>
  description    : "Check REST API for required lowercase"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".requiredLowercase"
  expect         : "\b[^0]+\b"
</custom_item>

<custom_item>
  description    : "Check REST API for max duration"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".maxDuration"
  expect         : "\b([1-9]|[1-9][0-9]|1[0-7][0-9]|180)\b"
</custom_item>

<custom_item>
  description    : "Check REST API for max duration"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".minDuration"
  expect         : "\b([1-9]|[1-8][0-9]|90)\b"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0001 - CSF5 - Check offline config for default partition"
  context        : "auth remote-user"
  regex          : "default-partition"
  not_expect     : "default-partition Common"
</custom_item>

<custom_item>
  description    : "1.0002 - CSF5 - Check REST API for default partition"
  f5_command     : "/tm/auth/remote-user"
  json_transform : ".defaultPartition"
  expect         : "Common"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0004 - CSF5 - Check offline config for remote console access"
  context        : "auth remote-user"
  regex          : "remote-console-access"
  expect         : "remote-console-access disabled"
</custom_item>

<custom_item>
  description    : "1.0005 - CSF5 - Check REST API for remote console access"
  f5_command     : "/tm/auth/remote-user"
  json_transform : ".remoteConsoleAccess"
  expect         : "disabled"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0007 - CSF5 - Check offline config for idle timeout"
  context        : "sys httpd"
  regex          : "auth-pam-idle-timeout"
  expect         : "auth-pam-idle-timeout ([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
</custom_item>

<custom_item>
  description    : "1.0008 - CSF5 - Check REST API for idle timeout"
  f5_command     : "/tm/sys/httpd"
  json_transform : "\"Configuration Utility Timeout: \(.authPamIdleTimeout)\""
  expect         : "^[\s]*Configuration Utility Timeout:[\s]*([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0010 - CSF5 - Check offline config for tls version"
  context        : "sys httpd"
  regex          : "ssl-protocol"
  expect         : "ssl-protocol TLSv1.(2|3)[\s]*$"
</custom_item>

<custom_item>
  description    : "1.0011 - CSF5 - Check REST API for tls version"
  f5_command     : "/tm/sys/httpd"
  json_transform : "\"SSL Protocol: \(.sslProtocol)\""
  expect         : "^[\s]*SSL[\s]*Protocol:[\s]*TLSv1.(2|3)[\s]*$"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0013 - CSF5 - Check offline config for access"
  context        : "sys httpd"
  regex          : "allow"
  expect         : "allow { 192.168.0.1 }"
</custom_item>

<custom_item>
  description    : "1.0014 - CSF5 - Check REST API for access"
  f5_command     : "/tm/sys/httpd"
  json_transform : ".allow | join(\" \")"
  expect         : "^192.168.0.1$"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0016 - CSF5 - Check offline config for Banner Enabled"
  context        : "sys sshd"
  regex          : "banner "
  expect         : "banner enabled"
</custom_item>

<custom_item>
  type           : OFFLINE_BANNER_CHECK
  description    : "1.0017 - CSF5 - Check offline config for Banner Text"
  context        : "sys sshd"
  item           : "banner-text"
  content        : "All unauthorized activity is monitored and logged."
</custom_item>

<custom_item>
  description    : "1.0018 - CSF5 - Check REST API for Banner Text"
  f5_command     : "/tm/sys/sshd"
  json_transform : ".bannerText"
  expect         : "All unauthorized activity is monitored and logged."
</custom_item>

<custom_item>
  description    : "1.0019 - CSF5 - Check REST API for Banner Enabled"
  f5_command     : "/tm/sys/sshd"
  json_transform : ".banner"
  expect         : "enabled"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0021 - CSF5 - Check offline config for inactivity timeout"
  context        : "sys sshd"
  regex          : "inactivity-timeout"
  expect         : "inactivity-timeout ([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
</custom_item>

<custom_item>
  description    : "1.0022 - CSF5 - Check REST API for inactivity timeout"
  f5_command     : "/tm/sys/sshd"
  json_transform : "\"SSH Idle Timeout: \(.inactivityTimeout)\""
  expect         : "^[\s]*SSH Idle Timeout:[\s]*([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0024 - CSF5 - Check offline config for idle timeout"
  context        : "cli global-settings"
  regex          : "idle-timeout"
  expect         : "idle-timeout ([1-9]|10)[\s]*$"
</custom_item>

<custom_item>
  description    : "1.0025 - CSF5 - Check REST API for idle timeout"
  f5_command     : "/tm/cli/global-settings"
  json_transform : "\"TMSH Timeout: \(.idleTimeout)\""
  expect         : "^TMSH Timeout:[\s]*([1-9]|10)[\s]*$"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0027 - CSF5 - Check offline config for console inactivity timeout"
  context        : "sys global-settings"
  regex          : "console-inactivity-timeout"
  expect         : "console-inactivity-timeout ([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
</custom_item>

<custom_item>
  description    : "1.0028 - CSF5 - Check REST API for console inactivity timeout"
  f5_command     : "/tm/sys/global-settings"
  json_transform : "\"Console Idle Timeout: \(.consoleInactivityTimeout)\""
  expect         : "^[\s]*Console Idle Timeout:[\s]*([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0030 - CSF5 - Check offline config for aes128-cbc"
  context        : "sys sshd"
  regex          : "Ciphers"
  expect         : "aes128-cbc"
</custom_item>

<custom_item>
  description    : "1.0031 - CSF5 - Check REST API for aes128-cbc"
  f5_command     : "/tm/sys/sshd"
  json_transform : ".include"
  expect         : "^[\s]*Ciphers.*aes128-cbc.*$"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0033 - CSF5 - Check offline config for hmac-sha2-256"
  context        : "sys sshd"
  regex          : "MACs"
  expect         : "hmac-sha2-256"
</custom_item>

<custom_item>
  description    : "1.0034 - CSF5 - Check REST API for hmac-sha2-256"
  f5_command     : "/tm/sys/sshd"
  json_transform : ".include"
  expect         : "^[\s]*Ciphers.*MACs.*hmac-sha2-256.*$"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0036 - CSF5 - Check offline config for kex algorithms"
  context        : "sys sshd"
  regex          : "KexAlgorithms"
  expect         : "^Manual Review Required$"
  severity       : MEDIUM
</custom_item>

<custom_item>
  description    : "1.0037 - CSF5 - Check REST API for kex algorithms"
  f5_command     : "/tm/sys/sshd"
  json_transform : ".include"
  expect         : "^Manual Review Required$"
  severity       : MEDIUM
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0039 - CSF5 - Check offline config for access"
  context        : "sys sshd"
  regex          : "allow"
  not_expect     : "\bALL\b"
</custom_item>

<custom_item>
  description    : "1.0040 - CSF5 - Check REST API for access"
  f5_command     : "/tm/sys/sshd"
  json_transform : ".allow"
  not_expect     : "All"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0042 - CSF5 - Check offline config for NTP servers"
  context        : "sys ntp"
  regex          : "servers"
  expect         : "servers.*[0-9.]+"
</custom_item>

<custom_item>
  description    : "1.0043 - CSF5 - Check REST API for NTP servers"
  f5_command     : "/tm/sys/ntp"
  json_transform : ".servers"
  expect         : "[0-9.]+"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0045 - CSF5 - Check offline config for inode information"
  context        : "sys httpd"
  regex          : "include"
  expect         : "include \"FileETag MTime Size\""
</custom_item>

<custom_item>
  description    : "1.0046 - CSF5 - Check REST API for inode information"
  f5_command     : "/tm/sys/httpd"
  json_transform : ".include"
  expect         : "^[\s]*FileETag[\s]*MTime[\s]*Size[\s]*$"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0048 - CSF5 - Check offline config for port lockdown"
  context        : "net self "
  regex          : "allow-service"
  not_expect     : "\ball\b"
</custom_item>

<custom_item>
  description    : "1.0049 - CSF5 - Check REST API for port lockdown"
  f5_command     : "/tm/net/self"
  json_transform : ".items[] | \"Name: \(.name) - Port Lockdown: \(.allowService) \""
  not_expect     : "all"
</custom_item>

<custom_item>
  description    : "1.0051 - CSF5 - Ensure to disable unused services in BIG-IP configuration"
  info           : "To disable unused BIG-IP system daemons NOTE: Nessus has provided the target output to assist in reviewing the benchmark to ensure target compliance."
  reference      : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
  see_also       : "See HTH Policies and Standards"
  f5_command     : "/tm/sys/service"
  json_transform : ".items[] | \"Service Name: \(.name)\""
  expect         : "^Manual Review Required$"
  severity       : MEDIUM
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0052 - CSF5 - Check offline config for snmp access"
  context        : "sys snmp"
  regex          : "allowed-addresses"
  expect         : "allowed-addresses { 192.168.0.1 }"
</custom_item>

<custom_item>
  description    : "1.0053 - CSF5 - Check REST API for snmp access"
  f5_command     : "/tm/sys/snmp"
  json_transform : ".allowedAddresses | join(\" \")"
  expect         : "^192.168.0.1$"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0058 - CSF5 - Check offline config for remote syslog servers"
  context        : "\w+"
  regex          : "host"
  expect         : "host \b192.168.0.2\b"
</custom_item>

<custom_item>
  description    : "1.0059 - CSF5 - Check REST API for remote syslog servers"
  f5_command     : "/tm/sys/syslog"
  json_transform : ".remoteServers[] | \"Remote Syslog Server: \(.host)\""
  expect         : "^[\s]*Remote Syslog Server:[\s]*192.168.0.2[\s]*$"
</custom_item>

