  xsl_stmt         : "</xsl:when>"
  xsl_stmt         : "<xsl:otherwise>"
  xsl_stmt         : "  Failed - Data Filtering Profile '<xsl:value-of select=\"@name\"/>' set to '<xsl:value-of select=\"rules/entry/alert-threshold\"/>'"
  xsl_stmt         : "</xsl:otherwise>"
  xsl_stmt         : "</xsl:choose>"
  xsl_stmt         : "</xsl:for-each>"
  xsl_stmt         : "<xsl:if test=\"count(//vsys/entry/profiles/data-filtering/entry) = 0\">"
  xsl_stmt         : "Failed - No Data Filtering Profiles found"
  xsl_stmt         : "</xsl:if>"
  regex            : ".*"
  expect           : "Passed"
</custom_item>

<custom_item>
  type             : AUDIT_XML
  description      : "1.0210 - CSPA - Ensure a secure Data Filtering profile is applied to all security policies allowing traffic to or from the Internet"
  info             : "Create a secure Data Filtering profile and apply it to all security policies permitting traffic to or from the Internet."
  reference        : "NIST 800-53r5|CA-9 SC-7"
  see_also         : "See HTH Policies and Standards"
  api_request_type : "op"
