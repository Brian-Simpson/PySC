# Merged Audit - NetPA

<custom_item>
  type             : AUDIT_XML
  description      : "Check for Palo Alto version 11"
  api_request_type : "op"
  request          : "<show><system><info></info></system></show>"
  xsl_stmt         : "<xsl:template match=\"/\">"
  xsl_stmt         : "<xsl:value-of select=\"/response/result/system/sw-version\"/>"
  regex            : ".*"
  expect           : "^[\s]*11\..*"
</custom_item>

<custom_item>
  type             : AUDIT_XML
  description      : "Panorama model"
  api_request_type : "version"
  request          : ""
  xsl_stmt         : "<xsl:template match=\"/\"><xsl:value-of select=\"//model\"/>"
  expect           : "Panorama"
</custom_item>

<custom_item>
  type             : AUDIT_XML
  description      : "Panorama system-mode"
  api_request_type : "op"
  request          : "<show><system><info></info></system></show>"
  xsl_stmt         : "<xsl:template match=\"/\">"
  xsl_stmt         : "<xsl:value-of select=\"//system-mode\"/>"
  expect           : "(?i)Panorama(?-i)"
</custom_item>

<custom_item>
  type             : AUDIT_XML
  description      : "1.0001 - CSPA - Panorama model"
  api_request_type : "version"
  request          : ""
  xsl_stmt         : "<xsl:template match=\"/\"><xsl:value-of select=\"//model\"/>"
  expect           : "Panorama"
</custom_item>

<custom_item>
  type             : AUDIT_XML
  description      : "1.0002 - CSPA - Panorama system-mode"
  api_request_type : "op"
  request          : "<show><system><info></info></system></show>"
  xsl_stmt         : "<xsl:template match=\"/\">"
  xsl_stmt         : "<xsl:value-of select=\"//system-mode\"/>"
  expect           : "(?i)Panorama(?-i)"
