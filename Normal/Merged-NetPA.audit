  xsl_stmt         : "</xsl:otherwise>"
  xsl_stmt         : "</xsl:choose>"
  xsl_stmt         : "</xsl:for-each>"
  xsl_stmt         : "<xsl:if test=\"count(/response/result/config/devices/entry/vsys/entry/profiles/url-filtering/entry) = 0\">"
  xsl_stmt         : "Failed - No URL Filtering profiles found"
  xsl_stmt         : "</xsl:if>"
  regex            : "(Passed|Failed)"
  not_expect       : "Failed"
</custom_item>

