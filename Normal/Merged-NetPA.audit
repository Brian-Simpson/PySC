  xsl_stmt         : "</xsl:when>"
  xsl_stmt         : "</xsl:choose>"
  xsl_stmt         : "</xsl:otherwise>"
  xsl_stmt         : "</xsl:choose>"
  regex            : "(Passed|Failed)"
  not_expect       : "Failed"
</custom_item>

