                                   ((decoder/entry[@name='http2']/mlav-action='reset-both') or (decoder/entry[@name='http2']/mlav-action='default')) and
                                   ((decoder/entry[@name='smb']/mlav-action='reset-both') or (decoder/entry[@name='smb']/mlav-action='default'))and
