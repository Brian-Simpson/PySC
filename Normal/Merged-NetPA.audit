  xsl_stmt         : "</xsl:when>"
  xsl_stmt         : "</xsl:choose>"
  xsl_stmt         : "</xsl:for-each>"
  xsl_stmt         : "<xsl:if test=\"count(//rulebase/security/rules/entry[application/member='msrpc']) = 0\">"
  xsl_stmt         : "Failed - No Security Profiles have an MSRPC application type selected."
  xsl_stmt         : "</xsl:if>"
  regex            : "(Passed|Failed)"
  not_expect       : "Failed"
</custom_item>

