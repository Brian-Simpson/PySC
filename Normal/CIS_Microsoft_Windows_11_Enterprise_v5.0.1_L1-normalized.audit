Impact:

Warning: Many existing print configurations may be using the older named pipes protocol and therefore will cease to function."
  reference                : "NIST 800-53r5|CM-6b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows NT\Printers\RPC"
  reg_item                 : "RpcUseNamedPipeProtocol"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

