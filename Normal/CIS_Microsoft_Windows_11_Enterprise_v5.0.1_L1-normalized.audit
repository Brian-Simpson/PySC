  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success, Failure"
  audit_policy_subcategory : "Credential Validation"
</custom_item>

