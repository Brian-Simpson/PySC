  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ("Administrators" && "Window Manager Group") || ("Administrators" && "Window Manager\Window Manager Group")
  right_type               : SeIncreaseBasePriorityPrivilege
</custom_item>

