  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows NT\DNSClient"
  reg_item                 : "EnableMDNS"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

