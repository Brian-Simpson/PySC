  description              : "1.0079 - MSWRK - Ensure 'Turn off Microsoft consumer experiences' is set to 'Enabled'"
  info                     : "This policy setting turns off experiences that help consumers make the most of their devices and Microsoft account."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\CloudContent"
  reg_item                 : "DisableWindowsConsumerFeatures"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0080 - MSWRK - Ensure 'Require pin for pairing' is set to 'Enabled: First Time' OR 'Enabled: Always'"
  info                     : "This policy setting controls whether or not a PIN is required for pairing to a wireless display device."
  reference                : "NIST 800-53r5|IA-5c."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1" || "2"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Connect"
  reg_item                 : "RequirePinForPairing"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0081 - MSWRK - Ensure 'Do not display the password reveal button' is set to 'Enabled'"
  info                     : "This policy setting allows you to configure the display of the password reveal button in password entry user experiences."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\CredUI"
  reg_item                 : "DisablePasswordReveal"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0082 - MSWRK - Ensure 'Enumerate administrator accounts on elevation' is set to 'Disabled'"
  info                     : "This policy setting controls whether administrator accounts are displayed when a user attempts to elevate a running application."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\CredUI"
  reg_item                 : "EnumerateAdministrators"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0083 - MSWRK - Ensure 'Prevent the use of security questions for local accounts' is set to 'Enabled'"
  info                     : "This policy setting controls whether security questions can be used to reset local account passwords."
  reference                : "NIST 800-53r5|CM-6b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\System"
  reg_item                 : "NoLocalPasswordResetQuestions"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0084 - MSWRK - Ensure 'Allow Diagnostic Data' is set to 'Enabled: Diagnostic data off (not recommended)' or 'Enabled: Send required diagnostic data'"
  info                     : "This policy setting determines the amount of diagnostic and usage data reported to Microsoft: - A value of (0) Diagnostic data off (not recommended)."
  reference                : "NIST 800-53r5|CM-7b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0" || "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DataCollection"
  reg_item                 : "AllowTelemetry"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0085 - MSWRK - Ensure 'Do not show feedback notifications' is set to 'Enabled'"
  info                     : "This policy setting allows an organization to prevent its devices from showing feedback questions from Microsoft."
  reference                : "NIST 800-53r5|CM-7b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DataCollection"
  reg_item                 : "DoNotShowFeedbackNotifications"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0086 - MSWRK - Ensure 'Enable OneSettings Auditing' is set to 'Enabled'"
  info                     : "This policy setting controls whether Windows records attempts to connect with the OneSettings service to the Event Log."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DataCollection"
  reg_item                 : "EnableOneSettingsAuditing"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0087 - MSWRK - Ensure 'Download Mode' is NOT set to 'Enabled: Internet'"
  info                     : "This policy setting specifies the download method that Delivery Optimization can use in downloads of Windows Updates, Apps and App updates."
  reference                : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0" || "1" || "2" || "99" || "100"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DeliveryOptimization"
  reg_item                 : "DODownloadMode"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0088 - MSWRK - Ensure 'Enable App Installer Experimental Features' is set to 'Disabled'"
  info                     : "This policy setting controls whether users can enable experimental features in the Windows Package Manager."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\AppInstaller"
  reg_item                 : "EnableExperimentalFeatures"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0089 - MSWRK - Ensure 'Enable App Installer Hash Override' is set to 'Disabled'"
  info                     : "This policy setting controls whether or not users can override the SHA256 security validation in the Windows Package Manager settings."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\AppInstaller"
  reg_item                 : "EnableHashOverride"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0090 - MSWRK - Ensure 'Enable App Installer Local Archive Malware Scan Override' is set to 'Disabled'"
  info                     : "This policy setting controls the ability to override malware scans when the following conditions are true: - installing an archive file - using a local manifest - via command line arguments The recommended state for this setting is: Disabled."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\AppInstaller"
  reg_item                 : "EnableLocalArchiveMalwareScanOverride"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0091 - MSWRK - Ensure 'Enable App Installer Microsoft Store Source Certificate Validation Bypass' is set to 'Disabled'"
  info                     : "This policy setting controls whether Windows Package Manager validates the Microsoft Store certificate hash to match a known Microsoft Store certificate when it initiates a connection to the Microsoft Store source."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\AppInstaller"
  reg_item                 : "EnableBypassCertificatePinningForMicrosoftStore"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0092 - MSWRK - Ensure 'Enable App Installer ms-appinstaller protocol' is set to 'Disabled'"
  info                     : "This policy setting controls whether users can install packages from a website that is using the ms-appinstaller protocol."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\AppInstaller"
  reg_item                 : "EnableMSAppInstallerProtocol"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0093 - MSWRK - Ensure 'Application: Control Event Log behavior when the log file reaches its maximum size' is set to 'Disabled'"
  info                     : "This policy setting controls Event Log behavior when the log file reaches its maximum size."
  reference                : "NIST 800-53r5|AU-4"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\EventLog\Application"
  reg_item                 : "Retention"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0094 - MSWRK - Ensure 'Application: Specify the maximum log file size (KB)' is set to 'Enabled: 32,768 or greater'"
  info                     : "This policy setting specifies the maximum size of the log file in kilobytes."
  reference                : "NIST 800-53r5|AU-4"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[32768..MAX]"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\EventLog\Application"
  reg_item                 : "MaxSize"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0095 - MSWRK - Ensure 'Security: Control Event Log behavior when the log file reaches its maximum size' is set to 'Disabled'"
  info                     : "This policy setting controls Event Log behavior when the log file reaches its maximum size."
  reference                : "NIST 800-53r5|AU-4"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\EventLog\Security"
  reg_item                 : "Retention"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0096 - MSWRK - Ensure 'Security: Specify the maximum log file size (KB)' is set to 'Enabled: 196,608 or greater'"
  info                     : "This policy setting specifies the maximum size of the log file in kilobytes."
  reference                : "NIST 800-53r5|AU-4"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[196608..MAX]"
