</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0161 - MSWRK - Ensure 'Turn off Automatic Download and Install of updates' is set to 'Disabled'"
  info                     : "This setting enables or disables the automatic download and installation of Microsoft Store app updates."
