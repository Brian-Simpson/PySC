  value_data               : "1"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS"
  reg_item                 : "ADPasswordEncryptionEnabled"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0270 - MSWRK - Ensure 'Password Settings: Password Complexity' is set to 'Enabled: Large letters + small letters + numbers + special characters' or 'Passphrase'"
  info                     : "This policy setting configures the Windows LAPS Password Settings policy for password complexity."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "4" || "6" || "7" || "8"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS"
  reg_item                 : "PasswordComplexity"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0271 - MSWRK - Ensure 'Password Settings: Password Length' is set to 'Enabled: 15 or more'"
  info                     : "This policy setting configures the Windows LAPS Password Settings policy for password length."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[15..MAX]"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS"
  reg_item                 : "PasswordLength"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0272 - MSWRK - Ensure 'Password Settings: Password Age (Days)' is set to 'Enabled: 30 or fewer'"
  info                     : "This policy setting configures the Windows LAPS Password Settings policy for password age."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[MIN..30]"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS"
  reg_item                 : "PasswordAgeDays"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0273 - MSWRK - Ensure 'Post-authentication actions: Grace period (hours)' is set to 'Enabled: 8 or fewer hours, but not 0'"
  info                     : "This policy settings configures post-authentication actions which will be executed after detecting an authentication by the Windows LAPS managed account."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[1..8]"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS"
  reg_item                 : "PostAuthenticationResetDelay"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0274 - MSWRK - Ensure 'Post-authentication actions: Actions' is set to 'Enabled: Reset the password and logoff the managed account' or higher"
  info                     : "This policy settings configures post-authentication actions which will be executed after detecting an authentication by the LAPS managed account."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "3" || "5" || "11"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS"
  reg_item                 : "PostAuthenticationActions"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0275 - MSWRK - Ensure 'Allow Custom SSPs and APs to be loaded into LSASS' is set to 'Disabled'"
  info                     : "This policy setting controls the configuration under which the Local Security Authority Subsystem Service (LSASS) will load custom Security Support Provider/Authentication Package (SSP/AP)."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\System"
  reg_item                 : "AllowCustomSSPsAPs"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0276 - MSWRK - Ensure 'Configures LSASS to run as a protected process' is set to 'Enabled: Enabled with UEFI Lock'"
  info                     : "This policy setting controls whether the Local Security Authority Subservice Service (LSASS) runs in protected mode and also has the option to lock in protected mode with Unified Extensible Firmware Interface (UEFI)."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\System"
  reg_item                 : "RunAsPPL"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0277 - MSWRK - Ensure 'Block user from showing account details on sign-in' is set to 'Enabled'"
  info                     : "This policy prevents the user from showing account details (email address or user name) on the sign-in screen."
  reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\System"
  reg_item                 : "BlockUserFromShowingAccountDetailsOnSignin"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0278 - MSWRK - Ensure 'Do not display network selection UI' is set to 'Enabled'"
  info                     : "This policy setting allows you to control whether anyone can interact with available networks UI on the logon screen."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
