  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\System"
  reg_item                 : "DisableLockScreenAppNotifications"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0282 - MSWRK - Ensure 'Turn off picture password sign-in' is set to 'Enabled'"
  info                     : "This policy setting allows you to control whether a domain user can sign in using a picture password."
  reference                : "NIST 800-53r5|CM-6 CM-7"
