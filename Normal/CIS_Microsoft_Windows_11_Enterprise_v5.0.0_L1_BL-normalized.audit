<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0281 - MSWRK - Ensure 'Turn off app notifications on the lock screen' is set to 'Enabled'"
  info                     : "This policy setting allows you to prevent app notifications from appearing on the lock screen."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
