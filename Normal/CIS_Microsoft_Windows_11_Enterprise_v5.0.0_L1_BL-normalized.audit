<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0137 - MSWRK - Ensure 'Prevent users and apps from accessing dangerous websites' is set to 'Enabled: Block'"
  info                     : "This policy setting controls Microsoft Defender Exploit Guard network protection."
  reference                : "NIST 800-53r5|SC-7(3) SC-7(4) SI-16"
  see_also                 : "See HTH Policies and Standards"
