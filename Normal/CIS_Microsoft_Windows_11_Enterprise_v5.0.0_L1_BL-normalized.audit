  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WTDS\Components"
  reg_item                 : "NotifyUnsafeApp"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0168 - MSWRK - Ensure 'Service Enabled' is set to 'Enabled'"
  info                     : "This policy setting determines whether Enhanced Phishing Protection is in audit mode."
  reference                : "NIST 800-53r5|SI-16"
