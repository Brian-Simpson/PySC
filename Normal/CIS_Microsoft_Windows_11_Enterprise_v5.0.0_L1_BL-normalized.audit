<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0162 - MSWRK - Ensure 'Turn off the offer to update to the latest version of Windows' is set to 'Enabled'"
  info                     : "Enables or disables the Microsoft Store offer to update to the latest version of Windows."
  reference                : "NIST 800-53r5|CM-7b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\WindowsStore"
  reg_item                 : "DisableOSUpgrade"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0163 - MSWRK - Ensure 'Allow Recall to be enabled' is set to 'Disabled'"
  info                     : "This policy setting controls whether the Recall optional component is available for end users to enable on the system."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WindowsAI"
  reg_item                 : "AllowRecallEnablement"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0164 - MSWRK - Ensure 'Automatic Data Collection' is set to 'Enabled'"
  info                     : "This policy setting determines whether Enhanced Phishing Protection can collect additional information such as content displayed, sounds played, and application memory when users enter their work or school password into a suspicious website or app."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WTDS\Components"
  reg_item                 : "CaptureThreatWindow"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0165 - MSWRK - Ensure 'Notify Malicious' is set to 'Enabled'"
  info                     : "This policy setting determines whether Enhanced Phishing Protection in Microsoft Defender SmartScreen warns users if they type their work or school password into one of the following malicious scenarios: into a reported phishing site, into a Microsoft login URL with an invalid certificate, or into an application connecting to either a reported phishing site or a Microsoft login URL with an invalid certificate."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WTDS\Components"
  reg_item                 : "NotifyMalicious"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0166 - MSWRK - Ensure 'Notify Password Reuse' is set to 'Enabled'"
  info                     : "This policy setting determines whether Enhanced Phishing Protection in Microsoft Defender SmartScreen warns users if they reuse their work or school password."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WTDS\Components"
  reg_item                 : "NotifyPasswordReuse"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0167 - MSWRK - Ensure 'Notify Unsafe App' is set to 'Enabled'"
  info                     : "This policy setting determines whether Enhanced Phishing Protection in Microsoft Defender SmartScreen warns users if they type their work or school passwords in Notepad, WordPad, or M365 Office apps like OneNote, Word, Excel, etc."
