</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0100 - MSWRK - Ensure 'System: Specify the maximum log file size (KB)' is set to 'Enabled: 32,768 or greater'"
  info                     : "This policy setting specifies the maximum size of the log file in kilobytes."
  reference                : "NIST 800-53r5|AU-4"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[32768..MAX]"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\EventLog\System"
  reg_item                 : "MaxSize"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0101 - MSWRK - Ensure 'Turn off Data Execution Prevention for Explorer' is set to 'Disabled'"
  info                     : "Disabling Data Execution Prevention can allow certain legacy plug-in applications to function without terminating Explorer."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Explorer"
  reg_item                 : "NoDataExecutionPrevention"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0102 - MSWRK - Ensure 'Do not apply the Mark of the Web tag to files copied from insecure sources' is set to 'Disabled'"
  info                     : "This policy setting determines whether files that are sourced from insecure locations are tagged with Mark of the Web (MOTW)."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Explorer"
  reg_item                 : "DisableMotWOnInsecurePathCopy"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0103 - MSWRK - Ensure 'Turn off heap termination on corruption' is set to 'Disabled'"
  info                     : "Without heap termination on corruption, legacy plug-in applications may continue to function when a File Explorer session has become corrupt."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Explorer"
  reg_item                 : "NoHeapTerminationOnCorruption"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0104 - MSWRK - Ensure 'Turn off shell protocol protected mode' is set to 'Disabled'"
  info                     : "This policy setting allows you to configure the amount of functionality that the shell protocol can have."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer"
  reg_item                 : "PreXPSP2ShellProtocolBehavior"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0105 - MSWRK - Ensure 'Block all consumer Microsoft account user authentication' is set to 'Enabled'"
  info                     : "This setting determines whether applications and services on the device can utilize new consumer Microsoft account authentication via the Windows OnlineID and WebAccountManager APIs."
  reference                : "NIST 800-53r5|AC-2(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\MicrosoftAccount"
  reg_item                 : "DisableUserAuth"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0106 - MSWRK - Ensure 'Not allow per-user unsigned packages to install by default (requires explicitly allow per install)' is set to 'Enabled'"
  info                     : "This setting manages a user's ability to install unsigned Windows App packages."
  reference                : "NIST 800-53r5|CM-7(5) CM-10"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Appx"
  reg_item                 : "DisablePerUserUnsignedPackagesByDefault"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0107 - MSWRK - Ensure 'Configure real-time protection and Security Intelligence Updates during OOBE' is set to 'Enabled'"
  info                     : "This policy setting configures whether Real-time Protection and Security Intelligence Updates are enabled during the Out of Box experience (OOBE)."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Real-Time Protection"
  reg_item                 : "OobeEnableRtpAndSigUpdate"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0108 - MSWRK - Ensure 'Scan all downloaded files and attachments' is set to 'Enabled'"
  info                     : "This policy setting configures scanning for all downloaded files and attachments."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Real-Time Protection"
  reg_item                 : "DisableIOAVProtection"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0109 - MSWRK - Ensure 'Turn off real-time protection' is set to 'Disabled'"
  info                     : "This policy setting configures real-time protection prompts for known malware detection."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Real-Time Protection"
  reg_item                 : "DisableRealtimeMonitoring"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0110 - MSWRK - Ensure 'Turn on behavior monitoring' is set to 'Enabled'"
  info                     : "This policy setting allows you to configure behavior monitoring for Microsoft Defender Antivirus."
  reference                : "NIST 800-53r5|SI-4"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Real-Time Protection"
  reg_item                 : "DisableBehaviorMonitoring"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0111 - MSWRK - Ensure 'Turn on script scanning' is set to 'Enabled'"
  info                     : "This policy setting allows script scanning to be turned on/off."
  reference                : "NIST 800-53r5|SI-4"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Real-Time Protection"
  reg_item                 : "DisableScriptScanning"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0112 - MSWRK - Ensure 'Configure Remote Encryption Protection Mode' is set to 'Enabled: Audit' or higher"
  info                     : "This policy setting configures the Brute-Force Protection feature in Microsoft Defender Antivirus."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1" || "2"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Remediation\Behavioral Network Blocks\Brute Force Protection"
  reg_item                 : "BruteForceProtectionConfiguredState"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0113 - MSWRK - Ensure 'Scan excluded files and directories during quick scans' is set to 'Enabled: 1'"
  info                     : "This policy setting manages whether or not Microsoft Defender Antivirus scans excluded files and directories when running a Quick Scan."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Scan"
  reg_item                 : "QuickScanIncludeExclusions"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0114 - MSWRK - Ensure 'Scan packed executables' is set to 'Enabled'"
  info                     : "This policy setting manages whether or not Microsoft Defender Antivirus scans packed executables."
  reference                : "NIST 800-53r5|MP-7 SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Scan"
  reg_item                 : "DisablePackedExeScanning"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0115 - MSWRK - Ensure 'Scan removable drives' is set to 'Enabled'"
  info                     : "This policy setting manages whether to scan for malicious software and unwanted software in the contents of removable drives, such as USB flash drives, when running a full scan."
  reference                : "NIST 800-53r5|MP-7 SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Scan"
  reg_item                 : "DisableRemovableDriveScanning"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0116 - MSWRK - Ensure 'Trigger a quick scan after X days without any scans' is set to 'Enabled: 7'"
  info                     : "This policy setting configures the number of days after the last scan (of any type) before an aggressive Quick Scan is automatically triggered."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "7"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Scan"
  reg_item                 : "DaysUntilAggressiveCatchupQuickScan"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0117 - MSWRK - Ensure 'Turn on e-mail scanning' is set to 'Enabled'"
  info                     : "This policy setting configures e-mail scanning."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Scan"
  reg_item                 : "DisableEmailScanning"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0118 - MSWRK - Ensure 'Configure detection for potentially unwanted applications' is set to 'Enabled: Block'"
  info                     : "This policy setting controls detection and action for Potentially Unwanted Applications (PUA), which are sneaky unwanted application bundlers or their bundled applications, that can deliver adware or malware."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender"
  reg_item                 : "PUAProtection"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0119 - MSWRK - Ensure 'Control whether exclusions are visible to local users' is set to 'Enabled'"
  info                     : "This policy setting controls whether Microsoft Defender Antivirus exclusions are visible to local users on the system."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender"
  reg_item                 : "HideExclusionsFromLocalUsers"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0120 - MSWRK - Ensure 'Enable EDR in block mode' is set to 'Enabled'"
  info                     : "This policy setting controls whether Microsoft Defender Antivirus Endpoint Detection and Response (EDR) is enabled in block mode (passive remediation)."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Features"
  reg_item                 : "PassiveRemediation"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0121 - MSWRK - Ensure 'Configure local setting override for reporting to Microsoft MAPS' is set to 'Disabled'"
  info                     : "This policy setting configures a local override for the configuration to join Microsoft Active Protection Service (MAPS), which Microsoft renamed to Windows Defender Antivirus Cloud Protection Service and then Microsoft Defender Antivirus Cloud Protection Service."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Spynet"
  reg_item                 : "LocalSettingOverrideSpynetReporting"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0122 - MSWRK - Ensure 'Join Microsoft MAPS' is set to 'Enabled: Advanced'"
  info                     : "This policy setting configures Microsoft Active Protection Service (MAPS)."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "2"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Spynet"
  reg_item                 : "SpynetReporting"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

