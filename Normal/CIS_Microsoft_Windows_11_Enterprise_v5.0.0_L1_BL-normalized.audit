<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0269 - MSWRK - Ensure 'Enable password encryption' is set to 'Enabled'"
  info                     : "This policy setting controls whether the Windows LAPS managed password is encrypted before being sent to Active Directory."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
