<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0280 - MSWRK - Ensure 'Enumerate local users on domain-joined computers' is set to 'Disabled'"
  info                     : "This policy setting allows local users to be enumerated on domain-joined computers."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
