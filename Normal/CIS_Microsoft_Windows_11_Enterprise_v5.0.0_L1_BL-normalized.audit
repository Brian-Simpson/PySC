  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\W32Time\TimeProviders\NtpServer"
  reg_item                 : "Enabled"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0304 - MSWRK - Ensure 'Turn On Virtualization Based Security: Require UEFI Memory Attributes Table' is set to 'True (checked)'"
  info                     : "This option will only enable Virtualization Based Protection of Code Integrity on devices with UEFI firmware support for the Memory Attributes Table."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DeviceGuard"
  reg_item                 : "HVCIMATRequired"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0305 - MSWRK - (L1) Ensure 'Configure the behavior of the sudo command' is set to 'Enabled: Disabled'"
  info                     : "This policy setting configures the use of the sudo."
  reference                : "NIST 800-53r5|CM-7b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Sudo"
  reg_item                 : "Enabled"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0306 - MSWRK - Ensure 'Turn On Virtualization Based Security: Credential Guard Configuration' is set to 'Enabled with UEFI lock'"
  info                     : "This setting lets users turn on Credential Guard with virtualization-based security to help protect credentials."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DeviceGuard"
  reg_item                 : "LsaCfgFlags"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0307 - MSWRK - Ensure 'Turn On Virtualization Based Security: Secure Launch Configuration' is set to 'Enabled'"
  info                     : "Secure Launch protects the Virtualization Based Security environment from exploited vulnerabilities in device firmware."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DeviceGuard"
  reg_item                 : "ConfigureSystemGuardLaunch"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0308 - MSWRK - Ensure 'Turn On Virtualization Based Security: Kernel-mode Hardware-enforced Stack Protection' is set to 'Enabled: Enabled in enforcement mode'"
  info                     : "This policy setting enables Hardware-enforced Stack Protection for kernel-mode code."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DeviceGuard"
  reg_item                 : "ConfigureKernelShadowStacksLaunch"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0309 - MSWRK - Ensure 'Prevent installation of devices using drivers that match these device setup classes' is set to 'Enabled'"
  info                     : "This policy setting allows you to specify a list of device setup class globally unique identifiers (GUIDs) for device drivers that Windows is prevented from installing."
  reference                : "NIST 800-53r5|MP-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DeviceInstall\Restrictions"
  reg_item                 : "DenyDeviceClasses"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0310 - MSWRK - Ensure 'Prevent installation of devices using drivers that match these device setup classes: Prevent installation of devices using drivers for these device setup' is set to 'IEEE 1394 device setup classes'"
  info                     : "This policy setting allows you to specify a list of device setup class globally unique identifiers (GUIDs) for device drivers that Windows is prevented from installing."
  reference                : "NIST 800-53r5|SI-3c.2."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "STATUS: PASSED"
  powershell_args          : "$values = '{d48179be-ec20-11d1-b6b8-00c04fa372a7}', '{7ebefbc0-3200-11d2-b4c2-00a0C9697d07}', '{c06ff265-ae09-48f0-812c-16753d7cba83}', '{6bdd1fc1-810f-11d0-bec7-08002be2092f}'; $path = 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\Deviceinstall\Restrictions\DenyDeviceClasses'; Get-Item -Path $path -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Property | ForEach-Object { $value = (Get-ItemProperty -Path $path -Name $_).$_; if ($values -contains $value) { $values = $values | Where-Object { $_ -ne $value } } }; if ($values) { 'The following values are missing:'; ''; $values; ''; 'STATUS: FAILED' } else { 'STATUS: PASSED' }"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0311 - MSWRK - Ensure 'Prevent installation of devices using drivers that match these device setup classes: Also apply to matching devices that are already installed.' is set to 'True' (checked)"
  info                     : "This policy setting allows you to specify a list of device setup class globally unique identifiers (GUIDs) for device drivers that Windows is prevented from installing."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DeviceInstall\Restrictions"
  reg_item                 : "DenyDeviceClassesRetroactive"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0312 - MSWRK - Ensure 'Prevent automatic download of applications associated with device metadata' is set to 'Enabled'"
  info                     : "This policy setting allows you to prevent Windows from retrieving device metadata from the Internet."
  reference                : "NIST 800-53r5|CM-7(5) CM-10 SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Device Metadata"
  reg_item                 : "PreventDeviceMetadataFromNetwork"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0313 - MSWRK - Ensure 'Turn off toast notifications on the lock screen' is set to 'Enabled'"
  info                     : "This policy setting turns off toast notifications on the lock screen."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKU\Software\Policies\Microsoft\Windows\CurrentVersion\PushNotifications"
  reg_item                 : "NoToastApplicationNotificationOnLockScreen"
  reg_option               : CAN_NOT_BE_NULL
  reg_include_hku_users    : "S-1-5-21-*"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0314 - MSWRK - Ensure 'Prevent users from sharing files within their profile.' is set to 'Enabled'"
  info                     : "This policy setting determines whether users can share files within their profile."
  reference                : "NIST 800-53r5|AC-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer"
  reg_item                 : "NoInplaceSharing"
  reg_option               : CAN_NOT_BE_NULL
  reg_include_hku_users    : "S-1-5-21-*"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0315 - MSWRK - Ensure 'Do not preserve zone information in file attachments' is set to 'Disabled'"
  info                     : "This policy setting allows you to manage whether Windows marks file attachments with information about their zone of origin (such as restricted, Internet, intranet, local)."
  reference                : "NIST 800-53r5|CM-6b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "2"
  reg_key                  : "HKU\Software\Microsoft\Windows\CurrentVersion\Policies\Attachments"
  reg_item                 : "SaveZoneInformation"
  reg_option               : CAN_NOT_BE_NULL
  reg_include_hku_users    : "S-1-5-21-*"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0316 - MSWRK - Ensure 'Notify antivirus programs when opening attachments' is set to 'Enabled'"
  info                     : "This policy setting manages the behavior for notifying registered antivirus programs."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "3"
  reg_key                  : "HKU\Software\Microsoft\Windows\CurrentVersion\Policies\Attachments"
  reg_item                 : "ScanWithAntiVirus"
  reg_option               : CAN_NOT_BE_NULL
  reg_include_hku_users    : "S-1-5-21-*"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0317 - MSWRK - Ensure 'Configure Windows spotlight on lock screen' is set to 'Disabled'"
  info                     : "This policy setting lets you configure Windows Spotlight on the lock screen."
  reference                : "NIST 800-53r5|AC-11"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "2"
  reg_key                  : "HKU\Software\Policies\Microsoft\Windows\CloudContent"
  reg_item                 : "ConfigureWindowsSpotlight"
  reg_option               : CAN_NOT_BE_NULL
  reg_include_hku_users    : "S-1-5-21-*"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0318 - MSWRK - Ensure 'Do not suggest third-party content in Windows spotlight' is set to 'Enabled'"
  info                     : "This policy setting determines whether Windows will suggest apps and content from third-party software publishers."
  reference                : "NIST 800-53r5|CM-7b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKU\Software\Policies\Microsoft\Windows\CloudContent"
  reg_item                 : "DisableThirdPartySuggestions"
  reg_option               : CAN_NOT_BE_NULL
  reg_include_hku_users    : "S-1-5-21-*"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0319 - MSWRK - Ensure 'Turn off Spotlight collection on Desktop' is set to 'Enabled'"
  info                     : "This policy setting removes the Spotlight collection setting in Personalization, rendering the user unable to select and subsequently download daily images from Microsoft to the system desktop."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKU\Software\Policies\Microsoft\Windows\CloudContent"
  reg_item                 : "DisableSpotlightCollectionOnDesktop"
  reg_option               : CAN_NOT_BE_NULL
  reg_include_hku_users    : "S-1-5-21-*"
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0320 - MSWRK - Ensure 'Access Credential Manager as a trusted caller' is set to 'No One'"
  info                     : "This security setting is used by Credential Manager during Backup and Restore."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeTrustedCredManAccessPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0321 - MSWRK - Ensure 'Create a token object' is set to 'No One'"
  info                     : "This policy setting allows a process to create an access token, which may provide elevated rights to access sensitive data."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeCreateTokenPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0322 - MSWRK - Ensure 'Create global objects' is set to 'Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE'"
  info                     : "This policy setting determines whether users can create global objects that are available to all sessions."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "LOCAL SERVICE" && "NETWORK SERVICE" && "SERVICE"
  right_type               : SeCreateGlobalPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0323 - MSWRK - Ensure 'Create permanent shared objects' is set to 'No One'"
  info                     : "This user right is useful to kernel-mode components that extend the object namespace."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeCreatePermanentPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0324 - MSWRK - Ensure 'Create symbolic links' is set to 'Administrators'"
  info                     : "This policy setting determines which users can create symbolic links."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ("Administrators" || ("Administrators" && "Virtual Machines") || ("Administrators" && "NT VIRTUAL MACHINE\Virtual Machines"))
  right_type               : SeCreateSymbolicLinkPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0325 - MSWRK - Ensure 'Debug programs' is set to 'Administrators'"
  info                     : "This policy setting determines which user accounts will have the right to attach a debugger to any process or to the kernel, which provides complete access to sensitive and critical operating system components."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeDebugPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0326 - MSWRK - Ensure 'Deny access to this computer from the network' to include 'Guests, Local account'"
  info                     : "This policy setting prohibits users from connecting to a computer from across the network, which would allow users to access and potentially modify data remotely."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Guests" && "Local account"
  right_type               : SeDenyNetworkLogonRight
  check_type               : CHECK_SUPERSET
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0327 - MSWRK - Ensure 'Deny log on as a batch job' to include 'Guests'"
  info                     : "This policy setting determines which accounts will not be able to log on to the computer as a batch job."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Guests"
  right_type               : SeDenyBatchLogonRight
  check_type               : CHECK_SUPERSET
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0328 - MSWRK - Ensure 'Deny log on as a service' to include 'Guests'"
  info                     : "This security setting determines which service accounts are prevented from registering a process as a service."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Guests"
  right_type               : SeDenyServiceLogonRight
  check_type               : CHECK_SUPERSET
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0329 - MSWRK - Ensure 'Deny log on locally' to include 'Guests'"
  info                     : "This security setting determines which users are prevented from logging on at the computer."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Guests"
  right_type               : SeDenyInteractiveLogonRight
  check_type               : CHECK_SUPERSET
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0330 - MSWRK - Ensure 'Deny log on through Remote Desktop Services' to include 'Guests, Local account'"
  info                     : "This policy setting determines whether users can log on as Remote Desktop clients."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Guests" && "Local account"
  right_type               : SeDenyRemoteInteractiveLogonRight
  check_type               : CHECK_SUPERSET
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0331 - MSWRK - Ensure 'Access this computer from the network' is set to 'Administrators, Remote Desktop Users'"
  info                     : "This policy setting allows other users on the network to connect to the computer and is required by various network protocols that include Server Message Block (SMB)-based protocols, NetBIOS, Common Internet File System (CIFS), and Component Object Model Plus (COM+)."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "Remote Desktop Users"
  right_type               : SeNetworkLogonRight
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0332 - MSWRK - Ensure 'Enable computer and user accounts to be trusted for delegation' is set to 'No One'"
  info                     : "This policy setting allows users to change the Trusted for Delegation setting on a computer object in Active Directory."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeEnableDelegationPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0333 - MSWRK - Ensure 'Force shutdown from a remote system' is set to 'Administrators'"
  info                     : "This policy setting allows users to shut down Windows Vista-based or newer computers from remote locations on the network."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeRemoteShutdownPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0334 - MSWRK - Ensure 'Generate security audits' is set to 'LOCAL SERVICE, NETWORK SERVICE, RESTRICTED SERVICES\PrintSpoolerService'"
  info                     : "This policy setting determines which users or processes can generate audit records in the Security log."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Local Service" && "Network Service" && "spooler"
  right_type               : SeAuditPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0335 - MSWRK - Ensure 'Impersonate a client after authentication' is set to 'Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE, RESTRICTED SERVICES\PrintSpoolerService'"
  info                     : "The policy setting allows programs that run on behalf of a user to impersonate that user (or another specified account) so that they can act on behalf of the user."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "Local Service" && "Network Service" && "Service" && "Spooler"
  right_type               : SeImpersonatePrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0336 - MSWRK - Ensure 'Increase scheduling priority' is set to 'Administrators, Window Manager\Window Manager Group'"
  info                     : "This policy setting determines whether users can increase the base priority class of a process."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ("Administrators" && "Window Manager Group") || ("Administrators" && "Window Manager\Window Manager Group")
  right_type               : SeIncreaseBasePriorityPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0337 - MSWRK - Ensure 'Load and unload device drivers' is set to 'Administrators'"
  info                     : "This policy setting allows users to dynamically load a new device driver on a system."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeLoadDriverPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0338 - MSWRK - Ensure 'Lock pages in memory' is set to 'No One'"
  info                     : "This policy setting allows a process to keep data in physical memory, which prevents the system from paging the data to virtual memory on disk."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeLockMemoryPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0339 - MSWRK - Ensure 'Manage auditing and security log' is set to 'Administrators'"
  info                     : "This policy setting determines which users can change the auditing options for files and directories and clear the Security log."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeSecurityPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0340 - MSWRK - Ensure 'Act as part of the operating system' is set to 'No One'"
  info                     : "This policy setting allows a process to assume the identity of any user and thus gain access to the resources that the user is authorized to access."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeTcbPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0341 - MSWRK - Ensure 'Modify an object label' is set to 'No One'"
  info                     : "This privilege determines which user accounts can modify the integrity label of objects, such as files, registry keys, or processes owned by other users."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeReLabelPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0342 - MSWRK - Ensure 'Modify firmware environment values' is set to 'Administrators'"
  info                     : "This policy setting allows users to configure the system-wide environment variables that affect hardware configuration."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeSystemEnvironmentPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0343 - MSWRK - Ensure 'Perform volume maintenance tasks' is set to 'Administrators'"
  info                     : "This policy setting allows users to manage the system's volume or disk configuration, which could allow a user to delete a volume and cause data loss as well as a denial-of-service condition."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeManageVolumePrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0344 - MSWRK - Ensure 'Profile single process' is set to 'Administrators'"
  info                     : "This policy setting determines which users can use tools to monitor the performance of non-system processes."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeProfileSingleProcessPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0345 - MSWRK - Ensure 'Profile system performance' is set to 'Administrators, NT SERVICE\WdiServiceHost'"
  info                     : "This policy setting determines which users can use Windows performance monitoring tools to monitor the performance of system processes."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && ("NT SERVICE\WdiServiceHost" || "WdiServiceHost")
  right_type               : SeSystemProfilePrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0346 - MSWRK - Ensure 'Replace a process level token' is set to 'LOCAL SERVICE, NETWORK SERVICE'"
  info                     : "This policy setting allows one process or service to start another service or process with a different security access token, which can be used to modify the security access token of that sub-process and result in the escalation of privileges."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "LOCAL SERVICE" && "NETWORK SERVICE"
  right_type               : SeAssignPrimaryTokenPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0347 - MSWRK - Ensure 'Restore files and directories' is set to 'Administrators'"
  info                     : "This policy setting determines which users can bypass file, directory, registry, and other persistent object permissions when restoring backed up files and directories on systems that run Windows Vista (or newer)."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeRestorePrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0348 - MSWRK - Ensure 'Shut down the system' is set to 'Administrators, Users'"
  info                     : "This policy setting determines which users who are logged on locally to the computers in your environment can shut down the operating system with the Shut Down command."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Users" && "Administrators"
  right_type               : SeShutdownPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0349 - MSWRK - Ensure 'Take ownership of files or other objects' is set to 'Administrators'"
  info                     : "This policy setting allows users to take ownership of files, folders, registry keys, processes, or threads."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeTakeOwnershipPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0350 - MSWRK - Ensure 'Adjust memory quotas for a process' is set to 'Administrators, LOCAL SERVICE, NETWORK SERVICE'"
  info                     : "This policy setting allows a user to adjust the maximum amount of memory that is available to a process."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "LOCAL SERVICE" && "NETWORK SERVICE"
  right_type               : SeIncreaseQuotaPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0351 - MSWRK - Ensure 'Allow log on locally' is set to 'Administrators, Users'"
  info                     : "This policy setting determines which users can interactively log on to computers in your environment."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "Users"
  right_type               : SeInteractiveLogonRight
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0352 - MSWRK - Ensure 'Allow log on through Remote Desktop Services' is set to 'Administrators, Remote Desktop Users'"
  info                     : "This policy setting determines which users or groups have the right to log on as a Remote Desktop Services client."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "Remote Desktop Users"
  right_type               : SeRemoteInteractiveLogonRight
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0353 - MSWRK - Ensure 'Back up files and directories' is set to 'Administrators'"
  info                     : "This policy setting allows users to circumvent file and directory permissions to back up the system."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeBackupPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0354 - MSWRK - Ensure 'Change the system time' is set to 'Administrators, LOCAL SERVICE'"
  info                     : "This policy setting determines which users and groups can change the time and date on the internal clock of the computers in your environment."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "LOCAL SERVICE"
  right_type               : SeSystemTimePrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0355 - MSWRK - Ensure 'Create a pagefile' is set to 'Administrators'"
  info                     : "This policy setting allows users to change the size of the pagefile."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeCreatePagefilePrivilege
</custom_item>

<custom_item>
  type                     : ANONYMOUS_SID_SETTING
  description              : "1.0356 - MSWRK - Ensure 'Network access: Allow anonymous SID/Name translation' is set to 'Disabled'"
  info                     : "This policy setting determines whether an anonymous user can request security identifier (SID) attributes for another user, or use a SID to obtain its corresponding user name."
  reference                : "NIST 800-53r5|AC-6(10) IA-2(2)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_SET
  value_data               : "Disabled"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0357 - MSWRK - Ensure 'Network access: Restrict clients allowed to make remote calls to SAM' is set to 'Administrators: Remote Access: Allow'"
  info                     : "This policy setting allows you to restrict remote RPC connections to SAM."
  reference                : "NIST 800-53r5|AC-6(3)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "O:BAG:BAD:(A;;RC;;;BA)"
  reg_key                  : "HKLM\SYSTEM\CurrentControlSet\Control\Lsa"
  reg_item                 : "restrictremotesam"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0358 - MSWRK - Ensure 'Network access: Shares that can be accessed anonymously' is set to 'None'"
  info                     : "This policy setting determines which network shares can be accessed by anonymous users."
  reference                : "NIST 800-53r5|AC-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_MULTI_TEXT
  value_data               : ""
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "NullSessionShares"
  reg_option               : CAN_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0359 - MSWRK - Ensure 'Network access: Sharing and security model for local accounts' is set to 'Classic - local users authenticate as themselves'"
  info                     : "This policy setting determines how network logons that use local accounts are authenticated."
  reference                : "NIST 800-53r5|CM-6b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
  reg_item                 : "ForceGuest"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0360 - MSWRK - Ensure 'Network access: Do not allow anonymous enumeration of SAM accounts' is set to 'Enabled'"
  info                     : "This policy setting controls the ability of anonymous users to enumerate the accounts in the Security Accounts Manager (SAM)."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
  reg_item                 : "RestrictAnonymousSAM"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0361 - MSWRK - Ensure 'Network access: Do not allow anonymous enumeration of SAM accounts and shares' is set to 'Enabled'"
  info                     : "This policy setting controls the ability of anonymous users to enumerate SAM accounts as well as shares."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
  reg_item                 : "RestrictAnonymous"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0362 - MSWRK - Ensure 'Network access: Do not allow storage of passwords and credentials for network authentication' is set to 'Enabled'"
  info                     : "This policy setting determines whether Credential Manager (formerly called Stored User Names and Passwords) saves passwords or credentials for later use when it gains domain authentication."
  reference                : "NIST 800-53r5|IA-5(1)(c)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
  reg_item                 : "DisableDomainCreds"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0363 - MSWRK - Ensure 'Network access: Let Everyone permissions apply to anonymous users' is set to 'Disabled'"
  info                     : "This policy setting determines what additional permissions are assigned for anonymous connections to the computer."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
  reg_item                 : "EveryoneIncludesAnonymous"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0364 - MSWRK - Ensure 'Network access: Named Pipes that can be accessed anonymously' is set to 'None'"
  info                     : "This policy setting determines which communication sessions, or pipes, will have attributes and permissions that allow anonymous access."
  reference                : "NIST 800-53r5|IA-2(2)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_MULTI_TEXT
  value_data               : ""
  reg_key                  : "HKLM\SYSTEM\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "NullSessionPipes"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0365 - MSWRK - Ensure 'Network access: Remotely accessible registry paths' is configured"
  info                     : "This policy setting determines which registry paths will be accessible over the network, regardless of the users or groups listed in the access control list (ACL) of the winreg registry key."
  reference                : "NIST 800-53r5|AC-6(7)(b)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_MULTI_TEXT
  value_data               : "System\CurrentControlSet\Control\ProductOptions" && "System\CurrentControlSet\Control\Server Applications" && "Software\Microsoft\Windows NT\CurrentVersion"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedExactPaths"
  reg_item                 : "Machine"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0366 - MSWRK - Ensure 'Network access: Remotely accessible registry paths and sub-paths' is configured"
  info                     : "This policy setting determines which registry paths and sub-paths will be accessible over the network, regardless of the users or groups listed in the access control list (ACL) of the winreg registry key."
  reference                : "NIST 800-53r5|AC-6(7)(b)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_MULTI_TEXT
  value_data               : "System\CurrentControlSet\Control\Print\Printers" && "System\CurrentControlSet\Services\Eventlog" && "Software\Microsoft\OLAP Server" && "Software\Microsoft\Windows NT\CurrentVersion\Print" && "Software\Microsoft\Windows NT\CurrentVersion\Windows" && "System\CurrentControlSet\Control\ContentIndex" && "System\CurrentControlSet\Control\Terminal Server" && "System\CurrentControlSet\Control\Terminal Server\UserConfig" && "System\CurrentControlSet\Control\Terminal Server\DefaultUserConfiguration" && "Software\Microsoft\Windows NT\CurrentVersion\Perflib" && "System\CurrentControlSet\Services\Sysmonlog"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedPaths"
  reg_item                 : "Machine"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0367 - MSWRK - Ensure 'Network access: Restrict anonymous access to Named Pipes and Shares' is set to 'Enabled'"
  info                     : "When enabled, this policy setting restricts anonymous access to only those shares and pipes that are named in the Network access: Named pipes that can be accessed anonymously and Network access: Shares that can be accessed anonymously settings."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "RestrictNullSessAccess"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : CHECK_ACCOUNT
  description              : "1.0368 - MSWRK - Ensure 'Accounts: Guest account status' is set to 'Disabled'"
  info                     : "This policy setting determines whether the Guest account is enabled or disabled."
  reference                : "NIST 800-53r5|IA-5"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_SET
  value_data               : "Disabled"
  account_type             : GUEST_ACCOUNT
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0369 - MSWRK - Ensure 'Network security: Allow Local System to use computer identity for NTLM' is set to 'Enabled'"
  info                     : "This policy setting determines whether Local System services that use Negotiate when reverting to NTLM authentication can use the computer identity."
  reference                : "NIST 800-53r5|IA-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
  reg_item                 : "UseMachineId"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0370 - MSWRK - Ensure 'Network security: Minimum session security for NTLM SSP based (including secure RPC) servers' is set to 'Require NTLMv2 session security, Require 128-bit encryption'"
  info                     : "This policy setting determines which behaviors are allowed by servers for applications using the NTLM Security Support Provider (SSP)."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "537395200"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa\MSV1_0"
  reg_item                 : "NTLMMinServerSec"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0371 - MSWRK - Ensure 'Network security: Restrict NTLM: Audit Incoming NTLM Traffic' is set to 'Enable auditing for all accounts'"
  info                     : "This policy setting allows the auditing of incoming NTLM traffic."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "2"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa\MSV1_0"
  reg_item                 : "AuditReceivingNTLMTraffic"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0372 - MSWRK - Ensure 'Network security: Restrict NTLM: Outgoing NTLM traffic to remote servers' is set to 'Audit all' or higher"
  info                     : "This policy setting allows the auditing of outgoing NTLM traffic."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1" || "2"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa\MSV1_0"
  reg_item                 : "RestrictSendingNTLMTraffic"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0373 - MSWRK - Ensure 'Network security: Allow LocalSystem NULL session fallback' is set to 'Disabled'"
  info                     : "This policy setting determines whether NTLM is allowed to fall back to a NULL session when used with LocalSystem."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa\MSV1_0"
  reg_item                 : "AllowNullSessionFallback"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0374 - MSWRK - Ensure 'Network Security: Allow PKU2U authentication requests to this computer to use online identities' is set to 'Disabled'"
  info                     : "This setting determines if online identities are able to authenticate to this computer."
  reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa\pku2u"
  reg_item                 : "AllowOnlineID"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0375 - MSWRK - Ensure 'Network security: Configure encryption types allowed for Kerberos' is set to 'AES128_HMAC_SHA1, AES256_HMAC_SHA1, Future encryption types'"
  info                     : "This policy setting allows you to set the encryption types that Kerberos is allowed to use."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "2147483640"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System\Kerberos\Parameters"
  reg_item                 : "SupportedEncryptionTypes"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : PASSWORD_POLICY
  description              : "1.0376 - MSWRK - Ensure 'Network security: Force logoff when logon hours expire' is set to 'Enabled'"
  info                     : "This policy setting determines whether to disconnect users who are connected to the local computer outside their user account's valid logon hours."
  reference                : "NIST 800-53r5|AC-2(12)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_SET
  value_data               : "Enabled"
  password_policy          : FORCE_LOGOFF
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0377 - MSWRK - Ensure 'Network security: LAN Manager authentication level' is set to 'Send NTLMv2 response only. Refuse LM & NTLM'"
  info                     : "This policy setting determines which challenge or response authentication protocol is used for network logons."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "5"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
  reg_item                 : "LMCompatibilityLevel"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0378 - MSWRK - Ensure 'Network security: LDAP client encryption requirements' is set to 'Negotiate sealing' or higher"
  info                     : "This policy setting determines the level of data encryption that is requested on behalf of clients that issue LDAP BIND requests."
  reference                : "NIST 800-53r5|IA-3(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1" || "2"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LDAP"
  reg_item                 : "LDAPClientConfidentiality"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0379 - MSWRK - Ensure 'Network security: LDAP client signing requirements' is set to 'Negotiate signing' or higher"
  info                     : "This policy setting determines the level of data signing that is requested on behalf of clients that issue LDAP BIND requests."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1" || "2"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LDAP"
  reg_item                 : "LDAPClientIntegrity"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0380 - MSWRK - Ensure 'Network security: Minimum session security for NTLM SSP based (including secure RPC) clients' is set to 'Require NTLMv2 session security, Require 128-bit encryption'"
  info                     : "This policy setting determines which behaviors are allowed by clients for applications using the NTLM Security Support Provider (SSP)."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "537395200"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa\MSV1_0"
  reg_item                 : "NTLMMinClientSec"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0381 - MSWRK - Ensure 'Accounts: Limit local account use of blank passwords to console logon only' is set to 'Enabled'"
  info                     : "This policy setting determines whether local accounts that are not password protected can be used to log on from locations other than the physical computer console."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
  reg_item                 : "LimitBlankPasswordUse"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : CHECK_ACCOUNT
  description              : "1.0382 - MSWRK - Configure 'Accounts: Rename administrator account'"
  info                     : "This policy setting enables the ability to rename the built-in local administrator account."
  reference                : "NIST 800-53r5|IA-5"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "\b[Aa]dmin(istrator)?"
  account_type             : ADMINISTRATOR_ACCOUNT
  check_type               : CHECK_NOT_REGEX
</custom_item>

<custom_item>
  type                     : CHECK_ACCOUNT
  description              : "1.0383 - MSWRK - Configure 'Accounts: Rename guest account'"
  info                     : "This policy setting enables the ability to rename the built-in local guest account."
  reference                : "NIST 800-53r5|IA-5"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Guest"
  account_type             : GUEST_ACCOUNT
  check_type               : CHECK_NOT_EQUAL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0384 - MSWRK - Ensure 'System objects: Require case insensitivity for non-Windows subsystems' is set to 'Enabled'"
  info                     : "This policy setting determines whether case insensitivity is enforced for all subsystems."
  reference                : "NIST 800-53r5|CM-6b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Session Manager\Kernel"
  reg_item                 : "ObCaseInsensitive"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0385 - MSWRK - Ensure 'System objects: Strengthen default permissions of internal system objects (e.g. Symbolic Links)' is set to 'Enabled'"
  info                     : "This policy setting determines the strength of the default discretionary access control list (DACL) for objects."
  reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Session Manager"
  reg_item                 : "ProtectionMode"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0386 - MSWRK - Ensure 'User Account Control: Admin Approval Mode for the Built-in Administrator account' is set to 'Enabled'"
  info                     : "This policy setting controls the behavior of Admin Approval Mode for the built-in Administrator account."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "FilterAdministratorToken"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0387 - MSWRK - Ensure 'User Account Control: Behavior of the elevation prompt for administrators in Admin Approval Mode' is set to 'Prompt for consent on the secure desktop' or higher"
  info                     : "This policy setting controls the behavior of the elevation prompt for administrators."
  reference                : "NIST 800-53r5|AC-6(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1" || "2"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "ConsentPromptBehaviorAdmin"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0388 - MSWRK - Ensure 'User Account Control: Behavior of the elevation prompt for standard users' is set to 'Automatically deny elevation requests'"
  info                     : "This policy setting controls the behavior of the elevation prompt for standard users."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "ConsentPromptBehaviorUser"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0389 - MSWRK - Ensure 'User Account Control: Detect application installations and prompt for elevation' is set to 'Enabled'"
  info                     : "This policy setting controls the behavior of application installation detection for the computer."
  reference                : "NIST 800-53r5|AC-6(8)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "EnableInstallerDetection"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0390 - MSWRK - Ensure 'User Account Control: Only elevate UIAccess applications that are installed in secure locations' is set to 'Enabled'"
  info                     : "This policy setting controls whether applications that request to run with a User Interface Accessibility (UIAccess) integrity level must reside in a secure location in the file system."
  reference                : "NIST 800-53r5|AC-6(8)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "EnableSecureUIAPaths"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0391 - MSWRK - Ensure 'User Account Control: Run all administrators in Admin Approval Mode' is set to 'Enabled'"
  info                     : "This policy setting controls the behavior of all User Account Control (UAC) policy settings for the computer."
  reference                : "NIST 800-53r5|AC-6(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "EnableLUA"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0392 - MSWRK - Ensure 'User Account Control: Switch to the secure desktop when prompting for elevation' is set to 'Enabled'"
  info                     : "This policy setting controls whether the elevation request prompt is displayed on the interactive user's desktop or the secure desktop."
  reference                : "NIST 800-53r5|AC-6(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "PromptOnSecureDesktop"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0393 - MSWRK - Ensure 'User Account Control: Virtualize file and registry write failures to per-user locations' is set to 'Enabled'"
  info                     : "This policy setting controls whether application write failures are redirected to defined registry and file system locations."
  reference                : "NIST 800-53r5|SC-29(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "EnableVirtualization"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0394 - MSWRK - Ensure 'Audit: Force audit policy subcategory settings (Windows Vista or later) to override audit policy category settings' is set to 'Enabled'"
  info                     : "This policy setting allows administrators to enable the more precise auditing capabilities present in Windows Vista."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
  reg_item                 : "SCENoApplyLegacyAuditPolicy"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0395 - MSWRK - Ensure 'Audit: Shut down system immediately if unable to log security audits' is set to 'Disabled'"
  info                     : "This policy setting determines whether the system shuts down if it is unable to log Security events."
  reference                : "NIST 800-53r5|AU-4"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
  reg_item                 : "CrashOnAuditFail"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0396 - MSWRK - Ensure 'Domain member: Digitally encrypt or sign secure channel data (always)' is set to 'Enabled'"
  info                     : "This policy setting determines whether all secure channel traffic that is initiated by the domain member must be signed or encrypted."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
  reg_item                 : "RequireSignOrSeal"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0397 - MSWRK - Ensure 'Domain member: Digitally encrypt secure channel data (when possible)' is set to 'Enabled'"
  info                     : "This policy setting determines whether a domain member should attempt to negotiate encryption for all secure channel traffic that it initiates."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
  reg_item                 : "SealSecureChannel"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0398 - MSWRK - Ensure 'Domain member: Digitally sign secure channel data (when possible)' is set to 'Enabled'"
  info                     : "This policy setting determines whether a domain member should attempt to negotiate whether all secure channel traffic that it initiates must be digitally signed."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
  reg_item                 : "SignSecureChannel"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0399 - MSWRK - Ensure 'Domain member: Disable machine account password changes' is set to 'Disabled'"
  info                     : "This policy setting determines whether a domain member can periodically change its computer account password."
  reference                : "NIST 800-53r5|AC-2(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
  reg_item                 : "DisablePasswordChange"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0400 - MSWRK - Ensure 'Domain member: Maximum machine account password age' is set to '30 or fewer days, but not 0'"
  info                     : "This policy setting determines the maximum allowable age for a computer account password."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[1..30]"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
  reg_item                 : "MaximumPasswordAge"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0401 - MSWRK - Ensure 'Domain member: Require strong (Windows 2000 or later) session key' is set to 'Enabled'"
  info                     : "When this policy setting is enabled, a secure channel can only be established with Domain Controllers that are capable of encrypting secure channel data with a strong (128-bit) session key."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
  reg_item                 : "RequireStrongKey"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0402 - MSWRK - Ensure 'Interactive logon: Don't display last signed-in' is set to 'Enabled'"
  info                     : "This policy setting determines whether the account name of the last user to log on to the client computers in your organization will be displayed on each computer's respective Windows logon screen."
  reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "DontDisplayLastUserName"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0403 - MSWRK - Ensure 'Interactive logon: Machine inactivity limit' is set to '900 or fewer second(s), but not 0'"
  info                     : "Windows notices inactivity of a logon session, and if the amount of inactive time exceeds the inactivity limit, then the screen saver will run, locking the session."
  reference                : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[1..900]"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "InactivityTimeoutSecs"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : BANNER_CHECK
  description              : "1.0404 - MSWRK - Configure 'Interactive logon: Message text for users attempting to log on'"
  info                     : "This policy setting specifies a text message that is displayed to users when they log on."
  reference                : "NIST 800-53r5|AC-8"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "All activities performed on this system will be monitored."
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "LegalNoticeText"
</custom_item>

<custom_item>
  type                     : BANNER_CHECK
  description              : "1.0405 - MSWRK - Configure 'Interactive logon: Message title for users attempting to log on'"
  info                     : "This policy setting specifies the text displayed in the title bar of the window that is displayed to users when they log on to the system."
  reference                : "NIST 800-53r5|AC-8"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Notice and Consent Banner"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "LegalNoticeCaption"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0406 - MSWRK - Ensure 'Interactive logon: Prompt user to change password before expiration' is set to 'between 5 and 14 days'"
  info                     : "This policy setting determines how far in advance users are warned that their password will expire."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[5..14]"
  reg_key                  : "HKLM\Software\Microsoft\Windows NT\CurrentVersion\Winlogon"
  reg_item                 : "PasswordExpiryWarning"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0407 - MSWRK - Ensure 'Interactive logon: Smart card removal behavior' is set to 'Lock Workstation' or higher"
  info                     : "This policy setting determines what happens when the smart card for a logged-on user is removed from the smart card reader."
  reference                : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "^(1|2|3)$"
  reg_key                  : "HKLM\Software\Microsoft\Windows NT\CurrentVersion\Winlogon"
  reg_item                 : "ScRemoveOption"
  reg_option               : CAN_NOT_BE_NULL
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0408 - MSWRK - Ensure 'Microsoft network client: Digitally sign communications (always)' is set to 'Enabled'"
  info                     : "This policy setting determines whether packet signing is required by the Server Message Block (SMB) client component."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanmanWorkstation\Parameters"
  reg_item                 : "RequireSecuritySignature"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0409 - MSWRK - Ensure 'Microsoft network client: Send unencrypted password to third-party SMB servers' is set to 'Disabled'"
  info                     : "This policy setting determines whether the SMB redirector will send plaintext passwords during authentication to third-party SMB servers that do not support password encryption."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanmanWorkstation\Parameters"
  reg_item                 : "EnablePlainTextPassword"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0410 - MSWRK - Ensure 'Microsoft network server: Amount of idle time required before suspending session' is set to '15 or fewer minute(s)'"
  info                     : "This policy setting allows you to specify the amount of continuous idle time that must pass in an SMB session before the session is suspended because of inactivity."
  reference                : "NIST 800-53r5|AC-11"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[1..15]"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "AutoDisconnect"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0411 - MSWRK - Ensure 'Microsoft network server: Digitally sign communications (always)' is set to 'Enabled'"
  info                     : "This policy setting determines whether packet signing is required by the SMB server component."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "RequireSecuritySignature"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0412 - MSWRK - Ensure 'Microsoft network server: Disconnect clients when logon hours expire' is set to 'Enabled'"
  info                     : "This security setting determines whether to disconnect users who are connected to the local computer outside their user account's valid logon hours."
  reference                : "NIST 800-53r5|AC-2(12)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "EnableForcedLogoff"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0413 - MSWRK - Ensure 'Microsoft network server: Server SPN target name validation level' is set to 'Accept if provided by client' or higher"
  info                     : "This policy setting controls the level of validation a computer with shared folders or printers (the server) performs on the service principal name (SPN) that is provided by the client computer when it establishes a session using the server message block (SMB) protocol."
  reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1" || "2"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "SMBServerNameHardeningLevel"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0414 - MSWRK - Ensure 'Microsoft FTP Service (FTPSVC)' is set to 'Disabled' or 'Not Installed'"
  info                     : "Enables the server to be a File Transfer Protocol (FTP) server."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "4"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\FTPSVC"
  reg_item                 : "Start"
  reg_option               : CAN_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0415 - MSWRK - Ensure 'OpenSSH SSH Server (sshd)' is set to 'Disabled' or 'Not Installed'"
  info                     : "SSH protocol based service to provide secure encrypted communications between two untrusted hosts over an insecure network."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "4"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\sshd"
  reg_item                 : "Start"
  reg_option               : CAN_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0416 - MSWRK - Ensure 'Remote Procedure Call (RPC) Locator (RpcLocator)' is set to 'Disabled'"
  info                     : "In Windows 2003 and older versions of Windows, the Remote Procedure Call (RPC) Locator service manages the RPC name service database."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "4"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\RpcLocator"
  reg_item                 : "Start"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0417 - MSWRK - Ensure 'Routing and Remote Access (RemoteAccess)' is set to 'Disabled'"
  info                     : "Offers routing services to businesses in local area and wide area network environments."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "4"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\RemoteAccess"
  reg_item                 : "Start"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0418 - MSWRK - Ensure 'Simple TCP/IP Services (simptcp)' is set to 'Disabled' or 'Not Installed'"
  info                     : "Supports the following TCP/IP services: Character Generator, Daytime, Discard, Echo, and Quote of the Day."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "4"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\simptcp"
  reg_item                 : "Start"
  reg_option               : CAN_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0419 - MSWRK - Ensure 'Special Administration Console Helper (sacsvr)' is set to 'Disabled' or 'Not Installed'"
  info                     : "This service allows administrators to remotely access a command prompt using Emergency Management Services."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "4"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\sacsvr"
  reg_item                 : "Start"
  reg_option               : CAN_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0420 - MSWRK - Ensure 'Computer Browser (Browser)' is set to 'Disabled' or 'Not Installed'"
  info                     : "Maintains an updated list of computers on the network and supplies this list to computers designated as browsers."
