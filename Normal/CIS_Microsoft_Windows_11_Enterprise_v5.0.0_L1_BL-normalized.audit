  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0159 - MSWRK - Ensure 'Allow search and Cortana to use location' is set to 'Disabled'"
  info                     : "This policy setting specifies whether search and Cortana can provide location aware search and Cortana results."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
