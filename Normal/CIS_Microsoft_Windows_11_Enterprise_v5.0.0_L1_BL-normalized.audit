  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\System"
  reg_item                 : "DontDisplayNetworkSelectionUI"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0279 - MSWRK - Ensure 'Do not enumerate connected users on domain-joined computers' is set to 'Enabled'"
  info                     : "This policy setting prevents connected users from being enumerated on domain-joined computers."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
