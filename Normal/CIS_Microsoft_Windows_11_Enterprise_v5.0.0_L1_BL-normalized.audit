<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0285 - MSWRK - Ensure 'Block NetBIOS-based discovery for domain controller location' is set to 'Enabled'"
  info                     : "This policy setting determines whether the Domain Controller (DC) location algorithm uses NetBIOS-based discovery for the Domain Controller's location."
  reference                : "NIST 800-53r5|CM-6 CM-7"
