<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0078 - MSSRV - (L1) Ensure 'Configure Remote Encryption Protection Mode' is set to 'Enabled: Audit' or higher"
  info                     : "This policy setting configures the Brute-Force Protection feature in Microsoft Defender Antivirus."
  reference                : "NIST 800-53r5|SI-3"
