  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0105 - MSSRV - (L1) Ensure 'Do not delete temp folders upon exit' is set to 'Disabled'"
  info                     : "This policy setting specifies whether Remote Desktop Services retains a user's per-session temporary folders at logoff."
  reference                : "NIST 800-53r5|AU-11 SI-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\Software\Policies\Microsoft\Windows NT\Terminal Services'; $name = 'DeleteTempDirsOnExit'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0106 - MSSRV - (L1) Ensure 'Do not use temporary folders per session' is set to 'Disabled'"
  info                     : "By default, Remote Desktop Services creates a separate temporary folder on the RD Session Host server for each active session that a user maintains on the RD Session Host server."
  reference                : "NIST 800-53r5|AU-11 SI-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
