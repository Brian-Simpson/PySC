<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0278 - MSSRV - (L1) Ensure 'Accounts: Guest account status' is set to 'Disabled' (MS only)"
  info                     : "This policy setting determines whether the Guest account is enabled or disabled."
  reference                : "NIST 800-53r5|IA-5"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
