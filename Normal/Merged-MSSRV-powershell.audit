<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0006 - MSSRV - Ensure 'Relax minimum password length limits' is set to 'Enabled'"
  info                     : "This policy setting determines whether the minimum password length setting can be increased beyond the legacy limit of 14 characters."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$line = net accounts | Where-Object { $_ -match 'Minimum password length' }; if ($line -match '(\d+)$') { if ([int]$matches[1] -gt 14) { '1' } else { '0' } } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0187 - MSSRV - Ensure 'Password Settings: Password Complexity' is set to 'Enabled: Large letters + small letters + numbers + special characters' or 'Passphrase'"
  info                     : "This policy setting configures the Windows LAPS Password Settings policy for password complexity."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "4" || "6" || "7" || "8"
  powershell_args          : "$path = 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS'; $name = 'PasswordComplexity'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

