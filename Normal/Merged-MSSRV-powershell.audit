<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0288 - MSSRV - Ensure 'Network security: LDAP client encryption requirements' is set to 'Negotiate sealing' or higher"
  info                     : "This policy setting determines the level of data encryption that is requested on behalf of clients that issue LDAP BIND requests."
  reference                : "NIST 800-53r5|IA-3(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1" || "2"
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Services\LDAP'; $name = 'LDAPClientConfidentiality'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0311 - MSSRV - Ensure 'Domain controller: LDAP server signing requirements Enforcement' is set to 'Enabled' (DC only)"
  info                     : "This policy setting determines whether the Lightweight Directory Access Protocol (LDAP) server requires LDAP clients to negotiate data signing."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Services\NTDS\Parameters'; $name = 'LDAPServerEnforceIntegrity'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

