<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0206 - MSSRV - Ensure 'Block NetBIOS-based discovery for domain controller location' is set to 'Enabled'"
  info                     : "This policy setting determines whether the Domain Controller (DC) location algorithm uses NetBIOS-based discovery for the Domain Controller's location."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\SOFTWARE\Policies\Microsoft\Netlogon\Parameters'; $name = 'BlockNetbiosDiscovery'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0213 - MSSRV - Ensure 'Configure SAM change password RPC methods policy' is set to 'Enabled: Allow strong encryption change password RPC method only' (DC only)"
  info                     : "This policy setting determines which RPC methods can be used to change passwords stored in the Security Account Manager (SAM)."
  reference                : "NIST 800-53r5|IA-5(1)(c)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "2"
  powershell_args          : "$path = 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System\SAM'; $name = 'SamrChangeUserPasswordApiPolicy'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0241 - MSSRV - Ensure 'Generate security audits' is set to 'LOCAL SERVICE, NETWORK SERVICE, RESTRICTED SERVICES\PrintSpoolerService'"
  info                     : "This policy setting determines which users or processes can generate audit records in the Security log."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "LOCAL SERVICE" && "NETWORK SERVICE" && ("PrintSpoolerService" || "Spooler")
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeAuditPrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0242 - MSSRV - Ensure 'Impersonate a client after authentication' is set to 'Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE, RESTRICTED SERVICES\PrintSpoolerService' (DC only)"
  info                     : "The policy setting allows programs that run on behalf of a user to impersonate that user (or another specified account) so that they can act on behalf of the user."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : ("Administrators" && "Local Service" && "Network Service" && "Service" && ("PrintSpoolerService" || "Spooler")) || ("Administrators" && "IIS_IUSRS" && "Local Service" && "Network Service" && "Service" && ("PrintSpoolerService" || "Spooler"))
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeImpersonatePrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0271 - MSSRV - WINS Server Feature installed"
  value_type               : POLICY_TEXT
  value_data               : ".*Installed.*"
  powershell_args          : "Get-WindowsFeature | Where {$_.Name -eq 'WINS'} | SELECT 'InstallState' | Format-List"
  check_type               : CHECK_REGEX
</custom_item>

