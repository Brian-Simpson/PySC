</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0212 - MSSRV - (L1) Ensure 'Enable Windows NTP Server' is set to 'Disabled' (MS only)"
  info                     : "This policy setting specifies whether the Windows NTP Server is enabled."
  reference                : "NIST 800-53r5|AU-7 AU-8"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
