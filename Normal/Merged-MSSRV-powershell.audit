  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeIncreaseBasePriorityPrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0238 - MSSRV - (L1) Ensure 'Load and unload device drivers' is set to 'Administrators'"
  info                     : "This policy setting allows users to dynamically load a new device driver on a system."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
