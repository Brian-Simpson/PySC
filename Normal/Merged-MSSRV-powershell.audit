<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0164 - MSSRV - Ensure 'Audit client does not support encryption' is set to 'Enabled'"
  info                     : "This policy setting determines whether the Server Message Block (SMB) server will log events when the SMB client doesn't support encryption."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\Software\Policies\Microsoft\Windows\LanmanServer'; $name = 'AuditClientDoesNotSupportEncryption'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

