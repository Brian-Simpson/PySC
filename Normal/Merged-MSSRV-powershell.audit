  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Services\LanmanWorkstation\Parameters'; $name = 'EnablePlainTextPassword'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0323 - MSSRV - (L1) Ensure 'Microsoft network server: Amount of idle time required before suspending session' is set to '15 or fewer minute(s)'"
  info                     : "This policy setting allows you to specify the amount of continuous idle time that must pass in an SMB session before the session is suspended because of inactivity."
  reference                : "NIST 800-53r5|AC-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "[1..15]"
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters'; $name = 'AutoDisconnect'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0324 - MSSRV - (L1) Ensure 'Microsoft network server: Digitally sign communications (always)' is set to 'Enabled'"
  info                     : "This policy setting determines whether packet signing is required by the SMB server component."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters'; $name = 'RequireSecuritySignature'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0325 - MSSRV - (L1) Ensure 'Microsoft network server: Digitally sign communications (if client agrees)' is set to 'Enabled'"
  info                     : "This policy setting determines whether the SMB server will negotiate SMB packet signing with clients that request it."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters'; $name = 'EnableSecuritySignature'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0326 - MSSRV - (L1) Ensure 'Microsoft network server: Disconnect clients when logon hours expire' is set to 'Enabled'"
  info                     : "This security setting determines whether to disconnect users who are connected to the local computer outside their user account's valid logon hours."
  reference                : "NIST 800-53r5|AC-2(12)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters'; $name = 'EnableForcedLogoff'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0327 - MSSRV - (L1) Ensure 'Print Spooler (Spooler)' is set to 'Disabled' (DC only)"
  info                     : "This service spools print jobs and handles interaction with printers."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : 4
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Services\Spooler'; $name = 'Start'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
