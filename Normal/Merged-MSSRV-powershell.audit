  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0195 - MSSRV - (L1) Ensure 'Post-authentication actions: Actions' is set to 'Enabled: Reset the password and logoff the managed account' or higher"
