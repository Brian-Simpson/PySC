  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0079 - MSSRV - (L1) Ensure 'Scan excluded files and directories during quick scans' is set to 'Enabled: 1'"
  info                     : "This policy setting manages whether or not Microsoft Defender Antivirus scans excluded files and directories when running a Quick Scan."
