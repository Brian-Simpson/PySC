  type                     : WMI_POLICY
  description              : "Check if server is Standalone or Member Server"
  value_type               : POLICY_DWORD
  value_data               : 2 || 3
  wmi_namespace            : "root/CIMV2"
  wmi_request              : "select DomainRole from Win32_ComputerSystem"
  wmi_attribute            : "DomainRole"
  wmi_key                  : "DomainRole"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0009 - MSSRV - (L1) Ensure 'Allow Administrator account lockout' is set to 'Enabled' (MS only)"
  info                     : "This policy setting determines whether the built-in Administrator account is subject to the following Account Lockout Policy settings: Account lockout duration , Account lockout threshold , and Reset account lockout counter."
  reference                : "NIST 800-53r5|AC-7 AC-19"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$line = net accounts | Where-Object { $_ -match 'Lockout threshold' }; if ($line -match '(\d+)$') { if ([int]$matches[1] -gt 0) { '1' } else { '0' } } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0139 - MSSRV - (L1) Ensure 'Apply UAC restrictions to local accounts on network logons' is set to 'Enabled' (MS only)"
  info                     : "This setting controls whether local accounts can be used for remote administration via network logon (e."
  reference                : "NIST 800-53r5|AC-2(9)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$path = 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'; $name = 'LocalAccountTokenFilterPolicy'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0188 - MSSRV - (L1) Ensure 'Configure password backup directory' is set to 'Enabled: Active Directory' or 'Enabled: Azure Active Directory'"
  info                     : "This policy setting configures which directory Windows LAPS will use to back up the local admin account password."
  reference                : "NIST 800-53r5|CP-9"
  see_also                 : "See HTH Policies and Standards"
