</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0349 - MSSRV - (L1) Ensure 'Windows Firewall: Public: Logging: Log dropped packets' is set to 'Yes'"
  info                     : "Use this option to log when Windows Firewall with Advanced Security discards an inbound packet for any reason."
