<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0167 - MSSRV - Ensure 'Enable authentication rate limiter' is set to 'Enabled'"
  info                     : "This policy settings configures the Server Message Block (SMB) server authentication rate limiter."
  reference                : "NIST 800-53r5|SC-7(20)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\Software\Policies\Microsoft\Windows\LanmanServer'; $name = 'EnableAuthRateLimiter'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0168 - MSSRV - Ensure 'Enable remote mailslots' is set to 'Disabled'"
  info                     : "This policy settings controls whether the SMB server will use remote mailslots over the computer browser service."
