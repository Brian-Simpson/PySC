  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'; $name = 'SignSecureChannel'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0310 - MSSRV - (L1) Ensure 'Domain member: Disable machine account password changes' is set to 'Disabled'"
  info                     : "This policy setting determines whether a domain member can periodically change its computer account password."
  reference                : "NIST 800-53r5|AC-2(1)"
  see_also                 : "See HTH Policies and Standards"
