</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0161 - MSSRV - (L1) Ensure 'MSS: (ScreenSaverGracePeriod) The time in seconds before the screen saver grace period expires' is set to 'Enabled: 5 or fewer seconds'"
