<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0297 - MSSRV - (L1) Ensure 'User Account Control: Switch to the secure desktop when prompting for elevation' is set to 'Enabled'"
  info                     : "This policy setting controls whether the elevation request prompt is displayed on the interactive user's desktop or the secure desktop."
  reference                : "NIST 800-53r5|AC-6(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'; $name = 'PromptOnSecureDesktop'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
