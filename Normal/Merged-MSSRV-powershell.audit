  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "3" || "5" || "11"
  powershell_args          : "$path = 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS'; $name = 'PostAuthenticationActions'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
