# Merged Audit - MSSRV

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "Windows Server 20(19-25) is installed"
  info                     : "Confirm system is Server 2019-2025"
  reference                : "NIST SP 800-53 CM-6"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "^[a-zA-Z0-9\(\)\s]*2019[\s]*[a-zA-Z0-9\(\)\s:]*$"
  powershell_args          : "$path = 'HKLM:\Software\Microsoft\Windows Nt\Currentversion'; $name = 'ProductName'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : WMI_POLICY
  description              : "Check if server is Domain Controller"
  value_type               : POLICY_DWORD
  value_data               : 4 || 5
  wmi_namespace            : "root/CIMV2"
  wmi_request              : "select DomainRole from Win32_ComputerSystem"
  wmi_attribute            : "DomainRole"
  wmi_key                  : "DomainRole"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0001 - MSSRV - (L1) Ensure 'Enforce password history' is set to '24 or more password(s)'"
  info                     : "This policy setting determines the number of renewed, unique passwords that have to be associated with a user account before you can reuse an old password."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "24"
  powershell_args          : "$line = net accounts | Where-Object { $_ -match 'password history' }; if ($line -match '(\d+)$') { $matches[1] } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0002 - MSSRV - (L1) Ensure 'Maximum password age' is set to '365 or fewer days, but not 0'"
  info                     : "This policy setting defines how long a user can use their password before it expires."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "365"
  powershell_args          : "$line = net accounts | Where-Object { $_ -match 'Maximum password age' }; if ($line -match '(\d+)$') { $matches[1] } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0003 - MSSRV - (L1) Ensure 'Minimum password age' is set to '1 or more day(s)'"
  info                     : "This policy setting determines the number of days that you must use a password before you can change it."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$line = net accounts | Where-Object { $_ -match 'Minimum password age' }; if ($line -match '(\d+)$') { $matches[1] } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0004 - MSSRV - (L1) Ensure 'Minimum password length' is set to '14 or more character(s)'"
  info                     : "This policy setting determines the least number of characters that make up a password for a user account."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "14"
  powershell_args          : "$line = net accounts | Where-Object { $_ -match 'Minimum password length' }; if ($line -match '(\d+)$') { $matches[1] } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0005 - MSSRV - (L1) Ensure 'Password must meet complexity requirements' is set to 'Enabled'"
  info                     : "This policy setting checks all new passwords to ensure that they meet basic requirements for strong passwords."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; (Select-String -Path $tmp -Pattern '^PasswordComplexity\s*=\s*(\d+)').Matches.Groups[1].Value"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0006 - MSSRV - (L1) Ensure 'Store passwords using reversible encryption' is set to 'Disabled'"
  info                     : "This policy setting determines whether the operating system stores passwords in a way that uses reversible encryption, which provides support for application protocols that require knowledge of the user's password for authentication purposes."
  reference                : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; (Select-String -Path $tmp -Pattern '^ClearTextPassword\s*=\s*(\d+)').Matches.Groups[1].Value"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0007 - MSSRV - (L1) Ensure 'Account lockout duration' is set to '15 or more minute(s)'"
  info                     : "This policy setting determines the length of time that must pass before a locked account is unlocked and a user can try to log on again."
  reference                : "NIST 800-53r5|AC-7 AC-19"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "15"
  powershell_args          : "$line = net accounts | Where-Object { $_ -match 'Lockout duration' }; if ($line -match '(\d+)$') { $matches[1] } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0008 - MSSRV - (L1) Ensure 'Account lockout threshold' is set to '5 or fewer invalid logon attempt(s), but not 0'"
  info                     : "This policy setting determines the number of failed logon attempts before the account is locked."
  reference                : "NIST 800-53r5|AC-7 AC-19"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "5"
  powershell_args          : "$line = net accounts | Where-Object { $_ -match 'Lockout threshold' }; if ($line -match '(\d+)$') { $matches[1] } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0009 - MSSRV - (L1) Ensure 'Reset account lockout counter after' is set to '15 or more minute(s)'"
  info                     : "This policy setting determines the length of time before the Account lockout threshold resets to zero."
  reference                : "NIST 800-53r5|AC-7 AC-19"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "15"
  powershell_args          : "$line = net accounts | Where-Object { $_ -match 'Lockout observation window' }; if ($line -match '(\d+)$') { $matches[1] } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0010 - MSSRV - (L1) Ensure 'Audit Credential Validation' is set to 'Success and Failure'"
  info                     : "This subcategory reports the results of validation tests on credentials submitted for a user account logon request."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Success, Failure"
  powershell_args          : "try { $text = (auditpol.exe /get /subcategory:'Credential Validation' 2>$null | Out-String); if ($text -match '(No Auditing|Success and Failure|Success|Failure)') { $matches[1] } else { 'NOT_FOUND' } } catch { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

