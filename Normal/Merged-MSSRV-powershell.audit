  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0170 - MSSRV - Ensure 'Set authentication rate limiter delay (milliseconds)' is set to 'Enabled: 2000' or more"
  info                     : "This policy settings configures the SMB server invalid authentication delay value in milliseconds."
  reference                : "NIST 800-53r5|SC-7(20)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
