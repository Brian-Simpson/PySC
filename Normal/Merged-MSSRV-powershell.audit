</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0223 - MSSRV - (L1) Ensure 'Allow log on through Remote Desktop Services' is set to 'Administrators, Remote Desktop Users' (MS only)"
  info                     : "This policy setting determines which users or groups have the right to log on as a Remote Desktop Services client."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators" && "Remote Desktop Users"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeRemoteInteractiveLogonRight\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0231 - MSSRV - (L1) Ensure 'Create symbolic links' is set to 'Administrators, NT VIRTUAL MACHINE\Virtual Machines' (MS only)"
  info                     : "This policy setting determines which users can create symbolic links."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : ("Administrators" || ("Administrators" && "Virtual Machines") || ("Administrators" && "NT VIRTUAL MACHINE\Virtual Machines"))
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeCreateSymbolicLinkPrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0233 - MSSRV - (L1) Ensure 'Deny access to this computer from the network' to include 'Guests, Local account and member of Administrators group' (MS only)"
  info                     : "This policy setting prohibits users from connecting to a computer from across the network, which would allow users to access and potentially modify data remotely."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Guests" && "Local account and member of Administrators group"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeDenyNetworkLogonRight\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
