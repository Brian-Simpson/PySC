<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0081 - MSSRV - (L1) Ensure 'Scan removable drives' is set to 'Enabled'"
  info                     : "This policy setting manages whether or not to scan for malicious software and unwanted software in the contents of removable drives, such as USB flash drives, when running a full scan."
  reference                : "NIST 800-53r5|MP-7 SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
