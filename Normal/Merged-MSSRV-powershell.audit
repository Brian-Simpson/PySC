</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0160 - MSSRV - (L1) Ensure 'MSS: (SafeDllSearchMode) Enable Safe DLL search mode' is set to 'Enabled'"
