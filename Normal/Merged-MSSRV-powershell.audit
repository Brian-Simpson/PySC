  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0069 - MSSRV - (L1) Ensure 'Turn off Data Execution Prevention for Explorer' is set to 'Disabled'"
  info                     : "Disabling Data Execution Prevention can allow certain legacy plug-in applications to function without terminating Explorer."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
