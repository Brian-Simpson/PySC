  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0311 - MSSRV - (L1) Ensure 'Domain member: Maximum machine account password age' is set to '30 or fewer days, but not 0'"
  info                     : "This policy setting determines the maximum allowable age for a computer account password."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "[1..30]"
