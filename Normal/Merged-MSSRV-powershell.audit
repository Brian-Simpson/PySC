  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0239 - MSSRV - (L1) Ensure 'Lock pages in memory' is set to 'No One'"
  info                     : "This policy setting allows a process to keep data in physical memory, which prevents the system from paging the data to virtual memory on disk."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : ""
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeLockMemoryPrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0240 - MSSRV - (L1) Ensure 'Manage auditing and security log' is set to 'Administrators' (DC only)"
  info                     : "This policy setting determines which users can change the auditing options for files and directories and clear the Security log."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
