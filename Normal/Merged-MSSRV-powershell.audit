<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0188 - MSSRV - Ensure 'Allow Custom SSPs and APs to be loaded into LSASS' is set to 'Disabled' (DC only)"
  info                     : "This policy setting controls the configuration under which the Local Security Authority Subsystem Service (LSASS) will load custom Security Support Provider/Authentication Package (SSP/AP)."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$path = 'HKLM:\Software\Policies\Microsoft\Windows\System'; $name = 'AllowCustomSSPsAPs'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
