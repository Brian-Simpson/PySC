</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0104 - MSSRV - (L1) Ensure 'Do not allow passwords to be saved' is set to 'Enabled'"
  info                     : "This policy setting helps prevent Remote Desktop clients from saving passwords on a computer."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
