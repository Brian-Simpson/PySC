<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0068 - MSSRV - (L1) Ensure 'Do not apply the Mark of the Web tag to files copied from insecure sources' is set to 'Disabled'"
  info                     : "This policy setting determines whether files that are sourced from insecure locations are tagged with Mark of the Web (MOTW)."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
