<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0044 - MSSRV - (L1) Ensure 'Turn off cloud consumer account state content' is set to 'Enabled'"
  info                     : "This policy setting determines whether cloud consumer account state content is allowed in all Windows experiences."
  reference                : "NIST 800-53r5|AC-2(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\Software\Policies\Microsoft\Windows\CloudContent'; $name = 'DisableConsumerAccountStateContent'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

