  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0164 - MSSRV - Ensure 'Mandate the minimum version of SMB' is set to 'Enabled: 3.1.1'"
  info                     : "This policy settings controls the minimum version of Server Message Block (SMB) protocol that can be used on the system."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "785"
  powershell_args          : "$path = 'HKLM:\Software\Policies\Microsoft\Windows\LanmanServer'; $name = 'MinSmb2Dialect'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0166 - MSSRV - Ensure 'Require Encryption' is set to 'Enabled'"
  info                     : "This policy setting controls whether the SMB client will require encryption."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\Software\Policies\Microsoft\Windows\LanmanWorkstation'; $name = 'RequireEncryption'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0180 - MSSRV - Ensure 'Enable / disable CLFS logfile authentication' is set to 'Enabled'"
  info                     : "This policy setting configures Common Log File System (CLFS) logfile authentication."
  reference                : "NIST 800-53r5|AU-9(3)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Policies'; $name = 'ClfsAuthenticationChecking'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
