  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0300 - MSSRV - (L1) Ensure 'Audit: Shut down system immediately if unable to log security audits' is set to 'Disabled'"
