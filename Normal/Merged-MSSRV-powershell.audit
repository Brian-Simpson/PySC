  powershell_args          : "$path = 'HKLM:\Software\Policies\Microsoft\WindowsFirewall\PublicProfile\Logging'; $name = 'LogFileSize'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
