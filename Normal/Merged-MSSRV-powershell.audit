  powershell_args          : "(Get-LocalUser | Where-Object {$_.SID.Value -match '-501$'}).Enabled"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0320 - MSSRV - (L1) Ensure 'Interactive logon: Require Domain Controller Authentication to unlock workstation' is set to 'Enabled' (MS only)"
  info                     : "Logon information is required to unlock a locked computer."
  reference                : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon'; $name = 'ForceUnlockLogon'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0329 - MSSRV - (L1) Ensure 'Microsoft network server: Server SPN target name validation level' is set to 'Accept if provided by client' or higher (MS only)"
  info                     : "This policy setting controls the level of validation a computer with shared folders or printers (the server) performs on the service principal name (SPN) that is provided by the client computer when it establishes a session using the server message block (SMB) protocol."
  reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1" || "2"
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters'; $name = 'SMBServerNameHardeningLevel'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "Windows Server 2022 is installed"
  info                     : 
  reference                : 
  see_also                 : 
  value_type               : POLICY_TEXT
  value_data               : "^[a-zA-Z0-9\(\)\s]*2022[\s]*[a-zA-Z0-9\(\)\s:]*$"
  powershell_args          : "$path = 'HKLM:\Software\Microsoft\Windows Nt\Currentversion'; $name = 'ProductName'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0038 - MSSRV - Ensure 'Audit Sensitive Privilege Use' is set to 'Success'"
  info                     : "This subcategory reports when a user account or service uses a sensitive privilege."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Success" || "Success, Failure"
  powershell_args          : "try { $text = (auditpol.exe /get /subcategory:'Sensitive Privilege Use' 2>$null | Out-String); if ($text -match '(No Auditing|Success and Failure|Success|Failure)') { $matches[1] } else { 'NOT_FOUND' } } catch { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0054 - MSSRV - Ensure 'Enable App Installer Microsoft Store Source Certificate Validation Bypass' is set to 'Disabled'"
  info                     : "This policy setting controls whether Windows Package Manager validates the Microsoft Store certificate hash to match a known Microsoft Store certificate when it initiates a connection to the Microsoft Store source."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$path = 'HKLM:\Software\Policies\Microsoft\Windows\AppInstaller'; $name = 'EnableBypassCertificatePinningForMicrosoftStore'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0083 - MSSRV - Ensure 'Join Microsoft MAPS' is set to 'Enabled: Advanced'"
