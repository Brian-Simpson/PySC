<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0209 - MSSRV - (L1) Ensure 'Turn off toast notifications on the lock screen' is set to 'Enabled'"
  info                     : "This policy setting turns off toast notifications on the lock screen."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$matches = Get-ChildItem Registry::HKEY_USERS | Where-Object { $_.PSChildName -like 'S-1-5-21-*' }; if (-not $matches) { 'NO_MATCHING_SIDS' } else { $results = $matches | ForEach-Object { $path = Join-Path $_.PSPath 'Software\Policies\Microsoft\Windows\CurrentVersion\PushNotifications'; if (Test-Path $path) { try { Get-ItemPropertyValue -Path $path -Name 'NoToastApplicationNotificationOnLockScreen' -ErrorAction Stop } catch {} } }; if ($results) { $results | Select-Object -First 1 } else { 'VALUE_NOT_FOUND_IN_ANY_PROFILE' } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0210 - MSSRV - (L1) Ensure 'Prevent users from sharing files within their profile.' is set to 'Enabled'"
  info                     : "This policy setting determines whether users can share files within their profile."
