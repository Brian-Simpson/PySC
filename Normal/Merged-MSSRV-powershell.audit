  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0071 - MSSRV - (L1) Ensure 'Turn off shell protocol protected mode' is set to 'Disabled'"
  info                     : "This policy setting allows you to configure the amount of functionality that the shell protocol can have."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
