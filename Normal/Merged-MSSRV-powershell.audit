  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0199 - MSSRV - (L1) Ensure 'Enumerate local users on domain-joined computers' is set to 'Disabled' (MS only)"
  info                     : "This policy setting allows local users to be enumerated on domain-joined computers."
  reference                : "NIST 800-53r5|AC-6(10)"
