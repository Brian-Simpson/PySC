<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0281 - MSSRV - (L1) Ensure 'Network security: Force logoff when logon hours expire' is set to 'Enabled'"
  info                     : "This policy setting determines whether to disconnect users who are connected to the local computer outside their user account's valid logon hours."
  reference                : "NIST 800-53r5|AC-2(12)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Never"
  powershell_args          : "$line = net accounts | Where-Object { $_ -match 'Force user logoff' }; if ($line -match ':\s*(.+)$') { $matches[1].Trim() } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
