<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0244 - MSSRV - (L1) Ensure 'Perform volume maintenance tasks' is set to 'Administrators'"
  info                     : "This policy setting allows users to manage the system's volume or disk configuration, which could allow a user to delete a volume and cause data loss as well as a denial-of-service condition."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeManageVolumePrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0245 - MSSRV - (L1) Ensure 'Profile single process' is set to 'Administrators'"
  info                     : "This policy setting determines which users can use tools to monitor the performance of non-system processes."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeProfileSingleProcessPrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0246 - MSSRV - (L1) Ensure 'Profile system performance' is set to 'Administrators, NT SERVICE\WdiServiceHost'"
  info                     : "This policy setting allows users to use tools to view the performance of different system processes, which could be abused to allow attackers to determine a system's active processes and provide insight into the potential attack surface of the computer."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators" && ("NT SERVICE\WdiServiceHost" || "WdiServiceHost")
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeSystemProfilePrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0247 - MSSRV - (L1) Ensure 'Replace a process level token' is set to 'LOCAL SERVICE, NETWORK SERVICE'"
  info                     : "This policy setting allows one process or service to start another service or process with a different security access token, which can be used to modify the security access token of that sub-process and result in the escalation of privileges."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "LOCAL SERVICE" && "NETWORK SERVICE"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeAssignPrimaryTokenPrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0248 - MSSRV - (L1) Ensure 'Restore files and directories' is set to 'Administrators'"
  info                     : "This policy setting determines which users can bypass file, directory, registry, and other persistent object permissions when restoring backed up files and directories on computers that run Windows Vista (or newer) in your environment."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeRestorePrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0249 - MSSRV - (L1) Ensure 'Shut down the system' is set to 'Administrators'"
  info                     : "This policy setting determines which users who are logged on locally to the computers in your environment can shut down the operating system with the Shut Down command."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeShutdownPrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0250 - MSSRV - (L1) Ensure 'Synchronize directory service data' is set to 'No One' (DC only)"
  info                     : "This security setting determines which users and groups have the authority to synchronize all directory service data."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : ""
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeSyncAgentPrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0251 - MSSRV - (L1) Ensure 'Take ownership of files or other objects' is set to 'Administrators'"
  info                     : "This policy setting allows users to take ownership of files, folders, registry keys, processes, or threads."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeTakeOwnershipPrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0252 - MSSRV - (L1) Ensure 'Add workstations to domain' is set to 'Administrators' (DC only)"
  info                     : "This policy setting specifies which users can add computer workstations to the domain."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeMachineAccountPrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0253 - MSSRV - (L1) Ensure 'Adjust memory quotas for a process' is set to 'Administrators, LOCAL SERVICE, NETWORK SERVICE'"
  info                     : "This policy setting allows a user to adjust the maximum amount of memory that is available to a process."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators" && "LOCAL SERVICE" && "NETWORK SERVICE"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeIncreaseQuotaPrivilege\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0254 - MSSRV - (L1) Ensure 'Allow log on locally' is set to 'Administrators, ENTERPRISE DOMAIN CONTROLLERS' (DC only)"
  info                     : "This policy setting determines which users can interactively log on to computers in your environment."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators" && "ENTERPRISE DOMAIN CONTROLLERS"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeInteractiveLogonRight\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0255 - MSSRV - (L1) Ensure 'Allow log on through Remote Desktop Services' is set to 'Administrators' (DC only)"
  info                     : "This policy setting determines which users or groups have the right to log on as a Remote Desktop Services client."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators"
  powershell_args          : "$tmp = Join-Path $env:TEMP 'secpol.inf'; secedit.exe /export /cfg $tmp 2>$null | Out-Null; if (Test-Path $tmp) { (Select-String -Path $tmp -Pattern '^SeRemoteInteractiveLogonRight\s*=').Line } else { 'NOT_FOUND' }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0256 - MSSRV - (L1) Ensure 'Network access: Allow anonymous SID/Name translation' is set to 'Disabled'"
  info                     : "This policy setting determines whether an anonymous user can request security identifier (SID) attributes for another user, or use a SID to obtain its corresponding user name."
  reference                : "NIST 800-53r5|AC-6(10) IA-2(2)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Disabled"
  powershell_args          : "(Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Lsa').TurnOffAnonymousBlock"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0257 - MSSRV - (L1) Ensure 'Network access: Restrict anonymous access to Named Pipes and Shares' is set to 'Enabled'"
  info                     : "When enabled, this policy setting restricts anonymous access to only those shares and pipes that are named in the Network access: Named pipes that can be accessed anonymously and Network access: Shares that can be accessed anonymously settings."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters'; $name = 'RestrictNullSessAccess'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0258 - MSSRV - (L1) Ensure 'Network access: Shares that can be accessed anonymously' is set to 'None'"
  info                     : "This policy setting determines which network shares can be accessed by anonymous users."
  reference                : "NIST 800-53r5|AC-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : ""
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters'; $name = 'NullSessionShares'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0259 - MSSRV - (L1) Ensure 'Network access: Sharing and security model for local accounts' is set to 'Classic - local users authenticate as themselves'"
  info                     : "This policy setting determines how network logons that use local accounts are authenticated."
  reference                : "NIST 800-53r5|CM-6b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Control\Lsa'; $name = 'ForceGuest'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0260 - MSSRV - (L1) Ensure 'Network access: Let Everyone permissions apply to anonymous users' is set to 'Disabled'"
  info                     : "This policy setting determines what additional permissions are assigned for anonymous connections to the computer."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Control\Lsa'; $name = 'EveryoneIncludesAnonymous'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0261 - MSSRV - (L1) Ensure 'Network access: Named Pipes that can be accessed anonymously' is configured (DC only)"
  info                     : "This policy setting determines which communication sessions, or pipes, will have attributes and permissions that allow anonymous access."
  reference                : "NIST 800-53r5|IA-2(2)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : ("LSARPC" && "NETLOGON" && "SAMR" && "Browser") || ("LSARPC" && "NETLOGON" && "SAMR")
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters'; $name = 'NullSessionPipes'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0262 - MSSRV - (L1) Ensure 'Network access: Remotely accessible registry paths' is configured"
  info                     : "This policy setting determines which registry paths will be accessible over the network, regardless of the users or groups listed in the access control list (ACL) of the winreg registry key."
  reference                : "NIST 800-53r5|AC-6(7)(b)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "System\CurrentControlSet\Control\ProductOptions" && "System\CurrentControlSet\Control\Server Applications" && "Software\Microsoft\Windows NT\CurrentVersion"
  powershell_args          : "$path = 'HKLM:\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedExactPaths'; $name = 'Machine'; if (-not (Test-Path $path)) { 'PATH_NOT_FOUND: ' + $path } else { try { $props = Get-ItemProperty -Path $path -ErrorAction Stop; if ($name -in $props.PSObject.Properties.Name) { $props.$name } else { 'VALUE_NOT_FOUND: ' + $name } } catch { 'ERROR: ' + $_.Exception.Message } }"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0263 - MSSRV - WINS Server Feature installed"
  value_type               : POLICY_TEXT
  value_data               : ".*Installed.*"
  powershell_args          : "Get-WindowsFeature | Where {$_.Name -eq 'WINS'} | SELECT 'InstallState' | Format-List"
  check_type               : CHECK_REGEX
</custom_item>

