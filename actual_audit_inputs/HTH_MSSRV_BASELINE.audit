#########################################################################################################################################
########################################################## HTH_SERVER_BASELINE ##########################################################
#########################################################################################################################################

<check_type:"Windows" version:"2">
<group_policy:"HTH Windows Server Baseline">

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "Network Information"
  info            : "This obtains relevent hosted view network information that may be used for additional evaluation."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53r5|"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : ".*"
  powershell_args : "$__pysc_result = (& { Get-NetIPConfiguration -Detailed ;(Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.2\Server'); } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "System/Domain Identification"
  info            : "This obtains specific user and system information that may be used for additional evaluation."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53r5|"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : ".*"
  powershell_args : "$__pysc_result = (& { (Get-ComputerInfo) |Select-Object OSDisplayVersion, CsManufacturer, CsModel, BiosBIOSVersion, BiosSeralNumber, CsUserName, OsName, OsBuildNumber, OsProductType, CsDNSHostName, CsDomain; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

#########################################################################################################################################
############################################################# All SERVERS #############################################################
#########################################################################################################################################

<if>
  <condition type:"AND">
    <custom_item>
      type        : REGISTRY_SETTING
      description : "Windows Server is installed"
      value_type  : POLICY_TEXT
      value_data  : "^[Ww][Ii][Nn][Dd][Oo][Ww][Ss].+[Ss][Ee][Rr][Vv][Ee][Rr].+$"
      reg_key     : "HKLM\Software\Microsoft\Windows Nt\Currentversion"
      reg_item    : "ProductName"
      check_type  : CHECK_REGEX
    </custom_item>
  </condition>    
 
  <then>
    <report type:"PASSED">
      description : "PASSED - TARGET OS MATCHES BASELINE - WINSRV"
      see_also    : "Link to Controls"
    </report>


<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0000 - MSSRV - Access Credential Manager as a trusted caller is set to No One"
  info            : "This security setting is used by Credential Manager during Backup and Restore."
  solution        : "To establish the recommended configuration via GP, set the following UI path to No One :"
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "^NO_MEMBERS$"
  powershell_args : "$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match '^\s*SeTrustedCredManAccessPrivilege\s*=' } | Select-Object -Last 1); $m=if($l){ ($l -replace '.*=', '').Split(',') | ForEach-Object { $s=$_.Trim(); $s=$s -replace '^\*', ''; if($s -match '^S-1-5-'){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]}catch{$s} } else { if($s -match '\\'){ $s.Split('\\')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join ',' } else { 'NO_MEMBERS' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0001 - MSSRV - Act as part of the operating system is set to No One"
  info            : "This policy setting allows a process to assume the identity of any user and thus gain access to the resources that the user is authorized to access."
  solution        : "To establish the recommended configuration via GP, set the following UI path to No One :"
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "^NO_MEMBERS$"
  powershell_args : "$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match '^\s*SeTcbPrivilege\s*=' } | Select-Object -Last 1); $m=if($l){ ($l -replace '.*=', '').Split(',') | ForEach-Object { $s=$_.Trim(); $s=$s -replace '^\*', ''; if($s -match '^S-1-5-'){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]}catch{$s} } else { if($s -match '\\'){ $s.Split('\\')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join ',' } else { 'NO_MEMBERS' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0002 - MSSRV - Adjust memory quotas for a process is set to Administrators, LOCAL SERVICE, NETWORK SERVICE"
  info            : "This policy setting allows a user to adjust the maximum amount of memory that is available to a process."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Administrators, LOCAL SERVICE, NETWORK SERVICE :"
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "(?s)^(?:(?=.*Administrators)(?=.*LOCAL\ SERVICE)(?=.*NETWORK\ SERVICE).*|'?NO_MEMBERS'?)$"
  powershell_args : "$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match '^\s*SeIncreaseQuotaPrivilege\s*=' } | Select-Object -Last 1); $m=if($l){ ($l -replace '.*=', '').Split(',') | ForEach-Object { $s=$_.Trim(); $s=$s -replace '^\*', ''; if($s -match '^S-1-5-'){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]}catch{$s} } else { if($s -match '\\'){ $s.Split('\\')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join ',' } else { 'NO_MEMBERS' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_SUPERSET
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0003 - MSSRV - Back up files and directories is configured correctly"
  info            : "This policy setting allows users to circumvent file and directory permissions to back up the system."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Administrators"
