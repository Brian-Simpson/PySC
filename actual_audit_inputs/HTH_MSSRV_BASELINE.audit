  check_type      : CHECK_NOT_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0113 - MSSRV - Accounts: Limit local account use of blank passwords to console logon only is set to Enabled"
