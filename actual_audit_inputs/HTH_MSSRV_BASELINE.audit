  powershell_args : "$__pysc_result = (& { if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\WindowsUpdate'){Write-Output 'Path Exists'} else {Write-Output '__NON_COMPLIANT__'};$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\WindowsUpdate').DeferFeatureUpdatesPeriodInDays;if($noutput -eq $Null) {Write-Output 'KEY Not Found'} else {$noutput} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
