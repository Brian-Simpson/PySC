#   description     : "1.0172 - MSSRV - (L1) Ensure Configure real-time protection and Security Intelligence Updates during OOBE is set to Enabled"
#   info            : "This policy setting configures whether Real-time Protection and Security Intelligence Updates are enabled during the Out of Box experience (OOBE)."
#   solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled :"
#   reference       : "NIST 800-53r5|SI-3"
#   see_also        : "See HTH Policies and Standards"
#   value_type      : POLICY_TEXT
#   value_data      : "1"
