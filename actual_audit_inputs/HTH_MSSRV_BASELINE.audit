<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0132 - MSSRV - Enable Structured Exception Handling Overwrite Protection (SEHOP) is set to Enabled"
  info            : "Windows includes support for Structured Exception Handling Overwrite Protection (SEHOP)."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled :"
  reference       : "NIST 800-53r5|SI-16"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "0"
  powershell_args : "$__pysc_result = (& { if(Test-Path -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\kernel'){$noutput = (Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\kernel').DisableExceptionChainValidation;if($noutput -eq $Null) {Write-Output '__NON_COMPLIANT__'} else {$noutput}}else {Write-Output '__NON_COMPLIANT__'} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0133 - MSSRV - Ensure Notify antivirus programs when opening attachments is set to Enabled'"
  info            : "This policy setting manages the behavior for notifying registered antivirus programs."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled :"
  reference       : "NIST 800-53r5|SI-3"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "3"
  powershell_args : "$__pysc_result = (& { $noutput = (Get-ItemProperty 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Policies\Attachments').ScanWithAntiVirus; if ($noutput -eq $Null) {Write-Output 'Service Not Found'} else {$noutput} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_EQUAL
</custom_item>

