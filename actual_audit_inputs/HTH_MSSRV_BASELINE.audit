<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0126 - MSSRV - MSS: (DisableIPSourceRouting) IP source routing protection level is set to Enabled: Highest protection, source routing is completely disabled"
  info            : "IP source routing is a mechanism that allows the sender to determine the IP route that a datagram should take through the network."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled: Highest protection, source routing is completely disabled :"
  reference       : "NIST 800-53r5|SC-7(12)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "2"
  powershell_args : "$__pysc_result = (& { if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Tcpip\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Tcpip\Parameters').DisableIPSourceRouting;if($noutput -eq $Null) {Write-Output '__NON_COMPLIANT__'} else {$noutput}}else {Write-Output '__NON_COMPLIANT__'} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0127 - MSSRV - Services - Windows Firewall is enabled"
  info            : "This policy setting determines if the Windows Firewall service is automatically started during startup."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53|CM-6"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "Running"
  powershell_args : "$__pysc_result = (& { $noutput = (get-wmiobject win32_service | where-object {$_.name -eq 'MpsSvc' -and $_.state -eq 'Running'}).state; if ($noutput -eq $Null) {Write-Output 'Service Not Found'} else {$noutput} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_EQUAL
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0128 - MSSRV - User Account Control: Virtualize file and registry write failures to per-user locations is set to Enabled"
  info            : "This policy setting controls whether application write failures are redirected to defined registry and file system locations."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled :"
  reference       : "NIST 800-53r5|SC-29(1)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "1"
  powershell_args : "$__pysc_result = (& { if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').EnableVirtualization; if($noutput -eq $Null) {Write-Output '__NON_COMPLIANT__'} else {$noutput}} else {Write-Output '__NON_COMPLIANT__'} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0129 - MSSRV - Windows Firewall: Domain: Logging: Size limit (KB) is set to 16,384 KB or greater"
  info            : "Use this option to specify the size limit of the file in which Windows Firewall will write its log information."
  solution        : "To establish the recommended configuration via GP, set the following UI path to 16,384 KB or greater :"
  reference       : "NIST 800-53r5|SC-7 SC-7(5)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "^(?:16384|16385|16386|16387|16388|16389|1639\d{1}|164\d{2}|165\d{2}|166\d{2}|167\d{2}|168\d{2}|169\d{2}|17\d{3}|18\d{3}|19\d{3}|2\d{4}|3\d{4}|4\d{4}|5\d{4}|6\d{4}|7\d{4}|8\d{4}|9\d{4}|[1-9]\d{5,})$"
  powershell_args : "$__pysc_result = (& { if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\WindowsFirewall\DomainProfile\Logging'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\WindowsFirewall\DomainProfile\Logging').LogFileSize; if($noutput -eq $Null) {Write-Output '__NON_COMPLIANT__'} else {$noutput}} else {Write-Output '__NON_COMPLIANT__'} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

