<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0077 - MSSRV - Audit: Force audit policy subcategory settings (Windows Vista or later) to override audit policy category settings is set to Enabled"
  info            : "This policy setting allows administrators to enable the more precise auditing capabilities present in Windows Vista."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled :"
  reference       : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "1"
  powershell_args : "$__pysc_result = (& { if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\LSA').SCENoApplyLegacyAuditPolicy; if($noutput -eq $Null) {Write-Output '__NON_COMPLIANT__'} else {$noutput}} else {Write-Output '__NON_COMPLIANT__'} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0078 - MSSRV - Audit: Shut down system immediately if unable to log security audits is set to Disabled"
