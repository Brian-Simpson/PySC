#########################################################################################################################################
########################################################### MEMBER SERVER ####################################################################
#########################################################################################################################################

<if>
  <condition type:"AND">
<custom_item>
  type          : WMI_POLICY
  description   : "Check if server is Member Server"
  value_type    : POLICY_DWORD
  value_data    : 2 || 3
  wmi_namespace : "root/CIMV2"
  wmi_request   : "select DomainRole from Win32_ComputerSystem"
  wmi_attribute : "DomainRole"
  wmi_key       : "DomainRole"
</custom_item>
  </condition>

  <then>
<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0366 - MSSRV - Allow log on through Remote Desktop Services is set to Administrators, Remote Desktop Users (MS only)"
  info            : "This policy setting determines which users or groups have the right to log on as a Remote Desktop Services client."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "^(?:Administrators,Remote Desktop Users|'?NO_MEMBERS'?)$"
  powershell_args : "$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match '^\s*SeRemoteInteractiveLogonRight\s*=' } | Select-Object -Last 1); $m=if($l){ ($l -replace '.*=', '').Split(',') | ForEach-Object { $s=$_.Trim(); $s=$s -replace '^\*', ''; if($s -match '^S-1-5-'){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]}catch{$s} } else { if($s -match '\\'){ $s.Split('\\')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join ',' } else { 'NO_MEMBERS' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0367 - MSSRV - Create symbolic links is set to Administrators, NT VIRTUAL MACHINE\Virtual Machines (MS only)"
  info            : "This policy setting determines which users can create symbolic links."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "^(?:Administrators(,Virtual Machines)?|'?NO_MEMBERS'?)$"
  powershell_args : "$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match '^\s*SeCreateSymbolicLinkPrivilege\s*=' } | Select-Object -Last 1); $m=if($l){ ($l -replace '.*=', '').Split(',') | ForEach-Object { $s=$_.Trim(); $s=$s -replace '^\*', ''; if($s -match '^S-1-5-'){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]}catch{$s} } else { if($s -match '\\'){ $s.Split('\\')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join ',' } else { 'NO_MEMBERS' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0368 - MSSRV - Enable computer and user accounts to be trusted for delegation is set to No One (MS only)"
  info            : "This policy setting allows users to change the Trusted for Delegation setting on a computer object in Active Directory."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "^NO_MEMBERS$"
  powershell_args : "$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match '^\s*SeEnableDelegationPrivilege\s*=' } | Select-Object -Last 1); $m=if($l){ ($l -replace '.*=', '').Split(',') | ForEach-Object { $s=$_.Trim(); $s=$s -replace '^\*', ''; if($s -match '^S-1-5-'){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]}catch{$s} } else { if($s -match '\\'){ $s.Split('\\')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join ',' } else { 'NO_MEMBERS' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0369 - MSSRV - Impersonate a client after authentication is set to Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE and (when the Web Server (IIS) Role with Web Services Role Service is installed) IIS_IUSRS (MS only)"
  info            : "The policy setting allows programs that run on behalf of a user to impersonate that user (or another specified account) so that they can act on behalf of the user."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "^(?:(?:Administrators,Local Service,Network Service,Service|Administrators,IIS_IUSRS,Local Service,Network Service,Service)|'?NO_MEMBERS'?)$"
  powershell_args : "$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match '^\s*SeImpersonatePrivilege\s*=' } | Select-Object -Last 1); $m=if($l){ ($l -replace '.*=', '').Split(',') | ForEach-Object { $s=$_.Trim(); $s=$s -replace '^\*', ''; if($s -match '^S-1-5-'){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]}catch{$s} } else { if($s -match '\\'){ $s.Split('\\')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join ',' } else { 'NO_MEMBERS' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0370 - MSSRV - Manage auditing and security log is set to Administrators (MS only)"
  info            : "This policy setting determines which users can change the auditing options for files and directories and clear the Security log."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "(?s)^(?:Administrators|'?NO_MEMBERS'?)$"
  powershell_args : "$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match '^\s*SeSecurityPrivilege\s*=' } | Select-Object -Last 1); $m=if($l){ ($l -replace '.*=', '').Split(',') | ForEach-Object { $s=$_.Trim(); $s=$s -replace '^\*', ''; if($s -match '^S-1-5-'){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]}catch{$s} } else { if($s -match '\\'){ $s.Split('\\')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join ',' } else { 'NO_MEMBERS' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0371 - MSSRV - Network access: Do not allow anonymous enumeration of SAM accounts is set to Enabled (MS only)"
  info            : "This policy setting controls the ability of anonymous users to enumerate the accounts in the Security Accounts Manager (SAM)."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled :"
  reference       : "NIST 800-53r5|AC-6(10)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "1"
  powershell_args : "$__pysc_result = (& { if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Lsa').RestrictAnonymousSAM;if($noutput -eq $Null) {Write-Output '__NON_COMPLIANT__'} else {$noutput}}else {Write-Output '__NON_COMPLIANT__'} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0372 - MSSRV - Accounts: Guest account status is configured correctly.(MS only)"
  info            : "This policy setting determines whether the Guest account is enabled or disabled."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Disabled :"
  reference       : "NIST 800-53r5|IA-5"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "Disabled"
  powershell_args : "$__pysc_result = (& { $A = Get-CimInstance -ClassName Win32_UserAccount -EA SilentlyContinue | Where-Object { $_.SID -match '-501$' } | Select-Object -First 1; if($A -and $A.Disabled -ne $null){ if($A.Disabled){ Write-Output 'Disabled' } else { Write-Output 'Enabled' } } elseif($A -and -not [string]::IsNullOrEmpty($A.Name)){ Write-Output $A.Name } else { Write-Output '__NON_COMPLIANT__' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

 <custom_item>
   type            : AUDIT_POWERSHELL
   description     : "1.0373 - MSSRV - (L1) Ensure Allow Administrator account lockout is set to Enabled (MS only)"
   info            : "This policy setting determines whether the built-in Administrator account is subject to the following Account Lockout Policy settings: Account lockout duration , Account lockout threshold , and Reset account lockout counter."
   solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled :"
   reference       : "NIST 800-53r5|AC-7 AC-19"
   see_also        : "See HTH Policies and Standards"
   value_type      : POLICY_TEXT
   value_data      : "(?i)^Enabled$"
   powershell_args : "$__pysc_result = (& { $secfile = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $secfile /areas SECURITYPOLICY /quiet | Out-Null; $line = Select-String -Path $secfile -Pattern 'AllowAdministratorLockout\s*=\s*(\d)' | Select-Object -First 1; Remove-Item $secfile -ErrorAction SilentlyContinue; if($line -and $line.Matches.Count -gt 0){ if($line.Matches[0].Groups[1].Value -eq '1'){ Write-Output 'Enabled' } else { Write-Output 'Disabled' } } else { Write-Output '__NON_COMPLIANT__' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
   check_type      : CHECK_REGEX
 </custom_item>

