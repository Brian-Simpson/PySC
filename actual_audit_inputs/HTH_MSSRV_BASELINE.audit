<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0058 - MSSRV - Audit Account Lockout is set to include Failure"
  info            : "This subcategory reports when a user s account is locked out as a result of too many failed logon attempts."
  solution        : "To establish the recommended configuration via GP, set the following UI path to include Failure :"
  reference       : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "(?s)^(?:Failure|Success\ and\ Failure)$"
  powershell_args : "$__pysc_result = (& { $rows = auditpol /get /Subcategory:'Account Lockout' /r 2>$null | ConvertFrom-Csv; $row = if($rows){ $rows | Where-Object { $_.Subcategory -eq 'Account Lockout' } | Select-Object -First 1 } else { $null }; $inc = if($row){ [string]$row.'Inclusion Setting' } else { '' }; if(-not [string]::IsNullOrWhiteSpace($inc)){ Write-Output $inc.Trim(); return }; $AP = auditpol /get /Subcategory:'Account Lockout' 2>$null | ForEach-Object { $_.ToString() }; $line = $AP | Where-Object { $_ -match '^\s*Account\ Lockout\s{2,}' } | Select-Object -First 1; if(-not $line){ Write-Output 'Not Found'; return }; if($line -match 'Success and Failure'){ Write-Output 'Success and Failure'; return }; if($line -match 'No Auditing'){ Write-Output 'No Auditing'; return }; if($line -match 'Success'){ Write-Output 'Success'; return }; if($line -match 'Failure'){ Write-Output 'Failure'; return }; Write-Output $line; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

