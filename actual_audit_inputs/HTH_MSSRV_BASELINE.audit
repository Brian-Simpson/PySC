<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0019 - MSSRV - Force shutdown from a remote system is set to Administrators"
  info            : "This policy setting allows users to shut down Windows Vista-based or newer computers from remote locations on the network."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Administrators :"
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "(?s)^(?:Administrators|'?NO_MEMBERS'?)$"
  powershell_args : "$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match '^\s*SeRemoteShutdownPrivilege\s*=' } | Select-Object -Last 1); $m=if($l){ ($l -replace '.*=', '').Split(',') | ForEach-Object { $s=$_.Trim(); $s=$s -replace '^\*', ''; if($s -match '^S-1-5-'){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]}catch{$s} } else { if($s -match '\\'){ $s.Split('\\')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join ',' } else { 'NO_MEMBERS' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

