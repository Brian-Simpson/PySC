<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0033 - MSSRV - Network access - Remotely accessible registry paths and sub-paths Allowed Exact Paths is configured"
  info            : "This audit is written to dynamically identify if all paths are present in any order. This policy setting determines which registry paths will be accessible over the network, regardless of the users or groups listed in the access control list (ACL) of the winreg registry key."
  solution        : "To establish the recommended configuration via GP, set the following UI path to: System\CurrentControlSet\Control\ProductOptions System\CurrentControlSet\Control\Server Applications Software\Microsoft\Windows NT\CurrentVersion"
  reference       : "NIST 800-53r5|AC-6(7)(b)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "^Compliant$"
  powershell_args : "$__pysc_result = (& { if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedExactPaths'){$paths = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedExactPaths').Machine;if([string]::IsNullOrWhiteSpace([string]$paths)){ Write-Output '__NON_COMPLIANT__'; return };if($paths -contains 'System\CurrentControlSet\Control\ProductOptions' -and $paths -contains 'System\CurrentControlSet\Control\Server Applications' -and $paths -contains 'Software\Microsoft\Windows NT\CurrentVersion') { Write-Output 'Compliant' } else { Write-Output 'Non-Compliant' }}else { Write-Output '__NON_COMPLIANT__' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0034 - MSSRV - Network access - Remotely accessible registry paths and sub-paths Allowed Paths is configured"
  info            : "This audit is written to dynamically identify if all paths are present in any order. This policy setting determines which registry paths and sub-paths will be accessible over the network, regardless of the users or groups listed in the access control list (ACL) of the winreg registry key."
  solution        : "To establish the recommended configuration via GP, set the following UI path to: System\CurrentControlSet\Control\Print\Printers System\CurrentControlSet\Services\Eventlog Software\Microsoft\OLAP Server Software\Microsoft\Windows NT\CurrentVersion\Print Software\Microsoft\Windows NT\CurrentVersion\Windows System\CurrentControlSet\Control\ContentIndex System\CurrentControlSet\Control\Terminal Server System\CurrentControlSet\Control\Terminal Server\UserConfig System\CurrentControlSet\Control\Terminal Server\DefaultUserConfiguration Software\Microsoft\Windows NT\CurrentVersion\Perflib System\CurrentControlSet\Services\SysmonLog"
  reference       : "NIST 800-53r5|AC-6(7)(b)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "^Compliant$"
  powershell_args : "$__pysc_result = (& { if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedPaths'){$paths = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedPaths').Machine;if([string]::IsNullOrWhiteSpace([string]$paths)){ Write-Output '__NON_COMPLIANT__'; return };if($paths -contains 'System\CurrentControlSet\Control\Print\Printers' -and $paths -contains 'System\CurrentControlSet\Services\Eventlog' -and $paths -contains 'Software\Microsoft\OLAP Server' -and $paths -contains 'Software\Microsoft\Windows NT\CurrentVersion\Print' -and $paths -contains 'Software\Microsoft\Windows NT\CurrentVersion\Windows' -and $paths -contains 'System\CurrentControlSet\Control\ContentIndex' -and $paths -contains 'System\CurrentControlSet\Control\Terminal Server' -and $paths -contains 'System\CurrentControlSet\Control\Terminal Server\UserConfig' -and $paths -contains 'System\CurrentControlSet\Control\Terminal Server\DefaultUserConfiguration' -and $paths -contains 'Software\Microsoft\Windows NT\CurrentVersion\Perflib' -and $paths -contains 'System\CurrentControlSet\Services\SysmonLog') { Write-Output 'Compliant' } else { Write-Output 'Non-Compliant' }}else { Write-Output '__NON_COMPLIANT__' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type                 : AUDIT_POWERSHELL
  description          : "1.0035 - MSSRV - Network access - WINS Server Feature installed"
  info                 : "This policy setting determines if WINSService is installed."
  solution             : "Configure this setting to the expected baseline value shown in the control description and value_data."
