  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0110 - MSSRV - Account - Local Admin Account Disabled"
  info            : "The built-in local admin account should be disabled."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53r5|IA-5"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "Disabled"
  powershell_args : "$A = Get-CimInstance -ClassName Win32_UserAccount -EA SilentlyContinue | Where-Object { $_.SID -match '-500$' } | Select-Object -First 1; if($A -and $A.Disabled -ne $null){ if($A.Disabled){ Write-Output 'Disabled' } else { Write-Output 'Enabled' } } elseif($A -and -not [string]::IsNullOrEmpty($A.Name)){ Write-Output $A.Name } else { Write-Output '__NON_COMPLIANT__' }"
  check_type      : CHECK_EQUAL
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0111 - MSSRV - Account - Rename Guest Account"
