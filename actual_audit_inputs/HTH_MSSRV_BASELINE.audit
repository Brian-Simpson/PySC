  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0041 - MSSRV - Password - Account Lockout Duration - 60 minutes"
  info            : "This policy setting determines the length of time that must pass before a locked account is unlocked and a user can try to log on again."
  solution        : "To establish the recommended configuration via GP, set the following UI path to 15 or more minute(s) :"
  reference       : "NIST 800-53r5|AC-7 AC-19"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "60"
  powershell_args : "$__pysc_result = (& { $LockDurObj = net accounts | Select-string 'Lockout duration'; $LockDurStr = $LockDurObj.ToString(); $LockDurStr -match '\d{1,2}' | out-null; $LockDurStr -match '60' | out-null; $LO_LockDur = $matches[0]; Write-Output $LO_LockDur; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0042 - MSSRV - Password - Account Lockout Reset - 1 day"
  info            : "This policy setting determines the length of time before the Account lockout threshold resets to zero."
  solution        : "To establish the recommended configuration via GP, set the following UI path to 15 or more minute(s) :"
  reference       : "NIST 800-53r5|AC-7 AC-19"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "60"
  powershell_args : "$__pysc_result = (& { $LockObsObj = net accounts | Select-string 'Lockout observation'; $LockObsStr = $LockObsObj.ToString(); $LockObsStr -match '\d{1,2}' | out-null; $LockObsStr -match '60' | out-null; $LO_LockObs = $matches[0]; Write-Output $LO_LockObs; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0043 - MSSRV - Password - Account Lockout Threshold - 5 invalid attempts"
  info            : "This policy setting determines the number of failed logon attempts before the account is locked."
  solution        : "To establish the recommended configuration via GP, set the following UI path to 5 or fewer invalid login attempt(s), but not 0 :"
  reference       : "NIST 800-53r5|AC-7 AC-19"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "5"
  powershell_args : "$__pysc_result = (& { $lockoutObj = net accounts | Select-string threshold; $lockoutStr = $lockoutObj.ToString(); $lockoutStr -match '\d{1,3}' | out-null; $lockoutStr -match 'Never' | out-null; $LO_threshold = $matches[0]; Write-Output $LO_threshold; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

