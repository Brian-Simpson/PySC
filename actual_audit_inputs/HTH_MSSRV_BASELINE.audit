# <custom_item>
#   type            : AUDIT_POWERSHELL
#   description     : "1.0298 - MSSRV - (L1) Ensure Deny log on as a batch job to include Guests"
#   info            : "This policy setting determines which accounts will not be able to log on to the computer as a batch job."
#   solution        : "To establish the recommended configuration via GP, set the following UI path to include Guests :"
#   reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
#   see_also        : "See HTH Policies and Standards"
#   value_type      : POLICY_TEXT
#   value_data      : "(?s)^(?:Guests|'?NO_MEMBERS'?)$"
#   powershell_args : "$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match '^\s*SeDenyBatchLogonRight\s*=' } | Select-Object -Last 1); $m=if($l){ ($l -replace '.*=', '').Split(',') | ForEach-Object { $s=$_.Trim(); $s=$s -replace '^\*', ''; if($s -match '^S-1-5-'){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]}catch{$s} } else { if($s -match '\\'){ $s.Split('\\')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join ',' } else { 'NO_MEMBERS' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
#   check_type      : CHECK_SUPERSET
# </custom_item>

 <custom_item>
   type            : AUDIT_POWERSHELL
   description     : "1.0299 - MSSRV - (L1) Ensure Deny log on as a service to include Guests"
   info            : "This security setting determines which service accounts are prevented from registering a process as a service."
   solution        : "To establish the recommended configuration via GP, set the following UI path to include Guests :"
   reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
   see_also        : "See HTH Policies and Standards"
   value_type      : POLICY_TEXT
   value_data      : "(?s)^(?:Guests|'?NO_MEMBERS'?)$"
   powershell_args : "$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match '^\s*SeDenyServiceLogonRight\s*=' } | Select-Object -Last 1); $m=if($l){ ($l -replace '.*=', '').Split(',') | ForEach-Object { $s=$_.Trim(); $s=$s -replace '^\*', ''; if($s -match '^S-1-5-'){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]}catch{$s} } else { if($s -match '\\'){ $s.Split('\\')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join ',' } else { 'NO_MEMBERS' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
   check_type      : CHECK_SUPERSET
 </custom_item>

 <custom_item>
   type            : AUDIT_POWERSHELL
