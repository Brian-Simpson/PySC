#HTH Cisco NXOS Baseline

<check_type:"Cisco">

<item>
  type            : CONFIG_CHECK
  description     : "IA - NetNXOS - Authentication - TACACS - feature tacacs+"
  info            : ""
  reference       : "NIST 800-53|IA-2"
  see_also        : "HTH"
  item            : "feature tacacs\+"
</item>

<item>
  type            : CONFIG_CHECK
  description     : "IA - NetNXOS - Authentication - TACACS - tacacs-server"
  info            : ""
  reference       : "NIST 800-53|IA-2"
  see_also        : "HTH"
  item            : "tacacs-server host .+ key .+"
  min_occurrences : "2"
</item>

<item>
  type            : CONFIG_CHECK
  description     : "IA - NetNXOS -  Authentication - TACACS - aaa group"
  info            : ""
  reference       : "NIST 800-53|IA-2"
  see_also        : "HTH"
  context         : "aaa group server tacacs\+ .+"
  item            : "server .+"
  min_occurrences : "1"
</item>

<item>
  type            : CONFIG_CHECK
  description     : "IA - NetNXOS -  Authentication - RADIUS - aaa group"
  info            : ""
  reference       : "NIST 800-53|IA-2"
  see_also        : "HTH"
  context         : "aaa group server radius .+"
  item            : "server .+"
  min_occurrences : "1"
</item>

<item>
  type            : CONFIG_CHECK
  description     : "AC - NetNXOS - Timeout - Console exec-timeout"
  info            : ""
  reference       : "NIST 800-53|AC-12"
  see_also        : "HTH"
  context         : "line console"
  item            : "exec-timeout ([1-9]|[1-9][0-9]|[12][0-9]{2}|300)"
</item>

<if>
  <condition type:"OR">
    <item>
      type        : CONFIG_CHECK
      description : "Check for SNMPv3 engineID"
      item        : "snmp-server engineID remote .+"
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "Check for SNMPv3 group v3"
      item        : "snmp-server group .+ v3 .+"
    </item>
  </condition>

  <then>
    <item>
      type        : CONFIG_CHECK
      description : "IA - NetNXOS - Authentication - SNMPv3 - group v3"
      info        : ""
      reference   : "NIST 800-53|IA-2(1)"
      see_also    : "HTH"
      item        : "snmp-server group .+ v3 .+"
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "IA - NetNXOS - Authentication - SNMPv3 - engineID"
      info        : ""
      reference   : "NIST 800-53|IA-2(1)"
      see_also    : "HTH"
      item        : "snmp-server engineID remote .+"
    </item>
  </then>

  <else>
    <report type:"PASSED">
      description : "IA - NetNXOS - Authentication - SNMPv3 - group v3"
      info        : ""
      reference   : "NIST 800-53|IA-2(1)"
      see_also    : "HTH"
    </report>

    <report type:"PASSED">
      description : "IA - NetNXOS - Authentication - SNMPv3 - engineID"
      info        : ""
      reference   : "NIST 800-53|IA-2(1)"
      see_also    : "HTH"
    </report>
  </else>
</if>

<item>
  type        : CONFIG_CHECK
  description : "CM - NetNXOS - SNMP Traps - Enabled"
  info        : ""
  reference   : "NIST 800-53|CM-6"
  see_also    : "HTH"
  item        : "snmp-server enable traps .+"
</item>

<item>
  type        : CONFIG_CHECK
  description : "AU - NetNXOS - Logging - Logging server/source-interface"
  info        : ""
  reference   : "NIST 800-53|AU-12"
  see_also    : "HTH"
  item        : "logging (server|source-interface) .+"
</item>

<item>
  type        : CONFIG_CHECK
  description : "AU - NetNXOS - Logging - MGMT interface"
  info        : ""
  reference   : "NIST 800-53|AU-12"
  see_also    : "HTH"
  item        : "logging source-interface .+"
</item>

<item>
  type        : CONFIG_CHECK_NOT
  description : "CM - NetNXOS - Services -  Disable iPXE"
  info        : ""
  reference   : "NIST 800-53|CM-7"
  see_also    : "HTH"
  item        : "boot order pxe"
</item>

<item>
  type        : CONFIG_CHECK
  description : "CM - NetNXOS - Limit SSH Login Attempts"
  info        : "After a configured number of failed password attempts, an SSH session terminate."
  reference   : "NIST 800-53r5|CM-7 MA-4"
  see_also    : "Please see the corresponding HTH Standard and Policies."
  context     : "line console"
  item        : "exec-timeout 120"
</item>

<item>
  type        : CONFIG_CHECK
  description : "CM - NetNXOS - Set the Maximum Number of VTY Sessions"
  info        : "This sets the maximum number of remote administrative sessions, which in most environments means the maximum number of SSH sessions."
  reference   : "NIST 800-53r5|CM-7 MA-4"
  see_also    : "Please see the corresponding HTH Standard and Policies."
  context     : "line vty"
  item        : "session-limit 16"
</item>

<item>
  type        : CONFIG_CHECK
  description : "CM - NetNXOS - Disable the Telnet Feature"
  info        : "Telnet is a clear-text administrative protocol."
  reference   : "NIST 800-53r5|CM-7 MA-4"
  see_also    : "Please see the corresponding HTH Standard and Policies."
  item        : "no feature telnet"
</item>

<if>
  <condition type:"AND">
    <item>
      type        : CONFIG_CHECK
      description : "VTY ACL"
      context     : "ip access-list acl-mgt"
      item        : "$Manual Review Required^"
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "line vty access-class"
      context     : "line vty"
      item        : "access-class acl-mgt in"
    </item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "AC - NetNXOS - Restrict Access to VTY Sessions"
      info        : "Restrict Management Access to trusted management stations and VLANs."
      reference   : "NIST 800-53r5|AC-17(3),800-53r5|CM-7,800-53r5|MA-4,800-53r5|SI-7"
      see_also    : "Please see the corresponding HTH Standard and Policies."
      show_output : YES
    </report>
  </then>
</if>

  <item>
  type        : CONFIG_CHECK
  description : "IA - NetNXOS - Set password length for local credentials"
  info        : "Password length should be set to some value that makes compromising any captured hashed difficult."
  reference   : "NIST 800-53r5|IA-5(1)"
  see_also    : "Please see the corresponding HTH Standard and Policies."
  item        : "userpassphrase min-length 20 max-length 127"
  </item>

<item>
  type        : CONFIG_CHECK
  description : "AC - NetNXOS - Pre-authentication Banner"
  info        : "A pre-authentication banner is displayed when a terminal connects, before a login occurs."
  reference   : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
  see_also    : "Please see the corresponding HTH Standard and Policies."
  item        : "banner motd"
  content     : "!! WARNING !!"
  is_substring: YES
</item>


<report type: "PASSED">
  description : "AU - NetNXOS - Configure at least 2 external NTP Servers"
  info        : "Accurate time is a critical piece of security infrastructure."
  reference   : "NIST 800-53r5|AU-7 AU-8"
  see_also    : "Please see the corresponding HTH Standard and Policies."
 </report>

<item>
  type        : CONFIG_CHECK
  description : "AC - NetNXOS - Configure Control Plane Policing"
  info        : "Control Plane Policing is used to create a set of policies governing specific traffic."
  reference   : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
  see_also    : "Please see the corresponding HTH Standard and Policies."
  item        : "copp profile strict"
</item>

<if>
  <condition type:"AND">
    <item>
      type        : CONFIG_CHECK
      description : "Check for eigrp"
      item        : "router eigrp .+"
    </item>
  </condition>

  <then>
    <item>
      type        : CONFIG_CHECK
      description : "AC - NetNXOS - Configure EIGRP Passive interfaces for interfaces that do not have peers"
      info        : "EIGRP both listens on and advertises on all interfaces that have IPs in subnets that are defined as 'networks' in the EIGRP configuration."
      reference   : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
      see_also    : "Please see the corresponding HTH Standard and Policies."
      context     : "interface .+"
      regex       : "$Manual Review Required^"
      item        : "ip passive-interface eigrp .+"
    
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "AC - NetNXOS - Configure EIGRP log-adjacency-changes"
      info        : "Logging changes to the EIGRP peering relationships is recommended. This setting is enabled by default."
      reference   : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) AU-3 AU-3(1) AU-7 AU-12 CM-2 CM-6 CM-7 CM-7(1) CM-9 SC-23"
      see_also    : "Please see the corresponding HTH Standard and Policies."
      context     : "router eigrp .+"
      item        : "log-adjacency-changes"
    </item>
  </then>

  <else>
    <report type:"PASSED">
      description : "AC - NetNXOS - Configure EIGRP Passive interfaces for interfaces that do not have peers"
      info        : "EIGRP both listens on and advertises on all interfaces that have IPs in subnets that are defined as 'networks' in the EIGRP configuration."
      reference   : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
      see_also    : "Please see the corresponding HTH Standard and Policies."
    </report>

    <report type:"PASSED">
      description : "AC - NetNXOS - Configure EIGRP log-adjacency-changes"
      info        : "Logging changes to the EIGRP peering relationships is recommended. This setting is enabled by default."
      reference   : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) AU-3 AU-3(1) AU-7 AU-12 CM-2 CM-6 CM-7 CM-7(1) CM-9 SC-23"
      see_also    : "Please see the corresponding HTH Standard and Policies."
    </report>
  </else>
</if>

<if>
  <condition type:"AND">
    <item>
      type        : CONFIG_CHECK
      description : "Check for BGP"
      item        : "router bgp"
    </item>
  </condition>

  <then>
    <item>
      type        : CONFIG_CHECK
      description : "CM - NetNXOS - Configure BGP to Log Neighbor Changes"
      info        : "Logging changes to the BGP peering relationships is recommended."
      reference   : "NIST 800-53r5|CM-6 CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7 SC-23"
      see_also    : "Please see the corresponding HTH Standard and Policies."
      context     : "router bgp .+"
      item        : "log-neighbor-changes"
    </item>
  </then>

  <else>
    <report type:"PASSED">
      description : "CM - NetNXOS - Configure BGP to Log Neighbor Changes"
      info        : "Logging changes to the BGP peering relationships is recommended."
      reference   : "NIST 800-53r5|CM-6 CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7 SC-23"
      see_also    : "Please see the corresponding HTH Standard and Policies."
    </report>
  </else>
</if>

<if>
  <condition type:"AND">
    <item>
      type        : CONFIG_CHECK
      description : "Check for interface Vlan with IPs"
      context     : "interface Vlan.+"
      item        : "ip address .+"
    </item>
  </condition>

  <then>
    <item>
      type            : CONFIG_CHECK
      description     : "CA - NetNXOS - If VLAN interfaces have IP addreses, configure anti spoofing / ingress filtering protections"
      info            : "If VLAN interfaces have IP addresses, it is important that anti-spoofing protections are in place, to prevent an attacker from spoofing an address that is illegal on that inbound interface."
      reference       : "NIST 800-53r5|CA-9 SC-7 SI-4 SI-4(4)"
      see_also        : "Please see the corresponding HTH Standard and Policies."
      context         : "interface Vlan.+"
      item            : "(ip address .+|ip verify unicast source reachable-via rx)"
      min_occurrences : "2"
    </item>
  </then>

  <else>
    <report type:"PASSED">
      description : "CA - NetNXOS - If VLAN interfaces have IP addreses, configure anti spoofing / ingress filtering protections"
      info        : "If VLAN interfaces have IP addresses, it is important that anti-spoofing protections are in place, to prevent an attacker from spoofing an address that is illegal on that inbound interface."
      reference   : "NIST 800-53r5|CA-9 SC-7 SI-4 SI-4(4)"
      see_also    : "Please see the corresponding HTH Standard and Policies."
    </report>
  </else>
</if>

<if>
  <condition type:"AND">
    <item>
      type        : CONFIG_CHECK
      description : "Check for feature hsrp"
      item        : "^feature hsrp"
    </item>
  </condition>

  <then>
    <if>
      <condition type:"AND">
        <item>
          type        : CONFIG_CHECK
          description : "hsrp version 2"
          context     : "interface .+"
          regex       : "$Manual Review Required^"
          item        : "hsrp version 2"
        
        </item>

        <item>
          type        : CONFIG_CHECK
          description : "interface md5"
          context     : "interface .+"
          regex       : "$Manual Review Required^"
          item        : "authentication md5 key-chain .+"
        
        </item>
      </condition>

      <then>
        <report type:"PASSED">
          description : "AC - NetNXOS - Configure HSRP protections"
          info        : "HSRP is a valuable redundancy protocol and authentication is recommended to protect against attacks."
          reference   : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
          see_also    : "Please see the corresponding HTH Standard and Policies."
          show_output : YES
        </report>
      </then>
    </if>
  </then>

  <else>
    <report type:"PASSED">
      description : "AC - NetNXOS - Configure HSRP protections"
      info        : "HSRP is a valuable redundancy protocol and authentication is recommended to protect against attacks."
      reference   : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
      see_also    : "Please see the corresponding HTH Standard and Policies."
    </report>
  </else>
</if>

<if>
  <condition type:"AND">
    <item>
      type        : CONFIG_CHECK
      description : "policy"
      item        : "ipv6 nd raguard policy .+"
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "interfaces"
      context     : "interface .+"
      regex       : "$Manual Review Required^"
      item        : "ipv6 nd raguard attach-policy .+"
    
    </item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "AC - NetNXOS - Configure RA Guard"
      info        : "The IPv6 RA Guard feature provides support for allowing the network administrator to block or reject unwanted or rogue RA guard messages that arrive at the network device platform."
      reference   : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
      see_also    : "Please see the corresponding HTH Standard and Policies."
      show_output : YES
    </report>
  </then>
</if>

<item>
  type        : CONFIG_CHECK_NOT
  description : "AC - NetNXOS - Disable Proxy ARP on all Layer 3 Interfaces"
  info        : "Proxy ARP is the technique in which one host, usually a router, answers ARP requests intended for another machine on a different network segment (vlan or subnet)."
  reference   : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
  see_also    : "Please see the corresponding HTH Standard and Policies."
  context     : "interface .+"
  item        : "ip proxy arp"
</item>

<item>
  type        : CONFIG_CHECK_NOT
  description : "AC - NetNXOS - Disable IP Directed Broadcasts on all Layer 3 Interfaces"
  info        : "An IP directed broadcast is an IP packet whose destination address is a valid broadcast address for an IP subnet, but which originates from a node that is not itself a part of that destination subnet."
  solution    : "switch(config-if)# no ip directed-broadcast"
  reference   : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
  see_also    : "Please see the corresponding HTH Standard and Policies."
  context     : "interface .+"
  item        : "ip directed-broadcast"
</item>

<if>
  <condition type:"AND">
    <item>
      type        : CONFIG_CHECK
      description : "ip dhcp snooping"
      item        : "^ip dhcp snooping$"
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "ip dhcp snooping vlan"
      item        : "^ip dhcp snooping vlan .+"
    </item>

    <item>
      type        : CONFIG_CHECK
      description : "ip dhcp snooping trust"
      context     : "interface .+"
      regex       : "$Manual Review Required^"
      item        : "ip dhcp snooping trust"
    
    </item>
  </condition>

  <then>
    <report type:"PASSED">
      description : "AC - NetNXOS - Configure DHCP Trust"
      info        : "You can configure whether DHCP snooping trusts traffic sources. An untrusted source may initiate traffic attacks or other hostile actions."
      reference   : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
      see_also    : "Please see the corresponding HTH Standard and Policies."
      show_output : YES
    </report>
  </then>
</if>



</check_type>