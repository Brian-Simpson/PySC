  powershell_args : "$__pysc_result = (& { $p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableVirtualization'] -ne $null) { [int]$p.'EnableVirtualization' } else { 0 }; [string]$val } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0108 - MSWRK - Ensure Audit: Shut down system immediately if unable to log security audits is set to Disabled"
