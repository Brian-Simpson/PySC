  description     : "1.0327 - MSWRK - Ensure Configure RPC connection settings: Use authentication for outgoing RPC connections is set to Enabled: Default"
  info            : "This policy setting controls which protocol and protocol settings to use for outgoing Remote Procedure Call (RPC) connections to a remote print spooler."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled: Default :"
  reference       : "NIST 800-53r5|CM-6b."
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "0"
  powershell_args : "$__pysc_result = (& { $P = 'Registry::HKLM\Software\Policies\Microsoft\Windows NT\Printers\RPC'; $K = 'RpcAuthentication'; if(-not (Test-Path -Path $P)){ Write-Output '__NON_COMPLIANT__'; return }; $R = Get-ItemProperty -Path $P -ErrorAction SilentlyContinue; if($null -eq $R){ Write-Output '__NON_COMPLIANT__'; return }; $prop = $R.PSObject.Properties[$K]; if($null -eq $prop -or $null -eq $prop.Value){ Write-Output '__NON_COMPLIANT__'; return }; $V = $prop.Value; if($null -eq $V -or [string]::IsNullOrWhiteSpace([string]$V)){ Write-Output '__NON_COMPLIANT__' } elseif($V -is [System.Array]){ $joined = ($V -join [Environment]::NewLine); if([string]::IsNullOrWhiteSpace([string]$joined)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output $joined } } else { Write-Output $V; } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
