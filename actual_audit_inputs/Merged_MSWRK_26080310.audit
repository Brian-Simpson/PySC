  powershell_args : "$__pysc_result = (& { if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedExactPaths'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedExactPaths').Machine;if($noutput -eq $Null) {Write-Output '__NON_COMPLIANT__'} else {$noutput}}else {Write-Output '__NON_COMPLIANT__'} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0129 - MSWRK - Network access: Remotely accessible registry paths and sub-paths is configured - Allowedpaths"
  info            : "This policy setting determines which registry paths and sub-paths will be accessible over the network, regardless of the users or groups listed in the access control list (ACL) of the winreg registry key."
  solution        : "To establish the recommended configuration via GP, set the following UI path to: System\CurrentControlSet\Control\Print\Printers System\CurrentControlSet\Services\Eventlog SOFTWARE\Microsoft\OLAP Server SOFTWARE\Microsoft\Windows NT\CurrentVersion\Print SOFTWARE\Microsoft\Windows NT\CurrentVersion\Windows System\CurrentControlSet\Control\ContentIndex System\CurrentControlSet\Control\Terminal Server System\CurrentControlSet\Control\Terminal Server\UserConfig System\CurrentControlSet\Control\Terminal Server\DefaultUserConfiguration SOFTWARE\Microsoft\Windows NT\CurrentVersion\Perflib System\CurrentControlSet\Services\SysmonLog"
  reference       : "NIST 800-53r5|AC-6(7)(b)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "(?s)^(?=.*System\\\\CurrentControlSet\\\\Control\\\\Print\\\\Printers)(?=.*System\\\\CurrentControlSet\\\\Services\\\\Eventlog)(?=.*Software\\\\Microsoft\\\\OLAP\ Server)(?=.*Software\\\\Microsoft\\\\Windows\ NT\\\\CurrentVersion\\\\Print)(?=.*Software\\\\Microsoft\\\\Windows\ NT\\\\CurrentVersion\\\\Windows)(?=.*System\\\\CurrentControlSet\\\\Control\\\\ContentIndex)(?=.*System\\\\CurrentControlSet\\\\Control\\\\Terminal\ Server)(?=.*System\\\\CurrentControlSet\\\\Control\\\\Terminal\ Server\\\\UserConfig)(?=.*System\\\\CurrentControlSet\\\\Control\\\\Terminal\ Server\\\\DefaultUserConfiguration)(?=.*Software\\\\Microsoft\\\\Windows\ NT\\\\CurrentVersion\\\\Perflib)(?=.*System\\\\CurrentControlSet\\\\Services\\\\SysmonLog).*$"
  powershell_args : "$__pysc_result = (& { if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedPaths'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedPaths').Machine;if($noutput -eq $Null) {Write-Output '__NON_COMPLIANT__'} else {$noutput}}else {Write-Output '__NON_COMPLIANT__'} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0130 - MSWRK - Network security: Do not store LAN Manager hash value on next password change is set to Enabled"
  info            : "This policy setting determines whether the LAN Manager (LM) hash value for the new password is stored when the password is changed."
