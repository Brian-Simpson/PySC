<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0386 - MSWRK - Ensure Configure Windows spotlight on lock screen is set to Disabled"
  info            : "This policy setting lets you configure Windows Spotlight on the lock screen."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Disabled :"
  reference       : "NIST 800-53r5|AC-11"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "2"
  powershell_args : "$__pysc_result = (& { $P = 'Registry::HKU\Software\Policies\Microsoft\Windows\CloudContent'; $K = 'ConfigureWindowsSpotlight'; if(-not (Test-Path -Path $P)){ Write-Output '__NON_COMPLIANT__'; return }; $R = Get-ItemProperty -Path $P -ErrorAction SilentlyContinue; if($null -eq $R){ Write-Output '__NON_COMPLIANT__'; return }; $prop = $R.PSObject.Properties[$K]; if($null -eq $prop -or $null -eq $prop.Value){ Write-Output '__NON_COMPLIANT__'; return }; $V = $prop.Value; if($null -eq $V -or [string]::IsNullOrWhiteSpace([string]$V)){ Write-Output '__NON_COMPLIANT__' } elseif($V -is [System.Array]){ $joined = ($V -join [Environment]::NewLine); if([string]::IsNullOrWhiteSpace([string]$joined)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output $joined } } else { Write-Output $V; } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0387 - MSWRK - Ensure Do not suggest third-party content in Windows spotlight is set to Enabled"
  info            : "This policy setting determines whether Windows will suggest apps and content from third-party software publishers."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled :"
  reference       : "NIST 800-53r5|CM-7b."
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "1"
  powershell_args : "$__pysc_result = (& { $P = 'Registry::HKU\Software\Policies\Microsoft\Windows\CloudContent'; $K = 'DisableThirdPartySuggestions'; if(-not (Test-Path -Path $P)){ Write-Output '__NON_COMPLIANT__'; return }; $R = Get-ItemProperty -Path $P -ErrorAction SilentlyContinue; if($null -eq $R){ Write-Output '__NON_COMPLIANT__'; return }; $prop = $R.PSObject.Properties[$K]; if($null -eq $prop -or $null -eq $prop.Value){ Write-Output '__NON_COMPLIANT__'; return }; $V = $prop.Value; if($null -eq $V -or [string]::IsNullOrWhiteSpace([string]$V)){ Write-Output '__NON_COMPLIANT__' } elseif($V -is [System.Array]){ $joined = ($V -join [Environment]::NewLine); if([string]::IsNullOrWhiteSpace([string]$joined)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output $joined } } else { Write-Output $V; } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0388 - MSWRK - Ensure Turn off Spotlight collection on Desktop is set to Enabled"
  info            : "This policy setting removes the Spotlight collection setting in Personalization, rendering the user unable to select and subsequently download daily images from Microsoft to the system desktop."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled :"
  reference       : "NIST 800-53r5|CM-6 CM-7"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "1"
  powershell_args : "$__pysc_result = (& { $P = 'Registry::HKU\Software\Policies\Microsoft\Windows\CloudContent'; $K = 'DisableSpotlightCollectionOnDesktop'; if(-not (Test-Path -Path $P)){ Write-Output '__NON_COMPLIANT__'; return }; $R = Get-ItemProperty -Path $P -ErrorAction SilentlyContinue; if($null -eq $R){ Write-Output '__NON_COMPLIANT__'; return }; $prop = $R.PSObject.Properties[$K]; if($null -eq $prop -or $null -eq $prop.Value){ Write-Output '__NON_COMPLIANT__'; return }; $V = $prop.Value; if($null -eq $V -or [string]::IsNullOrWhiteSpace([string]$V)){ Write-Output '__NON_COMPLIANT__' } elseif($V -is [System.Array]){ $joined = ($V -join [Environment]::NewLine); if([string]::IsNullOrWhiteSpace([string]$joined)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output $joined } } else { Write-Output $V; } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0389 - MSWRK - Ensure Deny access to this computer from the network to include Guests, Local account"
  info            : "This policy setting prohibits users from connecting to a computer from across the network, which would allow users to access and potentially modify data remotely."
  solution        : "To establish the recommended configuration via GP, set the following UI path to include Guests, Local account :"
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "(?s)^(?:(?=.*Guests)(?=.*Local\ account).*|'?NO_MEMBERS'?)$"
  powershell_args : "$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match '^\s*SeDenyNetworkLogonRight\s*=' } | Select-Object -Last 1); $m=if($l){ ($l -replace '.*=', '').Split(',') | ForEach-Object { $s=$_.Trim(); $s=$s -replace '^\*', ''; if($s -match '^S-1-5-'){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]}catch{$s} } else { if($s -match '\\'){ $s.Split('\\')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join ',' } else { 'NO_MEMBERS' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_SUPERSET
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0390 - MSWRK - Ensure Deny log on as a batch job to include Guests"
  info            : "This policy setting determines which accounts will not be able to log on to the computer as a batch job."
  solution        : "To establish the recommended configuration via GP, set the following UI path to include Guests :"
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "(?s)^(?:Guests|'?NO_MEMBERS'?)$"
  powershell_args : "$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match '^\s*SeDenyBatchLogonRight\s*=' } | Select-Object -Last 1); $m=if($l){ ($l -replace '.*=', '').Split(',') | ForEach-Object { $s=$_.Trim(); $s=$s -replace '^\*', ''; if($s -match '^S-1-5-'){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split('\\')[-1]}catch{$s} } else { if($s -match '\\'){ $s.Split('\\')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join ',' } else { 'NO_MEMBERS' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_SUPERSET
</custom_item>

