<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0163 - MSWRK - Ensure Prevent enabling lock screen camera is set to Enabled"
  info            : "Disables the lock screen camera toggle switch in PC Settings and prevents a camera from being invoked on the lock screen."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled :"
  reference       : "NIST 800-53r5|AC-11"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "1"
