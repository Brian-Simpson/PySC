<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0337 - MSWRK - Ensure Turn off background refresh of Group Policy is set to Disabled"
  info            : "This policy setting prevents Group Policy from being updated while the computer is in use."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Disabled :"
  reference       : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  powershell_args : "$__pysc_result = (& { Write-Output 'REG_CHECK|DisableBkGndGroupPolicy|HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System'; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

