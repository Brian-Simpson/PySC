<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0097 - MSWRK - Ensure Accounts: Guest account status is set to Disabled"
  info            : "This policy setting determines whether the Guest account is enabled or disabled."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Disabled :"
  reference       : "NIST 800-53r5|IA-5"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "Disabled"
  powershell_args : "$__pysc_result = (& { $g = Get-LocalUser | Where-Object { $_.SID -match '-501$' -or $_.Name -eq 'Guest' }; if ($g) { if ($g | Where-Object { $_.Enabled }) { 'Enabled' } else { 'Disabled' } } else { 'NOT_FOUND' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
</custom_item>

