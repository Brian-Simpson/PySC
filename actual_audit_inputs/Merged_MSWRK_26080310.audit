# generated_by: merge-master-audits-v2
<check_type:"Windows" version:"2">
<group_policy:"CIS Microsoft Windows 11 Enterprise">

<if>
  <condition type:"AND">
<custom_item>
  type        : REGISTRY_SETTING
  description : "Windows Workstation is installed"
  value_type  : POLICY_TEXT
  value_data  : "^[Ww][Ii][Nn][Dd][Oo][Ww][Ss](?!.*[Ss][Ee][Rr][Vv][Ee][Rr]).+$"
  reg_key     : "HKLM\Software\Microsoft\Windows Nt\Currentversion"
  reg_item    : "ProductName"
  check_type  : CHECK_REGEX
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description : "PASSED - TARGET OS MATCHES BASELINE - MSWRK"
  see_also    : "See HTH Policies and Standards"
</report>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0000 - MSWRK - INFO - System/Domain Identification"
  info            : "This obtains specific user and system information that may be used for additional evaluation."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53r5|"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : ".*"
  powershell_args : "$__pysc_result = (& { (Get-ComputerInfo) |Select-Object OSDisplayVersion, CsManufacturer, CsModel, BiosBIOSVersion, BiosSeralNumber, CsUserName, OsName, OsBuildNumber, OsProductType, CsDNSHostName, CsDomain; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0001 - MSWRK - INFO - Network Information"
  info            : "This obtains relevent hosted view network information that may be used for additional evaluation."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53r5|"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : ".*"
  powershell_args : "$__pysc_result = (& { Get-NetIPConfiguration -Detailed ;(Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.2\Server'); } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0002 - MSWRK - Ensure Enforce password history is set to 24 or more password(s)"
  info            : "This policy setting determines the number of renewed, unique passwords that have to be associated with a user account before you can reuse an old password."
  solution        : "To establish the recommended configuration via GP, set the following UI path to 24 or more password(s) :"
  reference       : "NIST 800-53r5|IA-5(1)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : 24
  powershell_args : "$__pysc_result = (& { $line = net accounts | Where-Object { $_ -match 'Length of password history' }; if ($line -match '(\d+)$') { $matches[1] } else { 'NOT_FOUND' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0003 - MSWRK - Ensure Maximum password age is set to 365 or fewer days, but not 0"
  info            : "This policy setting defines how long a user can use their password before it expires."
  solution        : "To establish the recommended configuration via GP, set the following UI path to 365 or fewer days, but not 0 :"
  reference       : "NIST 800-53r5|IA-5(1)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "60"
  powershell_args : "$__pysc_result = (& { $tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^MaximumPasswordAge\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -ne '') { $val.Trim() } else { 'NOT_FOUND' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0004 - MSWRK - Ensure Minimum password age is set to 1 or more day(s)"
  info            : "This policy setting determines the number of days that you must use a password before you can change it."
  solution        : "To establish the recommended configuration via GP, set the following UI path to 1 or more day(s) :"
  reference       : "NIST 800-53r5|IA-5(1)"
