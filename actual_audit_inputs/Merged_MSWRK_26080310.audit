  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0395 - MSWRK - Ensure Network security: Allow Local System to use computer identity for NTLM is set to Enabled"
  info            : "This policy setting determines whether Local System services that use Negotiate when reverting to NTLM authentication can use the computer identity."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled :"
  reference       : "NIST 800-53r5|IA-3"
