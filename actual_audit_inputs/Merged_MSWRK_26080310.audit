  powershell_args : "$__pysc_result = (& { $p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanmanWorkstation\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RequireSecuritySignature'] -ne $null) { [int]$p.'RequireSecuritySignature' } else { 0 }; [string]$val } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output '__NON_COMPLIANT__' } else { Write-Output ($__pysc_result.Trim()) }"
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
