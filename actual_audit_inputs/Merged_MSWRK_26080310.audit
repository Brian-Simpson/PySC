  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0400 - MSWRK - Ensure Network Security: Allow PKU2U authentication requests to this computer to use online identities is set to Disabled"
  info            : "This setting determines if online identities are able to authenticate to this computer."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Disabled :"
  reference       : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also        : "See HTH Policies and Standards"
