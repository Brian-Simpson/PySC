# HTH Custom RHEL Baseline

<check_type:"Unix">

<if>
  <condition type:"AND">
    <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "PASSED - TARGET OS MATCHES BASELINE - RHEL"
      file        : "/etc/system-release"
      regex       : "^[\\s]*Red Hat Enterprise Linux.*release"
      expect      : "^[\\s]*Red Hat Enterprise Linux.*release"
    </custom_item>
  </condition>

  <then>
    <custom_item>
      system      : "Linux"
      type        : FILE_CHECK
      description : "AC - RHEL - Ensure permissions on /etc/passwd are configured"
      info        : "The /etc/passwd file contains user account information that is used by many system utilities and therefore must be readable for these utilities to operate."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      file        : "/etc/passwd"
      owner       : "root"
      mask        : "133"
      group       : "root"
   </custom_item>

   <custom_item>
      type        : FILE_CHECK
      description : "AC - RHEL - File Permissions - Ensure permissions on /etc/passwd- are configured"
      info        : "The /etc/passwd- file contains backup user account information."
      reference   : "NIST 800-53|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      file        : "/etc/passwd-"
      owner       : "root"
      mask        : "133"
      group       : "root"
    </custom_item>

    <custom_item>
      type        : FILE_CHECK
      description : "AC - RHEL- File Permissions - Ensure permissions on /etc/group are configured"
      info        : "The /etc/group file contains a list of all the valid groups defined in the system. The command below allows read/write access for root and read access for everyone else"
      reference   : "NIST 800-53|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      file        : "/etc/group"
      owner       : "root"
      mask        : "133"
      group       : "root"
    </custom_item>

    <custom_item>
      type        : FILE_CHECK
      description : "AC - RHEL - File Permissions - Ensure permissions on /etc/group- are configured"
      info        : "The /etc/group- file contains a backup list of all the valid groups defined in the system"
      reference   : "NIST 800-53|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      file        : "/etc/group-"
      owner       : "root"
      mask        : "133"
      group       : "root"
    </custom_item>

    <custom_item>
      type        : FILE_CHECK
      description : "AC - RHEL - File Permissions - Ensure permissions on /etc/shadow are configured"
      info        : "The /etc/shadow file is used to store the information about user accounts that is critical to the security of those accounts, such as the hashed password and other security information"
      reference   : "NIST 800-53|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      file        : "/etc/shadow"
      owner       : "root"
      mask        : "777"
      group       : "root"
    </custom_item>

    <custom_item>
      type        : FILE_CHECK
      description : "AC - RHEL - File Permissions - Ensure permissions on /etc/shadow- are configured"
      info        : "The /etc/shadow- file is used to store backup information about user accounts that is critical to the security of those accounts, such as the hashed password and other security information"
      reference   : "NIST 800-53|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      file        : "/etc/shadow-"
      owner       : "root"
      mask        : "777"
      group       : "root"
    </custom_item>

    <custom_item>
      type        : FILE_CHECK
      description : "AC - RHEL - File Permissions - Ensure permissions on /etc/gshadow are configured"
      info        : "The /etc/gshadow file is used to store the information about groups that is critical to the security of those accounts, such as the hashed password and other security information."
      reference   : "NIST 800-53|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      file        : "/etc/gshadow"
      owner       : "root"
      mask        : "777"
      group       : "root"
    </custom_item>

    <custom_item>
      type        : FILE_CHECK
      description : "AC - RHEL - File Permissions - Ensure permissions on /etc/gshadow- are configured"
      info        : "The /etc/gshadow- file is used to store backup information about groups that is critical to the security of those accounts, such as the hashed password and other security information"
      reference   : "NIST 800-53|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      file        : "/etc/gshadow-"
      owner       : "root"
      mask        : "777"
      group       : "root"
    </custom_item>

    <custom_item>
      type        : RPM_CHECK
      description : "AC - RHEL - Services - Ensure SELinux is installed"
      info        : "SELinux provides Mandatory Access Control."
      reference   : "NIST 800-53|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      rpm         : "libselinux-0.0.0-0"
      operator    : "gt"
      required    : YES
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "AC - RHEL - Services - Ensure SELinux is not disabled in bootloader configuration"
      info        : "Configure SELINUX to be enabled at boot time and verify that it has not been overwritten by the grub boot parameters."
      reference   : "NIST 800-53|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/sbin/grubby --info=ALL | /bin/grep -Po '(selinux|enforcing)=0' | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
      expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

    <custom_item>
      type        : RPM_CHECK
      description : "AC - RHEL - Services - Ensure sudo is installed"
      info        : "sudo allows a permitted user to execute a command as the superuser or another user, as specified by the security policy. The invoking user's real (not effective) user ID is used to determine the user name with which to query the security policy"
      reference   : "NIST 800-53|AC-6(2) AC-6(5)"
      see_also    : "HTH"
      rpm         : "sudo-0.0.0-0"
      operator    : "gt"
      required    : YES
    </custom_item>
    
    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure nodev option set on /var partition"
      info        : "The nodev mount option specifies that the filesystem cannot contain special devices."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /var | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*[,]?nodev|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure nosuid option set on /var partition"
      info        : "The nosuid mount option specifies that the filesystem cannot contain setuid files."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /var | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*[,]?nosuid|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure noexec option set on /var/tmp partition"
      info        : "The noexec mount option specifies that the filesystem cannot contain executable binaries."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /var/tmp | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*[,]?noexec|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure nosuid option set on /var/tmp partition"
      info        : "The nosuid mount option specifies that the filesystem cannot contain setuid files."
      solution    : "Edit the /etc/fstab file and add nosuid to the fourth field (mounting options) for the /var/tmp partition."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /var/tmp | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*[,]?nosuid|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure nodev option set on /var/tmp partition"
      info        : "The nodev mount option specifies that the filesystem cannot contain special devices."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /var/tmp | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*[,]?nodev|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure nodev option set on /var/log partition"
      info        : "The nodev mount option specifies that the filesystem cannot contain special devices."
      solution    : "Edit the /etc/fstab file and add nodev to the fourth field (mounting options) for the /var/log partition."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /var/log | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*[,]?nodev|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure noexec option set on /var/log partition"
      info        : "The noexec mount option specifies that the filesystem cannot contain executable binaries."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /var/log | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*[,]?noexec|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure nosuid option set on /var/log partition"
      info        : "The nosuid mount option specifies that the filesystem cannot contain setuid files."
      solution    : "Edit the /etc/fstab file and add nosuid to the fourth field (mounting options) for the /var/log partition."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /var/log | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*[,]?nosuid|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure noexec option set on /var/log/audit partition"
      info        : "The noexec mount option specifies that the filesystem cannot contain executable binaries."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /var/log/audit | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*[,]?noexec|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure nodev option set on /var/log/audit partition"
      info        : "The nodev mount option specifies that the filesystem cannot contain special devices."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /var/log/audit | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*[,]?nodev|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure nosuid option set on /var/log/audit partition"
      info        : "The nosuid mount option specifies that the filesystem cannot contain setuid files."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /var/log/audit | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*[,]?nosuid|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "CM - RHEL - Ensure /dev/shm is a separate partition"
      info        : "The /dev/shm directory is a world-writable directory that can function as shared memory that facilitates inter process communication (IPC)."
      reference   : "NIST 800-53r5|CM-6 CM-7"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /dev/shm | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*/dev/shm[\\s]*tmpfs|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure nodev option set on /dev/shm partition"
      info        : "The nodev mount option specifies that the filesystem cannot contain special devices."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /dev/shm | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*[,]?nodev|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure nosuid option set on /dev/shm partition"
      info        : "The nosuid mount option specifies that the filesystem cannot contain setuid files."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/bin/findmnt --kernel /dev/shm | /usr/bin/awk '{print} END {if (NR == 0) print \"not mounted\"}'"
      expect      : "([\\s]*[,]?nosuid|not mounted)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : FILE_CONTENT_CHECK
      description : "AC - RHEL - Ensure gpgcheck is globally activated - dnf.conf"
      info        : "The gpgcheck option, found in the main section of the /etc/dnf/dnf.conf and individual /etc/yum.repos.d/* files, determines if an RPM package's signature is checked prior to its installation."
      reference   : "NIST 800-53r5|RA-5SI-2 SI-2(2)"
      see_also    : "HTH"
      file        : "/etc/dnf/dnf.conf"
      regex       : "^[\\s]*gpgcheck[\\s]*="
      expect      : "^[\\s]*gpgcheck[\\s]*=[\\s]*1[\\s]*$"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : FILE_CONTENT_CHECK_NOT
      description : "RA - RHEL - Ensure gpgcheck is globally activated - /etc/yum.repos.d/*"
      info        : "The gpgcheck option, found in the main section of the /etc/dnf/dnf.conf and individual /etc/yum.repos.d/* files, determines if an RPM package's signature is checked prior to its installation."
      reference   : "NIST 800-53r5|RA-5SI-2 SI-2(2)"
      see_also    : "HTH"
      file        : "/etc/yum.repos.d/*"
      regex       : "^\\h*gpgcheck\\h*=\\h*\\b[^1]\\b.*\\h*$"
      expect      : "^\\h*gpgcheck\\h*=\\h*\\b[^1]\\b.*\\h*$"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : FILE_CONTENT_CHECK
      description : "RA - RHEL - Ensure gpgcheck is globally activated - dnf.conf"
      info        : "The gpgcheck option, found in the main section of the /etc/dnf/dnf.conf and individual /etc/yum.repos.d/* files, determines if an RPM package's signature is checked prior to its installation."
      reference   : "NIST 800-53r5|RA-5SI-2 SI-2(2)"
      see_also    : "HTH"
      file        : "/etc/dnf/dnf.conf"
      regex       : "^[\\s]*gpgcheck[\\s]*="
      expect      : "^[\\s]*gpgcheck[\\s]*=[\\s]*1[\\s]*$"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : FILE_CHECK
      description : "AC - RHEL - Ensure permissions on bootloader config are configured - grub.cfg"
      info        : "The grub files contain information on boot settings and passwords for unlocking boot options."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      file        : "/boot/grub2/grub.cfg"
      owner       : "root"
      mask        : "077"
      group       : "root"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : FILE_CHECK
      description : "AC - RHEL - Ensure permissions on bootloader config are configured - grubenv"
      info        : "The grub files contain information on boot settings and passwords for unlocking boot options."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      file        : "/boot/grub2/grubenv"
      owner       : "root"
      mask        : "077"
      group       : "root"
    </custom_item>

    <custom_item>
      system        : "Linux"
      type          : FILE_CHECK
      description   : "AC - RHEL - Ensure permissions on bootloader config are configured - user.cfg"
      info          : "The grub files contain information on boot settings and passwords for unlocking boot options."
      reference     : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also      : "HTH"
      file          : "/boot/grub2/user.cfg"
      owner         : "root"
      mask          : "077"
      file_required : NO
      group         : "root"
    </custom_item>

     <custom_item>
      type        : FILE_CONTENT_CHECK
      description : "AC - RHEL - Ensure SELinux policy is configured - /etc/selinux/config"
      info        : "Configure SELinux to meet or exceed the default targeted policy, which constrains daemons and system software only."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      file        : "/etc/selinux/config"
      regex       : "^[\\s]*[sS][eE][lL][iI][nN][uU][xX][tT][yY][pP][eE][\\s]*="
      expect      : "^[\\s]*[sS][eE][lL][iI][nN][uU][xX][tT][yY][pP][eE][\\s]*=[\\s]*[Tt][Aa][Rr][Gg][Ee][Tt][Ee][Dd][\\s]*$"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure SELinux policy is configured - sestatus"
      info        : "Configure SELinux to meet or exceed the default targeted policy, which constrains daemons and system software only."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/sbin/sestatus"
      expect      : "^[\\s]*Loaded policy name:[\\s]+([Tt][Aa][Rr][Gg][Ee][Tt][Ee][Dd]|[Mm][Ll][Ss])$"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : CMD_EXEC
      description : "AC - RHEL - Ensure the SELinux mode is not disabled - getenforce"
      info        : "SELinux can run in one of three modes: disabled, permissive, or enforcing."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      cmd         : "/usr/sbin/getenforce"
      expect      : "(Enforcing|Permissive)"
    </custom_item>

    <custom_item>
      system      : "Linux"
      type        : FILE_CONTENT_CHECK
      description : "AC - RHEL - Ensure the SELinux mode is not disabled - /etc/selinux/config"
      info        : "SELinux can run in one of three modes: disabled, permissive, or enforcing."
      reference   : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
      see_also    : "HTH"
      file        : "/etc/selinux/config"
      regex       : "^[\\s]*[sS][eE][lL][iI][nN][uU][xX][\\s]*="
      expect      : "(^[\\s]*[sS][eE][lL][iI][nN][uU][xX][\\s]*=[\\s]*([eE][nN][fF][oO][rR][cC][iI][nN][gG]|[pP][eE][rR][mM][iI][sS][sS][iI][vV][eE])[\\s]*$)"
    </custom_item>
  </then>  
  
  <else>
    <report type:"WARNING">
      description : "WARNING - TARGET OS DOESNT MATCH BASELINE - RHEL"
      info        : "NOTE: Nessus has not identified that the chosen audit applies to the target device."
      see_also    : "HTH"
    </report>
  </else>
</if>

</check_type>
