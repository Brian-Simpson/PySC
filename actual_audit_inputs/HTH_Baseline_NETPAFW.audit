<check_type:"Palo_Alto">

<custom_item>
  type             : AUDIT_XML
  description      : "AU - NetPAFW - Audit Logging - configuration"
  info             : "Syslog logging is a standard logging protocol that is widely supported."
  reference        : "NIST 800-53r5|AU-3 AU-12"
  see_also         : "HTH"
  api_request_type : "op"
  request          : "<show><config><merged></merged></config></show>"
  xsl_stmt         : "<xsl:template match=\"/\">"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"(/response/result/config/shared/log-settings/config/match-list/entry/send-syslog) and (/response/result/config/shared/log-settings/config/match-list/entry/filter='All Logs')\">"
  xsl_stmt         : "<xsl:template match=\"/response/result/config/shared/log-settings/config/match-list/entry\"/>"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  regex            : "(Passed|Failed)"
  expect           : "Passed"
</custom_item>

