<custom_item>
  type             : AUDIT_XML
  description      : "AC - NetPAFW - Idle Timeout - Enabled"
  info             : "Set the Idle Timeout value for device management to 10 minutes or less to automatically close inactive sessions."
  reference        : "NIST 800-53r5|AC-2(5) AC-11(1) AC-12"
  see_also         : "HTH"
  api_request_type : "op"
  request          : "<show><config><merged></merged></config></show>"
  xsl_stmt         : "<xsl:template match=\"/\">"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"not(//setting/management/idle-timeout) or (//setting/management/idle-timeout &gt; 10)\">"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"not(//setting/management/idle-timeout)\">"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"//setting/management/idle-timeout\"/>'"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"//setting/management/idle-timeout\"/>'"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  regex            : "(Passed|Failed)"
  expect           : "Passed"
</custom_item>

<custom_item>
