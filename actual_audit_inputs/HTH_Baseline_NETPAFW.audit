<custom_item>
  type             : AUDIT_XML
  description      : "AC - NetPAFW - Banner - Enabled"
  info             : "Configure a login banner, ideally approved by the organization's legal team."
  reference        : "NIST 800-53r5|AC-8"
  see_also         : "HTH"
  api_request_type : "op"
  request          : "<show><config><merged></merged></config></show>"
  xsl_stmt         : "<xsl:template match=\"/\">"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"not(//login-banner)\">"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"//login-banner\"/>'"
  xsl_stmt         : "<xsl:template match=\"
  xsl_stmt         : "<xsl:template match=\"
  regex            : "(Passed|Failed)"
  expect           : "Passed"
</custom_item>

    <custom_item>
      type             : AUDIT_XML
      description      : "AU - NetPAFW - Ensure 'Enable Log on High DP Load' is enabled"
      info             : "Enable the option 'Enable Log on High DP Load' feature."
       reference       : "NIST 800-53r5|AU-1 AU-2"
      see_also         : "See HTH Policies and Standards"
      api_request_type : "op"
      request          : "<show><config><merged></merged></config></show>"
      xsl_stmt         : "<xsl:template match=\"/\">"
      xsl_stmt         : "<xsl:template match=\"
      xsl_stmt         : "<xsl:template match=\"not(//config/devices/entry/deviceconfig/setting/management/enable-log-high-dp-load) or not(//config/devices/entry/deviceconfig/setting/management/enable-log-high-dp-load='yes')\">"
      xsl_stmt         : "<xsl:template match=\"
      xsl_stmt         : "<xsl:template match=\"
      xsl_stmt         : "<xsl:template match=\"
      xsl_stmt         : "<xsl:template match=\"
      xsl_stmt         : "<xsl:template match=\"
      xsl_stmt         : "<xsl:template match=\"
      regex            : "(Passed|Failed)"
      expect           : "Passed"
    </custom_item>
   
    <if>
      <condition type:"AND">
        <custom_item>
          type             : AUDIT_XML
          description      : "Check for existence of permitted-ip"
          api_request_type : "op"
          request          : "<show><config><merged></merged></config></show>"
          xsl_stmt         : "<xsl:template match=\"/\">"
          xsl_stmt         : "<xsl:template match=\"
          xsl_stmt         : "<xsl:template match=\"//response/result/config/devices/entry/deviceconfig/system/permitted-ip\">"
          xsl_stmt         : "<xsl:template match=\"
          xsl_stmt         : "<xsl:template match=\"
          xsl_stmt         : "<xsl:template match=\"
          xsl_stmt         : "<xsl:template match=\"
          xsl_stmt         : "<xsl:template match=\"
          xsl_stmt         : "<xsl:template match=\"
          regex            : ".*"
          expect           : "passed"
        </custom_item>
      </condition>
   
      <then>
        <custom_item>
          type             : AUDIT_XML
          description      : "AC - NetPAFW - Ensure 'Permitted IP Addresses' is set to those necessary for device management"
          info             : "Permit only the necessary IP addresses to be used to manage the device."
            reference      : "NIST 800-53r5|AC-2(1) AC-3 AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
          see_also         : "See HTH Policies and Standards"
          api_request_type : "op"
          request          : "<show><config><merged></merged></config></show>"
          xsl_stmt         : "<xsl:template match=\"/\">"
          xsl_stmt         : "<xsl:template match=\"response/result/config/devices/entry/deviceconfig/system/permitted-ip/entry\">"
          xsl_stmt         : "<xsl:template match=\"@name\"/>"
          xsl_stmt         : "<xsl:template match=\"
          regex            : ".*"
          expect           : "MANUAL_REVIEW"
          severity         : MEDIUM
        </custom_item>
      </then>
   
      <else>
        <report type:"PASSED">
          description : "AC - NetPAFW - Ensure 'Permitted IP Addresses' is set to those necessary for device management"
          info        : "Permit only the necessary IP addresses to be used to manage the device."
       reference      : "NIST 800-53r5|AC-2(1) AC-3 AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
          see_also    : "See HTH Policies and Standards"
        </report>
      </else>
    </if>
   
