  reference       : "NIST 800-53r5|IA-5"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "\b[Aa]dmin(istrator)?"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $A = Get-CimInstance -ClassName Win32_UserAccount -EA SilentlyContinue | Where-Object { $_.SID -match ''-500$'' } | Select-Object -ExpandProperty Name -First 1; if([string]::IsNullOrEmpty($A)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output $A } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type      : CHECK_NOT_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0116 - MSSRV - When Preview Builds and Feature Updates are received is set to Enabled: 180 or more days"
  info            : "This policy setting determines when Preview Build or Feature Updates are received."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
  see_also        : "See HTH Policies and Standards"
