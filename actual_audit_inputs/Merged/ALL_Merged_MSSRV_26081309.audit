<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0806 - MSSRV - (L1) Ensure Network access: Shares that can be accessed anonymously is set to None"
  info            : "This policy setting determines which network shares can be accessed by anonymous users."
  solution        : "To establish the recommended configuration via GP, set the following UI path to <blank> (i.e. None):"
  reference       : "NIST 800-53r5|AC-3"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : ".+"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $P = ''Registry::HKLM\System\CurrentControlSet\Services\LanManServer\Parameters''; $K = ''NullSessionShares''; if(-not (Test-Path -Path $P)){ Write-Output ''__NON_COMPLIANT__''; return }; $R = Get-ItemProperty -Path $P -ErrorAction SilentlyContinue; if($null -eq $R){ Write-Output ''__NON_COMPLIANT__''; return }; $prop = $R.PSObject.Properties[$K]; if($null -eq $prop -or $null -eq $prop.Value){ Write-Output ''__NON_COMPLIANT__''; return }; $V = $prop.Value; if($null -eq $V -or [string]::IsNullOrWhiteSpace([string]$V)){ Write-Output ''__NON_COMPLIANT__'' } elseif($V -is [System.Array]){ $joined = ($V -join [Environment]::NewLine); if([string]::IsNullOrWhiteSpace([string]$joined)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output $joined } } else { Write-Output $V; } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0807 - MSSRV - (L1) Ensure Network security: Allow Local System to use computer identity for NTLM is set to Enabled"
  info            : "This policy setting determines whether Local System services that use Negotiate when reverting to NTLM authentication can use the computer identity."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled :"
  reference       : "NIST 800-53r5|IA-3"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "1"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $P = ''Registry::HKLM\System\CurrentControlSet\Control\Lsa''; $K = ''UseMachineId''; if(-not (Test-Path -Path $P)){ Write-Output ''__NON_COMPLIANT__''; return }; $R = Get-ItemProperty -Path $P -ErrorAction SilentlyContinue; if($null -eq $R){ Write-Output ''__NON_COMPLIANT__''; return }; $prop = $R.PSObject.Properties[$K]; if($null -eq $prop -or $null -eq $prop.Value){ Write-Output ''__NON_COMPLIANT__''; return }; $V = $prop.Value; if($null -eq $V -or [string]::IsNullOrWhiteSpace([string]$V)){ Write-Output ''__NON_COMPLIANT__'' } elseif($V -is [System.Array]){ $joined = ($V -join [Environment]::NewLine); if([string]::IsNullOrWhiteSpace([string]$joined)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output $joined } } else { Write-Output $V; } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
