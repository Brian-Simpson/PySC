  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0113 - MSSRV - Account - Rename Guest Account"
  info            : "The built-in local guest account is another well-known name to attackers."
  solution        : "To establish the recommended configuration via GP, configure the following UI path:"
  reference       : "NIST 800-53r5|IA-5"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "Guest"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $A = Get-CimInstance -ClassName Win32_UserAccount -EA SilentlyContinue | Where-Object { $_.SID -match ''-501$'' } | Select-Object -ExpandProperty Name -First 1; if([string]::IsNullOrEmpty($A)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output $A } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type      : CHECK_NOT_EQUAL
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0114 - MSSRV - Interactive logon: Prompt user to change password before expiration is set to between 5 and 14 days"
  info            : "This policy setting determines how far in advance users are warned that their password will expire."
  solution        : "To establish the recommended configuration via GP, set the following UI path to a value between 5 and 14 days :"
  reference       : "NIST 800-53r5|IA-5(1)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "^(?:5|6|7|8|9|[1-9]\d+)$"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '-NoProfile -ExecutionPolicy Bypass -Command ''$__pysc_result = (& { if(Test-Path -Path ''''HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon''''){$noutput = (Get-ItemProperty -Path ''''HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon'''').PasswordExpiryWarning; if($noutput -eq $Null) {Write-Output ''''__NON_COMPLIANT__''''} else {$noutput}} else {Write-Output ''''__NON_COMPLIANT__''''} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''''__NON_COMPLIANT__'''' } else { Write-Output ($__pysc_result.Trim()) }'''"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0115 - MSSRV - Account - Rename Local Admin"
  info            : "The built-in local administrator account is a well-known account name that attackers will target."
