<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0897 - MSSRV - (L1) Ensure Audit Kerberos Authentication Service is set to Success and Failure (DC Only)"
  info            : "This subcategory reports the results of events generated after a Kerberos authentication TGT request."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Success and Failure :"
  reference       : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "Success and Failure"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $rows = auditpol /get /Subcategory:''Kerberos Authentication Service'' /r 2>$null | ConvertFrom-Csv; $row = if($rows){ $rows | Where-Object { $_.Subcategory -eq ''Kerberos Authentication Service'' } | Select-Object -First 1 } else { $null }; $inc = if($row){ [string]$row.''Inclusion Setting'' } else { '''' }; if(-not [string]::IsNullOrWhiteSpace($inc)){ Write-Output $inc.Trim(); return }; $AP = auditpol /get /Subcategory:''Kerberos Authentication Service'' 2>$null | ForEach-Object { $_.ToString() }; $line = $AP | Where-Object { $_ -match ''^\s*Kerberos\ Authentication\ Service\s{2,}'' } | Select-Object -First 1; if(-not $line){ Write-Output ''Not Found''; return }; if($line -match ''Success and Failure''){ Write-Output ''Success and Failure''; return }; if($line -match ''No Auditing''){ Write-Output ''No Auditing''; return }; if($line -match ''Success''){ Write-Output ''Success''; return }; if($line -match ''Failure''){ Write-Output ''Failure''; return }; Write-Output $line; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type      : CHECK_REGEX
</custom_item>

