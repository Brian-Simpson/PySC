<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0450 - MSSRV - Ensure Prevent users from sharing files within their profile. is set to Enabled"
  info              : "This policy setting determines whether users can share files within their profile."
  solution          : "To establish the recommended configuration via GP, set the following UI path to Enabled: User Configuration\Policies\Administrative Templates\Windows Components\Network Sharing\Prevent users from sharing files within their profile. Note: This Group Policy path is provided by the Group Policy template Sharing.admx/adml that is included with all versions of the Microsoft Windows Administrative Templates. Impact: Users cannot share files within their profile using the sharing wizard. Also, the sharing wizard cannot create a share at %root%\Users and can only be used to create SMB shares on folders."
  reference         : "NIST 800-53r5|AC-3"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "1"
  powershell_option : CAN_BE_NULL
  powershell_args   : "-NoProfile -ExecutionPolicy Bypass -Command '-NoProfile -ExecutionPolicy Bypass -Command ''$__pysc_result = (& { (Get-ItemProperty -Path ''''HKU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer'''' -Name ''''NoInplaceSharing'''' -ErrorAction SilentlyContinue).NoInplaceSharing } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''''__NON_COMPLIANT__'''' } else { Write-Output ($__pysc_result.Trim()) }'''"
</custom_item>

