  value_type      : POLICY_TEXT
  value_data      : "5"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $lockoutObj = net accounts | Select-string threshold; $lockoutStr = $lockoutObj.ToString(); $lockoutStr -match ''\d{1,3}'' | out-null; $lockoutStr -match ''Never'' | out-null; $LO_threshold = $matches[0]; Write-Output $LO_threshold; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0050 - MSSRV - User Account Control: Only elevate UIAccess applications that are installed in secure locations is set to Enabled"
  info            : "This policy setting controls whether applications that request to run with a User Interface Accessibility (UIAccess) integrity level must reside in a secure location in the file system."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled :"
