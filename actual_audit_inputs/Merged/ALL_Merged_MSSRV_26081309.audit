  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0053 - MSSRV - Application: Specify the maximum log file size (KB) is set to Enabled: 32,768 or greater"
  info            : "This policy setting specifies the maximum size of the log file in kilobytes."
