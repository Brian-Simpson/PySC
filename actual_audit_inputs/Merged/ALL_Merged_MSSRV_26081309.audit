# generated_by: merge-master-audits-v2
<check_type:"Windows" version:"2">
<group_policy:"MSSRV">

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "Network Information"
  info            : "This obtains relevent hosted view network information that may be used for additional evaluation."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53r5|"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : ".*"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '-NoProfile -ExecutionPolicy Bypass -Command ''$__pysc_result = (& { Get-NetIPConfiguration -Detailed ;(Get-ItemProperty -Path ''''HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.2\Server''''); } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''''__NON_COMPLIANT__'''' } else { Write-Output ($__pysc_result.Trim()) }'''"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "System/Domain Identification"
  info            : "This obtains specific user and system information that may be used for additional evaluation."
  solution        : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference       : "NIST 800-53r5|"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : ".*"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { (Get-ComputerInfo) |Select-Object OSDisplayVersion, CsManufacturer, CsModel, BiosBIOSVersion, BiosSeralNumber, CsUserName, OsName, OsBuildNumber, OsProductType, CsDNSHostName, CsDomain; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type      : CHECK_REGEX
</custom_item>

<if>
  <condition type:"AND">
<custom_item>
  type        : REGISTRY_SETTING
  description : "Windows Server is installed"
  value_type  : POLICY_TEXT
  value_data  : "^[Ww][Ii][Nn][Dd][Oo][Ww][Ss].+[Ss][Ee][Rr][Vv][Ee][Rr].+$"
  reg_key     : "HKLM\Software\Microsoft\Windows Nt\Currentversion"
  reg_item    : "ProductName"
  check_type  : CHECK_REGEX
</custom_item>
  </condition>

