<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0054 - MSSRV - Profile single process is set to Administrators"
  info            : "This policy setting determines which users can use tools to monitor the performance of non-system processes."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Administrators :"
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "(?s)^(?:Administrators|'?NO_MEMBERS'?)$"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match ''^\s*SeProfileSingleProcessPrivilege\s*='' } | Select-Object -Last 1); $m=if($l){ ($l -replace ''.*='', '''').Split('','') | ForEach-Object { $s=$_.Trim(); $s=$s -replace ''^\*'', ''''; if($s -match ''^S-1-5-''){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split(''\\'')[-1]}catch{$s} } else { if($s -match ''\\''){ $s.Split(''\\'')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join '','' } else { ''NO_MEMBERS'' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0055 - MSSRV - Audit Account Lockout is set to include Failure"
  info            : "This subcategory reports when a user s account is locked out as a result of too many failed logon attempts."
  solution        : "To establish the recommended configuration via GP, set the following UI path to include Failure :"
  reference       : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "(?s)^(?:Failure|Success\ and\ Failure)$"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $rows = auditpol /get /Subcategory:''Account Lockout'' /r 2>$null | ConvertFrom-Csv; $row = if($rows){ $rows | Where-Object { $_.Subcategory -eq ''Account Lockout'' } | Select-Object -First 1 } else { $null }; $inc = if($row){ [string]$row.''Inclusion Setting'' } else { '''' }; if(-not [string]::IsNullOrWhiteSpace($inc)){ Write-Output $inc.Trim(); return }; $AP = auditpol /get /Subcategory:''Account Lockout'' 2>$null | ForEach-Object { $_.ToString() }; $line = $AP | Where-Object { $_ -match ''^\s*Account\ Lockout\s{2,}'' } | Select-Object -First 1; if(-not $line){ Write-Output ''Not Found''; return }; if($line -match ''Success and Failure''){ Write-Output ''Success and Failure''; return }; if($line -match ''No Auditing''){ Write-Output ''No Auditing''; return }; if($line -match ''Success''){ Write-Output ''Success''; return }; if($line -match ''Failure''){ Write-Output ''Failure''; return }; Write-Output $line; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0056 - MSSRV - Profile system performance is set to Administrators, NT SERVICE\WdiServiceHost"
  info            : "This policy setting allows users to use tools to view the performance of different system processes, which could be abused to allow attackers to determine a system s active processes and provide insight into the potential attack surface of the computer."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Administrators, NT SERVICE\WdiServiceHost :"
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "^(?:Administrators,(?:NT SERVICE\\)?WdiServiceHost|'?NO_MEMBERS'?)$"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match ''^\s*SeSystemProfilePrivilege\s*='' } | Select-Object -Last 1); $m=if($l){ ($l -replace ''.*='', '''').Split('','') | ForEach-Object { $s=$_.Trim(); $s=$s -replace ''^\*'', ''''; if($s -match ''^S-1-5-''){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split(''\\'')[-1]}catch{$s} } else { if($s -match ''\\''){ $s.Split(''\\'')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join '','' } else { ''NO_MEMBERS'' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type      : CHECK_SUPERSET
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0057 - MSSRV - Replace a process level token is set to LOCAL SERVICE, NETWORK SERVICE"
