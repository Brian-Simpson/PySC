  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '-NoProfile -ExecutionPolicy Bypass -Command ''$__pysc_result = (& { if(Test-Path -Path ''''HKLM:\Software\Policies\Microsoft\Windows\EventLog\Application''''){$noutput = (Get-ITEMProperty -Path ''''HKLM:\Software\Policies\Microsoft\Windows\EventLog\Application'''').MaxSize; if($noutput -eq $Null) {Write-Output ''''__NON_COMPLIANT__''''} else {$noutput}} else {Write-Output ''''__NON_COMPLIANT__''''} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''''__NON_COMPLIANT__'''' } else { Write-Output ($__pysc_result.Trim()) }'''"
