  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $rows = auditpol /get /Subcategory:''Kerberos Service Ticket Operations'' /r 2>$null | ConvertFrom-Csv; $row = if($rows){ $rows | Where-Object { $_.Subcategory -eq ''Kerberos Service Ticket Operations'' } | Select-Object -First 1 } else { $null }; $inc = if($row){ [string]$row.''Inclusion Setting'' } else { '''' }; if(-not [string]::IsNullOrWhiteSpace($inc)){ Write-Output $inc.Trim(); return }; $AP = auditpol /get /Subcategory:''Kerberos Service Ticket Operations'' 2>$null | ForEach-Object { $_.ToString() }; $line = $AP | Where-Object { $_ -match ''^\s*Kerberos\ Service\ Ticket\ Operations\s{2,}'' } | Select-Object -First 1; if(-not $line){ Write-Output ''Not Found''; return }; if($line -match ''Success and Failure''){ Write-Output ''Success and Failure''; return }; if($line -match ''No Auditing''){ Write-Output ''No Auditing''; return }; if($line -match ''Success''){ Write-Output ''Success''; return }; if($line -match ''Failure''){ Write-Output ''Failure''; return }; Write-Output $line; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
