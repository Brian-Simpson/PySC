  type            : AUDIT_POWERSHELL
  description     : "1.0046 - MSSRV - Sign-in and lock last interactive user automatically after a restart is configured correctly."
  info            : "This policy setting controls whether a device will automatically sign-in the last interactive user after Windows Update restarts the system."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Disabled :"
  reference       : "NIST 800-53r5|AC-11"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "1"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '-NoProfile -ExecutionPolicy Bypass -Command ''$__pysc_result = (& { if(Test-Path -Path ''''HKLM:\Software\Microsoft\Windows\CurrentVersion\policies\system''''){$noutput = (Get-ItemProperty -Path ''''HKLM:\Software\Microsoft\Windows\CurrentVersion\policies\system'''').DisableAutomaticRestartSignOn;if($noutput -eq $Null) {Write-Output ''''__NON_COMPLIANT__''''} else {$noutput}}else {Write-Output ''''__NON_COMPLIANT__''''} } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''''__NON_COMPLIANT__'''' } else { Write-Output ($__pysc_result.Trim()) }'''"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0047 - MSSRV - Password - Account Lockout Reset - 1 day"
  info            : "This policy setting determines the length of time before the Account lockout threshold resets to zero."
  solution        : "To establish the recommended configuration via GP, set the following UI path to 15 or more minute(s) :"
  reference       : "NIST 800-53r5|AC-7 AC-19"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "60"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $LockObsObj = net accounts | Select-string ''Lockout observation''; $LockObsStr = $LockObsObj.ToString(); $LockObsStr -match ''\d{1,2}'' | out-null; $LockObsStr -match ''60'' | out-null; $LO_LockObs = $matches[0]; Write-Output $LO_LockObs; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
