  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0884 - MSSRV - (L1) Ensure Access this computer from the network is set to Administrators, Authenticated Users, ENTERPRISE DOMAIN CONTROLLERS (DC only)"
  info            : "This policy setting allows other users on the network to connect to the computer and is required by various network protocols that include Server Message Block (SMB)-based protocols, NetBIOS, Common Internet File System (CIFS), and Component Object Model Plus (COM+)."
  solution        : "To establish the recommended configuration via GP, configure the following UI path to Administrators, Authenticated Users, ENTERPRISE DOMAIN CONTROLLERS :"
  reference       : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "^(?:Administrators,Authenticated Users,Enterprise Domain Controllers|'?NO_MEMBERS'?)$"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match ''^\s*SeNetworkLogonRight\s*='' } | Select-Object -Last 1); $m=if($l){ ($l -replace ''.*='', '''').Split('','') | ForEach-Object { $s=$_.Trim(); $s=$s -replace ''^\*'', ''''; if($s -match ''^S-1-5-''){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split(''\\'')[-1]}catch{$s} } else { if($s -match ''\\''){ $s.Split(''\\'')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join '','' } else { ''NO_MEMBERS'' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type      : CHECK_REGEX
</custom_item>

<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0885 - MSSRV - (L1) Ensure Deny access to this computer from the network to include Guests (DC only)"
  info            : "This policy setting prohibits users from connecting to a computer from across the network, which would allow users to access and potentially modify data remotely."
  solution        : "To establish the recommended configuration via GP, configure the following UI path to include Guests :"
