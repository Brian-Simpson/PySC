<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0150 - MSSVR - (L1) Ensure 'LSA Protection' is set to 'Enabled'"
  info                     : "This policy setting controls whether the Local Security Authority Server Service (LSASS) process runs protected."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
