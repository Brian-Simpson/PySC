<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0210 - MSSVR - (L1) Ensure 'Prevent users from sharing files within their profile.' is set to 'Enabled'"
  info                     : "This policy setting determines whether users can share files within their profile."
