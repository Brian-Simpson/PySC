  reg_item                 : "PreXPSP2ShellProtocolBehavior"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0072 - MSSVR - (L1) Ensure 'Block all consumer Microsoft account user authentication' is set to 'Enabled'"
  info                     : "This setting determines whether applications and services on the device can utilize new consumer Microsoft account authentication via the Windows OnlineID and WebAccountManager APIs."
