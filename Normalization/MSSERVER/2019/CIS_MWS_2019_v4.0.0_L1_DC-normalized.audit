  reg_item                 : "RestrictSendingNTLMTraffic"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0277 - MSSVR - (L1) Ensure 'Network security: Allow LocalSystem NULL session fallback' is set to 'Disabled'"
  info                     : "This policy setting determines whether NTLM is allowed to fall back to a NULL session when used with LocalSystem."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
