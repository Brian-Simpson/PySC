  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0146 - MSSVR - (L1) Ensure 'Configure SMB v1 server' is set to 'Disabled'"
  info                     : "This setting configures the server-side processing of the Server Message Block version 1 (SMBv1) protocol."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
