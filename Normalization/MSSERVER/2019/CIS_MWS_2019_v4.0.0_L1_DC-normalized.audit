  audit_policy_subcategory : "File Share"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0031 - MSSVR - (L1) Ensure 'Audit Other Object Access Events' is set to 'Success and Failure'"
