  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\System"
  reg_item                 : "BlockDomainPicturePassword"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0199 - MSSVR - (L1) Ensure 'Turn on convenience PIN sign-in' is set to 'Disabled'"
  info                     : "This policy setting allows you to control whether a domain user can sign in using a convenience PIN."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
