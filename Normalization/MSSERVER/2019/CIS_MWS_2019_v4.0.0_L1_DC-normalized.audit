  value_data               : "2"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\NTDS\Parameters"
  reg_item                 : "LdapEnforceChannelBinding"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0305 - MSSVR - (L1) Ensure 'Domain controller: LDAP server signing requirements' is set to 'Require signing' (DC only)"
  info                     : "This policy setting determines whether the Lightweight Directory Access Protocol (LDAP) server requires LDAP clients to negotiate data signing."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : 2
  reg_key                  : "HKLM\System\CurrentControlSet\Services\NTDS\Parameters"
  reg_item                 : "LDAPServerIntegrity"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0306 - MSSVR - (L1) Ensure 'Domain controller: Refuse machine account password changes' is set to 'Disabled' (DC only)"
  info                     : "This security setting determines whether Domain Controllers will refuse requests from member computers to change computer account passwords."
  reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : 0
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
  reg_item                 : "RefusePasswordChange"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0307 - MSSVR - (L1) Ensure 'Domain member: Digitally encrypt or sign secure channel data (always)' is set to 'Enabled'"
  info                     : "This policy setting determines whether all secure channel traffic that is initiated by the domain member must be signed or encrypted."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
  reg_item                 : "RequireSignOrSeal"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0308 - MSSVR - (L1) Ensure 'Domain member: Digitally encrypt secure channel data (when possible)' is set to 'Enabled'"
  info                     : "This policy setting determines whether a domain member should attempt to negotiate encryption for all secure channel traffic that it initiates."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
  reg_item                 : "SealSecureChannel"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0309 - MSSVR - (L1) Ensure 'Domain member: Digitally sign secure channel data (when possible)' is set to 'Enabled'"
  info                     : "This policy setting determines whether a domain member should attempt to negotiate whether all secure channel traffic that it initiates must be digitally signed."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
  reg_item                 : "SignSecureChannel"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0310 - MSSVR - (L1) Ensure 'Domain member: Disable machine account password changes' is set to 'Disabled'"
  info                     : "This policy setting determines whether a domain member can periodically change its computer account password."
  reference                : "NIST 800-53r5|AC-2(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
  reg_item                 : "DisablePasswordChange"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0311 - MSSVR - (L1) Ensure 'Domain member: Maximum machine account password age' is set to '30 or fewer days, but not 0'"
  info                     : "This policy setting determines the maximum allowable age for a computer account password."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[1..30]"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
  reg_item                 : "MaximumPasswordAge"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0312 - MSSVR - (L1) Ensure 'Domain member: Require strong (Windows 2000 or later) session key' is set to 'Enabled'"
  info                     : "When this policy setting is enabled, a secure channel can only be established with Domain Controllers that are capable of encrypting secure channel data with a strong (128-bit) session key."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Netlogon\Parameters"
  reg_item                 : "RequireStrongKey"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0313 - MSSVR - (L1) Ensure 'Interactive logon: Do not require CTRL+ALT+DEL' is set to 'Disabled'"
  info                     : "This policy setting determines whether users must press CTRL+ALT+DEL before they log on."
  reference                : "NIST 800-53r5|AC-7 AC-19"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "DisableCAD"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0314 - MSSVR - (L1) Ensure 'Interactive logon: Don't display last signed-in' is set to 'Enabled'"
  info                     : "This policy setting determines whether the account name of the last user to log on to the client computers in your organization will be displayed in each computer's respective Windows logon screen."
  reference                : "NIST 800-53r5|AC-7 AC-19"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "DontDisplayLastUserName"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0315 - MSSVR - (L1) Ensure 'Interactive logon: Machine inactivity limit' is set to '900 or fewer second(s), but not 0'"
  info                     : "Windows notices inactivity of a logon session, and if the amount of inactive time exceeds the inactivity limit, then the screen saver will run, locking the session."
  reference                : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[1..900]"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "InactivityTimeoutSecs"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : BANNER_CHECK
  description              : "1.0316 - MSSVR - (L1) Configure 'Interactive logon: Message text for users attempting to log on'"
  info                     : "This policy setting specifies a text message that displays to users when they log on."
  reference                : "NIST 800-53r5|AC-8"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "All activities performed on this system will be monitored."
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "LegalNoticeText"
</custom_item>

<custom_item>
  type                     : BANNER_CHECK
  description              : "1.0317 - MSSVR - (L1) Configure 'Interactive logon: Message title for users attempting to log on'"
  info                     : "This policy setting specifies the text displayed in the title bar of the window that users see when they log on to the system."
  reference                : "NIST 800-53r5|AC-8"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Notice and Consent Banner"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"
  reg_item                 : "LegalNoticeCaption"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0318 - MSSVR - (L1) Ensure 'Interactive logon: Prompt user to change password before expiration' is set to 'between 5 and 14 days'"
  info                     : "This policy setting determines how far in advance users are warned that their password will expire."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[5..14]"
  reg_key                  : "HKLM\Software\Microsoft\Windows NT\CurrentVersion\Winlogon"
  reg_item                 : "PasswordExpiryWarning"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0319 - MSSVR - (L1) Ensure 'Interactive logon: Smart card removal behavior' is set to 'Lock Workstation' or higher"
  info                     : "This policy setting determines what happens when the smart card for a logged-on user is removed from the smart card reader."
  reference                : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "^(1|2|3)$"
  reg_key                  : "HKLM\Software\Microsoft\Windows NT\CurrentVersion\Winlogon"
  reg_item                 : "ScRemoveOption"
  reg_option               : CAN_NOT_BE_NULL
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0320 - MSSVR - (L1) Ensure 'Microsoft network client: Digitally sign communications (always)' is set to 'Enabled'"
  info                     : "This policy setting determines whether packet signing is required by the SMB client component."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanmanWorkstation\Parameters"
  reg_item                 : "RequireSecuritySignature"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0321 - MSSVR - (L1) Ensure 'Microsoft network client: Digitally sign communications (if server agrees)' is set to 'Enabled'"
  info                     : "This policy setting determines whether the SMB client will attempt to negotiate SMB packet signing."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanmanWorkstation\Parameters"
  reg_item                 : "EnableSecuritySignature"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0322 - MSSVR - (L1) Ensure 'Microsoft network client: Send unencrypted password to third-party SMB servers' is set to 'Disabled'"
  info                     : "This policy setting determines whether the SMB redirector will send plaintext passwords during authentication to third-party SMB servers that do not support password encryption."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanmanWorkstation\Parameters"
  reg_item                 : "EnablePlainTextPassword"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0323 - MSSVR - (L1) Ensure 'Microsoft network server: Amount of idle time required before suspending session' is set to '15 or fewer minute(s)'"
  info                     : "This policy setting allows you to specify the amount of continuous idle time that must pass in an SMB session before the session is suspended because of inactivity."
  reference                : "NIST 800-53r5|AC-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "[1..15]"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "AutoDisconnect"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0324 - MSSVR - (L1) Ensure 'Microsoft network server: Digitally sign communications (always)' is set to 'Enabled'"
  info                     : "This policy setting determines whether packet signing is required by the SMB server component."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "RequireSecuritySignature"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0325 - MSSVR - (L1) Ensure 'Microsoft network server: Digitally sign communications (if client agrees)' is set to 'Enabled'"
  info                     : "This policy setting determines whether the SMB server will negotiate SMB packet signing with clients that request it."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "EnableSecuritySignature"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0326 - MSSVR - (L1) Ensure 'Microsoft network server: Disconnect clients when logon hours expire' is set to 'Enabled'"
  info                     : "This security setting determines whether to disconnect users who are connected to the local computer outside their user account's valid logon hours."
  reference                : "NIST 800-53r5|AC-2(12)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "EnableForcedLogoff"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0327 - MSSVR - (L1) Ensure 'Print Spooler (Spooler)' is set to 'Disabled' (DC only)"
  info                     : "This service spools print jobs and handles interaction with printers."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : 4
  reg_key                  : "HKLM\System\CurrentControlSet\Services\Spooler"
  reg_item                 : "Start"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0328 - MSSVR - (L1) Ensure 'Windows Firewall: Domain: Firewall state' is set to 'On (recommended)'"
  info                     : "Select On (recommended) to have Windows Firewall with Advanced Security use the settings for this profile to filter network traffic."
  reference                : "NIST 800-53r5|SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\WindowsFirewall\DomainProfile"
  reg_item                 : "EnableFirewall"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0329 - MSSVR - (L1) Ensure 'Windows Firewall: Domain: Inbound connections' is set to 'Block (default)'"
  info                     : "This setting determines the behavior for inbound connections that do not match an inbound firewall rule."
  reference                : "NIST 800-53r5|SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\WindowsFirewall\DomainProfile"
  reg_item                 : "DefaultInboundAction"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0330 - MSSVR - (L1) Ensure 'Windows Firewall: Domain: Settings: Display a notification' is set to 'No'"
  info                     : "Select this option to have Windows Firewall with Advanced Security display notifications to the user when a program is blocked from receiving inbound connections."
  reference                : "NIST 800-53r5|SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\WindowsFirewall\DomainProfile"
  reg_item                 : "DisableNotifications"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

