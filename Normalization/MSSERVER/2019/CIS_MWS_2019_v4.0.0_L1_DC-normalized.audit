  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Connect"
  reg_item                 : "RequirePinForPairing"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0047 - MSSVR - (L1) Ensure 'Do not display the password reveal button' is set to 'Enabled'"
  info                     : "This policy setting allows you to configure the display of the password reveal button in password entry user experiences."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\CredUI"
  reg_item                 : "DisablePasswordReveal"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0048 - MSSVR - (L1) Ensure 'Enumerate administrator accounts on elevation' is set to 'Disabled'"
  info                     : "This policy setting controls whether administrator accounts are displayed when a user attempts to elevate a running application."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\CredUI"
  reg_item                 : "EnumerateAdministrators"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0049 - MSSVR - (L1) Ensure 'Allow Diagnostic Data' is set to 'Enabled: Diagnostic data off (not recommended)' or 'Enabled: Send required diagnostic data'"
  info                     : "This policy setting determines the amount of diagnostic and usage data reported to Microsoft: - A value of (0) Diagnostic data off (not recommended) Using this value, no diagnostic data is sent from the device."
  reference                : "NIST 800-53r5|CM-7b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
