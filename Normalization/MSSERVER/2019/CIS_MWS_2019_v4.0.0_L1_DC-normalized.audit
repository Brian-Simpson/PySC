<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0198 - MSSVR - (L1) Ensure 'Turn off picture password sign-in' is set to 'Enabled'"
  info                     : "This policy setting allows you to control whether a domain user can sign in using a picture password."
  reference                : "NIST 800-53r5|CM-6 CM-7"
