
<check_type:"Windows" version:"2">
<group_policy:"CIS Microsoft Windows Server 2019">

<if>
  <condition type:"AND">
<custom_item>
  type                     : REGISTRY_SETTING
  description              : "Windows Server 2019 is installed"
  value_type               : POLICY_TEXT
  value_data               : "^[a-zA-Z0-9\(\)\s]*2019[\s]*[a-zA-Z0-9\(\)\s:]*$"
  reg_key                  : "HKLM\Software\Microsoft\Windows Nt\Currentversion"
  reg_item                 : "ProductName"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : WMI_POLICY
  description              : "Check if server is Domain Controller"
  value_type               : POLICY_DWORD
  value_data               : 4 || 5
  wmi_namespace            : "root/CIMV2"
  wmi_request              : "select DomainRole from Win32_ComputerSystem"
  wmi_attribute            : "DomainRole"
  wmi_key                  : "DomainRole"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description : "HTH_Microsoft_Windows_Server_2019_v4.0.0_L1_DC.audit from HTH Microsoft Windows Server 2019 Benchmark v4.0.0"
  see_also    : "See HTH Policies and Standards"
</report>

<custom_item>
  type                     : PASSWORD_POLICY
  description              : "1.0001 - MSSVR - (L1) Ensure 'Enforce password history' is set to '24 or more password(s)'"
  info                     : "This policy setting determines the number of renewed, unique passwords that have to be associated with a user account before you can reuse an old password."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : [24..MAX]
  password_policy          : ENFORCE_PASSWORD_HISTORY
</custom_item>

<custom_item>
  type                     : PASSWORD_POLICY
  description              : "1.0002 - MSSVR - (L1) Ensure 'Maximum password age' is set to '365 or fewer days, but not 0'"
  info                     : "This policy setting defines how long a user can use their password before it expires."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : TIME_DAY
  value_data               : [1..365]
  password_policy          : MAXIMUM_PASSWORD_AGE
</custom_item>

<custom_item>
  type                     : PASSWORD_POLICY
  description              : "1.0003 - MSSVR - (L1) Ensure 'Minimum password age' is set to '1 or more day(s)'"
  info                     : "This policy setting determines the number of days that you must use a password before you can change it."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : TIME_DAY
  value_data               : [1..MAX]
  password_policy          : MINIMUM_PASSWORD_AGE
</custom_item>

<custom_item>
  type                     : PASSWORD_POLICY
  description              : "1.0004 - MSSVR - (L1) Ensure 'Minimum password length' is set to '14 or more character(s)'"
  info                     : "This policy setting determines the least number of characters that make up a password for a user account."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : [14..MAX]
  password_policy          : MINIMUM_PASSWORD_LENGTH
</custom_item>

<custom_item>
  type                     : PASSWORD_POLICY
  description              : "1.0005 - MSSVR - (L1) Ensure 'Password must meet complexity requirements' is set to 'Enabled'"
  info                     : "This policy setting checks all new passwords to ensure that they meet basic requirements for strong passwords."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_SET
  value_data               : "Enabled"
  password_policy          : COMPLEXITY_REQUIREMENTS
</custom_item>

<custom_item>
  type                     : PASSWORD_POLICY
  description              : "1.0006 - MSSVR - (L1) Ensure 'Store passwords using reversible encryption' is set to 'Disabled'"
  info                     : "This policy setting determines whether the operating system stores passwords in a way that uses reversible encryption, which provides support for application protocols that require knowledge of the user's password for authentication purposes."
  reference                : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_SET
  value_data               : "Disabled"
  password_policy          : REVERSIBLE_ENCRYPTION
</custom_item>

<custom_item>
  type                     : LOCKOUT_POLICY
  description              : "1.0007 - MSSVR - (L1) Ensure 'Account lockout duration' is set to '15 or more minute(s)'"
  info                     : "This policy setting determines the length of time that must pass before a locked account is unlocked and a user can try to log on again."
  reference                : "NIST 800-53r5|AC-7 AC-19"
  see_also                 : "See HTH Policies and Standards"
  value_type               : TIME_MINUTE
  value_data               : [15..MAX]
  lockout_policy           : LOCKOUT_DURATION
</custom_item>

<custom_item>
  type                     : LOCKOUT_POLICY
  description              : "1.0008 - MSSVR - (L1) Ensure 'Account lockout threshold' is set to '5 or fewer invalid logon attempt(s), but not 0'"
  info                     : "This policy setting determines the number of failed logon attempts before the account is locked."
  reference                : "NIST 800-53r5|AC-7 AC-19"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : [1..5]
  lockout_policy           : LOCKOUT_THRESHOLD
</custom_item>

<custom_item>
  type                     : LOCKOUT_POLICY
  description              : "1.0009 - MSSVR - (L1) Ensure 'Reset account lockout counter after' is set to '15 or more minute(s)'"
  info                     : "This policy setting determines the length of time before the Account lockout threshold resets to zero."
  reference                : "NIST 800-53r5|AC-7 AC-19"
  see_also                 : "See HTH Policies and Standards"
  value_type               : TIME_MINUTE
  value_data               : [15..MAX]
  lockout_policy           : LOCKOUT_RESET
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0010 - MSSVR - (L1) Ensure 'Audit Credential Validation' is set to 'Success and Failure'"
  info                     : "This subcategory reports the results of validation tests on credentials submitted for a user account logon request."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success, Failure"
  audit_policy_subcategory : "Credential Validation"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0011 - MSSVR - (L1) Ensure 'Audit Kerberos Authentication Service' is set to 'Success and Failure' (DC Only)"
  info                     : "This subcategory reports the results of events generated after a Kerberos authentication TGT request."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success, Failure"
  audit_policy_subcategory : "Kerberos Authentication Service"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0012 - MSSVR - (L1) Ensure 'Audit Kerberos Service Ticket Operations' is set to 'Success and Failure' (DC Only)"
  info                     : "This subcategory reports the results of events generated by Kerberos authentication ticket-granting ticket (TGT) requests."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success, Failure"
  audit_policy_subcategory : "Kerberos Service Ticket Operations"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0013 - MSSVR - (L1) Ensure 'Audit Application Group Management' is set to 'Success and Failure'"
  info                     : "This policy setting allows you to audit events generated by changes to application groups such as the following: - Application group is created, changed, or deleted."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success, Failure"
  audit_policy_subcategory : "Application Group Management"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0014 - MSSVR - (L1) Ensure 'Audit Computer Account Management' is set to include 'Success' (DC only)"
  info                     : "This subcategory reports each event of computer account management, such as when a computer account is created, changed, deleted, renamed, disabled, or enabled."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success, Failure" || "Success"
  audit_policy_subcategory : "Computer Account Management"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0015 - MSSVR - (L1) Ensure 'Audit Distribution Group Management' is set to include 'Success' (DC only)"
  info                     : "This subcategory reports each event of distribution group management, such as when a distribution group is created, changed, or deleted or when a member is added to or removed from a distribution group."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success, Failure" || "Success"
  audit_policy_subcategory : "Distribution Group Management"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0016 - MSSVR - (L1) Ensure 'Audit Other Account Management Events' is set to include 'Success' (DC only)"
  info                     : "This subcategory reports other account management events."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success" || "Success, Failure"
  audit_policy_subcategory : "Other Account Management Events"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0017 - MSSVR - (L1) Ensure 'Audit Security Group Management' is set to include 'Success'"
  info                     : "This subcategory reports each event of security group management, such as when a security group is created, changed, or deleted or when a member is added to or removed from a security group."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success" || "Success, Failure"
  audit_policy_subcategory : "Security Group Management"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0018 - MSSVR - (L1) Ensure 'Audit User Account Management' is set to 'Success and Failure'"
  info                     : "This subcategory reports each event of user account management, such as when a user account is created, changed, or deleted; a user account is renamed, disabled, or enabled; or a password is set or changed."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success, Failure"
  audit_policy_subcategory : "User Account Management"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0019 - MSSVR - (L1) Ensure 'Audit PNP Activity' is set to include 'Success'"
  info                     : "This policy setting allows you to audit when plug and play detects an external device."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success" || "Success, Failure"
  audit_policy_subcategory : "Plug and Play Events"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0020 - MSSVR - (L1) Ensure 'Audit Process Creation' is set to include 'Success'"
  info                     : "This subcategory reports the creation of a process and the name of the program or user that created it."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success" || "Success, Failure"
  audit_policy_subcategory : "Process Creation"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0021 - MSSVR - (L1) Ensure 'Audit Directory Service Access' is set to include 'Failure' (DC only)"
  info                     : "This subcategory reports when an AD DS object is accessed."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Failure" || "Success, Failure"
  audit_policy_subcategory : "Directory Service Access"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0022 - MSSVR - (L1) Ensure 'Audit Directory Service Changes' is set to include 'Success' (DC only)"
  info                     : "This subcategory reports changes to objects in Active Directory Domain Services (AD DS)."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
