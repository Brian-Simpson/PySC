<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0143 - MSSVR - (L1) Ensure 'Prevent enabling lock screen slide show' is set to 'Enabled'"
  info                     : "Disables the lock screen slide show settings in PC Settings and prevents a slide show from playing on the lock screen."
  reference                : "NIST 800-53r5|CM-6b."
