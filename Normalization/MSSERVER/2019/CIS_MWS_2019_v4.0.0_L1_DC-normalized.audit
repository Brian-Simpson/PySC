  reg_item                 : "NodeType"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0152 - MSSVR - (L1) Ensure 'WDigest Authentication' is set to 'Disabled'"
  info                     : "When WDigest authentication is enabled, Lsass."
  reference                : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
