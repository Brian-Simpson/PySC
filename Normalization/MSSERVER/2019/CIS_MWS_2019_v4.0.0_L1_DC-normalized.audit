  value_type               : AUDIT_SET
  value_data               : "Failure" || "Success, Failure"
  audit_policy_subcategory : "Detailed File Share"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0030 - MSSVR - (L1) Ensure 'Audit File Share' is set to 'Success and Failure'"
  info                     : "This policy setting allows you to audit attempts to access a shared folder."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
