  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DataCollection"
  reg_item                 : "AllowTelemetry"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0050 - MSSVR - (L1) Ensure 'Disable OneSettings Downloads' is set to 'Enabled'"
  info                     : "This policy setting controls whether Windows attempts to connect with the OneSettings service to download configuration settings."
  reference                : "NIST 800-53r5|SI-4"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : 1
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DataCollection"
  reg_item                 : "DisableOneSettingsDownloads"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0051 - MSSVR - (L1) Ensure 'Do not show feedback notifications' is set to 'Enabled'"
  info                     : "This policy setting allows an organization to prevent its devices from showing feedback questions from Microsoft."
  reference                : "NIST 800-53r5|CM-7b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DataCollection"
  reg_item                 : "DoNotShowFeedbackNotifications"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0052 - MSSVR - (L1) Ensure 'Enable OneSettings Auditing' is set to 'Enabled'"
  info                     : "This policy setting controls whether Windows records attempts to connect with the OneSettings service to the Event Log."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DataCollection"
  reg_item                 : "EnableOneSettingsAuditing"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0053 - MSSVR - (L1) Ensure 'Limit Diagnostic Log Collection' is set to 'Enabled'"
  info                     : "This policy setting controls whether additional diagnostic logs are collected when more information is needed to troubleshoot a problem on the device."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DataCollection"
  reg_item                 : "LimitDiagnosticLogCollection"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0054 - MSSVR - (L1) Ensure 'Limit Dump Collection' is set to 'Enabled'"
  info                     : "This policy setting limits the type of memory dumps that can be collected when more information is needed to troubleshoot a problem."
  reference                : "NIST 800-53r5|AU-2"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\DataCollection"
  reg_item                 : "LimitDumpCollection"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0055 - MSSVR - (L1) Ensure 'Enable App Installer Experimental Features' is set to 'Disabled'"
  info                     : "This policy setting controls whether users can enable experimental features in the Windows Package Manager."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\AppInstaller"
  reg_item                 : "EnableExperimentalFeatures"
