  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System\CredSSP\Parameters"
  reg_item                 : "AllowEncryptionOracle"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0206 - MSSVR - (L1) Ensure 'Remote host allows delegation of non-exportable credentials' is set to 'Enabled'"
  info                     : "Remote host allows delegation of non-exportable credentials."
  reference                : "NIST 800-53r5|IA-5"
  see_also                 : "See HTH Policies and Standards"
