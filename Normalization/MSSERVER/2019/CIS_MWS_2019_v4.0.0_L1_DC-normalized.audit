<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0119 - MSSVR - (L1) Ensure 'Allow Windows Ink Workspace' is set to 'Enabled: On, but disallow access above lock' OR 'Enabled: Disabled'"
  info                     : "This policy setting determines whether Windows Ink items are allowed above the lock screen."
  reference                : "NIST 800-53r5|CM-7b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0" || "1"
  reg_key                  : "HKLM\SOFTWARE\Policies\Microsoft\WindowsInkWorkspace"
  reg_item                 : "AllowWindowsInkWorkspace"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0120 - MSSVR - (L1) Ensure 'Disallow Autoplay for non-volume devices' is set to 'Enabled'"
  info                     : "This policy setting disallows AutoPlay for MTP devices like cameras or phones."
  reference                : "NIST 800-53r5|MP-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Explorer"
  reg_item                 : "NoAutoplayfornonVolume"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0121 - MSSVR - (L1) Ensure 'Allow user control over installs' is set to 'Disabled'"
  info                     : "This setting controls whether users are permitted to change installation options that typically are available only to system administrators."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Installer"
  reg_item                 : "EnableUserControl"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0122 - MSSVR - (L1) Ensure 'Always install with elevated privileges' is set to 'Disabled'"
  info                     : "This setting controls whether or not Windows Installer should use system permissions when it installs any program on the system."
  reference                : "NIST 800-53r5|AC-2(9)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\Installer"
  reg_item                 : "AlwaysInstallElevated"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0123 - MSSVR - (L1) Ensure 'Set the default behavior for AutoRun' is set to 'Enabled: Do not execute any autorun commands'"
  info                     : "This policy setting sets the default behavior for Autorun commands."
  reference                : "NIST 800-53r5|MP-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer"
  reg_item                 : "NoAutorun"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0124 - MSSVR - (L1) Ensure 'Sign-in and lock last interactive user automatically after a restart' is set to 'Disabled'"
  info                     : "This policy setting controls whether a device will automatically sign-in the last interactive user after Windows Update restarts the system."
  reference                : "NIST 800-53r5|AC-11"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\policies\system"
  reg_item                 : "DisableAutomaticRestartSignOn"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0125 - MSSVR - (L1) Ensure 'Turn off Autoplay' is set to 'Enabled: All drives'"
  info                     : "Autoplay starts to read from a drive as soon as you insert media in the drive, which causes the setup file for programs or audio media to start immediately."
  reference                : "NIST 800-53r5|MP-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "255"
  reg_key                  : "HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer"
  reg_item                 : "NoDriveTypeAutoRun"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0126 - MSSVR - (L1) Ensure 'Allow Basic authentication' is set to 'Disabled'"
  info                     : "This policy setting allows you to manage whether the Windows Remote Management (WinRM) client uses Basic authentication."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WinRM\Client"
  reg_item                 : "AllowBasic"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0127 - MSSVR - (L1) Ensure 'Allow unencrypted traffic' is set to 'Disabled'"
  info                     : "This policy setting allows you to manage whether the Windows Remote Management (WinRM) client sends and receives unencrypted messages over the network."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WinRM\Client"
  reg_item                 : "AllowUnencryptedTraffic"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0128 - MSSVR - (L1) Ensure 'Disallow Digest authentication' is set to 'Enabled'"
  info                     : "This policy setting allows you to manage whether the Windows Remote Management (WinRM) client will not use Digest authentication."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WinRM\Client"
  reg_item                 : "AllowDigest"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0129 - MSSVR - (L1) Ensure 'Allow Basic authentication' is set to 'Disabled'"
  info                     : "This policy setting allows you to manage whether the Windows Remote Management (WinRM) service accepts Basic authentication from a remote client."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WinRM\Service"
  reg_item                 : "AllowBasic"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0130 - MSSVR - (L1) Ensure 'Allow unencrypted traffic' is set to 'Disabled'"
  info                     : "This policy setting allows you to manage whether the Windows Remote Management (WinRM) service sends and receives unencrypted messages over the network."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WinRM\Service"
  reg_item                 : "AllowUnencryptedTraffic"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0131 - MSSVR - (L1) Ensure 'Disallow WinRM from storing RunAs credentials' is set to 'Enabled'"
  info                     : "This policy setting allows you to manage whether the Windows Remote Management (WinRM) service will allow RunAs credentials to be stored for any plug-ins."
  reference                : "NIST 800-53r5|SC-7(21)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WinRM\Service"
  reg_item                 : "DisableRunAs"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0132 - MSSVR - (L1) Ensure 'Configure enhanced anti-spoofing' is set to 'Enabled'"
  info                     : "This policy setting determines whether enhanced anti-spoofing is configured for devices which support it."
  reference                : "NIST 800-53r5|CM-6b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Biometrics\FacialFeatures"
  reg_item                 : "EnhancedAntiSpoofing"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0133 - MSSVR - (L1) Ensure 'Prevent users from modifying settings' is set to 'Enabled'"
  info                     : "This policy setting prevent users from making changes to the Exploit protection settings area in the Windows Security settings."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender Security Center\App and Browser protection"
  reg_item                 : "DisallowExploitProtectionOverride"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0134 - MSSVR - (L1) Ensure 'No auto-restart with logged on users for scheduled automatic updates installations' is set to 'Disabled'"
  info                     : "This policy setting specifies that Automatic Updates will wait for computers to be restarted by the users who are logged on to them to complete a scheduled installation."
  reference                : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate\AU"
  reg_item                 : "NoAutoRebootWithLoggedOnUsers"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0135 - MSSVR - (L1) Ensure 'Configure Automatic Updates' is set to 'Enabled'"
  info                     : "This policy setting specifies whether computers in your environment will receive security updates from Windows Update or WSUS."
  reference                : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate\AU"
  reg_item                 : "NoAutoUpdate"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0136 - MSSVR - (L1) Ensure 'Configure Automatic Updates: Scheduled install day' is set to '0 - Every day'"
  info                     : "This policy setting specifies when computers in your environment will receive security updates from Windows Update or WSUS."
  reference                : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows\WindowsUpdate\AU"
  reg_item                 : "ScheduledInstallDay"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0137 - MSSVR - (L1) Ensure 'Manage preview builds' is set to 'Disabled'"
  info                     : "This policy setting manages which updates that are received prior to the update being released."
  reference                : "NIST 800-53r5|CM-7(5) CM-10"
  see_also                 : "See HTH Policies and Standards"
