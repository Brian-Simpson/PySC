  reg_key                  : "HKU\Software\Policies\Microsoft\Windows\CloudContent"
  reg_item                 : "ConfigureWindowsSpotlight"
  reg_option               : CAN_NOT_BE_NULL
  reg_include_hku_users    : "S-1-5-21-*"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0215 - MSSVR - (L1) Ensure 'Do not suggest third-party content in Windows spotlight' is set to 'Enabled'"
  info                     : "This policy setting determines whether Windows will suggest apps and content from third-party software publishers."
  reference                : "NIST 800-53r5|CM-7b."
  see_also                 : "See HTH Policies and Standards"
