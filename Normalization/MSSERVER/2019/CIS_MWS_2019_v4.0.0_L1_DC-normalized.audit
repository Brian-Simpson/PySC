  value_data               : "Success, Failure"
  audit_policy_subcategory : "Logon"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0027 - MSSVR - (L1) Ensure 'Audit Other Logon/Logoff Events' is set to 'Success and Failure'"
  info                     : "This subcategory reports other logon/logoff-related events, such as Remote Desktop Services session disconnects and reconnects, using RunAs to run processes under a different account, and locking and unlocking a workstation."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success, Failure"
  audit_policy_subcategory : "Other Logon/Logoff Events"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0028 - MSSVR - (L1) Ensure 'Audit Special Logon' is set to include 'Success'"
  info                     : "This subcategory reports when a special logon is used."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : AUDIT_SET
  value_data               : "Success" || "Success, Failure"
  audit_policy_subcategory : "Special Logon"
</custom_item>

<custom_item>
  type                     : AUDIT_POLICY_SUBCATEGORY
  description              : "1.0029 - MSSVR - (L1) Ensure 'Audit Detailed File Share' is set to include 'Failure'"
  info                     : "This subcategory allows you to audit attempts to access files and folders on a shared folder."
