<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0081 - MSSVR - (L1) Ensure 'Scan removable drives' is set to 'Enabled'"
  info                     : "This policy setting manages whether or not to scan for malicious software and unwanted software in the contents of removable drives, such as USB flash drives, when running a full scan."
  reference                : "NIST 800-53r5|MP-7 SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Scan"
  reg_item                 : "DisableRemovableDriveScanning"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0082 - MSSVR - (L1) Ensure 'Trigger a quick scan after X days without any scans' is set to 'Enabled: 7'"
  info                     : "This policy setting configures the number of days after the last scan (of any type) before an aggressive Quick Scan is automatically triggered."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "7"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Scan"
  reg_item                 : "DaysUntilAggressiveCatchupQuickScan"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0083 - MSSVR - (L1) Ensure 'Turn on e-mail scanning' is set to 'Enabled'"
  info                     : "This policy setting configures e-mail scanning."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Scan"
  reg_item                 : "DisableEmailScanning"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0084 - MSSVR - (L1) Ensure 'Configure detection for potentially unwanted applications' is set to 'Enabled: Block'"
  info                     : "This policy setting controls detection and action for Potentially Unwanted Applications (PUA), which are sneaky unwanted application bundlers or their bundled applications, that can deliver adware or malware."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender"
  reg_item                 : "PUAProtection"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0085 - MSSVR - (L1) Ensure 'Control whether exclusions are visible to local users' is set to 'Enabled'"
  info                     : "This policy setting controls whether Microsoft Defender Antivirus exclusions are visible to local users on the system."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender"
  reg_item                 : "HideExclusionsFromLocalUsers"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0086 - MSSVR - (L1) Ensure 'Enable EDR in block mode' is set to 'Enabled'"
  info                     : "This policy setting controls whether Microsoft Defender Antivirus Endpoint Detection and Response (EDR) is enabled in block mode (passive remediation)."
  reference                : "NIST 800-53r5|SI-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Features"
  reg_item                 : "PassiveRemediation"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0087 - MSSVR - (L1) Ensure 'Configure local setting override for reporting to Microsoft MAPS' is set to 'Disabled'"
  info                     : "This policy setting configures a local override for the configuration to join Microsoft Active Protection Service (MAPS), which Microsoft renamed to Windows Defender Antivirus Cloud Protection Service and then Microsoft Defender Antivirus Cloud Protection Service."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Spynet"
  reg_item                 : "LocalSettingOverrideSpynetReporting"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0088 - MSSVR - (L1) Ensure 'Configure Attack Surface Reduction rules' is set to 'Enabled'"
  info                     : "This policy setting controls the state for the Attack Surface Reduction (ASR) rules."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\Software\Policies\Microsoft\Windows Defender\Windows Defender Exploit Guard\ASR"
  reg_item                 : "ExploitGuard_ASR_Rules"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

