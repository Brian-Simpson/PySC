  reg_include_hku_users    : "S-1-5-21-*"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0216 - MSSVR - (L1) Ensure 'Turn off Spotlight collection on Desktop' is set to 'Enabled'"
  info                     : "This policy setting removes the Spotlight collection setting in Personalization, rendering the user unable to select and subsequently download daily images from Microsoft to the system desktop."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKU\Software\Policies\Microsoft\Windows\CloudContent"
  reg_item                 : "DisableSpotlightCollectionOnDesktop"
  reg_option               : CAN_NOT_BE_NULL
  reg_include_hku_users    : "S-1-5-21-*"
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0217 - MSSVR - (L1) Ensure 'Access Credential Manager as a trusted caller' is set to 'No One'"
  info                     : "This security setting is used by Credential Manager during Backup and Restore."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeTrustedCredManAccessPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0218 - MSSVR - (L1) Ensure 'Back up files and directories' is set to 'Administrators'"
  info                     : "This policy setting allows users to circumvent file and directory permissions to back up the system."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeBackupPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0219 - MSSVR - (L1) Ensure 'Change the system time' is set to 'Administrators, LOCAL SERVICE'"
  info                     : "This policy setting determines which users and groups can change the time and date on the internal clock of the computers in your environment."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "LOCAL SERVICE"
  right_type               : SeSystemTimePrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0220 - MSSVR - (L1) Ensure 'Change the time zone' is set to 'Administrators, LOCAL SERVICE'"
  info                     : "This setting determines which users can change the time zone of the computer."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "LOCAL SERVICE"
  right_type               : SeTimeZonePrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0221 - MSSVR - (L1) Ensure 'Create a pagefile' is set to 'Administrators'"
  info                     : "This policy setting allows users to change the size of the pagefile."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeCreatePagefilePrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0222 - MSSVR - (L1) Ensure 'Create a token object' is set to 'No One'"
  info                     : "This policy setting allows a process to create an access token, which may provide elevated rights to access sensitive data."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeCreateTokenPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0223 - MSSVR - (L1) Ensure 'Create global objects' is set to 'Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE'"
  info                     : "This policy setting determines whether users can create global objects that are available to all sessions."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "LOCAL SERVICE" && "NETWORK SERVICE" && "SERVICE"
  right_type               : SeCreateGlobalPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0224 - MSSVR - (L1) Ensure 'Create permanent shared objects' is set to 'No One'"
  info                     : "This user right is useful to kernel-mode components that extend the object namespace."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeCreatePermanentPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0225 - MSSVR - (L1) Ensure 'Create symbolic links' is set to 'Administrators' (DC only)"
  info                     : "This policy setting determines which users can create symbolic links."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeCreateSymbolicLinkPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0226 - MSSVR - (L1) Ensure 'Access this computer from the network' is set to 'Administrators, Authenticated Users, ENTERPRISE DOMAIN CONTROLLERS' (DC only)"
  info                     : "This policy setting allows other users on the network to connect to the computer and is required by various network protocols that include Server Message Block (SMB)-based protocols, NetBIOS, Common Internet File System (CIFS), and Component Object Model Plus (COM+)."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "Authenticated Users" && "Enterprise Domain Controllers"
  right_type               : SeNetworkLogonRight
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0227 - MSSVR - (L1) Ensure 'Debug programs' is set to 'Administrators'"
  info                     : "This policy setting determines which user accounts will have the right to attach a debugger to any process or to the kernel, which provides complete access to sensitive and critical operating system components."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeDebugPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0228 - MSSVR - (L1) Ensure 'Deny access to this computer from the network' to include 'Guests' (DC only)"
  info                     : "This policy setting prohibits users from connecting to a computer from across the network, which would allow users to access and potentially modify data remotely."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Guests"
  right_type               : SeDenyNetworkLogonRight
  check_type               : CHECK_SUPERSET
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0229 - MSSVR - (L1) Ensure 'Deny log on as a batch job' to include 'Guests'"
  info                     : "This policy setting determines which accounts will not be able to log on to the computer as a batch job."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Guests"
  right_type               : SeDenyBatchLogonRight
  check_type               : CHECK_SUPERSET
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0230 - MSSVR - (L1) Ensure 'Deny log on as a service' to include 'Guests'"
  info                     : "This security setting determines which service accounts are prevented from registering a process as a service."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Guests"
  right_type               : SeDenyServiceLogonRight
  check_type               : CHECK_SUPERSET
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0231 - MSSVR - (L1) Ensure 'Deny log on locally' to include 'Guests'"
  info                     : "This security setting determines which users are prevented from logging on at the computer."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Guests"
  right_type               : SeDenyInteractiveLogonRight
  check_type               : CHECK_SUPERSET
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0232 - MSSVR - (L1) Ensure 'Deny log on through Remote Desktop Services' to include 'Guests' (DC only)"
  info                     : "This policy setting determines whether users can log on as Remote Desktop clients."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Guests"
  right_type               : SeDenyRemoteInteractiveLogonRight
  check_type               : CHECK_SUPERSET
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0233 - MSSVR - (L1) Ensure 'Enable computer and user accounts to be trusted for delegation' is set to 'Administrators' (DC only)"
  info                     : "This policy setting allows users to change the Trusted for Delegation setting on a computer object in Active Directory."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeEnableDelegationPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0234 - MSSVR - (L1) Ensure 'Force shutdown from a remote system' is set to 'Administrators'"
  info                     : "This policy setting allows users to shut down Windows Vista-based or newer computers from remote locations on the network."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeRemoteShutdownPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0235 - MSSVR - (L1) Ensure 'Generate security audits' is set to 'LOCAL SERVICE, NETWORK SERVICE'"
  info                     : "This policy setting determines which users or processes can generate audit records in the Security log."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "LOCAL SERVICE" && "NETWORK SERVICE"
  right_type               : SeAuditPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0236 - MSSVR - (L1) Ensure 'Impersonate a client after authentication' is set to 'Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE' (DC only)"
  info                     : "The policy setting allows programs that run on behalf of a user to impersonate that user (or another specified account) so that they can act on behalf of the user."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "LOCAL SERVICE" && "NETWORK SERVICE" && "SERVICE"
  right_type               : SeImpersonatePrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0237 - MSSVR - (L1) Ensure 'Increase scheduling priority' is set to 'Administrators, Window Manager\Window Manager Group'"
  info                     : "This policy setting determines whether users can increase the base priority class of a process."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ("Administrators" && "Window Manager Group") || ("Administrators" && "Window Manager\Window Manager Group")
  right_type               : SeIncreaseBasePriorityPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0238 - MSSVR - (L1) Ensure 'Load and unload device drivers' is set to 'Administrators'"
  info                     : "This policy setting allows users to dynamically load a new device driver on a system."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeLoadDriverPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0239 - MSSVR - (L1) Ensure 'Lock pages in memory' is set to 'No One'"
  info                     : "This policy setting allows a process to keep data in physical memory, which prevents the system from paging the data to virtual memory on disk."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeLockMemoryPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0240 - MSSVR - (L1) Ensure 'Manage auditing and security log' is set to 'Administrators' (DC only)"
  info                     : "This policy setting determines which users can change the auditing options for files and directories and clear the Security log."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" || ("Administrators" && "Exchange Servers")
  right_type               : SeSecurityPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0241 - MSSVR - (L1) Ensure 'Act as part of the operating system' is set to 'No One'"
  info                     : "This policy setting allows a process to assume the identity of any user and thus gain access to the resources that the user is authorized to access."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeTcbPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0242 - MSSVR - (L1) Ensure 'Modify an object label' is set to 'No One'"
  info                     : "This privilege determines which user accounts can modify the integrity label of objects, such as files, registry keys, or processes owned by other users."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeReLabelPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0243 - MSSVR - (L1) Ensure 'Modify firmware environment values' is set to 'Administrators'"
  info                     : "This policy setting allows users to configure the system-wide environment variables that affect hardware configuration."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeSystemEnvironmentPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0244 - MSSVR - (L1) Ensure 'Perform volume maintenance tasks' is set to 'Administrators'"
  info                     : "This policy setting allows users to manage the system's volume or disk configuration, which could allow a user to delete a volume and cause data loss as well as a denial-of-service condition."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeManageVolumePrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0245 - MSSVR - (L1) Ensure 'Profile single process' is set to 'Administrators'"
  info                     : "This policy setting determines which users can use tools to monitor the performance of non-system processes."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeProfileSingleProcessPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0246 - MSSVR - (L1) Ensure 'Profile system performance' is set to 'Administrators, NT SERVICE\WdiServiceHost'"
  info                     : "This policy setting allows users to use tools to view the performance of different system processes, which could be abused to allow attackers to determine a system's active processes and provide insight into the potential attack surface of the computer."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && ("NT SERVICE\WdiServiceHost" || "WdiServiceHost")
  right_type               : SeSystemProfilePrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0247 - MSSVR - (L1) Ensure 'Replace a process level token' is set to 'LOCAL SERVICE, NETWORK SERVICE'"
  info                     : "This policy setting allows one process or service to start another service or process with a different security access token, which can be used to modify the security access token of that sub-process and result in the escalation of privileges."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "LOCAL SERVICE" && "NETWORK SERVICE"
  right_type               : SeAssignPrimaryTokenPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0248 - MSSVR - (L1) Ensure 'Restore files and directories' is set to 'Administrators'"
  info                     : "This policy setting determines which users can bypass file, directory, registry, and other persistent object permissions when restoring backed up files and directories on computers that run Windows Vista (or newer) in your environment."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeRestorePrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0249 - MSSVR - (L1) Ensure 'Shut down the system' is set to 'Administrators'"
  info                     : "This policy setting determines which users who are logged on locally to the computers in your environment can shut down the operating system with the Shut Down command."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeShutdownPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0250 - MSSVR - (L1) Ensure 'Synchronize directory service data' is set to 'No One' (DC only)"
  info                     : "This security setting determines which users and groups have the authority to synchronize all directory service data."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : ""
  right_type               : SeSyncAgentPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0251 - MSSVR - (L1) Ensure 'Take ownership of files or other objects' is set to 'Administrators'"
  info                     : "This policy setting allows users to take ownership of files, folders, registry keys, processes, or threads."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeTakeOwnershipPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0252 - MSSVR - (L1) Ensure 'Add workstations to domain' is set to 'Administrators' (DC only)"
  info                     : "This policy setting specifies which users can add computer workstations to the domain."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeMachineAccountPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0253 - MSSVR - (L1) Ensure 'Adjust memory quotas for a process' is set to 'Administrators, LOCAL SERVICE, NETWORK SERVICE'"
  info                     : "This policy setting allows a user to adjust the maximum amount of memory that is available to a process."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "LOCAL SERVICE" && "NETWORK SERVICE"
  right_type               : SeIncreaseQuotaPrivilege
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0254 - MSSVR - (L1) Ensure 'Allow log on locally' is set to 'Administrators, ENTERPRISE DOMAIN CONTROLLERS' (DC only)"
  info                     : "This policy setting determines which users can interactively log on to computers in your environment."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators" && "ENTERPRISE DOMAIN CONTROLLERS"
  right_type               : SeInteractiveLogonRight
</custom_item>

<custom_item>
  type                     : USER_RIGHTS_POLICY
  description              : "1.0255 - MSSVR - (L1) Ensure 'Allow log on through Remote Desktop Services' is set to 'Administrators' (DC only)"
  info                     : "This policy setting determines which users or groups have the right to log on as a Remote Desktop Services client."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : USER_RIGHT
  value_data               : "Administrators"
  right_type               : SeRemoteInteractiveLogonRight
</custom_item>

<custom_item>
  type                     : ANONYMOUS_SID_SETTING
  description              : "1.0256 - MSSVR - (L1) Ensure 'Network access: Allow anonymous SID/Name translation' is set to 'Disabled'"
  info                     : "This policy setting determines whether an anonymous user can request security identifier (SID) attributes for another user, or use a SID to obtain its corresponding user name."
  reference                : "NIST 800-53r5|AC-6(10) IA-2(2)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_SET
  value_data               : "Disabled"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0257 - MSSVR - (L1) Ensure 'Network access: Restrict anonymous access to Named Pipes and Shares' is set to 'Enabled'"
  info                     : "When enabled, this policy setting restricts anonymous access to only those shares and pipes that are named in the Network access: Named pipes that can be accessed anonymously and Network access: Shares that can be accessed anonymously settings."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "1"
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "RestrictNullSessAccess"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0258 - MSSVR - (L1) Ensure 'Network access: Shares that can be accessed anonymously' is set to 'None'"
  info                     : "This policy setting determines which network shares can be accessed by anonymous users."
  reference                : "NIST 800-53r5|AC-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_MULTI_TEXT
  value_data               : ""
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "NullSessionShares"
  reg_option               : CAN_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0259 - MSSVR - (L1) Ensure 'Network access: Sharing and security model for local accounts' is set to 'Classic - local users authenticate as themselves'"
  info                     : "This policy setting determines how network logons that use local accounts are authenticated."
  reference                : "NIST 800-53r5|CM-6b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
  reg_item                 : "ForceGuest"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0260 - MSSVR - (L1) Ensure 'Network access: Let Everyone permissions apply to anonymous users' is set to 'Disabled'"
  info                     : "This policy setting determines what additional permissions are assigned for anonymous connections to the computer."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_DWORD
  value_data               : "0"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\Lsa"
  reg_item                 : "EveryoneIncludesAnonymous"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0261 - MSSVR - (L1) Ensure 'Network access: Named Pipes that can be accessed anonymously' is configured (DC only)"
  info                     : "This policy setting determines which communication sessions, or pipes, will have attributes and permissions that allow anonymous access."
  reference                : "NIST 800-53r5|IA-2(2)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_MULTI_TEXT
  value_data               : ("LSARPC" && "NETLOGON" && "SAMR" && "Browser") || ("LSARPC" && "NETLOGON" && "SAMR")
  reg_key                  : "HKLM\System\CurrentControlSet\Services\LanManServer\Parameters"
  reg_item                 : "NullSessionPipes"
</custom_item>

<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0262 - MSSVR - (L1) Ensure 'Network access: Remotely accessible registry paths' is configured"
  info                     : "This policy setting determines which registry paths will be accessible over the network, regardless of the users or groups listed in the access control list (ACL) of the winreg registry key."
  reference                : "NIST 800-53r5|AC-6(7)(b)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_MULTI_TEXT
  value_data               : "System\CurrentControlSet\Control\ProductOptions" && "System\CurrentControlSet\Control\Server Applications" && "Software\Microsoft\Windows NT\CurrentVersion"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedExactPaths"
  reg_item                 : "Machine"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>

    <if>
      <condition type:"OR">
<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0263 - MSSVR - WINS Server Feature installed"
  value_type               : POLICY_TEXT
  value_data               : ".*Installed.*"
  powershell_args          : "Get-WindowsFeature | Where {$_.Name -eq 'WINS'} | SELECT 'InstallState' | Format-List"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0264 - MSSVR - Active Directory Certificate Services role enabled"
  value_type               : POLICY_TEXT
  value_data               : ".*Installed.*"
  powershell_args          : "Get-WindowsFeature | Where {$_.Name -like 'ADCS*'} | SELECT 'InstallState' | Format-List"
  check_type               : CHECK_REGEX
</custom_item>
      </condition>

      <then>
        <if>
          <condition type:"AND">
<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0265 - MSSVR - WINS Server Feature installed"
  value_type               : POLICY_TEXT
  value_data               : ".*Installed.*"
  powershell_args          : "Get-WindowsFeature | Where {$_.Name -eq 'WINS'} | SELECT 'InstallState' | Format-List"
  check_type               : CHECK_REGEX
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0266 - MSSVR - Active Directory Certificate Services role enabled"
  value_type               : POLICY_TEXT
  value_data               : ".*Installed.*"
  powershell_args          : "Get-WindowsFeature | Where {$_.Name -like 'ADCS*'} | SELECT 'InstallState' | Format-List"
  check_type               : CHECK_REGEX
</custom_item>
          </condition>

          <then>
<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0267 - MSSVR - (L1) Ensure 'Network access: Remotely accessible registry paths and sub-paths' is configured"
  info                     : "This policy setting determines which registry paths and sub-paths will be accessible over the network, regardless of the users or groups listed in the access control list (ACL) of the winreg registry key."
  reference                : "NIST 800-53r5|AC-6(7)(b)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_MULTI_TEXT
  value_data               : "System\CurrentControlSet\Control\Print\Printers" && "System\CurrentControlSet\Services\Eventlog" && "Software\Microsoft\OLAP Server" && "Software\Microsoft\Windows NT\CurrentVersion\Print" && "Software\Microsoft\Windows NT\CurrentVersion\Windows" && "System\CurrentControlSet\Control\ContentIndex" && "System\CurrentControlSet\Control\Terminal Server" && "System\CurrentControlSet\Control\Terminal Server\UserConfig" && "System\CurrentControlSet\Control\Terminal Server\DefaultUserConfiguration" && "Software\Microsoft\Windows NT\CurrentVersion\Perflib" && "System\CurrentControlSet\Services\Sysmonlog" && "System\CurrentControlSet\Services\CertSvc" && "System\CurrentControlSet\Services\WINS"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedPaths"
  reg_item                 : "Machine"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>
          </then>

          <else>
            <if>
              <condition type:"AND">
<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0268 - MSSVR - Active Directory Certificate Services role enabled"
  value_type               : POLICY_TEXT
  value_data               : ".*Installed.*"
  powershell_args          : "Get-WindowsFeature | Where {$_.Name -like 'ADCS*'} | SELECT 'InstallState' | Format-List"
  check_type               : CHECK_REGEX
</custom_item>
              </condition>

              <then>
<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0269 - MSSVR - (L1) Ensure 'Network access: Remotely accessible registry paths and sub-paths' is configured"
  info                     : "This policy setting determines which registry paths and sub-paths will be accessible over the network, regardless of the users or groups listed in the access control list (ACL) of the winreg registry key."
  reference                : "NIST 800-53r5|AC-6(7)(b)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_MULTI_TEXT
  value_data               : "System\CurrentControlSet\Control\Print\Printers" && "System\CurrentControlSet\Services\Eventlog" && "Software\Microsoft\OLAP Server" && "Software\Microsoft\Windows NT\CurrentVersion\Print" && "Software\Microsoft\Windows NT\CurrentVersion\Windows" && "System\CurrentControlSet\Control\ContentIndex" && "System\CurrentControlSet\Control\Terminal Server" && "System\CurrentControlSet\Control\Terminal Server\UserConfig" && "System\CurrentControlSet\Control\Terminal Server\DefaultUserConfiguration" && "Software\Microsoft\Windows NT\CurrentVersion\Perflib" && "System\CurrentControlSet\Services\Sysmonlog" && "System\CurrentControlSet\Services\CertSvc"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedPaths"
  reg_item                 : "Machine"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>
              </then>

              <else>
<custom_item>
  type                     : REGISTRY_SETTING
  description              : "1.0270 - MSSVR - (L1) Ensure 'Network access: Remotely accessible registry paths and sub-paths' is configured"
  info                     : "This policy setting determines which registry paths and sub-paths will be accessible over the network, regardless of the users or groups listed in the access control list (ACL) of the winreg registry key."
  reference                : "NIST 800-53r5|AC-6(7)(b)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_MULTI_TEXT
  value_data               : "System\CurrentControlSet\Control\Print\Printers" && "System\CurrentControlSet\Services\Eventlog" && "Software\Microsoft\OLAP Server" && "Software\Microsoft\Windows NT\CurrentVersion\Print" && "Software\Microsoft\Windows NT\CurrentVersion\Windows" && "System\CurrentControlSet\Control\ContentIndex" && "System\CurrentControlSet\Control\Terminal Server" && "System\CurrentControlSet\Control\Terminal Server\UserConfig" && "System\CurrentControlSet\Control\Terminal Server\DefaultUserConfiguration" && "Software\Microsoft\Windows NT\CurrentVersion\Perflib" && "System\CurrentControlSet\Services\Sysmonlog" && "System\CurrentControlSet\Services\WINS"
  reg_key                  : "HKLM\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedPaths"
  reg_item                 : "Machine"
  reg_option               : CAN_NOT_BE_NULL
</custom_item>
              </else>
            </if>
          </else>
        </if>
      </then>

      <else>
