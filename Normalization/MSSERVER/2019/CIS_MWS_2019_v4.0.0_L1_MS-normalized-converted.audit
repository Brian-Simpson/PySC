<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0278 - MSSVR - (L1) Ensure Accounts: Guest account status is set to Disabled (MS only)"
  info                     : "This policy setting determines whether the Guest account is enabled or disabled."
  reference                : "NIST 800-53r5|IA-5"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Disabled"
  powershell_args          : "$u = Get-LocalUser -Name 'Guest' -ErrorAction SilentlyContinue; if ($u -ne $null) { if ($u.Enabled) { 'Enabled' } else { 'Disabled' } } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0279 - MSSVR - (L1) Ensure Network security: Allow Local System to use computer identity for NTLM is set to Enabled"
  info                     : "This policy setting determines whether Local System services that use Negotiate when reverting to NTLM authentication can use the computer identity."
  reference                : "NIST 800-53r5|IA-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['UseMachineId'] -ne $null) { [int]$p.'UseMachineId' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0280 - MSSVR - (L1) Ensure Network security: Minimum session security for NTLM SSP based (including secure RPC) servers is set to Require NTLMv2 session security, Require 128-bit encryption"
  info                     : "This policy setting determines which behaviors are allowed by servers for applications using the NTLM Security Support Provider (SSP)."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "537395200"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa\MSV1_0' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['NTLMMinServerSec'] -ne $null) { [int]$p.'NTLMMinServerSec' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0281 - MSSVR - (L1) Ensure Network security: Restrict NTLM: Audit Incoming NTLM Traffic is set to Enable auditing for all accounts"
  info                     : "This policy setting allows the auditing of incoming NTLM traffic."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "2"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa\MSV1_0' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AuditReceivingNTLMTraffic'] -ne $null) { [int]$p.'AuditReceivingNTLMTraffic' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0282 - MSSVR - (L1) Ensure Network security: Restrict NTLM: Outgoing NTLM traffic to remote servers is set to Audit all or higher"
  info                     : "This policy setting allows the auditing of outgoing NTLM traffic."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1" || "2"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa\MSV1_0' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RestrictSendingNTLMTraffic'] -ne $null) { [int]$p.'RestrictSendingNTLMTraffic' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0283 - MSSVR - (L1) Ensure Network security: Allow LocalSystem NULL session fallback is set to Disabled"
  info                     : "This policy setting determines whether NTLM is allowed to fall back to a NULL session when used with LocalSystem."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa\MSV1_0' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AllowNullSessionFallback'] -ne $null) { [int]$p.'AllowNullSessionFallback' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0284 - MSSVR - (L1) Ensure Network Security: Allow PKU2U authentication requests to this computer to use online identities is set to Disabled"
  info                     : "This setting determines if online identities are able to authenticate to this computer."
  reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa\pku2u' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AllowOnlineID'] -ne $null) { [int]$p.'AllowOnlineID' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0285 - MSSVR - (L1) Ensure Network security: Configure encryption types allowed for Kerberos is set to AES128_HMAC_SHA1, AES256_HMAC_SHA1, Future encryption types"
  info                     : "This policy setting allows you to set the encryption types that Kerberos is allowed to use."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "2147483640"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System\Kerberos\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SupportedEncryptionTypes'] -ne $null) { [int]$p.'SupportedEncryptionTypes' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0286 - MSSVR - (L1) Ensure Network security: Do not store LAN Manager hash value on next password change is set to Enabled"
  info                     : "This policy setting determines whether the LAN Manager (LM) hash value for the new password is stored when the password is changed."
  reference                : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['NoLMHash'] -ne $null) { [int]$p.'NoLMHash' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0287 - MSSVR - (L1) Ensure Network security: Force logoff when logon hours expire is set to Enabled"
  info                     : "This policy setting determines whether to disconnect users who are connected to the local computer outside their user account's valid logon hours."
  reference                : "NIST 800-53r5|AC-2(12)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Enabled"
  powershell_args          : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^ForceLogoffWhenHourExpire\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -eq '1') { 'Enabled' } elseif ($val -eq '0') { 'Disabled' } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0288 - MSSVR - (L1) Ensure Network security: LAN Manager authentication level is set to Send NTLMv2 response only. Refuse LM & NTLM"
  info                     : "LAN Manager (LM) was a family of early Microsoft client/server software (predating Windows NT) that allowed users to link personal computers together on a single network."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "5"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LMCompatibilityLevel'] -ne $null) { [int]$p.'LMCompatibilityLevel' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0289 - MSSVR - (L1) Ensure Network security: LDAP client signing requirements is set to Negotiate signing or higher"
  info                     : "This policy setting determines the level of data signing that is requested on behalf of clients that issue LDAP BIND requests."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1" || "2"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LDAP' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LDAPClientIntegrity'] -ne $null) { [int]$p.'LDAPClientIntegrity' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0290 - MSSVR - (L1) Ensure Network security: Minimum session security for NTLM SSP based (including secure RPC) clients is set to Require NTLMv2 session security, Require 128-bit encryption"
  info                     : "This policy setting determines which behaviors are allowed by clients for applications using the NTLM Security Support Provider (SSP)."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "537395200"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa\MSV1_0' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['NTLMMinClientSec'] -ne $null) { [int]$p.'NTLMMinClientSec' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0291 - MSSVR - (L1) Ensure Accounts: Limit local account use of blank passwords to console logon only is set to Enabled"
  info                     : "This policy setting determines whether local accounts that are not password protected can be used to log on from locations other than the physical computer console."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LimitBlankPasswordUse'] -ne $null) { [int]$p.'LimitBlankPasswordUse' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0292 - MSSVR - (L1) Configure Accounts: Rename administrator account"
  info                     : "The built-in local administrator account is a well-known account name that attackers will target."
  reference                : "NIST 800-53r5|IA-5"
  see_also                 : "See HTH Policies and Standards"
  check_type               : CHECK_NOT_EQUAL
  value_type               : POLICY_TEXT
  value_data               : "\b[Aa]dmin(istrator)?"
  powershell_args          : "$a = Get-LocalUser | Where-Object { $_.SID -like 'S-1-5-*-500' }; if ($a -ne $null) { $a.Name } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0293 - MSSVR - (L1) Ensure Shutdown: Allow system to be shut down without having to log on is set to Disabled"
  info                     : "This policy setting determines whether a computer can be shut down when a user is not logged on."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ShutdownWithoutLogon'] -ne $null) { [int]$p.'ShutdownWithoutLogon' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0294 - MSSVR - (L1) Configure Accounts: Rename guest account"
  info                     : "The built-in local guest account is another well-known name to attackers."
  reference                : "NIST 800-53r5|IA-5"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Guest"
  powershell_args          : "$u = Get-LocalUser -Name 'Guest' -ErrorAction SilentlyContinue; if ($u -ne $null) { if ($u.Enabled) { 'Enabled' } else { 'Disabled' } } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0295 - MSSVR - (L1) Ensure System objects: Require case insensitivity for non-Windows subsystems is set to Enabled"
  info                     : "This policy setting determines whether case insensitivity is enforced for all subsystems."
  reference                : "NIST 800-53r5|CM-6b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Session Manager\Kernel' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ObCaseInsensitive'] -ne $null) { [int]$p.'ObCaseInsensitive' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0296 - MSSVR - (L1) Ensure System objects: Strengthen default permissions of internal system objects (e.g. Symbolic Links) is set to Enabled"
  info                     : "This policy setting determines the strength of the default discretionary access control list (DACL) for objects."
  reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Session Manager' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ProtectionMode'] -ne $null) { [int]$p.'ProtectionMode' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0297 - MSSVR - (L1) Ensure User Account Control: Admin Approval Mode for the Built-in Administrator account is set to Enabled"
  info                     : "This policy setting controls the behavior of Admin Approval Mode for the built-in Administrator account."
  reference                : "NIST 800-53r5|AC-2(9)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['FilterAdministratorToken'] -ne $null) { [int]$p.'FilterAdministratorToken' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0298 - MSSVR - (L1) Ensure User Account Control: Behavior of the elevation prompt for administrators in Admin Approval Mode is set to Prompt for consent on the secure desktop or higher"
  info                     : "This policy setting controls the behavior of the elevation prompt for administrators."
  reference                : "NIST 800-53r5|AC-6(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1" || "2"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ConsentPromptBehaviorAdmin'] -ne $null) { [int]$p.'ConsentPromptBehaviorAdmin' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0299 - MSSVR - (L1) Ensure User Account Control: Behavior of the elevation prompt for standard users is set to Automatically deny elevation requests"
  info                     : "This policy setting controls the behavior of the elevation prompt for standard users."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ConsentPromptBehaviorUser'] -ne $null) { [int]$p.'ConsentPromptBehaviorUser' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0300 - MSSVR - (L1) Ensure User Account Control: Detect application installations and prompt for elevation is set to Enabled"
  info                     : "This policy setting controls the behavior of application installation detection for the computer."
  reference                : "NIST 800-53r5|AC-6(8)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableInstallerDetection'] -ne $null) { [int]$p.'EnableInstallerDetection' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0301 - MSSVR - (L1) Ensure User Account Control: Only elevate UIAccess applications that are installed in secure locations is set to Enabled"
  info                     : "This policy setting controls whether applications that request to run with a User Interface Accessibility (UIAccess) integrity level must reside in a secure location in the file system."
  reference                : "NIST 800-53r5|AC-6(8)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableSecureUIAPaths'] -ne $null) { [int]$p.'EnableSecureUIAPaths' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0302 - MSSVR - (L1) Ensure User Account Control: Run all administrators in Admin Approval Mode is set to Enabled"
  info                     : "This policy setting controls the behavior of all User Account Control (UAC) policy settings for the computer."
  reference                : "NIST 800-53r5|AC-6(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableLUA'] -ne $null) { [int]$p.'EnableLUA' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0303 - MSSVR - (L1) Ensure User Account Control: Switch to the secure desktop when prompting for elevation is set to Enabled"
  info                     : "This policy setting controls whether the elevation request prompt is displayed on the interactive user's desktop or the secure desktop."
  reference                : "NIST 800-53r5|AC-6(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['PromptOnSecureDesktop'] -ne $null) { [int]$p.'PromptOnSecureDesktop' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0304 - MSSVR - (L1) Ensure User Account Control: Virtualize file and registry write failures to per-user locations is set to Enabled"
  info                     : "This policy setting controls whether application write failures are redirected to defined registry and file system locations."
  reference                : "NIST 800-53r5|SC-29(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableVirtualization'] -ne $null) { [int]$p.'EnableVirtualization' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0305 - MSSVR - (L1) Ensure Audit: Force audit policy subcategory settings (Windows Vista or later) to override audit policy category settings is set to Enabled"
  info                     : "This policy setting allows administrators to enable the more precise auditing capabilities present in Windows Vista."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SCENoApplyLegacyAuditPolicy'] -ne $null) { [int]$p.'SCENoApplyLegacyAuditPolicy' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0306 - MSSVR - (L1) Ensure Audit: Shut down system immediately if unable to log security audits is set to Disabled"
  info                     : "This policy setting determines whether the system shuts down if it is unable to log Security events."
  reference                : "NIST 800-53r5|AU-4"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\LSA' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['CrashOnAuditFail'] -ne $null) { [int]$p.'CrashOnAuditFail' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0307 - MSSVR - (L1) Ensure Devices: Prevent users from installing printer drivers is set to Enabled"
  info                     : "For a computer to print to a shared printer, the driver for that shared printer must be installed on the local computer."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Print\Providers\LanMan Print Services\Servers' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AddPrinterDrivers'] -ne $null) { [int]$p.'AddPrinterDrivers' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0308 - MSSVR - (L1) Ensure Domain member: Digitally encrypt or sign secure channel data (always) is set to Enabled"
  info                     : "This policy setting determines whether all secure channel traffic that is initiated by the domain member must be signed or encrypted."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RequireSignOrSeal'] -ne $null) { [int]$p.'RequireSignOrSeal' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0309 - MSSVR - (L1) Ensure Domain member: Digitally encrypt secure channel data (when possible) is set to Enabled"
  info                     : "This policy setting determines whether a domain member should attempt to negotiate encryption for all secure channel traffic that it initiates."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SealSecureChannel'] -ne $null) { [int]$p.'SealSecureChannel' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0310 - MSSVR - (L1) Ensure Domain member: Digitally sign secure channel data (when possible) is set to Enabled"
  info                     : "This policy setting determines whether a domain member should attempt to negotiate whether all secure channel traffic that it initiates must be digitally signed."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SignSecureChannel'] -ne $null) { [int]$p.'SignSecureChannel' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0311 - MSSVR - (L1) Ensure Domain member: Disable machine account password changes is set to Disabled"
  info                     : "This policy setting determines whether a domain member can periodically change its computer account password."
  reference                : "NIST 800-53r5|AC-2(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DisablePasswordChange'] -ne $null) { [int]$p.'DisablePasswordChange' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0312 - MSSVR - (L1) Ensure Domain member: Maximum machine account password age is set to 30 or fewer days, but not 0"
  info                     : "This policy setting determines the maximum allowable age for a computer account password."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "[1..30]"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['MaximumPasswordAge'] -ne $null) { [int]$p.'MaximumPasswordAge' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0313 - MSSVR - (L1) Ensure Domain member: Require strong (Windows 2000 or later) session key is set to Enabled"
  info                     : "When this policy setting is enabled, a secure channel can only be established with Domain Controllers that are capable of encrypting secure channel data with a strong (128-bit) session key."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RequireStrongKey'] -ne $null) { [int]$p.'RequireStrongKey' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0314 - MSSVR - (L1) Ensure Interactive logon: Do not require CTRL+ALT+DEL is set to Disabled"
  info                     : "This policy setting determines whether users must press CTRL+ALT+DEL before they log on."
  reference                : "NIST 800-53r5|AC-7 AC-19"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DisableCAD'] -ne $null) { [int]$p.'DisableCAD' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0315 - MSSVR - (L1) Ensure Interactive logon: Dont display last signed-in is set to Enabled"
  info                     : "This policy setting determines whether the account name of the last user to log on to the client computers in your organization will be displayed in each computer's respective Windows logon screen."
  reference                : "NIST 800-53r5|AC-7 AC-19"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DontDisplayLastUserName'] -ne $null) { [int]$p.'DontDisplayLastUserName' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0316 - MSSVR - (L1) Ensure Interactive logon: Machine inactivity limit is set to 900 or fewer second(s), but not 0"
  info                     : "Windows notices inactivity of a logon session, and if the amount of inactive time exceeds the inactivity limit, then the screen saver will run, locking the session."
  reference                : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "[1..900]"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['InactivityTimeoutSecs'] -ne $null) { [int]$p.'InactivityTimeoutSecs' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0317 - MSSVR - (L1) Configure Interactive logon: Message text for users attempting to log on"
  info                     : "This policy setting specifies a text message that displays to users when they log on."
  reference                : "NIST 800-53r5|AC-8"
  see_also                 : "See HTH Policies and Standards"
  check_type               : CHECK_REGEX
  value_type               : POLICY_TEXT
  value_data               : "All activities performed on this system will be monitored."
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; if ($p) { [string]$p.'LegalNoticeText' } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0318 - MSSVR - (L1) Configure Interactive logon: Message title for users attempting to log on"
  info                     : "This policy setting specifies the text displayed in the title bar of the window that users see when they log on to the system."
  reference                : "NIST 800-53r5|AC-8"
  see_also                 : "See HTH Policies and Standards"
  check_type               : CHECK_REGEX
  value_type               : POLICY_TEXT
  value_data               : "Notice and Consent Banner"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; if ($p) { [string]$p.'LegalNoticeCaption' } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0319 - MSSVR - (L1) Ensure Interactive logon: Prompt user to change password before expiration is set to between 5 and 14 days"
  info                     : "This policy setting determines how far in advance users are warned that their password will expire."
  reference                : "NIST 800-53r5|IA-5(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "[5..14]"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Winlogon' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['PasswordExpiryWarning'] -ne $null) { [int]$p.'PasswordExpiryWarning' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0320 - MSSVR - (L1) Ensure Interactive logon: Require Domain Controller Authentication to unlock workstation is set to Enabled (MS only)"
  info                     : "Logon information is required to unlock a locked computer."
  reference                : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Winlogon' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ForceUnlockLogon'] -ne $null) { [int]$p.'ForceUnlockLogon' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0321 - MSSVR - (L1) Ensure Interactive logon: Smart card removal behavior is set to Lock Workstation or higher"
  info                     : "This policy setting determines what happens when the smart card for a logged-on user is removed from the smart card reader."
  reference                : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
  see_also                 : "See HTH Policies and Standards"
  check_type               : CHECK_REGEX
  value_type               : POLICY_TEXT
  value_data               : "^(1|2|3)$"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Winlogon' -ErrorAction SilentlyContinue; $val = if ($p) { [string]$p.'ScRemoveOption' } else { $null }; if ($val -ne $null) { $val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0322 - MSSVR - (L1) Ensure Microsoft network client: Digitally sign communications (always) is set to Enabled"
  info                     : "This policy setting determines whether packet signing is required by the SMB client component."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanmanWorkstation\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RequireSecuritySignature'] -ne $null) { [int]$p.'RequireSecuritySignature' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0323 - MSSVR - (L1) Ensure Microsoft network client: Digitally sign communications (if server agrees) is set to Enabled"
  info                     : "This policy setting determines whether the SMB client will attempt to negotiate SMB packet signing."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanmanWorkstation\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableSecuritySignature'] -ne $null) { [int]$p.'EnableSecuritySignature' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0324 - MSSVR - (L1) Ensure Microsoft network client: Send unencrypted password to third-party SMB servers is set to Disabled"
  info                     : "This policy setting determines whether the SMB redirector will send plaintext passwords during authentication to third-party SMB servers that do not support password encryption."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanmanWorkstation\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnablePlainTextPassword'] -ne $null) { [int]$p.'EnablePlainTextPassword' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0325 - MSSVR - (L1) Ensure Microsoft network server: Amount of idle time required before suspending session is set to 15 or fewer minute(s)"
  info                     : "This policy setting allows you to specify the amount of continuous idle time that must pass in an SMB session before the session is suspended because of inactivity."
  reference                : "NIST 800-53r5|AC-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "[1..15]"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanManServer\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AutoDisconnect'] -ne $null) { [int]$p.'AutoDisconnect' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0326 - MSSVR - (L1) Ensure Microsoft network server: Digitally sign communications (always) is set to Enabled"
  info                     : "This policy setting determines whether packet signing is required by the SMB server component."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanManServer\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RequireSecuritySignature'] -ne $null) { [int]$p.'RequireSecuritySignature' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0327 - MSSVR - (L1) Ensure Microsoft network server: Digitally sign communications (if client agrees) is set to Enabled"
  info                     : "This policy setting determines whether the SMB server will negotiate SMB packet signing with clients that request it."
  reference                : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanManServer\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableSecuritySignature'] -ne $null) { [int]$p.'EnableSecuritySignature' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0328 - MSSVR - (L1) Ensure Microsoft network server: Disconnect clients when logon hours expire is set to Enabled"
  info                     : "This security setting determines whether to disconnect users who are connected to the local computer outside their user account's valid logon hours."
  reference                : "NIST 800-53r5|AC-2(12)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanManServer\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableForcedLogoff'] -ne $null) { [int]$p.'EnableForcedLogoff' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0329 - MSSVR - (L1) Ensure Microsoft network server: Server SPN target name validation level is set to Accept if provided by client or higher (MS only)"
  info                     : "This policy setting controls the level of validation a computer with shared folders or printers (the server) performs on the service principal name (SPN) that is provided by the client computer when it establishes a session using the server message block (SMB) protocol."
  reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1" || "2"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanManServer\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SMBServerNameHardeningLevel'] -ne $null) { [int]$p.'SMBServerNameHardeningLevel' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0330 - MSSVR - (L1) Ensure Windows Firewall: Domain: Firewall state is set to On (recommended)"
  info                     : "Select On (recommended) to have Windows Firewall with Advanced Security use the settings for this profile to filter network traffic."
  reference                : "NIST 800-53r5|SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\WindowsFirewall\DomainProfile' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableFirewall'] -ne $null) { [int]$p.'EnableFirewall' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0331 - MSSVR - (L1) Ensure Windows Firewall: Domain: Inbound connections is set to Block (default)"
  info                     : "This setting determines the behavior for inbound connections that do not match an inbound firewall rule."
  reference                : "NIST 800-53r5|SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\WindowsFirewall\DomainProfile' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DefaultInboundAction'] -ne $null) { [int]$p.'DefaultInboundAction' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0332 - MSSVR - (L1) Ensure Windows Firewall: Domain: Settings: Display a notification is set to No"
  info                     : "Select this option to have Windows Firewall with Advanced Security display notifications to the user when a program is blocked from receiving inbound connections."
  reference                : "NIST 800-53r5|SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\WindowsFirewall\DomainProfile' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DisableNotifications'] -ne $null) { [int]$p.'DisableNotifications' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0333 - MSSVR - (L1) Ensure Windows Firewall: Domain: Logging: Name is set to %SystemRoot%\System32\logfiles\firewall\domainfw.log"
  info                     : "Use this option to specify the path and name of the file in which Windows Firewall will write its log information."
  reference                : "NIST 800-53r5|SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "%SYSTEMROOT%\System32\logfiles\firewall\domainfw.log"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\WindowsFirewall\DomainProfile\Logging' -ErrorAction SilentlyContinue; $val = if ($p) { [string]$p.'LogFilePath' } else { $null }; if ($val -ne $null) { $val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0334 - MSSVR - (L1) Ensure Windows Firewall: Domain: Logging: Size limit (KB) is set to 16,384 KB or greater"
  info                     : "Use this option to specify the size limit of the file in which Windows Firewall will write its log information."
  reference                : "NIST 800-53r5|SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "[16384..MAX]"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\WindowsFirewall\DomainProfile\Logging' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LogFileSize'] -ne $null) { [int]$p.'LogFileSize' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0335 - MSSVR - (L1) Ensure Windows Firewall: Domain: Logging: Log dropped packets is set to Yes"
  info                     : "Use this option to log when Windows Firewall with Advanced Security discards an inbound packet for any reason."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12 SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\WindowsFirewall\DomainProfile\Logging' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LogDroppedPackets'] -ne $null) { [int]$p.'LogDroppedPackets' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0336 - MSSVR - (L1) Ensure Windows Firewall: Domain: Logging: Log successful connections is set to Yes"
  info                     : "Use this option to log when Windows Firewall with Advanced Security allows an inbound connection."
  reference                : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12 SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\WindowsFirewall\DomainProfile\Logging' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LogSuccessfulConnections'] -ne $null) { [int]$p.'LogSuccessfulConnections' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0337 - MSSVR - (L1) Ensure Windows Firewall: Private: Firewall state is set to On (recommended)"
  info                     : "Select On (recommended) to have Windows Firewall with Advanced Security use the settings for this profile to filter network traffic."
  reference                : "NIST 800-53r5|SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\WindowsFirewall\PrivateProfile' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableFirewall'] -ne $null) { [int]$p.'EnableFirewall' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0338 - MSSVR - (L1) Ensure Windows Firewall: Private: Inbound connections is set to Block (default)"
  info                     : "This setting determines the behavior for inbound connections that do not match an inbound firewall rule."
  reference                : "NIST 800-53r5|SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\WindowsFirewall\PrivateProfile' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DefaultInboundAction'] -ne $null) { [int]$p.'DefaultInboundAction' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0339 - MSSVR - (L1) Ensure Windows Firewall: Private: Settings: Display a notification is set to No"
  info                     : "Select this option to have Windows Firewall with Advanced Security display notifications to the user when a program is blocked from receiving inbound connections."
  reference                : "NIST 800-53r5|SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\WindowsFirewall\PrivateProfile' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DisableNotifications'] -ne $null) { [int]$p.'DisableNotifications' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0340 - MSSVR - (L1) Ensure Windows Firewall: Private: Logging: Name is set to %SystemRoot%\System32\logfiles\firewall\privatefw.log"
  info                     : "Use this option to specify the path and name of the file in which Windows Firewall will write its log information."
  reference                : "NIST 800-53r5|SC-7 SC-7(5)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "%SYSTEMROOT%\System32\logfiles\firewall\privatefw.log"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\WindowsFirewall\PrivateProfile\Logging' -ErrorAction SilentlyContinue; $val = if ($p) { [string]$p.'LogFilePath' } else { $null }; if ($val -ne $null) { $val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0341 - MSSVR - (L1) Ensure Windows Firewall: Private: Logging: Size limit (KB) is set to 16,384 KB or greater"
  info                     : "Use this option to specify the size limit of the file in which Windows Firewall will write its log information."
