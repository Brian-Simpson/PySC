</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0163 - MSSVR - (L1) Ensure Configure multicast DNS (mDNS) protocol is set to Disabled"
  info                     : "This policy setting determines if the DNS client will perform name resolution over Multicast DNS (mDNS)."
  reference                : "NIST 800-53r5|CM-7b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
