</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0172 - MSSVR - (L1) Ensure Configure RPC connection settings: Use authentication for outgoing RPC connections is set to Enabled: Default"
  info                     : "This policy setting controls which protocol and protocol settings to use for outgoing Remote Procedure Call (RPC) connections to a remote print spooler."
  reference                : "NIST 800-53r5|CM-6b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
