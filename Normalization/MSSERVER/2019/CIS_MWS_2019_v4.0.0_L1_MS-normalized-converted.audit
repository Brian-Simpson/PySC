</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0177 - MSSVR - (L1) Ensure Limits print driver installation to Administrators is set to Enabled"
  info                     : "This policy setting controls whether users who aren't Administrators can install print drivers on the system."
  reference                : "NIST 800-53r5|SI-4"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\Printers\PointAndPrint' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RestrictDriverInstallationToAdministrators'] -ne $null) { [int]$p.'RestrictDriverInstallationToAdministrators' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0178 - MSSVR - (L1) Ensure Boot-Start Driver Initialization Policy is set to Enabled: Good, unknown and bad but critical"
  info                     : "This policy setting allows you to specify which boot-start drivers are initialized based on a classification determined by an Early Launch Antimalware boot-start driver."
