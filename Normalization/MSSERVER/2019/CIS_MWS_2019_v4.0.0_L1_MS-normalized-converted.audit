  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RestrictAnonymous'] -ne $null) { [int]$p.'RestrictAnonymous' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0266 - MSSVR - (L1) Ensure Network access: Let Everyone permissions apply to anonymous users is set to Disabled"
  info                     : "This policy setting determines what additional permissions are assigned for anonymous connections to the computer."
