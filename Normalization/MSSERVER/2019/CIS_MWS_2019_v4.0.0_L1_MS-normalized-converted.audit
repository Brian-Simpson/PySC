  value_data               : "2"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Tcpip6\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DisableIPSourceRouting'] -ne $null) { [int]$p.'DisableIPSourceRouting' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0152 - MSSVR - (L1) Ensure MSS: (DisableIPSourceRouting) IP source routing protection level is set to Enabled: Highest protection, source routing is completely disabled"
  info                     : "IP source routing is a mechanism that allows the sender to determine the IP route that a datagram should take through the network."
  reference                : "NIST 800-53r5|SC-7(12)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "2"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Tcpip\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DisableIPSourceRouting'] -ne $null) { [int]$p.'DisableIPSourceRouting' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0153 - MSSVR - (L1) Ensure MSS: (EnableICMPRedirect) Allow ICMP redirects to override OSPF generated routes is set to Disabled"
  info                     : "Internet Control Message Protocol (ICMP) redirects cause the IPv4 stack to plumb host routes."
  reference                : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Tcpip\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableICMPRedirect'] -ne $null) { [int]$p.'EnableICMPRedirect' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0154 - MSSVR - (L1) Ensure MSS: (NoNameReleaseOnDemand) Allow the computer to ignore NetBIOS name release requests except from WINS servers is set to Enabled"
  info                     : "NetBIOS over TCP/IP is a network protocol that among other things provides a way to easily resolve NetBIOS names that are registered on Windows-based systems to the IP addresses that are configured on those systems."
  reference                : "NIST 800-53r5|CM-6"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\NetBT\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['NoNameReleaseOnDemand'] -ne $null) { [int]$p.'NoNameReleaseOnDemand' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0155 - MSSVR - (L1) Ensure MSS: (SafeDllSearchMode) Enable Safe DLL search mode is set to Enabled"
  info                     : "The DLL search order can be configured to search for DLLs that are requested by running processes in one of two ways: - Search folders specified in the system path first, and then search the current working folder."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Session Manager' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SafeDllSearchMode'] -ne $null) { [int]$p.'SafeDllSearchMode' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0156 - MSSVR - (L1) Ensure MSS: (ScreenSaverGracePeriod) The time in seconds before the screen saver grace period expires is set to Enabled: 5 or fewer seconds"
  info                     : "Windows includes a grace period between when the screen saver is launched and when the console is actually locked automatically when screen saver locking is enabled."
  reference                : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "[0..5]"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Winlogon' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ScreenSaverGracePeriod'] -ne $null) { [int]$p.'ScreenSaverGracePeriod' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0157 - MSSVR - (L1) Ensure Prohibit installation and configuration of Network Bridge on your DNS domain network is set to Enabled"
  info                     : "You can use this procedure to control a user's ability to install and configure a Network Bridge."
  reference                : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\Network Connections' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['NC_AllowNetBridge_NLA'] -ne $null) { [int]$p.'NC_AllowNetBridge_NLA' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0158 - MSSVR - (L1) Ensure Prohibit use of Internet Connection Sharing on your DNS domain network is set to Enabled"
  info                     : "Although this \'legacy\' setting traditionally applied to the use of Internet Connection Sharing (ICS) in Windows 2000, Windows XP & Server 2003, this setting now freshly applies to the Mobile Hotspot feature in Windows 10 & Server 2016."
  reference                : "NIST 800-53r5|CM-6 CM-7"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
