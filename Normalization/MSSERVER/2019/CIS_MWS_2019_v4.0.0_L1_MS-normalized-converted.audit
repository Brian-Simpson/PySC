<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0233 - MSSVR - (L1) Ensure Deny access to this computer from the network to include Guests, Local account and member of Administrators group (MS only)"
  info                     : "This policy setting prohibits users from connecting to a computer from across the network, which would allow users to access and potentially modify data remotely."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "STATUS: PASSED"
  powershell_args          : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeDenyNetworkLogonRight\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; $expected = @('Guests', 'Local account and member of Administrators group'); $ok = $true; foreach ($e in $expected) { $found = $false; foreach ($m in $members) { if ($m -like $e) { $found = $true } }; if (-not $found) { $ok = $false } }; if ($ok) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

