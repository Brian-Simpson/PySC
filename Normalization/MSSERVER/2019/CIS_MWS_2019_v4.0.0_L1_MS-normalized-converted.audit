</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0159 - MSSVR - (L1) Ensure Require domain users to elevate when setting a networks location is set to Enabled"
  info                     : "This policy setting determines whether to require domain users to elevate when setting a network's location."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
