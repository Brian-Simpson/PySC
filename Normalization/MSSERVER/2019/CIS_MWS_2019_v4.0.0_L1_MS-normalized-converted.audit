</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0170 - MSSVR - (L1) Ensure Configure Redirection Guard is set to Enabled: Redirection Guard Enabled"
  info                     : "This policy setting determines whether Redirection Guard is enabled for the print spooler."
  reference                : "NIST 800-53r5|SI-16"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\Printers' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RedirectionGuardPolicy'] -ne $null) { [int]$p.'RedirectionGuardPolicy' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0171 - MSSVR - (L1) Ensure Configure RPC connection settings: Protocol to use for outgoing RPC connections is set to Enabled: RPC over TCP"
  info                     : "This policy setting controls which protocol and protocol settings to use for outgoing Remote Procedure Call (RPC) connections to a remote print spooler."
  reference                : "NIST 800-53r5|CM-6b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
