</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0176 - MSSVR - (L1) Ensure Configure RPC packet level privacy setting for incoming connections is set to Enabled"
  info                     : "This policy setting controls packet level privacy for Remote Procedure Call (RPC) incoming connections."
  reference                : "NIST 800-53r5|CM-6b."
  see_also                 : "See HTH Policies and Standards"
