  value_type               : POLICY_TEXT
  value_data               : "Administrators"
  powershell_args          : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeShutdownPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0256 - MSSVR - (L1) Ensure Take ownership of files or other objects is set to Administrators"
  info                     : "This policy setting allows users to take ownership of files, folders, registry keys, processes, or threads."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators"
  powershell_args          : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeTakeOwnershipPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0257 - MSSVR - (L1) Ensure Adjust memory quotas for a process is set to Administrators, LOCAL SERVICE, NETWORK SERVICE"
  info                     : "This policy setting allows a user to adjust the maximum amount of memory that is available to a process."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators,LOCAL SERVICE,NETWORK SERVICE"
  powershell_args          : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeIncreaseQuotaPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0258 - MSSVR - (L1) Ensure Allow log on locally is set to Administrators (MS only)"
  info                     : "This policy setting determines which users can interactively log on to computers in your environment."
  reference                : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Administrators"
  powershell_args          : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeInteractiveLogonRight\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0259 - MSSVR - (L1) Ensure Network access: Allow anonymous SID/Name translation is set to Disabled"
  info                     : "This policy setting determines whether an anonymous user can request security identifier (SID) attributes for another user, or use a SID to obtain its corresponding user name."
  reference                : "NIST 800-53r5|AC-6(10) IA-2(2)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "Disabled"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $v = if ($p) { [int]$p.AnonymousNameLookup } else { $null }; if ($v -eq 0) { 'Disabled' } elseif ($v -eq 1) { 'Enabled' } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0260 - MSSVR - (L1) Ensure Network access: Restrict anonymous access to Named Pipes and Shares is set to Enabled"
  info                     : "When enabled, this policy setting restricts anonymous access to only those shares and pipes that are named in the Network access: Named pipes that can be accessed anonymously and Network access: Shares that can be accessed anonymously settings."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanManServer\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RestrictNullSessAccess'] -ne $null) { [int]$p.'RestrictNullSessAccess' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0261 - MSSVR - (L1) Ensure Network access: Restrict clients allowed to make remote calls to SAM is set to Administrators: Remote Access: Allow (MS only)"
  info                     : "This policy setting allows you to restrict remote RPC connections to SAM."
  reference                : "NIST 800-53r5|AC-6(3)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "O:BAG:BAD:(A;;RC;;;BA)"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p) { [string]$p.'restrictremotesam' } else { $null }; if ($val -ne $null) { $val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0262 - MSSVR - (L1) Ensure Network access: Shares that can be accessed anonymously is set to None"
  info                     : "This policy setting determines which network shares can be accessed by anonymous users."
  reference                : "NIST 800-53r5|AC-3"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : ""
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanManServer\Parameters' -ErrorAction SilentlyContinue; $val = if ($p) { $p.'NullSessionShares' } else { @() }; if ($val) { ($val -join ',') } else { '' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0263 - MSSVR - (L1) Ensure Network access: Sharing and security model for local accounts is set to Classic - local users authenticate as themselves"
  info                     : "This policy setting determines how network logons that use local accounts are authenticated."
  reference                : "NIST 800-53r5|CM-6b."
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "0"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ForceGuest'] -ne $null) { [int]$p.'ForceGuest' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0264 - MSSVR - (L1) Ensure Network access: Do not allow anonymous enumeration of SAM accounts is set to Enabled (MS only)"
  info                     : "This policy setting controls the ability of anonymous users to enumerate the accounts in the Security Accounts Manager (SAM)."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
  value_type               : POLICY_TEXT
  value_data               : "1"
  powershell_args          : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RestrictAnonymousSAM'] -ne $null) { [int]$p.'RestrictAnonymousSAM' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
</custom_item>

<custom_item>
  type                     : AUDIT_POWERSHELL
  description              : "1.0265 - MSSVR - (L1) Ensure Network access: Do not allow anonymous enumeration of SAM accounts and shares is set to Enabled (MS only)"
  info                     : "This policy setting controls the ability of anonymous users to enumerate SAM accounts as well as shares."
  reference                : "NIST 800-53r5|AC-6(10)"
  see_also                 : "See HTH Policies and Standards"
