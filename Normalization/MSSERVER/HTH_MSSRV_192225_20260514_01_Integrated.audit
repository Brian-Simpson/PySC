          powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeDenyBatchLogonRight\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; $expected = @('Guests'); $ok = $true; foreach ($e in $expected) { $found = $false; foreach ($m in $members) { if ($m -like $e) { $found = $true } }; if (-not $found) { $ok = $false } }; if ($ok) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0209 - MSSRV - Ensure Deny log on as a service to include Guests"
