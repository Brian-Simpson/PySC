        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0206 - MSSRV - Ensure Create permanent shared objects is set to No One"
          info                 : "This user right is useful to kernel-mode components that extend the object namespace."
          reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : ""
          powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeCreatePermanentPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
        </custom_item>
        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0207 - MSSRV - Ensure Debug programs is set to Administrators"
          info                 : "This policy setting determines which user accounts will have the right to attach a debugger to any process or to the kernel, which provides complete access to sensitive and critical operating system components."
          reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
