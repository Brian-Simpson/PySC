        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0034 - MSSRV - Ensure Audit Security State Change is set to include Success"
          info                 : "This subcategory reports changes in security state of the system, such as when the security subsystem starts and stops."
