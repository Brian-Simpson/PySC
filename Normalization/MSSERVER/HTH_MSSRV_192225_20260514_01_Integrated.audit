        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0213 - MSSRV - Ensure Increase scheduling priority is set to Administrators, Window Manager\Window Manager Group"
          info                 : "This policy setting determines whether users can increase the base priority class of a process."
