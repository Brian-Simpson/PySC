        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0237 - MSSRV - Ensure Network security: Allow Local System to use computer identity for NTLM is set to Enabled"
          info                 : "This policy setting determines whether Local System services that use Negotiate when reverting to NTLM authentication can use the computer identity."
          reference            : "NIST 800-53r5|IA-3"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['UseMachineId'] -ne $null) { [int]$p.'UseMachineId' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0238 - MSSRV - Ensure Network security: Minimum session security for NTLM SSP based (including secure RPC) servers is set to Require NTLMv2 session security, Require 128-bit encryption"
          info                 : "This policy setting determines which behaviors are allowed by servers for applications using the NTLM Security Support Provider (SSP)."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "537395200"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa\MSV1_0' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['NTLMMinServerSec'] -ne $null) { [int]$p.'NTLMMinServerSec' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0239 - MSSRV - Ensure Network security: Restrict NTLM: Audit Incoming NTLM Traffic is set to Enable auditing for all accounts"
          info                 : "This policy setting allows the auditing of incoming NTLM traffic."
          reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "2"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa\MSV1_0' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AuditReceivingNTLMTraffic'] -ne $null) { [int]$p.'AuditReceivingNTLMTraffic' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>
        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0240 - MSSRV - Ensure Network security: Restrict NTLM: Outgoing NTLM traffic to remote servers is set to Audit all or higher"
          info                 : "This policy setting allows the auditing of outgoing NTLM traffic."
          reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1" || "2"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa\MSV1_0' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RestrictSendingNTLMTraffic'] -ne $null) { [int]$p.'RestrictSendingNTLMTraffic' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0241 - MSSRV - Ensure Network security: Allow LocalSystem NULL session fallback is set to Disabled"
          info                 : "This policy setting determines whether NTLM is allowed to fall back to a NULL session when used with LocalSystem."
          reference            : "NIST 800-53r5|AC-6(10)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa\MSV1_0' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AllowNullSessionFallback'] -ne $null) { [int]$p.'AllowNullSessionFallback' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0242 - MSSRV - Ensure Network Security: Allow PKU2U authentication requests to this computer to use online identities is set to Disabled"
          info                 : "This setting determines if online identities are able to authenticate to this computer."
          reference            : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa\pku2u' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AllowOnlineID'] -ne $null) { [int]$p.'AllowOnlineID' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0243 - MSSRV - Ensure Network security: Configure encryption types allowed for Kerberos is set to AES128_HMAC_SHA1, AES256_HMAC_SHA1, Future encryption types"
          info                 : "This policy setting allows you to set the encryption types that Kerberos is allowed to use."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "2147483640"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System\Kerberos\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SupportedEncryptionTypes'] -ne $null) { [int]$p.'SupportedEncryptionTypes' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0244 - MSSRV - Ensure Network security: Do not store LAN Manager hash value on next password change is set to Enabled"
          info                 : "This policy setting determines whether the LAN Manager (LM) hash value for the new password is stored when the password is changed."
          reference            : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['NoLMHash'] -ne $null) { [int]$p.'NoLMHash' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0245 - MSSRV - Ensure Network security: Force logoff when logon hours expire is set to Enabled"
          info                 : "This policy setting determines whether to disconnect users who are connected to the local computer outside their user account's valid logon hours."
          reference            : "NIST 800-53r5|AC-2(12)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "Enabled"
          powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^ForceLogoffWhenHourExpire\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -eq '1') { 'Enabled' } elseif ($val -eq '0') { 'Disabled' } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0246 - MSSRV - Ensure Network security: LAN Manager authentication level is set to Send NTLMv2 response only. Refuse LM & NTLM"
          info                 : "This policy setting determines which challenge or response authentication protocol is used for network logons."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "5"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LMCompatibilityLevel'] -ne $null) { [int]$p.'LMCompatibilityLevel' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0247 - MSSRV - Ensure Network security: LDAP client signing requirements is set to Negotiate signing or higher"
          info                 : "This policy setting determines the level of data signing that is requested on behalf of clients that issue LDAP BIND requests."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1" || "2"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LDAP' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LDAPClientIntegrity'] -ne $null) { [int]$p.'LDAPClientIntegrity' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0248 - MSSRV - Ensure Network security: Minimum session security for NTLM SSP based (including secure RPC) clients is set to Require NTLMv2 session security, Require 128-bit encryption"
          info                 : "This policy setting determines which behaviors are allowed by clients for applications using the NTLM Security Support Provider (SSP)."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "537395200"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa\MSV1_0' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['NTLMMinClientSec'] -ne $null) { [int]$p.'NTLMMinClientSec' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0249 - MSSRV - Ensure Accounts: Limit local account use of blank passwords to console logon only is set to Enabled"
          info                 : "This policy setting determines whether local accounts that are not password protected can be used to log on from locations other than the physical computer console."
          reference            : "NIST 800-53r5|IA-5(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LimitBlankPasswordUse'] -ne $null) { [int]$p.'LimitBlankPasswordUse' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0250 - MSSRV - Configure Accounts: Rename administrator account"
          info                 : "This policy setting enables the ability to rename the built-in local administrator account."
          reference            : "NIST 800-53r5|IA-5"
          see_also             : "See HTH Policies and Standards"
          check_type           : CHECK_NOT_EQUAL
          value_type           : POLICY_TEXT
          value_data           : "\b[Aa]dmin(istrator)?"
          powershell_args      : "$a = Get-LocalUser | Where-Object { $_.SID -like 'S-1-5-*-500' }; if ($a -ne $null) { $a.Name } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0251 - MSSRV - Ensure Shutdown: Allow system to be shut down without having to log on is set to Disabled"
          info                 : "This policy setting determines whether a computer can be shut down when a user is not logged on."
          reference            : "NIST 800-53r5|AC-6(10)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ShutdownWithoutLogon'] -ne $null) { [int]$p.'ShutdownWithoutLogon' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0252 - MSSRV - Configure Accounts: Rename guest account"
          info                 : "This policy setting enables the ability to rename the built-in local guest account."
          reference            : "NIST 800-53r5|IA-5"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "Guest"
          powershell_args      : "$u = Get-LocalUser -Name 'Guest' -ErrorAction SilentlyContinue; if ($u -ne $null) { if ($u.Enabled) { 'Enabled' } else { 'Disabled' } } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0253 - MSSRV - Ensure System objects: Require case insensitivity for non-Windows subsystems is set to Enabled"
          info                 : "This policy setting determines whether case insensitivity is enforced for all subsystems."
          reference            : "NIST 800-53r5|CM-6b."
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Session Manager\Kernel' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ObCaseInsensitive'] -ne $null) { [int]$p.'ObCaseInsensitive' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0254 - MSSRV - Ensure System objects: Strengthen default permissions of internal system objects (e.g. Symbolic Links) is set to Enabled"
          info                 : "This policy setting determines the strength of the default discretionary access control list (DACL) for objects."
          reference            : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Session Manager' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ProtectionMode'] -ne $null) { [int]$p.'ProtectionMode' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0255 - MSSRV - Ensure User Account Control: Admin Approval Mode for the Built-in Administrator account is set to Enabled"
          info                 : "This policy setting controls the behavior of Admin Approval Mode for the built-in Administrator account."
          reference            : "NIST 800-53r5|AC-2(9)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['FilterAdministratorToken'] -ne $null) { [int]$p.'FilterAdministratorToken' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0256 - MSSRV - Ensure User Account Control: Behavior of the elevation prompt for administrators in Admin Approval Mode is set to Prompt for consent on the secure desktop or higher"
          info                 : "This policy setting controls the behavior of the elevation prompt for administrators."
          reference            : "NIST 800-53r5|AC-6(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1" || "2"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ConsentPromptBehaviorAdmin'] -ne $null) { [int]$p.'ConsentPromptBehaviorAdmin' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0257 - MSSRV - Ensure User Account Control: Behavior of the elevation prompt for standard users is set to Automatically deny elevation requests"
          info                 : "This policy setting controls the behavior of the elevation prompt for standard users."
          reference            : "NIST 800-53r5|AC-6(10)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ConsentPromptBehaviorUser'] -ne $null) { [int]$p.'ConsentPromptBehaviorUser' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0258 - MSSRV - Ensure User Account Control: Detect application installations and prompt for elevation is set to Enabled"
          info                 : "This policy setting controls the behavior of application installation detection for the computer."
          reference            : "NIST 800-53r5|AC-6(8)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableInstallerDetection'] -ne $null) { [int]$p.'EnableInstallerDetection' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0259 - MSSRV - Ensure User Account Control: Only elevate UIAccess applications that are installed in secure locations is set to Enabled"
          info                 : "This policy setting controls whether applications that request to run with a User Interface Accessibility (UIAccess) integrity level must reside in a secure location in the file system."
          reference            : "NIST 800-53r5|AC-6(8)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableSecureUIAPaths'] -ne $null) { [int]$p.'EnableSecureUIAPaths' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0260 - MSSRV - Ensure User Account Control: Run all administrators in Admin Approval Mode is set to Enabled"
          info                 : "This policy setting controls the behavior of all User Account Control (UAC) policy settings for the computer."
          reference            : "NIST 800-53r5|AC-6(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableLUA'] -ne $null) { [int]$p.'EnableLUA' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0261 - MSSRV - Ensure User Account Control: Switch to the secure desktop when prompting for elevation is set to Enabled"
          info                 : "This policy setting controls whether the elevation request prompt is displayed on the interactive user's desktop or the secure desktop."
          reference            : "NIST 800-53r5|AC-6(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['PromptOnSecureDesktop'] -ne $null) { [int]$p.'PromptOnSecureDesktop' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0262 - MSSRV - Ensure User Account Control: Virtualize file and registry write failures to per-user locations is set to Enabled"
          info                 : "This policy setting controls whether application write failures are redirected to defined registry and file system locations."
          reference            : "NIST 800-53r5|SC-29(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableVirtualization'] -ne $null) { [int]$p.'EnableVirtualization' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0263 - MSSRV - Ensure Audit: Force audit policy subcategory settings (Windows Vista or later) to override audit policy category settings is set to Enabled"
          info                 : "This policy setting allows administrators to enable the more precise auditing capabilities present in Windows Vista."
          reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SCENoApplyLegacyAuditPolicy'] -ne $null) { [int]$p.'SCENoApplyLegacyAuditPolicy' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0264 - MSSRV - Ensure Audit: Shut down system immediately if unable to log security audits is set to Disabled"
          info                 : "This policy setting determines whether the system shuts down if it is unable to log Security events."
          reference            : "NIST 800-53r5|AU-4"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\LSA' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['CrashOnAuditFail'] -ne $null) { [int]$p.'CrashOnAuditFail' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0265 - MSSRV - Ensure Devices: Prevent users from installing printer drivers is set to Enabled"
          info                 : "This policy setting determines who is allowed to install a printer driver as part of connecting to a shared printer."
          reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Print\Providers\LanMan Print Services\Servers' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AddPrinterDrivers'] -ne $null) { [int]$p.'AddPrinterDrivers' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0266 - MSSRV - Ensure Domain member: Digitally encrypt or sign secure channel data (always) is set to Enabled"
          info                 : "This policy setting determines whether all secure channel traffic that is initiated by the domain member must be signed or encrypted."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RequireSignOrSeal'] -ne $null) { [int]$p.'RequireSignOrSeal' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0267 - MSSRV - Ensure Domain member: Digitally encrypt secure channel data (when possible) is set to Enabled"
          info                 : "This policy setting determines whether a domain member should attempt to negotiate encryption for all secure channel traffic that it initiates."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SealSecureChannel'] -ne $null) { [int]$p.'SealSecureChannel' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0268 - MSSRV - Ensure Domain member: Digitally sign secure channel data (when possible) is set to Enabled"
          info                 : "This policy setting determines whether a domain member should attempt to negotiate whether all secure channel traffic that it initiates must be digitally signed."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
