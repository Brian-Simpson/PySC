          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "Success and Failure"
          powershell_args      : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'IPsec Driver' 2>&1; $line = $r | Where-Object { $_ -like '*IPsec Driver*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; $val"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0033 - MSSRV - Ensure Audit Other System Events is set to Success and Failure"
          info                 : "This subcategory reports on other system events."
