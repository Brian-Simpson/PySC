          powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeReLabelPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0217 - MSSRV - Ensure Act as part of the operating system is set to No One"
          info                 : "This policy setting allows a process to assume the identity of any user and thus gain access to the resources that the user is authorized to access."
          reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
