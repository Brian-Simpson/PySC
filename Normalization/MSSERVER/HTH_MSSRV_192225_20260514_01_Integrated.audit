        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0035 - MSSRV - Ensure Audit Security System Extension is set to include Success"
          info                 : "This subcategory reports the loading of extension code such as authentication packages by the security subsystem."
          reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
