        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0125 - MSSRV - Ensure No auto-restart with logged on users for scheduled automatic updates installations is set to Disabled"
          info                 : "This policy setting specifies that Automatic Updates will wait for computers to be restarted by the users who are logged on to them to complete a scheduled installation."
          reference            : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
