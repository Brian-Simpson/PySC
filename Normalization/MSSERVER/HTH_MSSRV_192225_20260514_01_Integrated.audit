        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0037 - MSSRV - Ensure Turn off cloud consumer account state content is set to Enabled"
          info                 : "This policy setting determines whether cloud consumer account state content is allowed in all Windows experiences."
          reference            : "NIST 800-53r5|AC-2(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\CloudContent' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DisableConsumerAccountStateContent'] -ne $null) { [int]$p.'DisableConsumerAccountStateContent' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0038 - MSSRV - Ensure Require pin for pairing is set to Enabled: First Time OR Enabled: Always"
          info                 : "This policy setting controls whether or not a PIN is required for pairing to a wireless display device."
          reference            : "NIST 800-53r5|IA-5c."
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1" || "2"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\Connect' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RequirePinForPairing'] -ne $null) { [int]$p.'RequirePinForPairing' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0039 - MSSRV - Ensure Do not display the password reveal button is set to Enabled"
          info                 : "This policy setting allows you to configure the display of the password reveal button in password entry user experiences."
          reference            : "NIST 800-53r5|IA-5(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\CredUI' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DisablePasswordReveal'] -ne $null) { [int]$p.'DisablePasswordReveal' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0040 - MSSRV - Ensure Enumerate administrator accounts on elevation is set to Disabled"
          info                 : "This policy setting controls whether administrator accounts are displayed when a user attempts to elevate a running application."
          reference            : "NIST 800-53r5|AC-6(10)"
