          powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeTcbPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0218 - MSSRV - Ensure Modify firmware environment values is set to Administrators"
          info                 : "This policy setting allows users to configure the system-wide environment variables that affect hardware configuration."
          reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
