        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0036 - MSSRV - Ensure Audit System Integrity is set to Success and Failure"
          info                 : "This subcategory reports on violations of integrity of the security subsystem."
