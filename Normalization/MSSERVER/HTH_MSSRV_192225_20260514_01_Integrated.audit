          powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeProfileSingleProcessPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0221 - MSSRV - Ensure Profile system performance is set to Administrators, NT SERVICE\WdiServiceHost"
          info                 : "This policy setting determines which users can use Windows performance monitoring tools to monitor the performance of system processes."
          reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "Administrators" && ("NT SERVICE\WdiServiceHost" || "WdiServiceHost")
          powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeSystemProfilePrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0222 - MSSRV - Ensure Replace a process level token is set to LOCAL SERVICE, NETWORK SERVICE"
          info                 : "This policy setting allows one process or service to start another service or process with a different security access token, which can be used to modify the security access token of that sub-process and result in the escalation of privileges."
          reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "LOCAL SERVICE,NETWORK SERVICE"
          powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeAssignPrimaryTokenPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0223 - MSSRV - Ensure Restore files and directories is set to Administrators"
          info                 : "This policy setting determines which users can bypass file, directory, registry, and other persistent object permissions when restoring backed up files and directories on systems that run Windows Vista (or newer)."
          reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "Administrators"
          powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeRestorePrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0224 - MSSRV - Ensure Shut down the system is set to Administrators"
          info                 : "This policy setting determines which users who are logged on locally to the computers in your environment can shut down the operating system with the Shut Down command."
          reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "Administrators"
          powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeShutdownPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0225 - MSSRV - Ensure Take ownership of files or other objects is set to Administrators"
          info                 : "This policy setting allows users to take ownership of files, folders, registry keys, processes, or threads."
          reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "Administrators"
          powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeTakeOwnershipPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0226 - MSSRV - Ensure Adjust memory quotas for a process is set to Administrators, LOCAL SERVICE, NETWORK SERVICE"
          info                 : "This policy setting allows a user to adjust the maximum amount of memory that is available to a process."
          reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "Administrators,LOCAL SERVICE,NETWORK SERVICE"
          powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeIncreaseQuotaPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0227 - MSSRV - Ensure Network access: Allow anonymous SID/Name translation is set to Disabled"
          info                 : "This policy setting determines whether an anonymous user can request security identifier (SID) attributes for another user, or use a SID to obtain its corresponding user name."
          reference            : "NIST 800-53r5|AC-6(10) IA-2(2)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "Disabled"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $v = if ($p) { [int]$p.AnonymousNameLookup } else { $null }; if ($v -eq 0) { 'Disabled' } elseif ($v -eq 1) { 'Enabled' } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0228 - MSSRV - Ensure Network access: Restrict anonymous access to Named Pipes and Shares is set to Enabled"
          info                 : "When enabled, this policy setting restricts anonymous access to only those shares and pipes that are named in the Network access: Named pipes that can be accessed anonymously and Network access: Shares that can be accessed anonymously settings."
          reference            : "NIST 800-53r5|AC-6(10)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanManServer\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RestrictNullSessAccess'] -ne $null) { [int]$p.'RestrictNullSessAccess' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0229 - MSSRV - Ensure Network access: Shares that can be accessed anonymously is set to None"
          info                 : "This policy setting determines which network shares can be accessed by anonymous users."
          reference            : "NIST 800-53r5|AC-3"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : ""
