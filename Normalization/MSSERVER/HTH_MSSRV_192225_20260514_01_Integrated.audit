        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0090 - MSSRV - Ensure ShellSmartScreenLevel is Windows: Registry Value to Block"
          info                 : "Configures Windows SmartScreen to block unrecognized or potentially malicious applications and downloads."
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "Block"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\System' -ErrorAction SilentlyContinue; $val = if ($p) { [string]$p.'ShellSmartScreenLevel' } else { $null }; if ($val -ne $null) { $val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0091 - MSSRV - EnableSmartScreen"
          info                 : "Enables Windows SmartScreen to help protect systems from malicious websites and untrusted application downloads."
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableSmartScreen'] -ne $null) { [int]$p.'EnableSmartScreen' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0092 - MSSRV - Value of DeferQualityUpdatesPeriodInDays"
          info                 : "Specifies the number of days that quality updates are deferred to ensure timely installation of security patches."
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\WindowsUpdate' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DeferQualityUpdatesPeriodInDays'] -ne $null) { [int]$p.'DeferQualityUpdatesPeriodInDays' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0093 - MSSRV - Value of DeferQualityUpdates"
          info                 : "Controls whether quality updates are deferred, ensuring critical security updates are applied without delay."
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\WindowsUpdate' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DeferQualityUpdates'] -ne $null) { [int]$p.'DeferQualityUpdates' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0094 - MSSRV - NETLOGON"
          check_type           : CHECK_REGEX
          info                 : "Ensures SMB hardening for the NETLOGON share by requiring mutual authentication, integrity, and privacy protections to prevent man-in-the-middle attacks. Primarily relevant for domain-joined systems using domain authentication."
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "[Rr]equire([Mm]utual[Aa]uthentication|[Ii]ntegrity|[Pp]rivacy)=1.*[Rr]equire([Mm]utual[Aa]uthentication|[Ii]ntegrity|[Pp]rivacy)=1.*[Rr]equire([Mm]utual[Aa]uthentication|[Ii]ntegrity|[Pp]rivacy)=1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\NetworkProvider\HardenedPaths' -ErrorAction SilentlyContinue; $val = if ($p) { [string]$p.'\\*\NETLOGON' } else { $null }; if ($val -ne $null) { $val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0095 - MSSRV - SYSVOL"
          check_type           : CHECK_REGEX
          info                 : "Ensures SMB hardening for the SYSVOL share by requiring mutual authentication, integrity, and privacy protections to secure Group Policy distribution. Primarily relevant for domain-joined systems."
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "[Rr]equire([Mm]utual[Aa]uthentication|[Ii]ntegrity|[Pp]rivacy)=1.*[Rr]equire([Mm]utual[Aa]uthentication|[Ii]ntegrity|[Pp]rivacy)=1.*[Rr]equire([Mm]utual[Aa]uthentication|[Ii]ntegrity|[Pp]rivacy)=1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\NetworkProvider\HardenedPaths' -ErrorAction SilentlyContinue; $val = if ($p) { [string]$p.'\\*\SYSVOL' } else { $null }; if ($val -ne $null) { $val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0096 - MSSRV - WINS Server Feature installed"
          check_type           : CHECK_REGEX
          info                 : "Checks whether the legacy WINS server feature is installed, which is deprecated and should be removed to reduce attack surface. Only applicable to systems where the feature could be installed."
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : ".*Available.*"
          powershell_args      : "Get-WindowsFeature | Where {$_.Name -eq 'WINS'} | SELECT 'InstallState' | Format-List"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0097 - MSSRV - Active Directory Certificate Services role enabled"
          check_type           : CHECK_REGEX
          info                 : "Identifies systems with Active Directory Certificate Services installed, which require additional hardening and monitoring due to their role in Public Key Infrastructure."
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : ".*Installed.*"
          powershell_args      : "Get-WindowsFeature | Where {$_.Name -like 'ADCS*'} | SELECT 'InstallState' | Format-List"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0098 - MSSRV - Ensure Do not use temporary folders per session is set to Disabled"
          info                 : "By default, Remote Desktop Services creates a separate temporary folder on the RD Session Host server for each active session that a user maintains on the RD Session Host server."
          reference            : "NIST 800-53r5|AU-11 SI-12"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\Terminal Services' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['PerSessionTempDir'] -ne $null) { [int]$p.'PerSessionTempDir' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0099 - MSSRV - Ensure Do not allow drive redirection is set to Enabled"
          info                 : "This policy setting prevents users from sharing the local drives on their client computers to Remote Desktop Servers that they access."
          reference            : "NIST 800-53r5|CM-6 CM-7"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\Terminal Services' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['fDisableCdm'] -ne $null) { [int]$p.'fDisableCdm' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0100 - MSSRV - Ensure Always prompt for password upon connection is set to Enabled"
          info                 : "This policy setting specifies whether Remote Desktop Services always prompts the client computer for a password upon connection."
          reference            : "NIST 800-53r5|AC-17(6) IA-2"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\Terminal Services' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['fPromptForPassword'] -ne $null) { [int]$p.'fPromptForPassword' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0101 - MSSRV - Ensure Require secure RPC communication is set to Enabled"
          info                 : "This policy setting allows you to specify whether Remote Desktop Services requires secure Remote Procedure Call (RPC) communication with all clients or allows unsecured communication."
          reference            : "NIST 800-53r5|SC-7(8)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\Terminal Services' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['fEncryptRPCTraffic'] -ne $null) { [int]$p.'fEncryptRPCTraffic' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0102 - MSSRV - Ensure Require use of specific security layer for remote (RDP) connections is set to Enabled: SSL"
          info                 : "This policy setting specifies whether to require the use of a specific security layer to secure communications between clients and RD Session Host servers during Remote Desktop Protocol (RDP) connections."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "2"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\Terminal Services' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SecurityLayer'] -ne $null) { [int]$p.'SecurityLayer' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0103 - MSSRV - Ensure Require user authentication for remote connections by using Network Level Authentication is set to Enabled"
          info                 : "This policy setting allows you to specify whether to require user authentication for remote connections to the RD Session Host server by using Network Level Authentication."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\Terminal Services' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['UserAuthentication'] -ne $null) { [int]$p.'UserAuthentication' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0104 - MSSRV - Ensure Set client connection encryption level is set to Enabled: High Level"
          info                 : "This policy setting specifies whether to require the use of a specific encryption level to secure communications between client computers and RD Session Host servers during Remote Desktop Protocol (RDP) connections."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "3"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\Terminal Services' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['MinEncryptionLevel'] -ne $null) { [int]$p.'MinEncryptionLevel' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0105 - MSSRV - Ensure Prevent downloading of enclosures is set to Enabled"
          info                 : "This policy setting prevents the user from having enclosures (file attachments) downloaded from an RSS feed to the user's computer."
          reference            : "NIST 800-53r5|CM-10 CM-11 SC-18"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Internet Explorer\Feeds' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DisableEnclosureDownload'] -ne $null) { [int]$p.'DisableEnclosureDownload' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0106 - MSSRV - Ensure Turn on Basic feed authentication over HTTP is set to Disabled"
          info                 : "This policy setting controls whether RSS feeds can be authenticated using the Basic authentication scheme over an unencrypted HTTP connection."
          reference            : "NIST 800-53r5|CM-10 CM-11 SC-18"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Internet Explorer\Feeds' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AllowBasicAuthInClear'] -ne $null) { [int]$p.'AllowBasicAuthInClear' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0107 - MSSRV - Ensure Allow indexing of encrypted files is set to Disabled"
          info                 : "This policy setting controls whether encrypted items are allowed to be indexed."
          reference            : "NIST 800-53r5|CM-6 CM-7"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\Windows Search' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AllowIndexingEncryptedStoresOrItems'] -ne $null) { [int]$p.'AllowIndexingEncryptedStoresOrItems' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0108 - MSSRV - Ensure Allow Microsoft accounts to be optional is set to Enabled"
          info                 : "This policy setting lets you control whether Microsoft accounts are optional for Windows Store apps that require an account to sign in."
          reference            : "NIST 800-53r5|AC-2(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['MSAOptional'] -ne $null) { [int]$p.'MSAOptional' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0109 - MSSRV - Ensure Disallow Autoplay for non-volume devices is set to Enabled"
          info                 : "This policy setting disallows AutoPlay for MTP devices like cameras or phones."
          reference            : "NIST 800-53r5|MP-7"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\Explorer' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['NoAutoplayfornonVolume'] -ne $null) { [int]$p.'NoAutoplayfornonVolume' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0110 - MSSRV - Ensure Allow Windows Ink Workspace is set to Enabled: On, but disallow access above lock OR Enabled: Disabled"
          info                 : "This policy setting determines whether Windows Ink items are allowed above the lock screen."
          reference            : "NIST 800-53r5|CM-7b."
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0" || "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\WindowsInkWorkspace' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AllowWindowsInkWorkspace'] -ne $null) { [int]$p.'AllowWindowsInkWorkspace' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0111 - MSSRV - Ensure Set the default behavior for AutoRun is set to Enabled: Do not execute any autorun commands"
          info                 : "This policy setting sets the default behavior for Autorun commands."
          reference            : "NIST 800-53r5|MP-7"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['NoAutorun'] -ne $null) { [int]$p.'NoAutorun' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0112 - MSSRV - Ensure Allow user control over installs is set to Disabled"
          info                 : "This setting controls whether users are permitted to change installation options that typically are available only to system administrators."
          reference            : "NIST 800-53r5|AC-6(10)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\Installer' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableUserControl'] -ne $null) { [int]$p.'EnableUserControl' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0113 - MSSRV - Ensure Always install with elevated privileges is set to Disabled"
          info                 : "This setting controls whether or not Windows Installer should use system permissions when it installs any program on the system."
          reference            : "NIST 800-53r5|AC-2(9)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\Installer' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AlwaysInstallElevated'] -ne $null) { [int]$p.'AlwaysInstallElevated' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0114 - MSSRV - Ensure Turn off Autoplay is set to Enabled: All drives"
          info                 : "This policy setting controls Autoplay."
          reference            : "NIST 800-53r5|MP-7"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "255"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['NoDriveTypeAutoRun'] -ne $null) { [int]$p.'NoDriveTypeAutoRun' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0115 - MSSRV - Ensure Configure the transmission of the users password in the content of MPR notifications sent by winlogon. is set to Disabled"
          info                 : "This policy setting controls whether winlogon includes a user's password in the content of Multiple Provider Router (MPR) notifications."
          reference            : "NIST 800-53r5|CM-6 CM-7"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableMPR'] -ne $null) { [int]$p.'EnableMPR' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0116 - MSSRV - Ensure Sign-in and lock last interactive user automatically after a restart is set to Disabled"
          info                 : "This policy setting controls whether a device will automatically sign-in the last interactive user after Windows Update restarts the system."
          reference            : "NIST 800-53r5|AC-11"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\policies\system' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['DisableAutomaticRestartSignOn'] -ne $null) { [int]$p.'DisableAutomaticRestartSignOn' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0117 - MSSRV - Ensure Allow Basic authentication is set to Disabled"
          info                 : "This policy setting allows you to manage whether the Windows Remote Management (WinRM) client uses Basic authentication."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\WinRM\Client' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AllowBasic'] -ne $null) { [int]$p.'AllowBasic' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0118 - MSSRV - Ensure Allow unencrypted traffic is set to Disabled"
          info                 : "This policy setting allows you to manage whether the Windows Remote Management (WinRM) client sends and receives unencrypted messages over the network."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\WinRM\Client' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AllowUnencryptedTraffic'] -ne $null) { [int]$p.'AllowUnencryptedTraffic' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0119 - MSSRV - Ensure Disallow Digest authentication is set to Enabled"
          info                 : "This policy setting allows you to manage whether the Windows Remote Management (WinRM) client will not use Digest authentication."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\WinRM\Client' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AllowDigest'] -ne $null) { [int]$p.'AllowDigest' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0120 - MSSRV - Ensure Allow Basic authentication is set to Disabled"
          info                 : "This policy setting allows you to manage whether the Windows Remote Management (WinRM) service accepts Basic authentication from a remote client."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\WinRM\Service' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AllowBasic'] -ne $null) { [int]$p.'AllowBasic' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0121 - MSSRV - Ensure Allow unencrypted traffic is set to Disabled"
          info                 : "This policy setting allows you to manage whether the Windows Remote Management (WinRM) service sends and receives unencrypted messages over the network."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
