        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0041 - MSSRV - Ensure Allow Diagnostic Data is set to Enabled: Diagnostic data off (not recommended) or Enabled: Send required diagnostic data"
          info                 : "This policy setting determines the amount of diagnostic and usage data reported to Microsoft: - A value of (0) Diagnostic data off (not recommended)."
          reference            : "NIST 800-53r5|CM-7b."
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0" || "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\DataCollection' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AllowTelemetry'] -ne $null) { [int]$p.'AllowTelemetry' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0042 - MSSRV - Ensure Do not show feedback notifications is set to Enabled"
          info                 : "This policy setting allows an organization to prevent its devices from showing feedback questions from Microsoft."
