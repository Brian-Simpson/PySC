          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\LanmanWorkstation' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AuditInsecureGuestLogon'] -ne $null) { [int]$p.'AuditInsecureGuestLogon' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0314 - MSSRV - Ensure Audit server does not support encryption is set to Enabled"
          info                 : "This policy setting determines whether the Server Message Block (SMB) client will log events when the SMB server doesn't support encryption."
          reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\LanmanWorkstation' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AuditServerDoesNotSupportEncryption'] -ne $null) { [int]$p.'AuditServerDoesNotSupportEncryption' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0315 - MSSRV - Ensure Audit server does not support signing is set to Enabled"
          info                 : "This policy setting determines whether the Server Message Block (SMB) client will log events when the SMB server doesn't support signing."
          reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\LanmanWorkstation' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AuditServerDoesNotSupportSigning'] -ne $null) { [int]$p.'AuditServerDoesNotSupportSigning' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0316 - MSSRV - Ensure Enable remote mailslots is set to Disabled"
          info                 : "This policy settings controls whether the SMB client will use remote mailslots over Multiple UNC Provider (MUP)."
          reference            : "NIST 800-53r5|CM-6 CM-7"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\NetworkProvider' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableMailslots'] -ne $null) { [int]$p.'EnableMailslots' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0317 - MSSRV - Ensure Mandate the minimum version of SMB is set to Enabled: 3.1.1"
          info                 : "This policy settings controls the minimum version of Server Message Block (SMB) protocol that can be used on the system."
          reference            : "NIST 800-53r5|CM-6 CM-7"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "785"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\LanmanWorkstation' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['MinSmb2Dialect'] -ne $null) { [int]$p.'MinSmb2Dialect' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0318 - MSSRV - Ensure Block NetBIOS-based discovery for domain controller location is set to Enabled"
          info                 : "This policy setting determines whether the Domain Controller (DC) location algorithm uses NetBIOS-based discovery for the Domain Controller's location."
          reference            : "NIST 800-53r5|CM-6 CM-7"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['BlockNetbiosDiscovery'] -ne $null) { [int]$p.'BlockNetbiosDiscovery' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0319 - MSSRV - Ensure Network security: LDAP client encryption requirements is set to Negotiate sealing or higher"
          info                 : "This policy setting determines the level of data encryption that is requested on behalf of clients that issue LDAP BIND requests."
          reference            : "NIST 800-53r5|IA-3(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1" || "2"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LDAP' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LDAPClientConfidentiality'] -ne $null) { [int]$p.'LDAPClientConfidentiality' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0320 - MSSRV - Ensure Relax minimum password length limits is set to Enabled"
          info                 : "This policy setting determines whether the minimum password length setting can be increased beyond the legacy limit of 14 characters."
          reference            : "NIST 800-53r5|IA-5(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\SAM' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RelaxMinimumPasswordLengthLimits'] -ne $null) { [int]$p.'RelaxMinimumPasswordLengthLimits' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0321 - MSSRV - Ensure Configure password backup directory is set to Enabled: Active Directory or Enabled: Azure Active Directory"
          info                 : "This policy setting configures which directory Windows LAPS will use to back up the local admin account password."
          reference            : "NIST 800-53r5|CP-9"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1" || "2"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['BackupDirectory'] -ne $null) { [int]$p.'BackupDirectory' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0322 - MSSRV - Ensure Do not allow password expiration time longer than required by policy is set to Enabled"
          info                 : "This policy setting configures whether the password age dictated by the Windows LAPS \'Password Settings\' policy is enforced and cannot be extended manually (only shortened) by an authorized technician."
          reference            : "NIST 800-53r5|IA-5(1)(d)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\LAPS' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['PasswordExpirationProtectionEnabled'] -ne $null) { [int]$p.'PasswordExpirationProtectionEnabled' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0323 - MSSRV - Ensure Enable password encryption is set to Enabled"
          info                 : "This policy setting controls whether the Windows LAPS managed password is encrypted before being sent to Active Directory."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ADPasswordEncryptionEnabled'] -ne $null) { [int]$p.'ADPasswordEncryptionEnabled' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0324 - MSSRV - Ensure Password Settings: Password Complexity is set to Enabled: Large letters + small letters + numbers + special characters or Passphrase"
          info                 : "This policy setting configures the Windows LAPS Password Settings policy for password complexity."
          reference            : "NIST 800-53r5|IA-5(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "4" || "6" || "7" || "8"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['PasswordComplexity'] -ne $null) { [int]$p.'PasswordComplexity' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0325 - MSSRV - Ensure Password Settings: Password Length is set to Enabled: 15 or more"
          info                 : "This policy setting configures the Windows LAPS Password Settings policy for password length."
          reference            : "NIST 800-53r5|IA-5(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "[15..MAX]"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['PasswordLength'] -ne $null) { [int]$p.'PasswordLength' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0326 - MSSRV - Ensure Password Settings: Password Age (Days) is set to Enabled: 30 or fewer"
          info                 : "This policy setting configures the Windows LAPS Password Settings policy for password age."
          reference            : "NIST 800-53r5|IA-5(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "[MIN..30]"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['PasswordAgeDays'] -ne $null) { [int]$p.'PasswordAgeDays' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0327 - MSSRV - Ensure Post-authentication actions: Grace period (hours) is set to Enabled: 8 or fewer hours, but not 0"
          info                 : "This policy settings configures post-authentication actions which will be executed after detecting an authentication by the Windows LAPS managed account."
          reference            : "NIST 800-53r5|IA-5(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "[1..8]"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['PostAuthenticationResetDelay'] -ne $null) { [int]$p.'PostAuthenticationResetDelay' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0328 - MSSRV - Ensure Post-authentication actions: Actions is set to Enabled: Reset the password and logoff the managed account or higher"
          info                 : "This policy settings configures post-authentication actions which will be executed after detecting an authentication by the LAPS managed account."
          reference            : "NIST 800-53r5|IA-5(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "3" || "5" || "11"
          powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\LAPS' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['PostAuthenticationActions'] -ne $null) { [int]$p.'PostAuthenticationActions' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
        </custom_item>

#########################################################################################################################################
############################################################# MEMBER SERVER #############################################################
#########################################################################################################################################

        <if>
          <condition type:"AND">

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "Check if system is Member or Standalone Server"
              value_type           : POLICY_TEXT
              value_data           : 2 || 3
              powershell_args      : "$obj = Get-CimInstance Win32_ComputerSystem -ErrorAction SilentlyContinue; if ($obj) { [string]$obj.DomainRole } else { 'NOT_FOUND' }"
            </custom_item>

          </condition>

          <then>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0329 - MSSRV - Ensure Allow Administrator account lockout is set to Enabled (MS only)"
              info                 : "This policy setting determines whether the built-in Administrator account is subject to the following Account Lockout Policy settings: Account lockout duration, Account lockout threshold, and Reset account lockout counter."
              reference            : "NIST 800-53r5|AC-7 AC-19"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Enabled"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^AllowAdministratorLockout\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -eq '1') { 'Enabled' } elseif ($val -eq '0') { 'Disabled' } else { 'NOT_FOUND' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0330 - MSSRV - Ensure Apply UAC restrictions to local accounts on network logons is set to Enabled (MS only)"
              info                 : "This setting controls whether local accounts can be used for remote administration via network logon (e."
              reference            : "NIST 800-53r5|AC-2(9)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "0"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LocalAccountTokenFilterPolicy'] -ne $null) { [int]$p.'LocalAccountTokenFilterPolicy' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0331 - MSSRV - Ensure Enumerate local users on domain-joined computers is set to Disabled (MS only)"
              info                 : "This policy setting allows local users to be enumerated on domain-joined computers."
              reference            : "NIST 800-53r5|AC-6(10)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "0"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnumerateLocalUsers'] -ne $null) { [int]$p.'EnumerateLocalUsers' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0332 - MSSRV - Ensure Enable RPC Endpoint Mapper Client Authentication is set to Enabled (MS only)"
              info                 : "This policy setting controls whether RPC clients authenticate with the Endpoint Mapper Service when the call they are making contains authentication information."
              reference            : "NIST 800-53r5|CM-7b."
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "1"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\Rpc' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['EnableAuthEpResolution'] -ne $null) { [int]$p.'EnableAuthEpResolution' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0333 - MSSRV - Ensure Enable Windows NTP Server is set to Disabled (MS only)"
              info                 : "This policy setting specifies whether the Windows NTP Server is enabled."
              reference            : "NIST 800-53r5|AU-7 AU-8"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "0"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\W32Time\TimeProviders\NtpServer' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['Enabled'] -ne $null) { [int]$p.'Enabled' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0334 - MSSRV - Ensure Allow log on through Remote Desktop Services is set to Administrators, Remote Desktop Users (MS only)"
              info                 : "This policy setting determines which users or groups have the right to log on as a Remote Desktop Services client."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Administrators,Remote Desktop Users"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeRemoteInteractiveLogonRight\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0335 - MSSRV - Ensure Create symbolic links is set to Administrators, NT VIRTUAL MACHINE\Virtual Machines (MS only)"
              info                 : "This policy setting determines which users can create symbolic links."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : ("Administrators" || ("Administrators" && "Virtual Machines") || ("Administrators" && "NT VIRTUAL MACHINE\Virtual Machines"))
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeCreateSymbolicLinkPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0336 - MSSRV - Ensure Deny access to this computer from the network to include Guests, Local account and member of Administrators group (MS only)"
              info                 : "This policy setting prohibits users from connecting to a computer from across the network, which would allow users to access and potentially modify data remotely."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "STATUS: PASSED"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeDenyNetworkLogonRight\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; $expected = @('Guests', 'Local account and member of Administrators group'); $ok = $true; foreach ($e in $expected) { $found = $false; foreach ($m in $members) { if ($m -like $e) { $found = $true } }; if (-not $found) { $ok = $false } }; if ($ok) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0337 - MSSRV - Ensure Deny log on through Remote Desktop Services is set to Guests, Local account (MS only)"
              info                 : "This policy setting determines whether users can log on as Remote Desktop clients."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "STATUS: PASSED"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeDenyRemoteInteractiveLogonRight\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; $expected = @('Guests', 'Local account'); $ok = $true; foreach ($e in $expected) { $found = $false; foreach ($m in $members) { if ($m -like $e) { $found = $true } }; if (-not $found) { $ok = $false } }; if ($ok) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0338 - MSSRV - Ensure Enable computer and user accounts to be trusted for delegation is set to No One (MS only)"
              info                 : "This policy setting allows users to change the Trusted for Delegation setting on a computer object in Active Directory."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : ""
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeEnableDelegationPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0339 - MSSRV - Ensure Access this computer from the network  is set to Administrators, Authenticated Users (MS only)"
              info                 : "This policy setting allows other users on the network to connect to the computer and is required by various network protocols that include Server Message Block (SMB)-based protocols, NetBIOS, Common Internet File System (CIFS), and Component Object Model Plus (COM+)."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Administrators,Authenticated Users"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeNetworkLogonRight\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0340 - MSSRV - Ensure Impersonate a client after authentication is set to Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE (MS only)"
              info                 : "The policy setting allows programs that run on behalf of a user to impersonate that user (or another specified account) so that they can act on behalf of the user."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : ("Administrators" && "Local Service" && "Network Service" && "Service") || ("Administrators" && "IIS_IUSRS" && "Local Service" && "Network Service" && "Service")
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeImpersonatePrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0341 - MSSRV - Ensure Manage auditing and security log is set to Administrators (MS only)"
              info                 : "This policy setting determines which users can change the auditing options for files and directories and clear the Security log."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Administrators"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeSecurityPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0342 - MSSRV - Ensure Allow log on locally is set to Administrators (MS only)"
              info                 : "This policy setting determines which users can interactively log on to computers in your environment."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Administrators"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeInteractiveLogonRight\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0343 - MSSRV - Ensure Network access: Restrict clients allowed to make remote calls to SAM is set to Administrators: Remote Access: Allow (MS only)"
              info                 : "This policy setting allows you to restrict remote RPC connections to SAM."
              reference            : "NIST 800-53r5|AC-6(3)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "O:BAG:BAD:(A;;RC;;;BA)"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p) { [string]$p.'restrictremotesam' } else { $null }; if ($val -ne $null) { $val } else { 'NOT_FOUND' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0344 - MSSRV - Ensure Network access: Do not allow anonymous enumeration of SAM accounts is set to Enabled (MS only)"
              info                 : "This policy setting controls the ability of anonymous users to enumerate the accounts in the Security Accounts Manager (SAM)."
              reference            : "NIST 800-53r5|AC-6(10)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "1"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RestrictAnonymousSAM'] -ne $null) { [int]$p.'RestrictAnonymousSAM' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0345 - MSSRV - Ensure Network access: Do not allow anonymous enumeration of SAM accounts and shares is set to Enabled (MS only)"
              info                 : "This policy setting controls the ability of anonymous users to enumerate SAM accounts as well as shares."
              reference            : "NIST 800-53r5|AC-6(10)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "1"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RestrictAnonymous'] -ne $null) { [int]$p.'RestrictAnonymous' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0346 - MSSRV - Ensure Network access: Named Pipes that can be accessed anonymously is configured (MS only)"
              info                 : "This policy setting determines which communication sessions, or pipes, will have attributes and permissions that allow anonymous access."
              reference            : "NIST 800-53r5|IA-2(2)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "" || "Browser"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanManServer\Parameters' -ErrorAction SilentlyContinue; $val = if ($p) { $p.'NullSessionPipes' } else { @() }; if ($val) { ($val -join ',') } else { '' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0347 - MSSRV - Ensure Accounts: Guest account status is set to Disabled (MS only)"
              info                 : "This policy setting determines whether the Guest account is enabled or disabled."
              reference            : "NIST 800-53r5|IA-5"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Disabled"
              powershell_args      : "$u = Get-LocalUser -Name 'Guest' -ErrorAction SilentlyContinue; if ($u -ne $null) { if ($u.Enabled) { 'Enabled' } else { 'Disabled' } } else { 'NOT_FOUND' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0348 - MSSRV - Ensure Interactive logon: Require Domain Controller Authentication to unlock workstation is set to Enabled (MS only)"
              info                 : "Logon information is required to unlock a locked computer."
              reference            : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "1"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Winlogon' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['ForceUnlockLogon'] -ne $null) { [int]$p.'ForceUnlockLogon' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0349 - MSSRV - Ensure Microsoft network server: Server SPN target name validation level is set to Accept if provided by client or higher (MS only)"
              info                 : "This policy setting controls the level of validation a computer with shared folders or printers (the server) performs on the service principal name (SPN) that is provided by the client computer when it establishes a session using the server message block (SMB) protocol."
              reference            : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "1" || "2"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanManServer\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SMBServerNameHardeningLevel'] -ne $null) { [int]$p.'SMBServerNameHardeningLevel' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0350 - MSSRV - Ensure Configure SAM change password RPC methods policy is set to Enabled: Block all change password RPC methods (MS only)"
              info                 : "This policy setting determines which RPC methods can be used to change passwords stored in the Security Account Manager (SAM)."
              reference            : "NIST 800-53r5|IA-5(1)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "1"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System\SAM' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SamrChangeUserPasswordApiPolicy'] -ne $null) { [int]$p.'SamrChangeUserPasswordApiPolicy' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>

          </then>
        </if>

#########################################################################################################################################
########################################################### DOMAIN CONTROLLER ###########################################################
#########################################################################################################################################


        <if>
          <condition type:"AND">

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "Check if system is Domain Controller"
              value_type           : POLICY_TEXT
              value_data           : 4 || 5
              powershell_args      : "$obj = Get-CimInstance Win32_ComputerSystem -ErrorAction SilentlyContinue; if ($obj) { [string]$obj.DomainRole } else { 'NOT_FOUND' }"
            </custom_item>

          </condition>

          <then>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0351 - MSSRV - Ensure Audit Kerberos Authentication Service is set to Success and Failure (DC Only)"
              info                 : "This subcategory reports the results of events generated after a Kerberos authentication TGT request."
              reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Success and Failure"
              powershell_args      : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Kerberos Authentication Service' 2>&1; $line = $r | Where-Object { $_ -like '*Kerberos Authentication Service*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; $val"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0352 - MSSRV - Ensure Audit Kerberos Service Ticket Operations is set to Success and Failure (DC Only)"
              info                 : "This subcategory reports the results of events generated by Kerberos authentication ticket-granting ticket (TGT) requests."
              reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Success and Failure"
              powershell_args      : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Kerberos Service Ticket Operations' 2>&1; $line = $r | Where-Object { $_ -like '*Kerberos Service Ticket Operations*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; $val"
            </custom_item>
            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0353 - MSSRV - Ensure Audit Computer Account Management is set to include Success (DC only)"
              info                 : "This subcategory reports each event of computer account management, such as when a computer account is created, changed, deleted, renamed, disabled, or enabled."
              reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Success and Failure || Success"
              powershell_args      : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Computer Account Management' 2>&1; $line = $r | Where-Object { $_ -like '*Computer Account Management*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; $val"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0354 - MSSRV - Ensure Audit Distribution Group Management is set to include Success (DC only)"
              info                 : "This subcategory reports each event of distribution group management, such as when a distribution group is created, changed, or deleted or when a member is added to or removed from a distribution group."
              reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Success and Failure || Success"
              powershell_args      : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Distribution Group Management' 2>&1; $line = $r | Where-Object { $_ -like '*Distribution Group Management*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; $val"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0355 - MSSRV - Ensure Audit Other Account Management Events is set to include Success (DC only)"
              info                 : "This subcategory reports other account management events."
              reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Success || Success and Failure"
              powershell_args      : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Other Account Management Events' 2>&1; $line = $r | Where-Object { $_ -like '*Other Account Management Events*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; $val"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0356 - MSSRV - Ensure Audit Directory Service Access is set to include Failure (DC only)"
              info                 : "This subcategory reports when an AD DS object is accessed."
              reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Failure || Success and Failure"
              powershell_args      : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Directory Service Access' 2>&1; $line = $r | Where-Object { $_ -like '*Directory Service Access*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; $val"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0357 - MSSRV - Ensure Audit Directory Service Changes is set to include Success (DC only)"
              info                 : "This subcategory reports changes to objects in Active Directory Domain Services (AD DS)."
              reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Success || Success and Failure"
              powershell_args      : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Directory Service Changes' 2>&1; $line = $r | Where-Object { $_ -like '*Directory Service Changes*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; $val"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0358 - MSSRV - Ensure Allow Custom SSPs and APs to be loaded into LSASS is set to Disabled (DC only)"
              info                 : "This policy setting controls the configuration under which the Local Security Authority Subsystem Service (LSASS) will load custom Security Support Provider/Authentication Package (SSP/AP)."
              reference            : "NIST 800-53r5|SI-16"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "0"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\System' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AllowCustomSSPsAPs'] -ne $null) { [int]$p.'AllowCustomSSPsAPs' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0359 - MSSRV - Ensure Configure validation of ROCA-vulnerable WHfB keys during authentication is set to Enabled: Block (DC only)"
              info                 : "This policy setting allows you to configure how Domain Controllers handle Windows Hello for Business (WHfB) keys that are vulnerable to the \'Return of Coppersmith\'s attack\' (ROCA) vulnerability."
              reference            : "NIST 800-53r5|SC-39 SI-16"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "2"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System\SAM' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SamNGCKeyROCAValidation'] -ne $null) { [int]$p.'SamNGCKeyROCAValidation' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0360 - MSSRV - Ensure Create symbolic links is set to Administrators (DC only)"
              info                 : "This policy setting determines which users can create symbolic links."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Administrators"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeCreateSymbolicLinkPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0361 - MSSRV - Ensure Access this computer from the network is set to Administrators, Authenticated Users, ENTERPRISE DOMAIN CONTROLLERS (DC only)"
              info                 : "This policy setting allows other users on the network to connect to the computer and is required by various network protocols that include Server Message Block (SMB)-based protocols, NetBIOS, Common Internet File System (CIFS), and Component Object Model Plus (COM+)."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Administrators,Authenticated Users,Enterprise Domain Controllers"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeNetworkLogonRight\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0362 - MSSRV - Ensure Deny access to this computer from the network to include Guests (DC only)"
              info                 : "This policy setting prohibits users from connecting to a computer from across the network, which would allow users to access and potentially modify data remotely."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "STATUS: PASSED"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeDenyNetworkLogonRight\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; $expected = @('Guests'); $ok = $true; foreach ($e in $expected) { $found = $false; foreach ($m in $members) { if ($m -like $e) { $found = $true } }; if (-not $found) { $ok = $false } }; if ($ok) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0363 - MSSRV - Ensure Deny log on through Remote Desktop Services to include Guests (DC only)"
              info                 : "This policy setting determines whether users can log on as Remote Desktop clients."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "STATUS: PASSED"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeDenyRemoteInteractiveLogonRight\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; $expected = @('Guests'); $ok = $true; foreach ($e in $expected) { $found = $false; foreach ($m in $members) { if ($m -like $e) { $found = $true } }; if (-not $found) { $ok = $false } }; if ($ok) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0364 - MSSRV - Ensure Enable computer and user accounts to be trusted for delegation is set to Administrators (DC only)"
              info                 : "This policy setting allows users to change the Trusted for Delegation setting on a computer object in Active Directory."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Administrators"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeEnableDelegationPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0365 - MSSRV - Ensure Impersonate a client after authentication is set to Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE (DC only)"
              info                 : "The policy setting allows programs that run on behalf of a user to impersonate that user (or another specified account) so that they can act on behalf of the user."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Administrators,LOCAL SERVICE,NETWORK SERVICE,SERVICE"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeImpersonatePrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0366 - MSSRV - Ensure Manage auditing and security log is set to Administrators (DC only)"
              info                 : "This policy setting determines which users can change the auditing options for files and directories and clear the Security log."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Administrators" || ("Administrators" && "Exchange Servers")
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeSecurityPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0367 - MSSRV - Ensure Synchronize directory service data is set to No One (DC only)"
              info                 : "This security setting determines which users and groups have the authority to synchronize all directory service data."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : ""
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeSyncAgentPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0368 - MSSRV - Ensure Add workstations to domain is set to Administrators (DC only)"
              info                 : "This policy setting specifies which users can add computer workstations to the domain."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Administrators"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeMachineAccountPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0369 - MSSRV - Ensure Allow log on locally is set to Administrators, ENTERPRISE DOMAIN CONTROLLERS (DC only)"
              info                 : "This policy setting determines which users can interactively log on to computers in your environment."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Administrators,ENTERPRISE DOMAIN CONTROLLERS"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeInteractiveLogonRight\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0370 - MSSRV - Ensure Allow log on through Remote Desktop Services is set to Administrators (DC only)"
              info                 : "This policy setting determines which users or groups have the right to log on as a Remote Desktop Services client."
              reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "Administrators"
              powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeRemoteInteractiveLogonRight\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0371 - MSSRV - Ensure Network access: Named Pipes that can be accessed anonymously is configured (DC only)"
              info                 : "This policy setting determines which communication sessions, or pipes, will have attributes and permissions that allow anonymous access."
              reference            : "NIST 800-53r5|IA-2(2)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "("SAMR"),("LSARPC",Browser") || ("LSARPC,NETLOGON,NETLOGON,SAMR")"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\LanManServer\Parameters' -ErrorAction SilentlyContinue; $val = if ($p) { $p.'NullSessionPipes' } else { @() }; if ($val) { ($val -join ',') } else { '' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0372 - MSSRV - Ensure Network security: Restrict NTLM: Audit NTLM authentication in this domain is set to Enable all (DC only)"
              info                 : "This policy setting allows auditing of NTLM authentication within the domain from the Domain Controller."
              reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "7"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters\' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['AuditNTLMInDomain'] -ne $null) { [int]$p.'AuditNTLMInDomain' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0373 - MSSRV - Ensure Domain controller: Allow server operators to schedule tasks is set to Disabled (DC only)"
              info                 : "This policy setting determines whether members of the Server Operators group are allowed to submit jobs by means of the AT schedule facility."
              reference            : "NIST 800-53r5|AC-6(8)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : 0
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SubmitControl'] -ne $null) { [int]$p.'SubmitControl' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0374 - MSSRV - Ensure Domain controller: Allow vulnerable Netlogon secure channel connections is set to Not Configured (DC Only)"
              info                 : "This security setting determines whether the domain controller bypasses secure RPC for Netlogon secure channel connections for specified machine accounts."
              reference            : "NIST 800-53r5|CM-6b."
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "NOT_EXISTS"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; if ($p -ne $null -and $p.PSObject.Properties['VulnerableChannelAllowList'] -ne $null) { 'EXISTS' } else { 'NOT_EXISTS' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0375 - MSSRV - Ensure Domain controller: LDAP server channel binding token requirements is set to Always (DC Only)"
              info                 : "This policy setting determines whether the LDAP server (Domain Controller) enforces validation of Channel Binding Tokens (CBT) received in LDAP bind requests that are sent over SSL/TLS (i."
              reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "2"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\NTDS\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LdapEnforceChannelBinding'] -ne $null) { [int]$p.'LdapEnforceChannelBinding' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0376 - MSSRV - Ensure Domain controller: LDAP server signing requirements is set to Require signing (DC only)"
              info                 : "This policy setting determines whether the Lightweight Directory Access Protocol (LDAP) server requires LDAP clients to negotiate data signing."
              reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : 2
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\NTDS\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LDAPServerIntegrity'] -ne $null) { [int]$p.'LDAPServerIntegrity' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>

            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0377 - MSSRV - Ensure Domain controller: Refuse machine account password changes is set to Disabled (DC only)"
              info                 : "This security setting determines whether Domain Controllers will refuse requests from member computers to change computer account passwords."
              reference            : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : 0
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['RefusePasswordChange'] -ne $null) { [int]$p.'RefusePasswordChange' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0378 - MSSRV - Ensure Print Spooler (Spooler) is set to Disabled (DC only)"
              info                 : "This service spools print jobs and handles interaction with printers."
              reference            : "NIST 800-53r5|CM-6 CM-7"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : 4
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Spooler' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['Start'] -ne $null) { [int]$p.'Start' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0379 - MSSRV - Ensure Configure SAM change password RPC methods policy is set to Enabled: Allow strong encryption change password RPC method only (DC only)"
              info                 : "This policy setting determines which RPC methods can be used to change passwords stored in the Security Account Manager (SAM)."
              reference            : "NIST 800-53r5|IA-5(1)(c)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "2"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System\SAM' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['SamrChangeUserPasswordApiPolicy'] -ne $null) { [int]$p.'SamrChangeUserPasswordApiPolicy' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>


            <custom_item>
              type                 : AUDIT_POWERSHELL
              description          : "1.0380 - MSSRV - Ensure Domain controller: LDAP server signing requirements Enforcement is set to Enabled (DC only)"
              info                 : "This policy setting determines whether the Lightweight Directory Access Protocol (LDAP) server requires LDAP clients to negotiate data signing."
              reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
              see_also             : "See HTH Policies and Standards"
              value_type           : POLICY_TEXT
              value_data           : "1"
              powershell_args      : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\NTDS\Parameters' -ErrorAction SilentlyContinue; $val = if ($p -and $p.PSObject.Properties['LDAPServerEnforceIntegrity'] -ne $null) { [int]$p.'LDAPServerEnforceIntegrity' } else { $null }; if ($val -ne $null) { [string]$val } else { 'NOT_FOUND' }"
            </custom_item>

          </then>
        </if>


        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "System/Domain Identification"
          info                 : "This obtains specific user and system information that may be used for additional evaluation."
          reference            : "NIST 800-53r5|"
          see_also             : "HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : ".*"
          powershell_args      : "(Get-ComputerInfo) |Select-Object OSDisplayVersion, CsManufacturer, CsModel, BiosBIOSVersion, BiosSeralNumber, CsUserName, OsName, OsBuildNumber, OsProductType, CsDNSHostName, CsDomain;"
          check_type           : CHECK_REGEX
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "Network Information"
          info                 : "This obtains relevent hosted view network information that may be used for additional evaluation."
          reference            : "NIST 800-53r5|"
          see_also             : "HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : ".*"
          powershell_args      : "Get-NetIPConfiguration -Detailed ;(Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.2\Server');"
          check_type           : CHECK_REGEX
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0381 - MSSRV - Ensure Do not suggest third-party content in Windows spotlight is set to Enabled"
          info                 : "This policy setting determines whether Windows will suggest apps and content from third-party software publishers."
          reference            : "NIST 800-53r5|CM-7b"
          see_also             : "See corresponding HTH Policy or Standard"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$noutput = (Get-ItemProperty 'HKCU:\Software\Policies\Microsoft\Windows\CloudContent').DisableThirdPartySuggestions; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
          check_type           : CHECK_EQUAL
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0382 - MSSRV - When Preview Builds and Feature Updates are received is set to Enabled: 180 or more days"
          info                 : "This policy setting determines when Preview Build or Feature Updates are received."
          reference            : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "[180..MAX]"
          powershell_args      : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\WindowsUpdate'){write-host 'Path Exists'} else {write-host 'PATH Not Found'};$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\WindowsUpdate').DeferFeatureUpdatesPeriodInDays;if($noutput -eq $Null) {write-host 'KEY Not Found'} else {$noutput}"
          check_type           : CHECK_REGEX
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0383 - MSSRV - Account - Guest Account Disabled"
          info                 : "The built-in local guest account should be disabled."
          reference            : "NIST 800-53r5|IA-5"
          see_also             : "HTH"
          value_type           : POLICY_TEXT
          value_data           : "False"
          powershell_args      : "$noutput = Get-LocalUser | Where-Object { $_.SID -Match '^S-1-5-21.*-501$' } | Select Name, Enabled; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
          check_type           : CHECK_REGEX
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0384 - MSSRV - Ensure Do not preserve zone information in file attachments is set to Disabled"
          info                 : "This policy setting allows you to manage whether Windows marks file attachments with information about their zone of origin (such as restricted, Internet, intranet, local)."
          reference            : "NIST 800-53r5|CM-6b"
          see_also             : "See corresponding HTH Policy or Standard"
          value_type           : POLICY_TEXT
          value_data           : "2"
          powershell_args      : "$noutput = (Get-ItemProperty 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Policies\Attachments').SaveZoneInformation; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
          check_type           : CHECK_EQUAL
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0385 - MSSRV - Ensure Notify antivirus programs when opening attachments is set to Enabled'"
          info                 : "This policy setting manages the behavior for notifying registered antivirus programs."
          reference            : "NIST 800-53r5|SI-3"
          see_also             : "See corresponding HTH Policy or Standard"
          value_type           : POLICY_TEXT
          value_data           : "3"
          powershell_args      : "$noutput = (Get-ItemProperty 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Policies\Attachments').ScanWithAntiVirus; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
          check_type           : CHECK_EQUAL
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0386 - MSSRV - Ensure Configure Windows spotlight on lock screen is set to Disabled"
          info                 : "This policy setting lets you configure Windows Spotlight on the lock screen."
          reference            : "NIST 800-53r5|AC-11"
          see_also             : "See corresponding HTH Policy or Standard"
          value_type           : POLICY_TEXT
          value_data           : "2"
          powershell_args      : "$noutput = (Get-ItemProperty 'HKCU:\Software\Policies\Microsoft\Windows\CloudContent').ConfigureWindowsSpotlight; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
          check_type           : CHECK_EQUAL
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0387 - MSSRV - Shutdown: Allow system to be shut down without having to log on is set to Disabled"
          info                 : "This policy setting determines whether a computer can be shut down when a user is not logged on."
          reference            : "NIST 800-53r5|AC-6(10)"
          see_also             : "See corresponding HTH Policy or Standard"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "$noutput = (Get-ItemProperty 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').ShutdownWithoutLogon; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
          check_type           : CHECK_EQUAL
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0388 - MSSRV - Ensure Turn off Spotlight collection on Desktop is set to Enabled"
          info                 : "This policy setting removes the Spotlight collection setting in Personalization, rendering the user unable to select and subsequently download daily images from Microsoft to the system desktop."
          reference            : "NIST 800-53r5|CM-6,800-53r5|CM-7"
          see_also             : "See corresponding HTH Policy or Standard"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "$noutput = (Get-ItemProperty 'HKCU:\Software\Policies\Microsoft\Windows\CloudContent').DisableSpotlightCollectionOnDesktop; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
          check_type           : CHECK_EQUAL
        </custom_item>

        <custom_item>
          type                 : USER_RIGHTS_POLICY
          description          : "1.0389 - MSSRV - Change the time zone is configured correctly."
          info                 : "This setting determines which users can change the time zone of the computer. This ability holds no great danger for the computer and may be useful for mobile workers."
          reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
          see_also             : "See HTH Policies and Standards"
          value_type           : USER_RIGHT
          value_data           : "Administrators" && "LOCAL SERVICE"
          right_type           : SeTimeZonePrivilege
        </custom_item>

        <custom_item>
          type                 : ANONYMOUS_SID_SETTING
          description          : "1.0390 - MSSRV - Network access: Allow anonymous SID/Name translation is set to Disabled"
          info                 : "This policy setting determines whether an anonymous user can request security identifier (SID) attributes for another user, or use a SID to obtain its corresponding user name."
          reference            : "NIST 800-53r5|AC-6(10) IA-2(2)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_SET
          value_data           : "Disabled"
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0391 - MSSRV - Network access - WINS Server Feature installed"
          info                 : "This policy setting determines if WINSService is installed."
          reference            : "NIST 800-53r5|AC-6(7)(b)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "Running"
          powershell_args      : "$noutput = (Get-Service -Name 'wins').Status; if($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
          only_show_cmd_output : YES
          check_type           : CHECK_REGEX
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0392 - MSSRV - Domain member: Require strong (Windows 2000 or later) session key is set to Enabled"
          info                 : "When this policy setting is enabled, a secure channel can only be established with Domain Controllers that are capable of encrypting secure channel data with a strong (128-bit) session key."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameter').RequireStrongKey; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
          check_type           : CHECK_REGEX
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0393 - MSSRV - Interactive logon: Do not require CTRL+ALT+DEL is set to Disabled"
          info                 : "This policy setting determines whether users must press CTRL+ALT+DEL before they log on."
          reference            : "NIST 800-53r5|AC-7 AC-19"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "0"
          powershell_args      : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').DisableCAD; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
          check_type           : CHECK_REGEX
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0394 - MSSRV - Microsoft network client: Digitally sign communications (if server agrees) is set to Enabled"
          info                 : "This policy setting determines whether the SMB client will attempt to negotiate SMB packet signing."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\LanmanWorkstation\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\LanmanWorkstation\Parameters').EnableSecuritySignature; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
          check_type           : CHECK_REGEX
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0395 - MSSRV - Microsoft network server: Digitally sign communications (if client agrees) is set to Enabled"
          info                 : "This policy setting determines whether the SMB server will negotiate SMB packet signing with clients that request it. If no signing request comes from the client, a connection will be allowed without a signature if the Microsoft network server: Digitally sign communications (always) setting is not enabled."
          reference            : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
          see_also             : "See HTH Policies and Standards"
          value_type           : POLICY_TEXT
          value_data           : "1"
          powershell_args      : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters').EnableSecuritySignature; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
          check_type           : CHECK_REGEX
        </custom_item>

        <custom_item>
          type                 : AUDIT_POWERSHELL
          description          : "1.0396 - MSSRV - Windows Firewall: Public: Logging: Size limit (KB) is set to 16,384 KB or greater"
