          value_type           : POLICY_TEXT
          value_data           : "Administrators"
          powershell_args      : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeDebugPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } | Sort-Object } else { @() }; Remove-Item $tmp -Force; if ($members.Count -gt 0) { ($members -join ',') } else { '' }"
        </custom_item>
        <custom_item>
