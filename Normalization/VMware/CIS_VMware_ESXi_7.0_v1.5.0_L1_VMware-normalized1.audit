  info        : "This recommendation is intended to address configuring a standard switch."
  reference   : "NIST 800-53r5|CA-9 SC-7 SC-7(5)"
  see_also    : "See HTH Policies and Standards"
  show_output : YES
</report>
  </then>
</if>

<if>
