<check_type:"Cisco_ACI">

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.003 - ACI - System Alias and Banners - Controller CLI Banner"
                    info                : "The contents of the CLI informational banner to be displayed before user login authentication."
                    reference           : "NIST 800-53r5|AC-8a."
                    item                : "^[\s]*aaa[\s]+banner[\s]+['\"]Authorized Users Only['\"]"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.005 - ACI - Fabric Security - Policy - FIPS Mode"
                    info                : "Note: Anytime you change the mode, you must reboot to complete the configuration."
                    reference           : "NIST 800-53r5|SC-13"
                    item                : "^[\s]*fips[\s]+mode[\s]+enable[\s]*$"
                    severity            : MEDIUM
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.006 - ACI - Keychain Policy - Key Policy - Endtime"
                    info                : "The configured time that determines when the key entry is no longer valid."
                    reference           : "NIST 800-53r5|IA-5f."
                    context             : "^[\s]*key-policy[\s]+.+[\s]*$"
                    item                : "^[\s]*endtime[\s]+infinite[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.007 - ACI - First Hop Security - IP Inspection - Admin Status"
                    info                : "The IP Inspection administrative status."
                    reference           : "NIST 800-53r5|CM-6b."
                    context             : "^[\s]*security-policy[\s]+.+[\s]*$"
                    item                : "^[\s]*ip-inspection-admin-status[\s]+enabled-both[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.008 - ACI - First Hop Security - Source Guard - Admin Status"
                    info                : "The Source Guard administrative status."
                    reference           : "NIST 800-53r5|CM-6b."
                    context             : "^[\s]*security-policy[\s]+.+[\s]*$"
                    item                : "^[\s]*source-guard-admin-status[\s]+enabled-both[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.009 - ACI - First Hop Security - Router Advertisement Guard - Admin Status"
                    info                : "Router Advertisement Guard administrative status."
                    reference           : "NIST 800-53r5|CM-6b."
                    context             : "^[\s]*security-policy[\s]+.+[\s]*$"
                    item                : "^[\s]*router-advertisement-guard-admin-status[\s]+enabled[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.011 - ACI - Policies - Pod - Date and Time Policy - Host"
                    info                : "The user-configured NTP provider name."
                    reference           : "NIST 800-53r5|SC-45(1)"
                    context             : "^[\s]*template[\s]+ntp-fabric[\s]+.+"
                    item                : "^[\s]*server[\s]+127.0.0.1[\s]+"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.012 - ACI - Management Access Policy - HTTP - Admin State"
                    info                : "The state of the HTTP communication service."
                    reference           : "NIST 800-53r5|CM-7b."
                    context             : "^[\s]*http[\s]*$"
                    item                : "^[\s]*no[\s]+admin-state-enable[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.013 - ACI - Management Access Policy - HTTPS - Allow Credentials"
                    info                : "Set the Access-Control-Allow-Credentials header in the web server responses."
                    reference           : "NIST 800-53r5|CM-7b."
                    context             : "^[\s]*https[\s]*$"
                    item                : "^[\s]*no[\s]+allow-credential[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.014 - ACI - Management Access Policy - HTTPS - SSL Protocols - TLSv1"
                    info                : "The Secure Socket Layer (SSL) protocol."
                    reference           : "NIST 800-53r5|SC-13"
                    context             : "^[\s]*https[\s]*$"
                    regex               : "TLSv1(,|[\s]|$)"
                    item                : "^[\s]*ssl-protocols[\s]+"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.015 - ACI - Management Access Policy - HTTPS - SSL Protocols - TLSv1.1"
                    info                : "The Secure Socket Layer (SSL) protocol."
                    reference           : "NIST 800-53r5|SC-13"
                    context             : "^[\s]*https[\s]*$"
                    regex               : "TLSv1.1(,|[\s]|$)"
                    item                : "^[\s]*ssl-protocols[\s]+"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.017 - ACI - Management Access Policy - Telnet - Admin State"
                    info                : "The state of Telnet communication service."
                    reference           : "NIST 800-53r5|CM-7b."
                    context             : "^[\s]*telnet[\s]*$"
                    item                : "^[\s]*no[\s]+admin-state-enable[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.018 - ACI - Management Access Policy - SSH - MACs - hmac-sha1"
                    info                : "The state of the 'hmac-sha1' MAC (Message Authentication Code) algorithm(s) used for data integrity verification."
                    reference           : "NIST 800-53r5|SC-13"
                    context             : "^[\s]*ssh-service[\s]*$"
                    regex               : "hmac-sha1(,|[\s]|$)"
                    item                : "^[\s]*ssh-macs[\s]+"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.019 - ACI - Management Access Policy - SSH Access Via Web - Admin State"
                    info                : "The state of SSH via the Web communication service."
                    reference           : "NIST 800-53r5|CM-7b."
                    context             : "^[\s]*shellinabox[\s]*$"
                    item                : "^[\s]*no[\s]+admin-state-enable[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.020 - ACI - DNS Profile - Address - DNS Server 1"
                    info                : "The address of the DNS provider."
                    reference           : "NIST 800-53r5|SC-20"
                    context             : "^[\s]*dns[\s]*$"
                    item                : "^[\s]*address[\s]+127.0.0.1([\s]|$)"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.021 - ACI - DNS Profile - Address - DNS Server 2"
                    info                : "The address of the DNS provider."
                    reference           : "NIST 800-53r5|SC-20"
                    context             : "^[\s]*dns[\s]*$"
                    item                : "^[\s]*address[\s]+127.0.0.1([\s]|$)"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.022 - ACI - Remote user login policy"
                    info                : "The default role policy for the remote user with invalid (or no) CiscoAVPairs returned by the AAA server."
                    reference           : "NIST 800-53r5|AC-3"
                    item                : "^[\s]*aaa[\s]+user[\s]+default-role[\s]+assign-default-role[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.023 - ACI - Default Authentication Realm"
                    info                : "The default security method for processing authentication requests."
                    reference           : "NIST 800-53r5|AC-6(3)"
                    context             : "^[\s]*aaa[\s]+authentication[\s]+login[\s]+default[\s]*$"
                    item                : "^[\s]*realm[\s]+local[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.024 - ACI - Console Authentication Realm"
                    info                : "The default security method for processing authentication requests."
                    reference           : "NIST 800-53r5|AC-6(3)"
                    context             : "^[\s]*aaa[\s]+authentication[\s]+login[\s]+console[\s]*$"
                    item                : "^[\s]*realm[\s]+local[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.025 - ACI - Password Strength Check - Enabled"
                    info                : "Cisco recommends using a strong password; otherwise, the password strength check for locally authenticated users, the system rejects any password that does not meet the following requirements: - Must contain a minimum of eight characters and a maximum of 80 characters."
                    reference           : "NIST 800-53r5|IA-5(1)(a)"
                    item                : "^[\s]*password[\s]+pwd-strength-check[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.027 - ACI - LDAP - Enable SSL"
                    info                : "Enables an SSL connection with the LDAP provider."
                    reference           : "NIST 800-53r5|SC-8(1)"
                    context             : "^[\s]*ldap-server[\s]+host[\s]+.*"
                    item                : "^[\s]*enable-ssl[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.026 - ACI - Check if LDAP server is defined"
                    context             : "^[\s]*ldap-server[\s]+host[\s]+.*"
                    item                : ".+"
                    info                : "Enables an SSL connection with the LDAP provider."
                    reference           : "NIST 800-53r5|SC-8(1)"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.029 - ACI - Password Strength Check - Password Minimum Length"
                    info                : "Cisco recommends using a strong password; otherwise, the password strength check for locally authenticated users, the system rejects any password that does not meet the following requirements: - Must contain a minimum of eight characters and a maximum of 80 characters."
                    reference           : "NIST 800-53r5|IA-5(1)(a)"
                    item                : "^[\s]*password[\s]+pwd-rules.*minimum-length[\s]+12([\s]|$)"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.030 - ACI - Password Strength Check - Password Strength Test Type"
                    info                : "Cisco recommends using a strong password; otherwise, the password strength check for locally authenticated users, the system rejects any password that does not meet the following requirements: - Must contain a minimum of eight characters and a maximum of 80 characters."
                    reference           : "NIST 800-53r5|IA-5(1)(a)"
                    item                : "^[\s]*password[\s]+pwd-rules.*custom-password-class[\s]+(U|L|D|Sp){4,4}"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.031 - ACI - Enforce Password Change Interval"
                    info                : "Restricts the number of password changes a locally authenticated user can make within a given number of hours."
                    reference           : "NIST 800-53r5|IA-5(1)(d)"
                    item                : "^[\s]*password[\s]+change-during-interval[\s]+enable[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.032 - ACI - Password Change Interval (hours)"
                    info                : "The maximum number of hours over which the number of password changes specified in the Change Interval field are enforced."
                    reference           : "NIST 800-53r5|IA-5(1)(d)"
                    item                : "^[\s]*password[\s]+change-interval[\s]+48[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.033 - ACI - Number of changes allowed within the change interval (changes)"
                    info                : "The maximum number of times a locally authenticated user can change his or her password during the Change Interval."
                    reference           : "NIST 800-53r5|IA-5(1)(d)"
                    item                : "^[\s]*password[\s]+change-count[\s]+2[\s]*"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.034 - ACI - Minimum period between password changes (hours)"
                    info                : "The minimum number of hours over which the number of password changes specified in the Change Interval field are enforced."
                    reference           : "NIST 800-53r5|IA-5(1)(d)"
                    item                : "^[\s]*password[\s]+no-change-interval[\s]+24[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.035 - ACI - Number of recent user passwords to store"
                    info                : "The number of unique passwords that a locally authenticated user must create before that user can reuse a previously used password."
                    reference           : "NIST 800-53r5|IA-5(1)(e)"
                    item                : "^[\s]*password[\s]+history-count[\s]+5[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.036 - ACI - Web Token Timeout (s)"
                    info                : "APIC uses web session limits to restrict the number of web sessions that a given user account is permitted to access at any one time."
                    reference           : "NIST 800-53r5|AC-12"
                    context             : "^[\s]*crypto[\s]+webtoken[\s]*$"
                    item                : "^[\s]*webtoken-timeout-seconds[\s]+([3-5][0-9][0-9]|600)[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.037 - ACI - Maximum Validity Period (h)"
                    info                : "The maximum validity period of web sessions."
                    reference           : "NIST 800-53r5|AC-12"
                    context             : "^[\s]*crypto[\s]+webtoken[\s]*$"
                    item                : "^[\s]*max-validity-period[\s]+([1-9]|1[0-9]|2[0-4])[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.038 - ACI - Web Session Idle Timeout (s)"
                    info                : "The maximum amount of time that can elapse after the last refresh request before the APIC considers a web session as inactive."
                    reference           : "NIST 800-53r5|AC-12"
                    context             : "^[\s]*crypto[\s]+webtoken[\s]*$"
                    item                : "^[\s]*ui-idle-timeout-seconds[\s]+([6-9][0-9]|[1-9][0-9][0-9]|1[0-1][0-9][0-9]|1200)[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.039 - ACI - Include Refresh in Session Records"
                    info                : "When a web client connects to the APIC, the client must send refresh requests to keep the web session active."
                    reference           : "NIST 800-53r5|AU-12c."
                    context             : "^[\s]*crypto[\s]+webtoken[\s]*$"
                    item                : "^[\s]*session-record-flags[\s]+.*refresh"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.040 - ACI - Include Login in Session Records"
                    info                : "The session record flags are specified as a comma-separated value list of one or more of the following flags: login, logout, and refresh."
                    reference           : "NIST 800-53r5|AU-12c."
                    context             : "^[\s]*crypto[\s]+webtoken[\s]*$"
                    item                : "^[\s]*session-record-flags[\s]+.*login"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.041 - ACI - Include Logout in Session Records"
                    info                : "The session record flags are specified as a comma-separated value list of one or more of the following flags: login, logout, and refresh."
                    reference           : "NIST 800-53r5|AU-12c."
                    context             : "^[\s]*crypto[\s]+webtoken[\s]$"
                    item                : "^[\s]*session-record-flags[\s]+.*logout"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.043 - ACI - SNMP Destination - Host"
                    info                : "The host for the SNMP trap destination."
                    reference           : "NIST 800-53r5|AU-9(2)"
                    context             : "^[\s]*template[\s]+snmp-fabric[\s]+.+"
                    item                : "^[\s]*snmp-server[\s]+host[\s]+127.0.0.1[\s]+"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.042 - ACI - Check if SNMP Host configured"
                    context             : "^[\s]*template[\s]+snmp-fabric[\s]+"
                    item                : "^[\s]*snmp-server[\s]+host[\s]+"
                    info                : "The host for the SNMP trap destination."
                    reference           : "NIST 800-53r5|AU-9(2)"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.046 - ACI - SNMP Destination - Community Name"
                    info                : "The SNMP destination security name (community name)."
                    reference           : "NIST 800-53r5|IA-5e."
                    context             : "^[\s]*template[\s]+snmp-fabric[\s]+.+"
                    item                : "^[\s]*snmp-server[\s]+.*(public|private)[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.045 - ACI - Check if SNMP Host configured"
                    context             : "^[\s]*template[\s]+snmp-fabric[\s]+"
                    item                : "^[\s]*snmp-server[\s]+host[\s]+"
                    info                : "The SNMP destination security name (community name)."
                    reference           : "NIST 800-53r5|IA-5e."
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.049 - ACI - SNMP Destination - Version"
                    info                : "The CDP version supported by the device."
                    reference           : "NIST 800-53r5|CM-7b."
                    context             : "^[\s]*template[\s]+snmp-fabric[\s]+.+"
                    item                : "^[\s]*snmp-server[\s]+.*traps-version[\s]+(1|2)"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.048 - ACI - Check if SNMP Host configured"
                    context             : "^[\s]*template[\s]+snmp-fabric[\s]+"
                    item                : "^[\s]*snmp-server[\s]+host[\s]+"
                    info                : "The CDP version supported by the device."
                    reference           : "NIST 800-53r5|CM-7b."
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.052 - ACI - SNMP Destination - v3 Security level"
                    info                : "The SNMP V3 security level for the destination path."
                    reference           : "NIST 800-53r5|IA-5h."
                    context             : "^[\s]*template[\s]+snmp-fabric[\s]+.+"
                    item                : "^[\s]*snmp-server[\s]+.*+traps-version[\s]+3[\s]+[^\s]+[\s]+(auth|noauth)"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.051 - ACI - Check if SNMP Host configured"
                    context             : "^[\s]*template[\s]+snmp-fabric[\s]+"
                    item                : "^[\s]*snmp-server[\s]+host[\s]+"
                    info                : "The SNMP V3 security level for the destination path."
                    reference           : "NIST 800-53r5|IA-5h."
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.054 - ACI - Syslog - Admin State"
                    info                : "The state can be: - Enabled - Disabled."
                    reference           : "NIST 800-53r5|AU-12c."
                    context             : "^[\s]*logging[\s]+server-group[\s]+.+"
                    item                : "^[\s]*no[\s]+admin[\s]+enable[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.055 - ACI - Syslog - Show MilliSeconds in Timestamp"
                    info                : "This setting determines if forwarded syslog event timestamps should include millisecond granularity."
                    reference           : "NIST 800-53r5|AU-12c."
                    context             : "^[\s]*logging[\s]+server-group[\s]+.+"
                    item                : "^[\s]*no[\s]+millisecond[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.056 - ACI - Syslog - Local File Destination - Admin State"
                    info                : "The administrative state of the local file."
                    reference           : "NIST 800-53r5|AU-12c."
                    context             : "^[\s]*logging[\s]+server-group[\s]+.+"
                    item                : "^[\s]*no[\s]+logfile"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.057 - ACI - Syslog - Local File Destination - Severity"
                    info                : "The severity of the event, alert, or issue that caused the syslog entry to be generated."
                    reference           : "NIST 800-53r5|AU-12c."
                    context             : "^[\s]*logging[\s]+server-group[\s]+.+"
                    item                : "^[\s]*logfile[\s]+severity[\s]+(emergencies|alerts|critical|errors|warnings|notifications)[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.058 - ACI - Syslog - Console Destination - Admin State"
                    info                : "The administrative state of the console terminal."
                    reference           : "NIST 800-53r5|AU-12c."
                    context             : "^[\s]*logging[\s]+server-group[\s]+.+"
                    item                : "^[\s]*no[\s]+console[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.059 - ACI - Syslog - Console Destination - Severity"
                    info                : "The minimum severity level of the messages to be displayed."
                    reference           : "NIST 800-53r5|AU-12c."
                    context             : "^[\s]*logging[\s]+server-group[\s]+.+"
                    item                : "^[\s]*console[\s]+severity[\s]+emergencies[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK
                    description         : "1.060 - ACI - Syslog Remote Destination - Host"
                    info                : "The host name or IP for export destination."
                    reference           : "NIST 800-53r5|AU-4(1)"
                    context             : "^[\s]*logging[\s]+server-group[\s]+.+"
                    item                : "^[\s]*server[\s]+127.0.0.1[\s]+"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.061 - ACI - Syslog Remote Destination - Severity"
                    info                : "The minimum severity level of messages to be appended to the file."
                    reference           : "NIST 800-53r5|AU-12c."
                    context             : "^[\s]*logging[\s]+server-group[\s]+.+"
                    item                : "^[\s]*server[\s]+.*severity[\s]+(emergencies|alerts|critical|errors|warnings|notifications)[\s]*$"
        </custom_item>

        <custom_item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.062 - ACI - Remote Location - Protocol"
                    info                : "The transfer protocol to be used for data export."
                    reference           : "NIST 800-53r5|CM-7b."
                    context             : "^[\s]*remote[\s]+path[\s]+.*"
                    item                : "^[\s]*path[\s]+ftp[\s]+"
        </custom_item>
</check_type>
