<check_type:"Cisco">

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0001 - CSIOS - Check if Cisco IOS is installed"
                    item                : "version 1[6-9]"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0003 - CSIOS - Enable 'aaa new-model'"
                    info                : "This command enables the AAA access control system."
                    reference           : "NIST 800-53r5|AC-2(1)"
                    see_also            : "See HTH Policies and Standards"
                    item                : "aaa new-model$"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0004 - CSIOS - Enable 'aaa authentication login'"
                    info                : "Sets authentication, authorization and accounting (AAA) authentication at login."
                    reference           : "NIST 800-53r5|AC-2(1)"
                    see_also            : "See HTH Policies and Standards"
                    item                : "aaa authentication login"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0005 - CSIOS - Enable 'aaa authentication enable default'"
                    info                : "Authenticates users who access privileged EXEC mode when they use the enable command."
                    reference           : "NIST 800-53r5|AC-2(1)"
                    see_also            : "See HTH Policies and Standards"
                    item                : "aaa authentication enable default"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0007 - CSIOS - Set 'login authentication for 'line vty'"
                    info                : "Authenticates users who access the router or switch remotely through the VTY port."
                    reference           : "NIST 800-53r5|AC-2(1)"
                    see_also            : "See HTH Policies and Standards"
                    context             : "line vty .+"
                    item                : "login authentication .+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0006 - CSIOS - Check for existence of line vty"
                    item                : "line vty .+"
                    info                : "Authenticates users who access the router or switch remotely through the VTY port."
                    reference           : "NIST 800-53r5|AC-2(1)"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0010 - CSIOS - check for authentication policy"
                    item                : "ip http authentication (local|aaa_list_name)"
                    info                : "If account management functions are not automatically enforced, an attacker could gain privileged access to a vital element of the network security architecture Using AAA authentication for interactive management access to the device provides consistent, centralized control of your network."
                    reference           : "NIST 800-53r5|AC-2(1)"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0013 - CSIOS - Set 'privilege 1' for local users"
                    info                : "Sets the privilege level for the user."
                    reference           : "NIST 800-53r5|IA-2(2) IA-5(1)"
                    see_also            : "See HTH Policies and Standards"
                    item                : "username .+ privilege ([2-9]|1[0-5])"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0015 - CSIOS - Set 'http Secure-server' limit"
                    info                : "Device management includes the ability to control the number of administrators and management sessions that manage a device."
                    reference           : "NIST 800-53r5|AC-10"
                    see_also            : "See HTH Policies and Standards"
                    item                : "ip http max-connections 2"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0014 - CSIOS - check for ip http server in use"
                    item                : "ip http server"
                    info                : "Device management includes the ability to control the number of administrators and management sessions that manage a device."
                    reference           : "NIST 800-53r5|AC-10"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0018 - CSIOS - Set 'exec-timeout' to less than or equal to 10 min on 'ip http'"
                    info                : "If no input is detected during the interval, the EXEC facility resumes the current connection."
                    reference           : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
                    see_also            : "See HTH Policies and Standards"
                    item                : "ip http timeout-policy idle ([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600) life .+ requests .+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0017 - CSIOS - check for ip http server in use"
                    item                : "ip http server"
                    info                : "If no input is detected during the interval, the EXEC facility resumes the current connection."
                    reference           : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0020 - CSIOS - Set 'transport input ssh' for 'line vty' connections"
                    info                : "Selects the Secure Shell (SSH) protocol."
                    reference           : "NIST 800-53r5|IA-2(1)"
                    see_also            : "See HTH Policies and Standards"
                    context             : "line vty .+"
                    item                : "transport input ssh$"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0022 - CSIOS - Set 'no exec' for 'line aux 0'"
                    info                : "The 'no exec' command restricts a line to outgoing connections only."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    context             : "line aux .+"
                    item                : "no exec"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0021 - CSIOS - Check for line aux"
                    context             : "line aux .+"
                    info                : "The 'no exec' command restricts a line to outgoing connections only."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0024 - CSIOS - Test for ip-access list extended VTY_ACL"
                    item                : "ip access-list extended 100"
                    info                : "Access lists control the transmission of packets on an interface, control Virtual Terminal Line (VTY) access, and restrict the contents of routing updates."
                    reference           : "NIST 800-53r5|AC-17(3) SI-7"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0025 - CSIOS - check for permit configuration"
                    regex               : "^access-list 100 permit"
                    item                : "access-list 100 permit"
                    info                : "Access lists control the transmission of packets on an interface, control Virtual Terminal Line (VTY) access, and restrict the contents of routing updates."
                    reference           : "NIST 800-53r5|AC-17(3) SI-7"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0027 - CSIOS - Set 'access-class' for 'line vty'"
                    info                : "The 'access-class' setting restricts incoming and outgoing connections between a particular vty (into a Cisco device) and the networking devices associated with addresses in an access list."
                    reference           : "NIST 800-53r5|AC-17(3) SI-7"
                    see_also            : "See HTH Policies and Standards"
                    context             : "line vty .+"
                    item                : "access-class 100 in"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0028 - CSIOS - check that exec-timeout is not disabled"
                    context             : "line aux 0"
                    item                : "no exec-timeout"
                    info                : "If no input is detected during the interval, the EXEC facility resumes the current connection."
                    reference           : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0029 - CSIOS - check that exec-timeout does not exceed 10 minutes"
                    context             : "line aux 0"
                    item                : "exec-timeout (1[1-9]|[2-9][0-9]|[0-9]{3,}) [0-9]+$"
                    info                : "If no input is detected during the interval, the EXEC facility resumes the current connection."
                    reference           : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0031 - CSIOS - check that exec-timeout is not disabled"
                    context             : "line con 0"
                    item                : "no exec-timeout"
                    info                : "If no input is detected during the interval, the EXEC facility resumes the current connection."
                    reference           : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0032 - CSIOS - check that exec-timeout does not exceed 10 minutes"
                    context             : "line con 0"
                    item                : "exec-timeout (1[1-9]|[2-9][0-9]|[0-9]{3,}) [0-9]+$"
                    info                : "If no input is detected during the interval, the EXEC facility resumes the current connection."
                    reference           : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0034 - CSIOS - check that exec-timeout is not disabled"
                    context             : "line vty .+"
                    item                : "no exec-timeout"
                    info                : "If no input is detected during the interval, the EXEC facility resumes the current connection."
                    reference           : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0035 - CSIOS - check that exec-timeout does not exceed 10 minutes"
                    context             : "line vty .+"
                    item                : "exec-timeout (1[1-9]|[2-9][0-9]|[0-9]{3,}) [0-9]+$"
                    info                : "If no input is detected during the interval, the EXEC facility resumes the current connection."
                    reference           : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0038 - CSIOS - Set 'transport input none' for 'line aux 0'"
                    info                : "When you want to allow only an outgoing connection on a line, use the no exec command."
                    reference           : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
                    see_also            : "See HTH Policies and Standards"
                    context             : "line aux .+"
                    item                : "transport input (all|ssh|telnet)$"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0037 - CSIOS - Check for line aux"
                    context             : "line aux .+"
                    info                : "When you want to allow only an outgoing connection on a line, use the no exec command."
                    reference           : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : BANNER_CHECK
                    description         : "1.0040 - CSIOS - Set the 'banner-text' for 'banner exec'"
                    info                : "This command specifies a message to be displayed when an EXEC process is created (a line is activated, or an incoming connection is made to a vty)."
                    reference           : "NIST 800-53r5|AT-1 AT-2 PM-13"
                    see_also            : "See HTH Policies and Standards"
                    item                : "banner exec"
                    content             : "All unauthorized activity is monitored and logged."
        </item>

        <item>
                    type                : BANNER_CHECK
                    description         : "1.0041 - CSIOS - Set the 'banner-text' for 'banner login'"
                    info                : "Follow the banner login command with one or more blank spaces and a delimiting character of your choice."
                    reference           : "NIST 800-53r5|AT-1 AT-2 PM-13"
                    see_also            : "See HTH Policies and Standards"
                    item                : "banner login"
                    content             : "All unauthorized activity is monitored and logged."
        </item>

        <item>
                    type                : BANNER_CHECK
                    description         : "1.0042 - CSIOS - Set the 'banner-text' for 'banner motd'"
                    info                : "This MOTD banner is displayed to all terminals connected and is useful for sending messages that affect all users (such as impending system shutdowns)."
                    reference           : "NIST 800-53r5|AT-1 AT-2 PM-13"
                    see_also            : "See HTH Policies and Standards"
                    item                : "banner motd"
                    content             : "All unauthorized activity is monitored and logged."
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0043 - CSIOS - Set the 'banner-text' for 'webauth banner'"
                    info                : "This banner is displayed to all terminals connected and is useful for sending messages that affect all users (such as impending system shutdowns)."
                    reference           : "NIST 800-53r5|AT-1 AT-2 PM-13"
                    see_also            : "See HTH Policies and Standards"
                    item                : "ip admission auth-proxy-banner http .+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0044 - CSIOS - Set 'password' for 'enable secret'"
                    info                : "Enable secret password type 5 and enable secret password type 5 must be migrated to the stronger password type 8 or 9."
                    reference           : "NIST 800-53r5|AC-6(2) AC-6(5)"
                    see_also            : "See HTH Policies and Standards"
                    item                : "enable secret [^ ]+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0045 - CSIOS - Enable 'service password-encryption'"
                    info                : "When password encryption is enabled, the encrypted form of the passwords is displayed when a more system:running-config command is entered."
                    reference           : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
                    see_also            : "See HTH Policies and Standards"
                    item                : "service password-encryption"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0046 - CSIOS - Set 'username secret' for all local users"
                    info                : "Username secret password type 5 and enable secret password type 5 must be migrated to the stronger password type 8 or 9."
                    reference           : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
                    see_also            : "See HTH Policies and Standards"
                    regex               : "username .+ secret [^ ]+"
                    item                : "username [^ ]+"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0047 - CSIOS - Set 'no snmp-server' to disable SNMP when unused"
                    info                : "If not in use, disable simple network management protocol (SNMP), read and write access."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    item                : "snmp-server community .+"
                    severity            : MEDIUM
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0049 - CSIOS - Unset 'private' for 'snmp-server community'"
                    info                : "An SNMP community string permits read-only access to all objects."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    item                : "snmp-server community private"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0048 - CSIOS - SNMP is enabled"
                    item                : "snmp-server community .+"
                    info                : "An SNMP community string permits read-only access to all objects."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0052 - CSIOS - Unset 'public' for 'snmp-server community'"
                    info                : "An SNMP community string permits read-only access to all objects."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    item                : "snmp-server community public"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0051 - CSIOS - SNMP is enabled"
                    item                : "snmp-server community .+"
                    info                : "An SNMP community string permits read-only access to all objects."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0055 - CSIOS - Do not set 'RW' for any 'snmp-server community'"
                    info                : "Specifies read-write access."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    item                : "snmp-server community .+ [Rr][Ww]"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0054 - CSIOS - SNMP is enabled"
                    item                : "snmp-server community .+"
                    info                : "Specifies read-write access."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0058 - CSIOS - Set the ACL for each 'snmp-server community'"
                    info                : "This feature specifies a list of IP addresses that are allowed to use the community string to gain access to the SNMP agent."
                    reference           : "NIST 800-53r5|AC-17(3) SI-7"
                    see_also            : "See HTH Policies and Standards"
                    regex               : "snmp-server community .+ .+ 1$"
                    item                : "snmp-server community .+ .+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0057 - CSIOS - SNMP is enabled"
                    item                : "snmp-server community .+"
                    info                : "This feature specifies a list of IP addresses that are allowed to use the community string to gain access to the SNMP agent."
                    reference           : "NIST 800-53r5|AC-17(3) SI-7"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0061 - CSIOS - check for permit configuration"
                    regex               : "^access-list 1 permit"
                    item                : "access-list 1 permit"
                    info                : "You can use access lists to control the transmission of packets on an interface, control Simple Network Management Protocol (SNMP) access, and restrict the contents of routing updates."
                    reference           : "NIST 800-53r5|AC-17(3) SI-7"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0062 - CSIOS - Test for ip-access list extended SNMP_ACL"
                    item                : "ip access-list extended 1"
                    info                : "You can use access lists to control the transmission of packets on an interface, control Simple Network Management Protocol (SNMP) access, and restrict the contents of routing updates."
                    reference           : "NIST 800-53r5|AC-17(3) SI-7"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0067 - CSIOS - Set 'snmp-server host' when using SNMP"
                    info                : "SNMP notifications can be sent as traps to authorized management systems."
                    reference           : "NIST 800-53r5|AC-17(3) SI-7"
                    see_also            : "See HTH Policies and Standards"
                    item                : "snmp-server host 192\.168\.0\.2 .+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0065 - CSIOS - SNMP is enabled"
                    item                : "snmp-server community .+"
                    info                : "SNMP notifications can be sent as traps to authorized management systems."
                    reference           : "NIST 800-53r5|AC-17(3) SI-7"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0066 - CSIOS - Check for snmp-server host"
                    item                : "snmp-server host"
                    info                : "SNMP notifications can be sent as traps to authorized management systems."
                    reference           : "NIST 800-53r5|AC-17(3) SI-7"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0070 - CSIOS - Set 'snmp-server enable traps snmp'"
                    info                : "SNMP notifications can be sent as traps to authorized management systems."
                    reference           : "NIST 800-53r5|AC-17(3) SI-7"
                    see_also            : "See HTH Policies and Standards"
                    regex               : "^Manual Review Required$"
                    item                : "snmp-server enable traps"
                    severity            : MEDIUM
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0069 - CSIOS - SNMP is enabled"
                    item                : "snmp-server community .+"
                    info                : "SNMP notifications can be sent as traps to authorized management systems."
                    reference           : "NIST 800-53r5|AC-17(3) SI-7"
                    see_also            : "See HTH Policies and Standards"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0072 - CSIOS - Set the 'hostname'"
                    info                : "The hostname is used in prompts and default configuration filenames."
                    reference           : "NIST 800-53r5|CM-6b."
                    see_also            : "See HTH Policies and Standards"
                    regex               : "hostname Router$"
                    item                : "hostname .+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0073 - CSIOS - Set the 'ip domain-name'"
                    info                : "Define a default domain name that the Cisco IOS software uses to complete unqualified hostnames The domain name is a prerequisite for setting up SSH."
                    reference           : "NIST 800-53r5|CM-6b."
                    see_also            : "See HTH Policies and Standards"
                    item                : "ip domain(-| )name .+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0074 - CSIOS - Set 'modulus' to greater than or equal to 2048 for 'crypto key generate rsa'"
                    info                : "Use this command to generate RSA key pairs for your Cisco device."
                    reference           : "NIST 800-53r5|SA-15"
                    see_also            : "See HTH Policies and Standards"
                    cmd                 : "show crypto key mypubkey rsa"
                    regex               : "^Manual Review Required$"
                    item                : ".*"
                    severity            : MEDIUM
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0075 - CSIOS - Set 'seconds' for 'ip ssh timeout' for 60 seconds or less"
                    info                : "The time interval that the router waits for the SSH client to respond before disconnecting an uncompleted login attempt."
                    reference           : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
                    see_also            : "See HTH Policies and Standards"
                    regex               : "ip ssh time-out ([1-9]|[1-5][0-9]|60)$"
                    item                : "ip ssh time-out"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0076 - CSIOS - Set maximum value for 'ip ssh authentication-retries'"
                    info                : "The number of retries before the SSH login session disconnects."
                    reference           : "NIST 800-53r5|IA-2(1)"
                    see_also            : "See HTH Policies and Standards"
                    cmd                 : "show ip ssh"
                    item                : "Authentication timeout: .* secs; Authentication retries: [1-3]"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0077 - CSIOS - Set version 2 for 'ip ssh version'"
                    info                : "Specify the version of Secure Shell (SSH) to be run on a router SSH Version 1 has been subject to a number of serious vulnerabilities and is no longer considered to be a secure protocol, resulting in the adoption of SSH Version 2 as an Internet Standard in 2006."
                    reference           : "NIST 800-53r5|CM-6"
                    see_also            : "See HTH Policies and Standards"
                    item                : "ip ssh version 2"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0078 - CSIOS - Set 'no cdp run'"
                    info                : "Disable Cisco Discovery Protocol (CDP) service at device level."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    item                : "no cdp run"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0079 - CSIOS - Set 'no ip bootp server'"
                    info                : "Disable the Bootstrap Protocol (BOOTP) service on your routing device."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    item                : "no ip bootp server"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0080 - CSIOS - Set 'no service dhcp'"
                    info                : "Disable the Dynamic Host Configuration Protocol (DHCP) server and relay agent features on your router."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    item                : "no service dhcp"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0081 - CSIOS - Set 'service tcp-keepalives-in'"
                    info                : "Generate keepalive packets on idle incoming network connections."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    item                : "service tcp-keepalives-in"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0082 - CSIOS - Set 'service tcp-keepalives-out'"
                    info                : "Generate keepalive packets on idle outgoing network connections."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    item                : "service tcp-keepalives-out"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0083 - CSIOS - Set 'no service pad'"
                    info                : "Disable X."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    item                : "no service pad"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0084 - CSIOS - Set 'logging enable'"
                    info                : "Enable logging of system messages."
                    reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                    see_also            : "See HTH Policies and Standards"
                    item                : "logging host"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0085 - CSIOS - Set 'buffer size' for 'logging buffered'"
                    info                : "Enable system message logging to a local buffer."
                    reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                    see_also            : "See HTH Policies and Standards"
                    regex               : "logging buffered 64000( *|$)"
                    item                : "logging buffered"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0086 - CSIOS - Set 'logging console critical'"
                    info                : "Verify logging to device console is enabled and limited to a rational severity level to avoid impacting system performance and management."
                    reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                    see_also            : "See HTH Policies and Standards"
                    item                : "logging console critical"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0087 - CSIOS - Set IP address for 'logging host'"
                    info                : "Log system messages and debug output to a remote host."
                    reference           : "NIST 800-53r5|AU-6(1) AU-7 IR-4(1) SI-4 SI-4(2) SI-4(5)"
                    see_also            : "See HTH Policies and Standards"
                    item                : "logging host 192.168.0.254"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0088 - CSIOS - Set 'logging trap informational'"
                    info                : "Limit messages logged to the syslog servers based on severity level informational."
                    reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                    see_also            : "See HTH Policies and Standards"
                    regex               : "logging trap (debugging|7|informational|6)"
                    item                : "logging trap .+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0089 - CSIOS - Set 'service timestamps debug datetime'"
                    info                : "Configure the system to apply a time stamp to debugging messages or system logging messages Including timestamps in log messages allows correlating events and tracing network attacks across multiple devices."
                    reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                    see_also            : "See HTH Policies and Standards"
                    item                : "service timestamps debug datetime"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0090 - CSIOS - Set 'logging source interface'"
                    info                : "Specify the source IPv4 or IPv6 address of system logging packets This is required so that the router sends log messages to the logging server from a consistent IP address."
                    reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                    see_also            : "See HTH Policies and Standards"
                    item                : "logging source-interface .+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0091 - CSIOS - Set 'ip address' for 'ntp server'"
                    info                : "Use this command if you want to allow the system to synchronize the system software clock with the specified NTP server."
                    reference           : "NIST 800-53r5|AU-7 AU-8"
                    see_also            : "See HTH Policies and Standards"
                    item                : "ntp server 192.168.0.1"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0092 - CSIOS - Set 'no ip source-route'"
                    info                : "Disable the handling of IP datagrams with source routing header options."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    item                : "no ip source-route"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0093 - CSIOS - Set 'no interface tunnel'"
                    info                : "Verify no tunnel interfaces are defined."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    item                : "interface [Tt]unnel[0-9]+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0094 - CSIOS - Set 'ip verify unicast source reachable-via'"
                    info                : "Examines incoming packets to determine whether the source address is in the Forwarding Information Base (FIB) and permits the packet only if the source is reachable through the interface on which the packet was received (sometimes referred to as strict mode)."
                    reference           : "NIST 800-53r5|CM-7b."
                    see_also            : "See HTH Policies and Standards"
                    context             : "interface .+"
                    regex               : "ip verify unicast source reachable-via"
                    item                : "ip verify unicast"
                    severity            : MEDIUM
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0096 - CSIOS - Set 'authentication mode md5'"
                    info                : "Configure authentication to prevent unapproved sources from introducing unauthorized or false service messages."
                    reference           : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
                    see_also            : "See HTH Policies and Standards"
                    context             : "router eigrp .+"
                    item                : "authentication mode md5"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0095 - CSIOS - EIGRP is enabled"
                    item                : "router eigrp .+"
                    info                : "Configure authentication to prevent unapproved sources from introducing unauthorized or false service messages."
                    reference           : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
                    see_also            : "See HTH Policies and Standards"
        </item>
</check_type>
