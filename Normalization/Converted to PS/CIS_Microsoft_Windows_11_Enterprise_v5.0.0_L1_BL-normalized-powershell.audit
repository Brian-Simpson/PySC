  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p) { [int]$p.'RequireSignOrSeal' } else { $null }; if ($val -ne $null -and $val -eq 1) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0397 - MSWRK - Ensure Domain member: Digitally encrypt secure channel data (when possible) is set to Enabled"
  info              : "This policy setting determines whether a domain member should attempt to negotiate encryption for all secure channel traffic that it initiates."
  reference         : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p) { [int]$p.'SealSecureChannel' } else { $null }; if ($val -ne $null -and $val -eq 1) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0398 - MSWRK - Ensure Domain member: Digitally sign secure channel data (when possible) is set to Enabled"
  info              : "This policy setting determines whether a domain member should attempt to negotiate whether all secure channel traffic that it initiates must be digitally signed."
  reference         : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p) { [int]$p.'SignSecureChannel' } else { $null }; if ($val -ne $null -and $val -eq 1) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0399 - MSWRK - Ensure Domain member: Disable machine account password changes is set to Disabled"
  info              : "This policy setting determines whether a domain member can periodically change its computer account password."
  reference         : "NIST 800-53r5|AC-2(1)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p) { [int]$p.'DisablePasswordChange' } else { $null }; if ($val -ne $null -and $val -eq 0) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0400 - MSWRK - Ensure Domain member: Maximum machine account password age is set to 30 or fewer days, but not 0"
  info              : "This policy setting determines the maximum allowable age for a computer account password."
  reference         : "NIST 800-53r5|IA-5(1)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p) { $p.'MaximumPasswordAge' } else { $null }; if ($val -ne $null -and ([int]$val -ge 1 -and [int]$val -le 30)) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0401 - MSWRK - Ensure Domain member: Require strong (Windows 2000 or later) session key is set to Enabled"
  info              : "When this policy setting is enabled, a secure channel can only be established with Domain Controllers that are capable of encrypting secure channel data with a strong (128-bit) session key."
  reference         : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Netlogon\Parameters' -ErrorAction SilentlyContinue; $val = if ($p) { [int]$p.'RequireStrongKey' } else { $null }; if ($val -ne $null -and $val -eq 1) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0402 - MSWRK - Ensure Interactive logon: Dont display last signed-in is set to Enabled"
  info              : "This policy setting determines whether the account name of the last user to log on to the client computers in your organization will be displayed on each computer's respective Windows logon screen."
  reference         : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p) { [int]$p.'DontDisplayLastUserName' } else { $null }; if ($val -ne $null -and $val -eq 1) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0403 - MSWRK - Ensure Interactive logon: Machine inactivity limit is set to 900 or fewer second(s), but not 0"
  info              : "Windows notices inactivity of a logon session, and if the amount of inactive time exceeds the inactivity limit, then the screen saver will run, locking the session."
  reference         : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p) { $p.'InactivityTimeoutSecs' } else { $null }; if ($val -ne $null -and ([int]$val -ge 1 -and [int]$val -le 900)) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0404 - MSWRK - Configure Interactive logon: Message text for users attempting to log on"
  info              : "This policy setting specifies a text message that is displayed to users when they log on."
  reference         : "NIST 800-53r5|AC-8"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p) { [string]$p.'LegalNoticeText' } else { '' }; if ($val -match 'All activities performed on this system will be monitored.') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0405 - MSWRK - Configure Interactive logon: Message title for users attempting to log on"
  info              : "This policy setting specifies the text displayed in the title bar of the window that is displayed to users when they log on to the system."
  reference         : "NIST 800-53r5|AC-8"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Policies\System' -ErrorAction SilentlyContinue; $val = if ($p) { [string]$p.'LegalNoticeCaption' } else { '' }; if ($val -match 'Notice and Consent Banner') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0406 - MSWRK - Ensure Interactive logon: Prompt user to change password before expiration is set to between 5 and 14 days"
  info              : "This policy setting determines how far in advance users are warned that their password will expire."
  reference         : "NIST 800-53r5|IA-5(1)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Winlogon' -ErrorAction SilentlyContinue; $val = if ($p) { $p.'PasswordExpiryWarning' } else { $null }; if ($val -ne $null -and ([int]$val -ge 5 -and [int]$val -le 14)) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0407 - MSWRK - Ensure Interactive logon: Smart card removal behavior is set to Lock Workstation or higher"
  info              : "This policy setting determines what happens when the smart card for a logged-on user is removed from the smart card reader."
  reference         : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
