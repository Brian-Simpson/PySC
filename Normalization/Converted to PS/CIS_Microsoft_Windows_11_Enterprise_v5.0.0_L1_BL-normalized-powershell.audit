  description       : "1.0055 - MSWRK - Ensure Allow Secure Boot for integrity validation is set to Enabled"
  info              : "This policy setting allows you to configure whether Secure Boot will be allowed as the platform integrity provider for BitLocker operating system drives."
  reference         : "NIST 800-53r5|SI-16"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\FVE' -ErrorAction SilentlyContinue; $val = if ($p) { [int]$p.'OSAllowSecureBootForIntegrity' } else { $null }; if ($val -ne $null -and $val -eq 1) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

