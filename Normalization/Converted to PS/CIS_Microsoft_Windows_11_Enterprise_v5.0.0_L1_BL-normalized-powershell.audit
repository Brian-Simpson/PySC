</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0408 - MSWRK - Ensure Microsoft network client: Digitally sign communications (always) is set to Enabled"
  info              : "This policy setting determines whether packet signing is required by the Server Message Block (SMB) client component."
  reference         : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
