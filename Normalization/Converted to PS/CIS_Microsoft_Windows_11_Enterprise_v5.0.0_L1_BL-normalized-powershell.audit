
<check_type:"Windows" version:"2">
<group_policy:"CIS Microsoft Windows 11 Enterprise">

<if>
  <condition type:"AND">
<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "Windows 11 is installed"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows Nt\Currentversion' -ErrorAction SilentlyContinue; $val = if ($p) { [string]$p.'CurrentBuild' } else { '' }; if ($val -match '2[26][0-9]{3}') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "Windows 11 installation type"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Microsoft\Windows Nt\Currentversion' -ErrorAction SilentlyContinue; $val = if ($p) { [string]$p.'InstallationType' } else { $null }; if ($val -ne $null -and $val -eq 'Client') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description : "HTH_Microsoft_Windows_11_Enterprise_v5.0.0_L1_BL.audit from HTH Microsoft Windows 11 Enterprise v5.0.0"
  see_also    : "See HTH Policies and Standards"
  show_output : YES
</report>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0001 - MSWRK - Ensure Enforce password history is set to 24 or more password(s)"
  info              : "This policy setting determines the number of renewed, unique passwords that have to be associated with a user account before you can reuse an old password."
  reference         : "NIST 800-53r5|IA-5(1)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^PasswordHistorySize\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -ne '' -and ([int]$val -ge 24)) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0002 - MSWRK - Ensure Maximum password age is set to 365 or fewer days, but not 0"
  info              : "This policy setting defines how long a user can use their password before it expires."
  reference         : "NIST 800-53r5|IA-5(1)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^MaximumPasswordAge\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -ne '' -and ([int]$val -ge 1 -and [int]$val -le 365)) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0003 - MSWRK - Ensure Minimum password age is set to 1 or more day(s)"
  info              : "This policy setting determines the number of days that you must use a password before you can change it."
  reference         : "NIST 800-53r5|IA-5(1)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^MinimumPasswordAge\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -ne '' -and ([int]$val -ge 1)) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0004 - MSWRK - Ensure Minimum password length is set to 14 or more character(s)"
  info              : "This policy setting determines the least number of characters that make up a password for a user account."
  reference         : "NIST 800-53r5|IA-5(1)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^MinimumPasswordLength\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -ne '' -and ([int]$val -ge 14)) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0005 - MSWRK - Ensure Password must meet complexity requirements is set to Enabled"
  info              : "This policy setting checks all new passwords to ensure that they meet basic requirements for strong passwords."
  reference         : "NIST 800-53r5|IA-5(1)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^PasswordComplexity\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -eq '1') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0006 - MSWRK - Ensure Relax minimum password length limits is set to Enabled"
  info              : "This policy setting determines whether the minimum password length setting can be increased beyond the legacy limit of 14 characters."
  reference         : "NIST 800-53r5|IA-5(1)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\SAM' -ErrorAction SilentlyContinue; $val = if ($p) { [int]$p.'RelaxMinimumPasswordLengthLimits' } else { $null }; if ($val -ne $null -and $val -eq 1) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0007 - MSWRK - Ensure Store passwords using reversible encryption is set to Disabled"
  info              : "This policy setting determines whether the operating system stores passwords in a way that uses reversible encryption, which provides support for application protocols that require knowledge of the user's password for authentication purposes."
  reference         : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^ClearTextPassword\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -eq '0') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0008 - MSWRK - Ensure Account lockout duration is set to 15 or more minute(s)"
  info              : "This policy setting determines the length of time that must pass before a locked account is unlocked and a user can try to log on again."
  reference         : "NIST 800-53r5|AC-7 AC-19"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^LockoutDuration\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -ne '' -and ([int]$val -ge 15)) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0009 - MSWRK - Ensure Account lockout threshold is set to 5 or fewer invalid logon attempt(s), but not 0"
  info              : "This policy setting determines the number of failed logon attempts before the account is locked."
  reference         : "NIST 800-53r5|AC-7 AC-19"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^LockoutBadCount\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -ne '' -and ([int]$val -ge 1 -and [int]$val -le 5)) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0010 - MSWRK - Ensure Allow Administrator account lockout is set to Enabled"
  info              : "This policy setting determines whether the built-in Administrator account is subject to the following Account Lockout Policy settings: Account lockout duration, Account lockout threshold, and Reset account lockout counter."
  reference         : "NIST 800-53r5|AC-7 AC-19"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^AllowAdministratorLockout\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -eq '1') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0011 - MSWRK - Ensure Reset account lockout counter after is set to 15 or more minute(s)"
  info              : "This policy setting determines the length of time before the Account lockout threshold resets to zero."
  reference         : "NIST 800-53r5|AC-7 AC-19"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /quiet; $val = (Get-Content $tmp | Where-Object { $_ -match '^ResetLockoutCount\s*=' } | Select-Object -Last 1) -replace '.*=\s*',''; Remove-Item $tmp -Force; if ($val -ne '' -and ([int]$val -ge 15)) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0012 - MSWRK - Ensure Audit Credential Validation is set to Success and Failure"
  info              : "This subcategory reports the results of validation tests on credentials submitted for a user account logon request."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Credential Validation' 2>&1; $line = $r | Where-Object { $_ -like '*Credential Validation*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0013 - MSWRK - Ensure Audit Application Group Management is set to Success and Failure"
  info              : "This policy setting allows you to audit events generated by changes to application groups such as the following: - Application group is created, changed, or deleted."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Application Group Management' 2>&1; $line = $r | Where-Object { $_ -like '*Application Group Management*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0014 - MSWRK - Ensure Audit Security Group Management is set to include Success"
  info              : "This subcategory reports each event of security group management, such as when a security group is created, changed, or deleted or when a member is added to or removed from a security group."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Security Group Management' 2>&1; $line = $r | Where-Object { $_ -like '*Security Group Management*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Success' -or $val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0015 - MSWRK - Ensure Audit User Account Management is set to Success and Failure"
  info              : "This subcategory reports each event of user account management, such as when a user account is created, changed, or deleted; a user account is renamed, disabled, or enabled; or a password is set or changed."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'User Account Management' 2>&1; $line = $r | Where-Object { $_ -like '*User Account Management*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0016 - MSWRK - Ensure Audit PNP Activity is set to include Success"
  info              : "This policy setting allows you to audit when plug and play detects an external device."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Plug and Play Events' 2>&1; $line = $r | Where-Object { $_ -like '*Plug and Play Events*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Success' -or $val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0017 - MSWRK - Ensure Audit Process Creation is set to include Success"
  info              : "This subcategory reports the creation of a process and the name of the program or user that created it."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Process Creation' 2>&1; $line = $r | Where-Object { $_ -like '*Process Creation*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Success' -or $val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0018 - MSWRK - Ensure Audit Account Lockout is set to include Failure"
  info              : "This subcategory reports when a user's account is locked out as a result of too many failed logon attempts."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Account Lockout' 2>&1; $line = $r | Where-Object { $_ -like '*Account Lockout*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Failure' -or $val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0019 - MSWRK - Ensure Audit Group Membership is set to include Success"
  info              : "This policy allows you to audit the group membership information in the user's logon token."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Group Membership' 2>&1; $line = $r | Where-Object { $_ -like '*Group Membership*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Success' -or $val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0020 - MSWRK - Ensure Audit Logoff is set to include Success"
  info              : "This subcategory reports when a user logs off from the system."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Logoff' 2>&1; $line = $r | Where-Object { $_ -like '*Logoff*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Success' -or $val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0021 - MSWRK - Ensure Audit Logon is set to Success and Failure"
  info              : "This subcategory reports when a user attempts to log on to the system."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Logon' 2>&1; $line = $r | Where-Object { $_ -like '*Logon*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0022 - MSWRK - Ensure Audit Other Logon/Logoff Events is set to Success and Failure"
  info              : "This subcategory reports other logon/logoff-related events, such as Remote Desktop Services session disconnects and reconnects, using RunAs to run processes under a different account, and locking and unlocking a workstation."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Other Logon/Logoff Events' 2>&1; $line = $r | Where-Object { $_ -like '*Other Logon/Logoff Events*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0023 - MSWRK - Ensure Audit Special Logon is set to include Success"
  info              : "This subcategory reports when a special logon is used."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Special Logon' 2>&1; $line = $r | Where-Object { $_ -like '*Special Logon*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Success' -or $val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0024 - MSWRK - Ensure Audit Detailed File Share is set to include Failure"
  info              : "This subcategory allows you to audit attempts to access files and folders on a shared folder."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Detailed File Share' 2>&1; $line = $r | Where-Object { $_ -like '*Detailed File Share*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Failure' -or $val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0025 - MSWRK - Ensure Audit File Share is set to Success and Failure"
  info              : "This policy setting allows you to audit attempts to access a shared folder."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'File Share' 2>&1; $line = $r | Where-Object { $_ -like '*File Share*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0026 - MSWRK - Ensure Audit Other Object Access Events is set to Success and Failure"
  info              : "This policy setting allows you to audit events generated by the management of task scheduler jobs or COM+ objects."
  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$val = 'No Auditing'; $r = auditpol /get /subcategory:'Other Object Access Events' 2>&1; $line = $r | Where-Object { $_ -like '*Other Object Access Events*' } | Select-Object -Last 1; if ($line) { $parts = $line -split '\s{2,}'; if ($parts.Count -gt 1) { $val = $parts[-1].Trim() } }; if ($val -eq 'Success and Failure') { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0027 - MSWRK - Ensure Audit Removable Storage is set to Success and Failure"
  info              : "This policy setting allows you to audit user attempts to access file system objects on a removable storage device."
