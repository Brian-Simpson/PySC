</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0412 - MSWRK - Ensure Microsoft network server: Disconnect clients when logon hours expire is set to Enabled"
  info              : "This security setting determines whether to disconnect users who are connected to the local computer outside their user account's valid logon hours."
  reference         : "NIST 800-53r5|AC-2(12)"
