<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0320 - MSWRK - Ensure Access Credential Manager as a trusted caller is set to No One"
  info              : "This security setting is used by Credential Manager during Backup and Restore."
  reference         : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$tmp = [System.IO.Path]::GetTempFileName(); secedit /export /cfg $tmp /areas USER_RIGHTS /quiet; $line = (Get-Content $tmp | Where-Object { $_ -match '^SeTrustedCredManAccessPrivilege\s*=' } | Select-Object -Last 1); $members = if ($line) { ($line -replace '.*=\s*','').Trim() -split ',' | ForEach-Object { $_.Trim() -replace '\*','' } } else { @() }; Remove-Item $tmp -Force; if ($members.Count -eq 0) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0321 - MSWRK - Ensure Create a token object is set to No One"
  info              : "This policy setting allows a process to create an access token, which may provide elevated rights to access sensitive data."
