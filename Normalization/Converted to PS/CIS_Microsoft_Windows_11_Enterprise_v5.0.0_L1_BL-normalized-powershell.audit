  reference         : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12 SC-7 SC-7(5)"
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "STATUS: PASSED"
  powershell_args   : "$p = Get-ItemProperty -Path 'Registry::HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\WindowsFirewall\PublicProfile\Logging' -ErrorAction SilentlyContinue; $val = if ($p) { [int]$p.'LogSuccessfulConnections' } else { $null }; if ($val -ne $null -and $val -eq 1) { 'STATUS: PASSED' } else { 'STATUS: FAILED' }"
</custom_item>
  </then>

  <else>
<report type:"WARNING">
  description : "HTH_Microsoft_Windows_11_Enterprise_v5.0.0_L1_BL.audit from HTH Microsoft Windows 11 Enterprise v5.0.0"
  see_also    : "See HTH Policies and Standards"
  show_output : YES
</report>
  </else>
</if>

</group_policy>
</check_type>