<check_type:"Cisco">

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0008 - CSNXOS - Configure AAA Authentication - Local SSH keys"
                    info                : "Using the client's public key to authenticate their SSH sessions circumvents the need for using passwords for an administrative login to the switch."
                    reference           : "NIST 800-53r5|AC-2(1)"
                    see_also            : "See HTH Policies and Standards"
                    regex               : "^Manual Review Required$"
                    item                : "username .+ sshkey .+"
                    severity            : MEDIUM
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0015 - CSNXOS - vty line authentication"
                    info                : "Authenticate management access to the network devices."
                    reference           : "NIST 800-53r5|AC-2(1)"
                    see_also            : "See HTH Policies and Standards"
                    context             : "aaa authentication login default group"
                    item                : "aaa authentication login default group TACACSGROUP"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0019 - CSNXOS - Configure IP Blocking on Failed Logins"
                    info                : "After a configured number of failed logins in a set window, offending IP addresses should be blocked from login for a configured amount of time."
                    reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-6(3) AU-7 AU-12"
                    see_also            : "See HTH Policies and Standards"
                    item                : "(^|system )login block-for"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0021 - CSNXOS - Limit SSH Login Attempts to 3 or less"
                    info                : "After a configured number of failed password attempts, an SSH session terminate."
                    reference           : "NIST 800-53r5|CM-7 MA-4"
                    see_also            : "See HTH Policies and Standards"
                    item                : "ssh login-attempts 3"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0023 - CSNXOS - Ensure Exec Timeout for Console Sessions is set for less than 10"
                    info                : "Verify device is configured to automatically disconnect console sessions after a defined maximum session time, set in minutes."
                    reference           : "NIST 800-53r5|CM-7 MA-4"
                    see_also            : "See HTH Policies and Standards"
                    context             : "line console"
                    item                : "exec-timeout 10"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0024 - CSNXOS - Ensure Exec Timeout for Remote Administrative Sessions (VTY) is set to less than 10"
                    info                : "This value sets the maximum time of an administrative session that is attached via a VTY line - in most installations this means the maximum time and SSH session can have."
                    reference           : "NIST 800-53r5|CM-7 MA-4"
                    see_also            : "See HTH Policies and Standards"
                    context             : "line vty"
                    item                : "exec-timeout 10"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0025 - CSNXOS - Set the Maximum Number of VTY Sessions"
                    info                : "This sets the maximum number of remote administrative sessions, which in most environments means the maximum number of SSH sessions."
                    reference           : "NIST 800-53r5|CM-7 MA-4"
                    see_also            : "See HTH Policies and Standards"
                    context             : "line vty"
                    item                : "session-limit 16"
        </item>

        <item>
                    type                : BANNER_CHECK
                    description         : "1.0029 - CSNXOS - Pre-authentication Banner"
                    info                : "A pre-authentication banner is displayed when a terminal connects, before a login occurs."
                    reference           : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
                    see_also            : "See HTH Policies and Standards"
                    item                : "banner motd"
                    content             : "Ensure Legal Compliance and User Awareness Before Login"
        </item>

        <item>
                    type                : BANNER_CHECK
                    description         : "1.0030 - CSNXOS - Post-authentication Banner"
                    info                : "A post-authentication banner is displayed to the user after a successful login."
                    reference           : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
                    see_also            : "See HTH Policies and Standards"
                    item                : "banner exec"
                    content             : "All use of this device is monitored and logged."
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0031 - CSNXOS - Enable Password Complexity Requirements for Local Credentials"
                    info                : "While configuring a back-end authentication store is the recommended configuration, at least one local administrative account must be configured."
                    reference           : "NIST 800-53r5|IA-5(1)"
                    see_also            : "See HTH Policies and Standards"
                    item                : "password strength-check"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0032 - CSNXOS - Set password lifetime, warning time and grace time for local credentials"
                    info                : "NX-OS has commands to adjust the permitted lifetime of passphrases for local credentials, as well as the \"warning time\" before expiry and the \"grace time\" after expiry."
                    reference           : "NIST 800-53r5|AC-6(9) AU-2 AU-12 IA-5(1)"
                    see_also            : "See HTH Policies and Standards"
                    regex               : "$Manual Review Required^"
                    item                : "(username.*passphrase|userpassphrase.*)"
                    severity            : MEDIUM
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0033 - CSNXOS - Set password length for local credentials"
                    info                : "Password length should be set to some value that makes compromising any captured hashed difficult."
                    reference           : "NIST 800-53r5|IA-5(1)"
                    see_also            : "See HTH Policies and Standards"
                    item                : "userpassphrase min-length 20 max-length 127"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0034 - CSNXOS - Configure Logging Timestamps"
                    info                : "Timestamps are incredibly important since they drive a number of important activities in our product."
                    reference           : "NIST 800-53r5|AU-2 AU-3 AU-3(1) AU-7 AU-8 AU-12"
                    see_also            : "See HTH Policies and Standards"
                    item                : "logging timestamp .+"
                    required            : NO
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0038 - CSNXOS - Configure a Time Zone"
                    info                : "Timezones are a source of contention in larger corporations."
                    reference           : "NIST 800-53r5|AU-7 AU-8"
                    see_also            : "See HTH Policies and Standards"
                    item                : "clock timezone .+ .+ .+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0040 - CSNXOS - If a Local Time Zone is used, Configure Daylight Savings"
                    info                : "If local time zones are configured on network infrastructure, it is important to also configure the time \"shift\" that occurs as a result of Daylight Savings Time."
                    reference           : "NIST 800-53r5|AU-7 AU-8"
                    see_also            : "See HTH Policies and Standards"
                    item                : "clock summer-time .+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0047 - CSNXOS - Configure SNMP Traps"
                    info                : "SNMP relies on an architecture which consists of a manager and an agent."
                    reference           : "NIST 800-53r5|SI-4 SI-4(4)"
                    see_also            : "See HTH Policies and Standards"
                    item                : "snmp-server enable traps .+"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0051 - CSNXOS - Ensure Read Write privileges are not configured for SNMP"
                    info                : "SNMP RW (Read-Write) access allows stations with Management access to both read and write SNMP MIB objects."
                    reference           : "NIST 800-53r5|CM-7 MA-4"
                    see_also            : "See HTH Policies and Standards"
                    regex               : "^Manual Review Required$"
                    item                : "snmp-server community .+"
                    severity            : MEDIUM
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0052 - CSNXOS - Configure Control Plane Policing"
                    info                : "Control Plane Policing is used to create a set of policies governing specific traffic."
                    reference           : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
                    see_also            : "See HTH Policies and Standards"
                    item                : "copp profile strict"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0054 - CSNXOS - Configure EIGRP Passive interfaces for interfaces that do not have peers"
                    info                : "EIGRP both listens on and advertises on all interfaces that have IPs in subnets that are defined as \"networks\" in the EIGRP configuration."
                    reference           : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
                    see_also            : "See HTH Policies and Standards"
                    context             : "interface .+"
                    regex               : "^Manual Review Required$"
                    item                : "ip passive-interface eigrp .+"
                    severity            : MEDIUM
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0057 - CSNXOS - Configure EIGRP  log-adjacency-changes"
                    info                : "Logging changes to the EIGRP peering relationships is recommended."
                    reference           : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) AU-3 AU-3(1) AU-7 AU-12 CM-2 CM-6 CM-7 CM-7(1) CM-9 SC-23"
                    see_also            : "See HTH Policies and Standards"
                    context             : "router eigrp .+"
                    item                : "no log-adjacency-changes"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0060 - CSNXOS - Configure BGP to Log Neighbor Changes"
                    info                : "Logging changes to the BGP peering relationships is recommended."
                    reference           : "NIST 800-53r5|CM-6 CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7 SC-23"
                    see_also            : "See HTH Policies and Standards"
                    context             : "router bgp .+"
                    item                : "log-neighbor-changes"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0063 - CSNXOS - Set Interfaces with no Peers to Passive-Interface"
                    info                : "By default, OSPF will advertise via multicast to solicit peers, and will listen for neighbor / peer advertisements on all OSPF configured interfaces."
                    reference           : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
                    see_also            : "See HTH Policies and Standards"
                    context             : "interface .+"
                    regex               : "^Manual Review Required$"
                    item                : "ip ospf passive-interface"
                    severity            : MEDIUM
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0066 - CSNXOS - Log OSPF Adjacency Changes"
                    info                : "Logging changes to the BGP peering relationships is recommended."
                    reference           : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) AU-3 AU-3(1) AU-7 AU-12 CM-2 CM-6 CM-7 CM-7(1) CM-9 SI-4 SI-4(4)"
                    see_also            : "See HTH Policies and Standards"
                    context             : "router ospf .+"
                    item                : "log-adjacency-changes"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0068 - CSNXOS - If VLAN interfaces have IP addreses, configure anti spoofing / ingress filtering protections"
                    info                : "If VLAN interfaces have IP addresses, it is important that anti-spoofing protections are in place, to prevent an attacker from spoofing an address that is illegal on that inbound interface."
                    reference           : "NIST 800-53r5|CA-9 SC-7 SI-4 SI-4(4)"
                    see_also            : "See HTH Policies and Standards"
                    context             : "interface Vlan.+"
                    regex               : "^Manual Review Required$"
                    item                : "(ip address .+|ip verify unicast source reachable-via rx)"
                    severity            : MEDIUM
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0069 - CSNXOS - Configure HSRP protections"
                    info                : "HSRP is a valuable redundancy protocol, but like many protocols discussed in this document can be attacked and compromised."
                    reference           : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
                    see_also            : "See HTH Policies and Standards"
                    context             : "interface .+"
                    regex               : "^Manual Review Required$"
                    item                : "authentication md5 key-chain .+"
                    severity            : MEDIUM
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0073 - CSNXOS - Disable ICMP Redirects on all Layer 3 Interfaces"
                    info                : "A redirect packet basically informs the host that there is a better way to get to the destination host or network."
                    reference           : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
                    see_also            : "See HTH Policies and Standards"
                    context             : "interface .+"
                    regex               : "^Manual Review Required$"
                    item                : "^no ip redirects"
                    severity            : MEDIUM
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0074 - CSNXOS - Disable Proxy ARP on all Layer 3 Interfaces"
                    info                : "Proxy ARP is the technique in which one host, usually a router, answers ARP requests intended for another machine on a different network segment (vlan or subnet)."
                    reference           : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
                    see_also            : "See HTH Policies and Standards"
                    context             : "interface .+"
                    item                : "ip proxy-arp"
        </item>

        <item>
                    type                : CONFIG_CHECK_NOT
                    description         : "1.0075 - CSNXOS - Disable IP Directed Broadcasts on all Layer 3 Interfaces"
                    info                : "An IP directed broadcast is an IP packet whose destination address is a valid broadcast address for an IP subnet, but which originates from a node that is not itself a part of that destination subnet."
                    reference           : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
                    see_also            : "See HTH Policies and Standards"
                    context             : "interface .+"
                    item                : "ip directed-broadcast"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0076 - CSNXOS - Disable IP Source-Routing"
                    info                : "A malicious actor can influence the path that their traffic should take using source-routing."
                    reference           : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 CP-6 CP-7 PL-8 PM-7 SA-3 SA-8 SA-10 SC-7"
                    see_also            : "See HTH Policies and Standards"
                    item                : "no ip source-route"
        </item>

        <item>
                    type                : CONFIG_CHECK
                    description         : "1.0082 - CSNXOS - Configure LLDP"
                    info                : "LLDP is a discovery protocol that transmits information about the capabilities and current status of a device and its interfaces."
                    reference           : "NIST 800-53r5|CA-9 CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7 SI-4 SI-4(4)"
                    see_also            : "See HTH Policies and Standards"
                    context             : "interface .+"
                    regex               : "^Manual Review Required$"
                    item                : ".*lldp (transmit|receive).*"
                    severity            : MEDIUM
        </item>
</check_type>
