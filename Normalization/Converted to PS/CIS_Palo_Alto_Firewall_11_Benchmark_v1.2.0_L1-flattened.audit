<check_type:"Palo_Alto">

        <custom_item>
                    type                : AUDIT_XML
                    description         : "Check for Palo Alto version 11"
                    api_request_type    : "op"
                    request             : "<show><system><info></info></system></show>"
                    xsl_stmt            : "<xsl:value-of select=\"/response/result/system/sw-version\"/>"
                    regex               : ".*"
                    expect              : "^[\s]*11\..*"
                    info                : "This audit checks the testable Level 1 guidance in the CIS Palo Alto Firewall 11 benchmark document."
                    see_also            : "See HTH Policies and Standards"
        </custom_item>

        <custom_item>
                    type                : AUDIT_XML
                    description         : "Panorama model"
                    api_request_type    : "version"
                    request             : ""
                    xsl_stmt            : "<xsl:template match=\"/\"><xsl:value-of select=\"//model\"/>"
                    expect              : "Panorama"
                    info                : "This audit checks the testable Level 1 guidance in the CIS Palo Alto Firewall 11 benchmark document."
                    see_also            : "See HTH Policies and Standards"
        </custom_item>

        <custom_item>
                    type                : AUDIT_XML
                    description         : "Panorama system-mode"
                    api_request_type    : "op"
                    request             : "<show><system><info></info></system></show>"
                    xsl_stmt            : "<xsl:value-of select=\"//system-mode\"/>"
                    expect              : "(?i)Panorama(?-i)"
                    info                : "This audit checks the testable Level 1 guidance in the CIS Palo Alto Firewall 11 benchmark document."
                    see_also            : "See HTH Policies and Standards"
        </custom_item>

