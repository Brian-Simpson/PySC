#HTH Cisco IOS  Baseline

<check_type:"Cisco">

<if>
  <condition type:"AND">
    <item>
      type                : CONFIG_CHECK
      description         : "Check if Cisco IOS is installed"
      item                : "^version"
    </item>
  </condition>

  <then>
    <item>
      type                : CONFIG_CHECK
      description         : "1.0001 - NETIOS - Enable 'aaa new-model"
      info                : "This command enables the AAA access control system."
      reference           : "NIST 800-53r5|AC-2(1)"
      see_also            : "See HTH Policies and Standards"
      item                : "aaa new-model$"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0002 - NETIOS - Enable 'aaa authentication login"
      info                : "Sets authentication, authorization and accounting (AAA) authentication at login."
      reference           : "NIST 800-53r5|AC-2(1)"
      see_also            : "See HTH Policies and Standards"
      item                : "aaa authentication login"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0003 - NETIOS - Set 'login authentication for 'line vty"
      info                : "Authenticates users who access the router or switch remotely through the VTY port."
      reference           : "NIST 800-53r5|AC-2(1)"
      see_also            : "See HTH Policies and Standards"
      context             : "line vty .+"
      item                : "login authentication .+"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0004 - NETIOS - Set 'transport input ssh' for 'line vty' connections"
      info                : "Selects the Secure Shell (SSH) protocol."
      reference           : "NIST 800-53r5|IA-2(1)"
      see_also            : "See HTH Policies and Standards"
      context             : "line vty .+"
      item                : "transport input ssh$"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0005 - NETIOS - Set 'password' for 'enable secret"
      info                : "Enable secret password type 5 and enable secret password type 5 must be migrated to the stronger password type 8 or 9."
      reference           : "NIST 800-53r5|AC-6(2) AC-6(5)"
      see_also            : "See HTH Policies and Standards"
      item                : "enable secret [^ ]+"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0006 - NETIOS - Enable 'service password-encryption"
      info                : "When password encryption is enabled, the encrypted form of the passwords is displayed when a more system:running-config command is entered."
      reference           : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
      see_also            : "See HTH Policies and Standards"
      item                : "service password-encryption"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0007 - NETIOS - Set 'username secret' for all local users"
      info                : "Username secret password type 5 and enable secret password type 5 must be migrated to the stronger password type 8 or 9."
      reference           : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
      see_also            : "See HTH Policies and Standards"
      item                : "username [^ ]+"
      regex               : "username .+ secret [^ ]+"
    </item>

    <item>
      type                : CONFIG_CHECK_NOT
      description         : "1.0008 - NETIOS - Set 'no snmp-server' to disable SNMP when unused"
      info                : "If not in use, disable simple network management protocol (SNMP), read and write access."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "snmp-server community .+"
    </item>

    <item>
      type                : CONFIG_CHECK_NOT
      description         : "1.0009 - NETIOS - Unset 'private' for 'snmp-server community"
      info                : "An SNMP community string permits read-only access to all objects."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "snmp-server community private"
    </item>

    <item>
      type                : CONFIG_CHECK_NOT
      description         : "1.0010 - NETIOS - Unset 'public' for 'snmp-server community"
      info                : "An SNMP community string permits read-only access to all objects."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "snmp-server community public"
    </item>

    <item>
      type                : CONFIG_CHECK_NOT
      description         : "1.0011 - NETIOS - Do not set 'RW' for any 'snmp-server community"
      info                : "Specifies read-write access."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "snmp-server community .+ [Rr][Ww]"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0012 - NETIOS - Set 'snmp-server host' when using SNMP"
      info                : "SNMP notifications can be sent as traps to authorized management systems."
      reference           : "NIST 800-53r5|AC-17(3) SI-7"
      see_also            : "See HTH Policies and Standards"
      item                : "snmp-server host 192\.168\.0\.2 .+"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0013 - NETIOS - Set 'snmp-server enable traps snmp"
      info                : "SNMP notifications can be sent as traps to authorized management systems."
      reference           : "NIST 800-53r5|AC-17(3) SI-7"
      see_also            : "See HTH Policies and Standards"
      item                : "snmp-server enable traps"
      regex               : "^Manual Review Required$"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0014 - NETIOS - Set the 'ip domain-name"
      info                : "Define a default domain name that the Cisco IOS software uses to complete unqualified hostnames"
      reference           : "NIST 800-53r5|CM-6"
      see_also            : "See HTH Policies and Standards"
      item                : "ip domain(-| )name .+"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0015 - NETIOS - Set version 2 for 'ip ssh version"
      info                : "Specify the version of Secure Shell (SSH) to be run on a router"
      reference           : "NIST 800-53r5|CM-6"
      see_also            : "See HTH Policies and Standards"
      item                : "ip ssh version 2"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0016 - NETIOS - Set 'no cdp run"
      info                : "Disable Cisco Discovery Protocol (CDP) service at device level."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "no cdp run"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0017 - NETIOS - Set 'no service dhcp"
      info                : "Disable the Dynamic Host Configuration Protocol (DHCP) server and relay agent features on your router."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "no service dhcp"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0018 - NETIOS - Set 'service tcp-keepalives-in"
      info                : "Generate keepalive packets on idle incoming network connections."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "service tcp-keepalives-in"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0019 - NETIOS - Set 'service tcp-keepalives-out"
      info                : "Generate keepalive packets on idle outgoing network connections."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "service tcp-keepalives-out"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0020 - NETIOS - Set 'logging console critical"
      info                : "Verify logging to device console is enabled and limited to a rational severity level to avoid impacting system performance and management."
      reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also            : "See HTH Policies and Standards"
      item                : "logging console critical"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0021 - NETIOS - Set 'logging trap informational"
      info                : "Limit messages logged to the syslog servers based on severity level informational."
      reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also            : "See HTH Policies and Standards"
      item                : "logging trap .+"
      regex               : "logging trap (debugging|7|informational|6)"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0022 - NETIOS - Set 'service timestamps debug datetime"
      info                : "Configure the system to apply a time stamp to debugging messages or system logging messages"
      reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also            : "See HTH Policies and Standards"
      item                : "service timestamps debug datetime"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0023 - NETIOS - Set 'no ip source-route"
      info                : "Disable the handling of IP datagrams with source routing header options."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "no ip source-route"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0024 - NETIOS - Enable 'aaa new-model"
      info                : "This command enables the AAA access control system."
      reference           : "NIST 800-53r5|AC-2(1)"
      see_also            : "See HTH Policies and Standards"
      item                : "aaa new-model[ ]*$"
    </item>

