<check_type:"Cisco">

<if>
  <condition type:"AND">
    <item>
      type                : CONFIG_CHECK
      description         : "Check if Cisco IOS is installed"
      item                : "version 1[6-9]"
    </item>
  </condition>
  <then>
    <report type:"PASSED">
      description         : "CIS_Cisco_IOS_XE_16.x_v2.2.0_L1.audit from CIS Cisco IOS XE 16.x Benchmark v2.2.0"
      see_also            : "See HTH Policies and Standards"
      show_output         : YES
    </report>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0001 - NETIOS - Enable 'aaa new-model"
      info                : "This command enables the AAA access control system."
      reference           : "NIST 800-53r5|AC-2(1)"
      see_also            : "See HTH Policies and Standards"
      item                : "aaa new-model$"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0002 - NETIOS - Enable 'aaa authentication login"
      info                : "Sets authentication, authorization and accounting (AAA) authentication at login."
      reference           : "NIST 800-53r5|AC-2(1)"
      see_also            : "See HTH Policies and Standards"
      item                : "aaa authentication login"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0003 - NETIOS - Enable 'aaa authentication enable default"
      info                : "Authenticates users who access privileged EXEC mode when they use the enable command."
      reference           : "NIST 800-53r5|AC-2(1)"
      see_also            : "See HTH Policies and Standards"
      item                : "aaa authentication enable default"
    </item>

        <item>
          type            : CONFIG_CHECK
          description     : "1.0004 - NETIOS - Set 'login authentication for 'line vty"
          info            : "Authenticates users who access the router or switch remotely through the VTY port."
          reference       : "NIST 800-53r5|AC-2(1)"
          see_also        : "See HTH Policies and Standards"
          context         : "line vty .+"
          item            : "login authentication .+"
        </item>


    <item>
      type                : CONFIG_CHECK_NOT
      description         : "1.0005 - NETIOS - Set 'privilege 1' for local users"
      info                : "Sets the privilege level for the user."
      reference           : "NIST 800-53r5|IA-2(2) IA-5(1)"
      see_also            : "See HTH Policies and Standards"
      item                : "username .+ privilege ([2-9]|1[0-5])"
    </item>

        <item>
          type            : CONFIG_CHECK
          description     : "1.0006 - NETIOS - Set 'http Secure-server' limit"
          info            : "Device management includes the ability to control the number of administrators and management sessions that manage a device."
          reference       : "NIST 800-53r5|AC-10"
          see_also        : "See HTH Policies and Standards"
          item            : "ip http max-connections 2"
        </item>

        <item>
          type            : CONFIG_CHECK
          description     : "1.0007 - NETIOS - Set 'exec-timeout' to less than or equal to 10 min on 'ip http"
          info            : "If no input is detected during the interval, the EXEC facility resumes the current connection."
          reference       : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
          see_also        : "See HTH Policies and Standards"
          item            : "ip http timeout-policy idle ([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600) life .+ requests .+"
        </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0008 - NETIOS - Set 'transport input ssh' for 'line vty' connections"
      info                : "Selects the Secure Shell (SSH) protocol."
      reference           : "NIST 800-53r5|IA-2(1)"
      see_also            : "See HTH Policies and Standards"
      context             : "line vty .+"
      item                : "transport input ssh$"
    </item>

        <item>
          type            : CONFIG_CHECK
          description     : "1.0009 - NETIOS - Set 'no exec' for 'line aux 0"
          info            : "The 'no exec' command restricts a line to outgoing connections only."
          reference       : "NIST 800-53r5|CM-7"
          see_also        : "See HTH Policies and Standards"
          context         : "line aux .+"
          item            : "no exec"
        </item>


    <item>
      type                : CONFIG_CHECK
      description         : "1.0010 - NETIOS - Set 'access-class' for 'line vty"
      info                : "The 'access-class' setting restricts incoming and outgoing connections between a particular vty (into a Cisco device) and the networking devices associated with addresses in an access list."
      reference           : "NIST 800-53r5|AC-17(3) SI-7"
      see_also            : "See HTH Policies and Standards"
      context             : "line vty .+"
      item                : "access-class 100 in"
    </item>




        <item>
          type            : CONFIG_CHECK_NOT
          description     : "1.0011 - NETIOS - Set 'transport input none' for 'line aux 0"
          info            : "When you want to allow only an outgoing connection on a line, use the no exec command."
          reference       : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
          see_also        : "See HTH Policies and Standards"
          context         : "line aux .+"
          item            : "transport input (all|ssh|telnet)$"
        </item>

    <item>
      type                : BANNER_CHECK
      description         : "1.0012 - NETIOS - Set the 'banner-text' for 'banner exec"
      info                : "This command specifies a message to be displayed when an EXEC process is created (a line is activated, or an incoming connection is made to a vty)."
      reference           : "NIST 800-53r5|AT-1 AT-2 PM-13"
      see_also            : "See HTH Policies and Standards"
      item                : "banner exec"
      content             : "All unauthorized activity is monitored and logged."
    </item>

    <item>
      type                : BANNER_CHECK
      description         : "1.0013 - NETIOS - Set the 'banner-text' for 'banner login"
      info                : "Follow the banner login command with one or more blank spaces and a delimiting character of your choice."
      reference           : "NIST 800-53r5|AT-1 AT-2 PM-13"
      see_also            : "See HTH Policies and Standards"
      item                : "banner login"
      content             : "All unauthorized activity is monitored and logged."
    </item>

    <item>
      type                : BANNER_CHECK
      description         : "1.0014 - NETIOS - Set the 'banner-text' for 'banner motd"
      info                : "This MOTD banner is displayed to all terminals connected and is useful for sending messages that affect all users (such as impending system shutdowns)."
      reference           : "NIST 800-53r5|AT-1 AT-2 PM-13"
      see_also            : "See HTH Policies and Standards"
      item                : "banner motd"
      content             : "All unauthorized activity is monitored and logged."
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0015 - NETIOS - Set the 'banner-text' for 'webauth banner"
      info                : "This banner is displayed to all terminals connected and is useful for sending messages that affect all users (such as impending system shutdowns)."
      reference           : "NIST 800-53r5|AT-1 AT-2 PM-13"
      see_also            : "See HTH Policies and Standards"
      item                : "ip admission auth-proxy-banner http .+"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0016 - NETIOS - Set 'password' for 'enable secret"
      info                : "Enable secret password type 5 and enable secret password type 5 must be migrated to the stronger password type 8 or 9."
      reference           : "NIST 800-53r5|AC-6(2) AC-6(5)"
      see_also            : "See HTH Policies and Standards"
      item                : "enable secret [^ ]+"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0017 - NETIOS - Enable 'service password-encryption"
      info                : "When password encryption is enabled, the encrypted form of the passwords is displayed when a more system:running-config command is entered."
      reference           : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
      see_also            : "See HTH Policies and Standards"
      item                : "service password-encryption"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0018 - NETIOS - Set 'username secret' for all local users"
      info                : "Username secret password type 5 and enable secret password type 5 must be migrated to the stronger password type 8 or 9."
      reference           : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
      see_also            : "See HTH Policies and Standards"
      item                : "username [^ ]+"
      regex               : "username .+ secret [^ ]+"
    </item>

    <item>
      type                : CONFIG_CHECK_NOT
      description         : "1.0019 - NETIOS - Set 'no snmp-server' to disable SNMP when unused"
      info                : "If not in use, disable simple network management protocol (SNMP), read and write access."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "snmp-server community .+"
    </item>

        <item>
          type            : CONFIG_CHECK_NOT
          description     : "1.0020 - NETIOS - Unset 'private' for 'snmp-server community"
          info            : "An SNMP community string permits read-only access to all objects."
          reference       : "NIST 800-53r5|CM-7"
          see_also        : "See HTH Policies and Standards"
          item            : "snmp-server community private"
        </item>

        <item>
          type            : CONFIG_CHECK_NOT
          description     : "1.0021 - NETIOS - Unset 'public' for 'snmp-server community"
          info            : "An SNMP community string permits read-only access to all objects."
          reference       : "NIST 800-53r5|CM-7"
          see_also        : "See HTH Policies and Standards"
          item            : "snmp-server community public"
        </item>

        <item>
          type            : CONFIG_CHECK_NOT
          description     : "1.0022 - NETIOS - Do not set 'RW' for any 'snmp-server community"
          info            : "Specifies read-write access."
          reference       : "NIST 800-53r5|CM-7"
          see_also        : "See HTH Policies and Standards"
          item            : "snmp-server community .+ [Rr][Ww]"
        </item>

        <item>
          type            : CONFIG_CHECK
          description     : "1.0023 - NETIOS - Set the ACL for each 'snmp-server community"
          info            : "This feature specifies a list of IP addresses that are allowed to use the community string to gain access to the SNMP agent."
          reference       : "NIST 800-53r5|AC-17(3) SI-7"
          see_also        : "See HTH Policies and Standards"
          item            : "snmp-server community .+ .+"
          regex           : "snmp-server community .+ .+ 1$"
        </item>


        <item>
          type            : CONFIG_CHECK
          description     : "1.0024 - NETIOS - Set 'snmp-server host' when using SNMP"
          info            : "SNMP notifications can be sent as traps to authorized management systems."
          reference       : "NIST 800-53r5|AC-17(3) SI-7"
          see_also        : "See HTH Policies and Standards"
          item            : "snmp-server host 192\.168\.0\.2 .+"
        </item>

        <item>
          type            : CONFIG_CHECK
          description     : "1.0025 - NETIOS - Set 'snmp-server enable traps snmp"
          info            : "SNMP notifications can be sent as traps to authorized management systems."
          reference       : "NIST 800-53r5|AC-17(3) SI-7"
          see_also        : "See HTH Policies and Standards"
          item            : "snmp-server enable traps"
          regex           : "^Manual Review Required$"
        </item>

    <item>
      type                : CONFIG_CHECK_NOT
      description         : "1.0026 - NETIOS - Set the 'hostname"
      info                : "The hostname is used in prompts and default configuration filenames."
      reference           : "NIST 800-53r5|CM-6"
      see_also            : "See HTH Policies and Standards"
      item                : "hostname .+"
      regex               : "hostname Router$"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0027 - NETIOS - Set the 'ip domain-name"
      info                : "Define a default domain name that the Cisco IOS software uses to complete unqualified hostnames"
      reference           : "NIST 800-53r5|CM-6"
      see_also            : "See HTH Policies and Standards"
      item                : "ip domain(-| )name .+"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0028 - NETIOS - Set 'modulus' to greater than or equal to 2048 for 'crypto key generate rsa"
      info                : "Use this command to generate RSA key pairs for your Cisco device."
      reference           : "NIST 800-53r5|SA-15"
      see_also            : "See HTH Policies and Standards"
      item                : ".*"
      regex               : "^Manual Review Required$"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0029 - NETIOS - Set 'seconds' for 'ip ssh timeout' for 60 seconds or less"
      info                : "The time interval that the router waits for the SSH client to respond before disconnecting an uncompleted login attempt."
      reference           : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
      see_also            : "See HTH Policies and Standards"
      item                : "ip ssh time-out"
      regex               : "ip ssh time-out ([1-9]|[1-5][0-9]|60)$"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0030 - NETIOS - Set maximum value for 'ip ssh authentication-retries"
      info                : "The number of retries before the SSH login session disconnects."
      reference           : "NIST 800-53r5|IA-2(1)"
      see_also            : "See HTH Policies and Standards"
      item                : "Authentication timeout: .* secs; Authentication retries: [1-3]"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0031 - NETIOS - Set version 2 for 'ip ssh version"
      info                : "Specify the version of Secure Shell (SSH) to be run on a router"
      reference           : "NIST 800-53r5|CM-6"
      see_also            : "See HTH Policies and Standards"
      item                : "ip ssh version 2"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0032 - NETIOS - Set 'no cdp run"
      info                : "Disable Cisco Discovery Protocol (CDP) service at device level."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "no cdp run"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0033 - NETIOS - Set 'no ip bootp server"
      info                : "Disable the Bootstrap Protocol (BOOTP) service on your routing device."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "no ip bootp server"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0034 - NETIOS - Set 'no service dhcp"
      info                : "Disable the Dynamic Host Configuration Protocol (DHCP) server and relay agent features on your router."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "no service dhcp"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0035 - NETIOS - Set 'service tcp-keepalives-in"
      info                : "Generate keepalive packets on idle incoming network connections."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "service tcp-keepalives-in"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0036 - NETIOS - Set 'service tcp-keepalives-out"
      info                : "Generate keepalive packets on idle outgoing network connections."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "service tcp-keepalives-out"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0037 - NETIOS - Set 'no service pad"
      info                : "Disable X."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "no service pad"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0038 - NETIOS - Set 'logging enable"
      info                : "Enable logging of system messages."
      reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also            : "See HTH Policies and Standards"
      item                : "logging host"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0039 - NETIOS - Set 'buffer size' for 'logging buffered"
      info                : "Enable system message logging to a local buffer."
      reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also            : "See HTH Policies and Standards"
      item                : "logging buffered"
      regex               : "logging buffered 64000( *|$)"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0040 - NETIOS - Set 'logging console critical"
      info                : "Verify logging to device console is enabled and limited to a rational severity level to avoid impacting system performance and management."
      reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also            : "See HTH Policies and Standards"
      item                : "logging console critical"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0041 - NETIOS - Set IP address for 'logging host"
      info                : "Log system messages and debug output to a remote host."
      reference           : "NIST 800-53r5|AU-6(1) AU-7 IR-4(1) SI-4 SI-4(2) SI-4(5)"
      see_also            : "See HTH Policies and Standards"
      item                : "logging host 192\.168\.2\.1"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0042 - NETIOS - Set 'logging trap informational"
      info                : "Limit messages logged to the syslog servers based on severity level informational."
      reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also            : "See HTH Policies and Standards"
      item                : "logging trap .+"
      regex               : "logging trap (debugging|7|informational|6)"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0043 - NETIOS - Set 'service timestamps debug datetime"
      info                : "Configure the system to apply a time stamp to debugging messages or system logging messages"
      reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also            : "See HTH Policies and Standards"
      item                : "service timestamps debug datetime"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0044 - NETIOS - Set 'logging source interface"
      info                : "Specify the source IPv4 or IPv6 address of system logging packets"
      reference           : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
      see_also            : "See HTH Policies and Standards"
      item                : "logging source-interface .+"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0045 - NETIOS - Set 'ip address' for 'ntp server"
      info                : "Use this command if you want to allow the system to synchronize the system software clock with the specified NTP server."
      reference           : "NIST 800-53r5|AU-7 AU-8"
      see_also            : "See HTH Policies and Standards"
      item                : "ntp server 192\.168\.3\.1"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0046 - NETIOS - Set 'no ip source-route"
      info                : "Disable the handling of IP datagrams with source routing header options."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "no ip source-route"
    </item>

    <item>
      type                : CONFIG_CHECK_NOT
      description         : "1.0047 - NETIOS - Set 'no interface tunnel"
      info                : "Verify no tunnel interfaces are defined."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      item                : "interface [Tt]unnel[0-9]+"
    </item>

    <item>
      type                : CONFIG_CHECK
      description         : "1.0048 - NETIOS - Set 'ip verify unicast source reachable-via"
      info                : "Examines incoming packets to determine whether the source address is in the Forwarding Information Base (FIB) and permits the packet only if the source is reachable through the interface on which the packet was received (sometimes referred to as strict mode)."
      reference           : "NIST 800-53r5|CM-7"
      see_also            : "See HTH Policies and Standards"
      context             : "interface .+"
      item                : "ip verify unicast"
      regex               : "ip verify unicast source reachable-via"
    </item>

        <item>
          type            : CONFIG_CHECK
          description     : "1.0049 - NETIOS - Set 'authentication mode md5"
          info            : "Configure authentication to prevent unapproved sources from introducing unauthorized or false service messages."
          reference       : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
          see_also        : "See HTH Policies and Standards"
          context         : "router eigrp .+"
          item            : "authentication mode md5"
        </item>
  </then>

