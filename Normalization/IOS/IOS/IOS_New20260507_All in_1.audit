#HTH Cisco IOS  Baseline

<check_type:"Cisco">

  <if>
    <condition type:"AND">
      <item>
        type         : CONFIG_CHECK
        description  : "Check if Cisco IOS is installed"
        item         : "^version"
      </item>
    </condition>

    <then>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0001 - NETIOS - Enable 'aaa authentication login"
        info         : "Sets authentication, authorization and accounting (AAA) authentication at login."
        reference    : "NIST 800-53r5|AC-2(1)"
        see_also     : "See HTH Policies and Standards"
        item         : "^aaa authentication enable .+"
        required     : YES
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0002 - NETIOS - Set 'login authentication for 'line vty"
        info         : "Authenticates users who access the router or switch remotely through the VTY port."
        reference    : "NIST 800-53r5|AC-2(1)"
        see_also     : "See HTH Policies and Standards"
        context      : "line vty .+"
        item         : "login( authentication [A-Za-z0-9_-]+)?|no login"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0003 - NETIOS - Set 'login authentication for 'line tty"
        info         : "Authenticates users who access the router or switch remotely through the VTY port."
        reference    : "NIST 800-53r5|AC-2(1)"
        see_also     : "See HTH Policies and Standards"
        context      : "line tty .+"
        item         : "^login authentication .+"
        required     : NO
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0004 - NETIOS - Authentication - line con 0"
        info         : "Authenticates users who access the router or switch using the serial console port."
        reference    : "NIST 800-53r5|AC-2(1)"
        see_also     : "See cooresponding HTH Standards and Policies"
        context      : "line con 0"
        item         : "^no login$"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0005 - NETIOS - Set 'transport input ssh' for 'line vty' connections"
        info         : "Selects the Secure Shell (SSH) protocol."
        reference    : "NIST 800-53r5|IA-2(1)"
        see_also     : "See HTH Policies and Standards"
        context      : "line vty .+"
        item         : "transport input ssh$"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0006 - NETIOS - Set 'password' for 'enable secret"
        info         : "Enable secret password type 5 and enable secret password type 5 must be migrated to the stronger password type 8 or 9."
        reference    : "NIST 800-53r5|AC-6(2) AC-6(5)"
        see_also     : "See HTH Policies and Standards"
        item         : "enable secret [^ ]+"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0007 - NETIOS - Enable 'service password-encryption"
        info         : "When password encryption is enabled, the encrypted form of the passwords is displayed when a more system:running-config command is entered."
        reference    : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
        see_also     : "See HTH Policies and Standards"
        item         : "service password-encryption"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0008 - NETIOS - Set 'username secret' for all local users"
        info         : "Username secret password type 5 and enable secret password type 5 must be migrated to the stronger password type 8 or 9."
        reference    : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
        see_also     : "See HTH Policies and Standards"
        item         : "username [^ ]+"
        regex        : "username .+ secret [^ ]+"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0009 - NETIOS - Enable 'aaa new-model"
        info         : "This command enables the AAA access control system."
        reference    : "NIST 800-53r5|AC-2(1)"
        see_also     : "See HTH Policies and Standards"
        item         : "^aaa new-model$"
        required     : YES
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0010 - NETIOS - Enable 'aaa authentication enable default"
        info         : "Authenticates users who access privileged EXEC mode when they use the enable command."
        reference    : "NIST 800-53r5|AC-2(1)"
        see_also     : "See HTH Policies and Standards"
        item         : "^aaa authentication login .+"
        required     : YES
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0011 - NETIOS - Set 'privilege 1' Local users must not have privileged access"
        info         : "Local accounts must not be assigned elevated privilege levels."
        reference    : "NIST 800-53r5|IA-2(2) IA-5(1)"
        see_also     : "See HTH Policies and Standards"
        item         : "^username\s+\S+\s+privilege\s+[2-9][0-9]?\s+secret\s+(5|8|9)\s+"
      </item>

      <item>
        type         : BANNER_CHECK
        description  : "1.0012 - NETIOS - Set the 'banner-text' for 'banner exec"
        info         : "This command specifies a message to be displayed when an EXEC process is created (a line is activated, or an incoming connection is made to a vty)."
        reference    : "NIST 800-53r5|AT-1 AT-2 PM-13"
        see_also     : "See HTH Policies and Standards"
        item         : "banner exec"
        content      : "!! WARNING !!"
        is_substring : YES
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0013 - NETIOS - Set 'exec-timeout' to less than or equal to 10 minutes for 'line aux 0"
        info         : "If no input is detected during the interval, the EXEC facility resumes the current connection."
        reference    : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
        see_also     : "See HTH Policies and Standards"
        context      : "line aux 0"
        item         : "exec-timeout (10|[1-9])$"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0014 - NETIOS - Set 'exec-timeout' to less than or equal to 10 minutes 'line console 0'"
        info         : "If no input is detected during the interval, the EXEC facility resumes the current connection. If no connections exist, the EXEC facility returns the terminal to the idle state and disconnects the incoming session."
        reference    : "NIST 800-53r5|AC-12"
        see_also     : "See HTH Policies and Standards"
        context      : "line con 0"
        item         : "exec-timeout (1[6-9]|[2-9][0-9])"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0015 - NETIOS - Set 'exec-timeout' to less than or equal to 10 minutes 'line vty'"
        info         : "If no input is detected during the interval, the EXEC facility resumes the current connection. If no connections exist, the EXEC facility returns the terminal to the idle state and disconnects the incoming session."
        reference    : "NIST 800-53r5|AC-12"
        see_also     : "See HTH Policies and Standards"
        context      : "line vty .+"
        item         : "exec-timeout (1[6-9]|[2-9][0-9])"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0016 - NETIOS - Set 'exec-timeout' less than or equal to 10 minutes 'line tty'"
        info         : "If no input is detected during the interval, the EXEC facility resumes the current connection. If no connections exist, the EXEC facility returns the terminal to the idle state and disconnects the incoming session."
        reference    : "NIST 800-53r5|AC-12 CN-L3(1)"
        see_also     : "See HTH Policies and Standards"
        context      : "line tty .+"
        item         : "exec-timeout (1[6-9]|[2-9][0-9])"
      </item>

      <item>
        type         : BANNER_CHECK
        description  : "1.0017 - NETIOS - Banner - Enabled"
        info         : "Follow the banner login command with one or more blank spaces and a delimiting character of your choice."
        reference    : "NIST 800-53r5|AC-2"
        see_also     : "See cooresponding HTH Standards and Policies"
        item         : "banner login"
        content      : "!! WARNING !!"
        is_substring : YES
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0018 - NETIOS - Ensure NTP Server Configured"
        info         : ""
        reference    : "NIST 800-53|AU-7 AU-8"
        see_also     : "HTH"
        regex        : "^(sntp|ntp)[\\s]+server([\\s]+vrf[\\s]+[a-zA-Z0-9_\\-]+)?[\\s]*10.248.232.10.*$"
        item         : "^(sntp|ntp) server.*10.248.232.10"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0019 - NETIOS - Ensure NTP Server Configured (2nd)"
        info         : "Check to confirm 10.248.232.210 was configured."
        reference    : "NIST 800-53|AU-7 AU-8"
        see_also     : "HTH"
        regex        : "^(sntp|ntp)[\\s]+server([\\s]+vrf[\\s]+[a-zA-Z0-9_\\-]+)?[\\s]*10.248.232.210.*$"
        item         : "^(sntp|ntp) server.*10.248.232.210"
      </item>

##### checks are commented out for now, but may be added back in the future if needed.
      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0020 - NETIOS - Set 'no snmp-server' to disable SNMP when unused"
        info         : "If not in use, disable simple network management protocol (SNMP), read and write access."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "See HTH Policies and Standards"
        item         : "snmp-server community .+"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0021 - NETIOS - Unset 'private' for 'snmp-server community"
        info         : "An SNMP community string permits read-only access to all objects."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "See HTH Policies and Standards"
        item         : "snmp-server community private"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0022 - NETIOS - Unset 'public' for 'snmp-server community"
        info         : "An SNMP community string permits read-only access to all objects."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "See HTH Policies and Standards"
        item         : "snmp-server community public"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0023 - NETIOS - Do not set 'RW' for any 'snmp-server community"
        info         : "Specifies read-write access."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "See HTH Policies and Standards"
        item         : "snmp-server community .+ [Rr][Ww]"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0024 - NETIOS - SNMP must not be enabled without a configured host"
        info         : "Fails only if SNMP is configured but no snmp-server host is defined."
        reference    : "NIST 800-53r5|AC-17(3) SI-7"
        see_also     : "See HTH Policies and Standards"
        item         : "snmp-server (community|group|user)"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0025 - NETIOS - SNMP must not be enabled without traps"
        info         : "Fails only if SNMP is configured and traps are not enabled."
        reference    : "NIST 800-53r5|AC-17(3) SI-7"
        see_also     : "HTH Policies and Standards"
        item         : "snmp-server (community|group|user)(?!.*snmp-server enable traps)"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0026 - NETIOS - Set the 'ip domain-name"
        info         : "Define a default domain name that the Cisco IOS software uses to complete unqualified hostnames"
        reference    : "NIST 800-53r5|CM-6"
        see_also     : "See HTH Policies and Standards"
        item         : "ip domain(-| )name .+"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0027 - NETIOS - Set version 2 for 'ip ssh version"
        info         : "Specify the version of Secure Shell (SSH) to be run on a router"
        reference    : "NIST 800-53r5|CM-6"
        see_also     : "See HTH Policies and Standards"
        item         : "ip ssh version 2"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0028 - NETIOS - CDP must be disabled globally"
        info         : "Fails only if CDP is enabled."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "HTH Policies and Standards"
        item         : "^cdp run$"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0029 - NETIOS - CDP must not be enabled on any interface (interface-level)"
        info         : "Fails only if CDP is enabled at the interface level or enabled manually."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "HTH Policies and Standards"
        item         : "^cdp enable$"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0030 - NETIOS - DHCP service must be disabled"
        info         : "Disable the Dynamic Host Configuration Protocol (DHCP) server and relay agent features on your router. Fails only if DHCP services are enabled on the device."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "See HTH Policies and Standards"
        item         : "^service dhcp$"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0031 - NETIOS - Set 'service tcp-keepalives-in"
        info         : "Generate keepalive packets on idle incoming network connections."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "See HTH Policies and Standards"
        item         : "service tcp-keepalives-in"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0032 - NETIOS - Set 'service tcp-keepalives-out"
        info         : "Generate keepalive packets on idle outgoing network connections."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "See HTH Policies and Standards"
        item         : "service tcp-keepalives-out"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0033 - NETIOS - Console logging must not exceed critical severity level"
        info         : "Verify logging to device console is enabled and limited to a rational severity level to avoid impacting system performance and management."
        reference    : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        see_also     : "See HTH Policies and Standards"
        item         : "logging console (debugging|informational|notifications|warnings)"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0034 - NETIOS - Set 'logging trap informational"
        info         : "Limit messages logged to the syslog servers based on severity level informational."
        reference    : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        see_also     : "See HTH Policies and Standards"
        item         : "logging trap .+"
        regex        : "logging trap (debugging|7|informational|6)"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0035 - NETIOS - Timestamps must be enabled for debug messages"
        info         : "Configure the system to apply a time stamp to debugging messages or system logging messages"
        reference    : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        see_also     : "See HTH Policies and Standards"
        item         : "service timestamps debug datetime"
        regex        : "service timestamps debug datetime( .+)?"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0036 - NETIOS - Set 'no ip source-route"
        info         : "Disable the handling of IP datagrams with source routing header options."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "See HTH Policies and Standards"
        item         : "no ip source-route"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0037 - NETIOS - Set 'http Secure-server' limit"
        info         : "Device management includes the ability to control the number of administrators and management sessions that manage a device."
        reference    : "NIST 800-53r5|AC-10"
        see_also     : "See HTH Policies and Standards"
        item         : "ip http max-connections 2"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0038 - NETIOS - Set 'exec-timeout' to less than or equal to 10 min on 'ip http"
        info         : "If no input is detected during the interval, the EXEC facility resumes the current connection."
        reference    : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
        see_also     : "See HTH Policies and Standards"
        item         : "ip http timeout-policy idle ([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600) life .+ requests .+"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0039 - NETIOS - Set 'no exec' for 'line aux 0"
        info         : "The 'no exec' command restricts a line to outgoing connections only."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "See HTH Policies and Standards"
        context      : "line aux .+"
        item         : "no exec"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0040 - NETIOS - Set 'access-class' for 'line vty"
        info         : "The 'access-class' setting restricts incoming and outgoing connections between a particular vty (into a Cisco device) and the networking devices associated with addresses in an access list."
        reference    : "NIST 800-53r5|AC-17(3) SI-7"
        see_also     : "See HTH Policies and Standards"
        context      : "line vty .+"
        item         : "access-class 100 in"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0041 - NETIOS - Set 'transport input none' for 'line aux 0"
        info         : "When you want to allow only an outgoing connection on a line, use the no exec command."
        reference    : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
        see_also     : "See HTH Policies and Standards"
        context      : "line aux .+"
        item         : "transport input (all|ssh|telnet)$"
      </item>

      <item>
        type         : BANNER_CHECK
        description  : "1.0042 - NETIOS - Set the 'banner-text' for 'banner login"
        info         : "Follow the banner login command with one or more blank spaces and a delimiting character of your choice."
        reference    : "NIST 800-53r5|AT-1 AT-2 PM-13"
        see_also     : "See HTH Policies and Standards"
        item         : "banner login"
        content      : "All unauthorized activity is monitored and logged."
      </item>

      <item>
        type         : BANNER_CHECK
        description  : "1.0043 - NETIOS - Set the 'banner-text' for 'banner motd"
        info         : "This MOTD banner is displayed to all terminals connected and is useful for sending messages that affect all users (such as impending system shutdowns)."
        reference    : "NIST 800-53r5|AT-1 AT-2 PM-13"
        see_also     : "See HTH Policies and Standards"
        item         : "banner motd"
        content      : "All unauthorized activity is monitored and logged."
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0044 - NETIOS - Set the 'banner-text' for 'webauth banner"
        info         : "This banner is displayed to all terminals connected and is useful for sending messages that affect all users (such as impending system shutdowns)."
        reference    : "NIST 800-53r5|AT-1 AT-2 PM-13"
        see_also     : "See HTH Policies and Standards"
        item         : "ip admission auth-proxy-banner http .+"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0045 - NETIOS - Set the ACL for each 'snmp-server community"
        info         : "This feature specifies a list of IP addresses that are allowed to use the community string to gain access to the SNMP agent."
        reference    : "NIST 800-53r5|AC-17(3) SI-7"
        see_also     : "See HTH Policies and Standards"
        item         : "snmp-server community .+ .+"
        regex        : "snmp-server community .+ .+ 1$"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0046 - NETIOS - Set the 'hostname"
        info         : "The hostname is used in prompts and default configuration filenames."
        reference    : "NIST 800-53r5|CM-6"
        see_also     : "See HTH Policies and Standards"
        item         : "hostname .+"
        regex        : "hostname Router$"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0047 - NETIOS - Set 'modulus' to greater than or equal to 2048 for 'crypto key generate rsa"
        info         : "Use this command to generate RSA key pairs for your Cisco device."
        reference    : "NIST 800-53r5|SA-15"
        see_also     : "See HTH Policies and Standards"
        item         : ".*"
        regex        : "^Manual Review Required$"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0048 - NETIOS - Set 'seconds' for 'ip ssh timeout' for 60 seconds or less"
        info         : "The time interval that the router waits for the SSH client to respond before disconnecting an uncompleted login attempt."
        reference    : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) AC-12"
        see_also     : "See HTH Policies and Standards"
        item         : "ip ssh time-out"
        regex        : "ip ssh time-out ([1-9]|[1-5][0-9]|60)$"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0049 - NETIOS - Set maximum value for 'ip ssh authentication-retries"
        info         : "The number of retries before the SSH login session disconnects."
        reference    : "NIST 800-53r5|IA-2(1)"
        see_also     : "See HTH Policies and Standards"
        item         : "Authentication timeout: .* secs; Authentication retries: [1-3]"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0050 - NETIOS - Set 'no ip bootp server"
        info         : "Disable the Bootstrap Protocol (BOOTP) service on your routing device."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "See HTH Policies and Standards"
        item         : "no ip bootp server"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0051 - NETIOS - Set 'no service pad"
        info         : "Disable X."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "See HTH Policies and Standards"
        item         : "no service pad"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0052 - NETIOS - Set 'logging enable"
        info         : "Enable logging of system messages."
        reference    : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        see_also     : "See HTH Policies and Standards"
        item         : "logging host"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0053 - NETIOS - Set 'buffer size' for 'logging buffered"
        info         : "Enable system message logging to a local buffer."
        reference    : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        see_also     : "See HTH Policies and Standards"
        item         : "logging buffered"
        regex        : "logging buffered 64000( *|$)"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0054 - NETIOS - Set IP address for 'logging host"
        info         : "Log system messages and debug output to a remote host."
        reference    : "NIST 800-53r5|AU-6(1) AU-7 IR-4(1) SI-4 SI-4(2) SI-4(5)"
        see_also     : "See HTH Policies and Standards"
        item         : "logging host 192\.168\.2\.1"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0055 - NETIOS - Set 'logging source interface"
        info         : "Specify the source IPv4 or IPv6 address of system logging packets"
        reference    : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        see_also     : "See HTH Policies and Standards"
        item         : "logging source-interface .+"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0056 - NETIOS - Set 'no interface tunnel"
        info         : "Verify no tunnel interfaces are defined."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "See HTH Policies and Standards"
        item         : "interface [Tt]unnel[0-9]+"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0057 - NETIOS - Set 'ip verify unicast source reachable-via"
        info         : "Examines incoming packets to determine whether the source address is in the Forwarding Information Base (FIB) and permits the packet only if the source is reachable through the interface on which the packet was received (sometimes referred to as strict mode)."
        reference    : "NIST 800-53r5|CM-7"
        see_also     : "See HTH Policies and Standards"
        context      : "interface .+"
        item         : "ip verify unicast"
        regex        : "ip verify unicast source reachable-via"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0058 - NETIOS - Set 'authentication mode md5"
        info         : "Configure authentication to prevent unapproved sources from introducing unauthorized or false service messages."
        reference    : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
        see_also     : "See HTH Policies and Standards"
        context      : "router eigrp .+"
        item         : "authentication mode md5"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0059 - NETIOS - Set 'aaa accounting system"
        info         : "Performs accounting for all system-level events not associated with users, such as reloads."
        reference    : "NIST 800-53r5|AU-2 AU-3 AU-3(1) AU-7 AU-12"
        see_also     : "See HTH Policies and Standards"
        item         : "aaa accounting system [^ ]+"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0060 - NETIOS - Set 'login authentication for 'ip http"
        info         : "If account management functions are not automatically enforced, an attacker could gain privileged access to a vital element of the network security architecture"
        reference    : "NIST 800-53r5|AC-2(1)"
        see_also     : "See HTH Policies and Standards"
        item         : "^[ ]*ip http authentication (local|aaa_list_name)"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0061 - NETIOS - Set 'aaa accounting' to log all privileged use commands using 'commands 15"
        info         : "Runs accounting for all commands at the specified privilege level."
        reference    : "NIST 800-53r5|AU-2 AU-3 AU-3(1) AU-7 AU-12"
        see_also     : "See HTH Policies and Standards"
        item         : "aaa accounting commands 15 [^ ]+"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0062 - NETIOS - Set 'aaa accounting connection"
        info         : "Provides information about all outbound connections made from the network access server."
        reference    : "NIST 800-53r5|AC-2(1)"
        see_also     : "See HTH Policies and Standards"
        item         : "aaa accounting connection [^ ]+"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0063 - NETIOS - Set 'aaa accounting exec"
        info         : "Runs accounting for the EXEC shell session."
        reference    : "NIST 800-53r5|AU-2 AU-3 AU-3(1) AU-7 AU-12"
        see_also     : "See HTH Policies and Standards"
        item         : "aaa accounting exec [^ ]+"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0064 - NETIOS - Set 'aaa accounting network"
        info         : "Runs accounting for all network-related service requests."
        reference    : "NIST 800-53r5|AU-2 AU-3 AU-3(1) AU-7 AU-12"
        see_also     : "See HTH Policies and Standards"
        item         : "aaa accounting network [^ ]+"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0065 - NETIOS - Set 'exec-timeout' to less than or equal to 10 min on 'ip http"
        info         : "If no input is detected during the interval, the EXEC facility resumes the current connection."
        reference    : "NIST 800-53r5|SC-10"
        see_also     : "See HTH Policies and Standards"
        item         : "^[ ]*ip http timeout-policy"
        regex        : "^[ ]*ip http timeout-policy idle ([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600) life .+ requests .+"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0066 - NETIOS - Set 'http Secure-server' limit"
        info         : "Device management includes the ability to control the number of administrators and management sessions that manage a device."
        reference    : "NIST 800-53r5|AC-10"
        see_also     : "See HTH Policies and Standards"
        item         : "^[ ]*ip http max-connections 2"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0067 - NETIOS - Set the 'banner-text' for 'webauth banner"
        info         : "This banner is displayed to all terminals connected and is useful for sending messages that affect all users (such as impending system shutdowns)."
        reference    : "NIST 800-53r5|AT-1 AT-2 PM-13"
        see_also     : "See HTH Policies and Standards"
        item         : "^[ ]*ip admission auth-proxy-banner http .+"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0068 - NETIOS - Require 'aes 128' as minimum for 'snmp-server user' when using SNMPv3"
        info         : "Specify the use of a minimum of 128-bit AES algorithm for encryption when using SNMPv3."
        reference    : "NIST 800-53r5|IA-2(1)"
        see_also     : "See HTH Policies and Standards"
        item         : "Privacy Protocol: AES128"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0069 - NETIOS - Set 'priv' for each 'snmp-server group' using SNMPv3"
        info         : "Specifies authentication of a packet with encryption when using SNMPv3"
        reference    : "NIST 800-53r5|IA-2(1)"
        see_also     : "See HTH Policies and Standards"
        item         : "snmp-server group .+ v3"
        regex        : "snmp-server group .+ v3 priv"
      </item>

      <item>
        type         : CONFIG_CHECK_NOT
        description  : "1.0070 - NETIOS - Set maximum value for 'ip ssh authentication-retries"
        info         : "The number of retries before the SSH login session disconnects."
        reference    : "NIST 800-53r5|IA-2(1)"
        see_also     : "See HTH Policies and Standards"
        item         : "ip ssh authentication-retries ([4-9]|[1-9][0-9]+)$"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0071 - NETIOS - Set 'logging enable"
        info         : "Enable logging of system messages."
        reference    : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        see_also     : "See HTH Policies and Standards"
        context      : "archive"
        item         : "logging enable"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0072 - NETIOS - Set 'login success/failure logging"
        info         : "Without generating audit records that are specific to the security and mission needs of the organization, it would be difficult to establish, correlate, and investigate the events relating to an incident or identify those responsible for one."
        reference    : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        see_also     : "See HTH Policies and Standards"
        item         : "login on-(failure|success) log"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0073 - NETIOS - Set 'ntp authenticate"
        info         : "Enable NTP authentication."
        reference    : "NIST 800-53r5|AU-7 AU-8"
        see_also     : "See HTH Policies and Standards"
        item         : "ntp authenticate"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0074 - NETIOS - Set 'ntp authentication-key"
        info         : "Define an authentication key for Network Time Protocol (NTP)."
        reference    : "NIST 800-53r5|AU-7 AU-8"
        see_also     : "See HTH Policies and Standards"
        item         : "ntp authentication-key"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0075 - NETIOS - Set the 'ntp trusted-key"
        info         : "Ensure you authenticate the identity of a system to which Network Time Protocol (NTP) will synchronize"
        reference    : "NIST 800-53r5|AU-7 AU-8"
        see_also     : "See HTH Policies and Standards"
        item         : "ntp trusted-key .+"
        regex        : "ntp trusted-key 1"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0076 - NETIOS - Set 'ntp source' to Loopback Interface"
        info         : "Use a particular source address in Network Time Protocol (NTP) packets."
        reference    : "NIST 800-53r5|AU-7 AU-8"
        see_also     : "See HTH Policies and Standards"
        item         : "ntp source [Ll]oopback"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0077 - NETIOS - Set 'ip tftp source-interface' to the Loopback Interface"
        info         : "Specify the IP address of an interface as the source address for TFTP connections."
        reference    : "NIST 800-53r5|CA-9 SC-7 SC-7(5)"
        see_also     : "See HTH Policies and Standards"
        item         : "ip tftp source-interface [Ll]oopback"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0078 - NETIOS - Set 'authentication key-chain"
        info         : "Configure the EIGRP address family key chain."
        reference    : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CA-9 CM-2 CM-6 CM-7 CM-7(1) CM-9 SC-7 SC-7(5)"
        see_also     : "See HTH Policies and Standards"
        context      : "router eigrp .+"
        item         : "authentication key-chain .+"
        regex        : "authentication key-chain CIS-KEY-CHAIN"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0079 - NETIOS - Set 'ip authentication key-chain eigrp"
        info         : "Specify the type of authentication used in Enhanced Interior Gateway Routing Protocol (EIGRP) packets per interface."
        reference    : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CA-9 CM-2 CM-6 CM-7 CM-7(1) CM-9 SC-7 SC-7(5)"
        see_also     : "See HTH Policies and Standards"
        context      : "interface GigabitEthernet2"
        item         : "ip authentication key-chain eigrp"
        regex        : "ip authentication key-chain eigrp 100 CIS-KEY-CHAIN"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0080 - NETIOS - Set 'ip authentication mode eigrp"
        info         : "Configure authentication to prevent unapproved sources from introducing unauthorized or false routing messages."
        reference    : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CA-9 CM-2 CM-6 CM-7 CM-7(1) CM-9 SC-7 SC-7(5)"
        see_also     : "See HTH Policies and Standards"
        context      : "interface GigabitEthernet2"
        item         : "ip authentication mode eigrp"
        regex        : "ip authentication mode eigrp 100 md5"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0081 - NETIOS - Set 'authentication message-digest' for OSPF area"
        info         : "Enable MD5 authentication for OSPF."
        reference    : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CA-9 CM-2 CM-6 CM-7 CM-7(1) CM-9 SC-7 SC-7(5)"
        see_also     : "See HTH Policies and Standards"
        context      : "router ospf .+"
        item         : "area [^ ]+ authentication message-digest"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0082 - NETIOS - Set 'ip ospf message-digest-key md5"
        info         : "Enable Open Shortest Path First (OSPF) Message Digest 5 (MD5) authentication."
        reference    : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CA-9 CM-2 CM-6 CM-7 CM-7(1) CM-9 SC-7 SC-7(5)"
        see_also     : "See HTH Policies and Standards"
        context      : "interface GigabitEthernet2"
        item         : "ip ospf message-digest-key 1"
        regex        : "ip ospf message-digest-key 1 md5 [0-7] ([A-Za-z0-9]+)"
      </item>

      <item>
        type         : CONFIG_CHECK
        description  : "1.0083 - NETIOS - Set 'neighbor password"
        info         : "Enable message digest5 (MD5) authentication on a TCP connection between two BGP peers"
        reference    : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CA-9 CM-2 CM-6 CM-7 CM-7(1) CM-9 SC-7 SC-7(5)"
        see_also     : "See HTH Policies and Standards"
        context      : "router [Bb][Gg][Pp] .+"
        item         : "neighbor [^ ]+ password .+"
        regex        : "neighbor [^ ]+ password ([A-Za-z0-9\\/\\$]+)"
      </item>

    </then>

    <else>
      <report type:"WARNING">
        description  : "WARNING - TARGET OS DOESNT MATCH BASELINE - IOS"
        info         : "NOTE: Nessus has identified that the chosen audit does not apply to the target device."
        see_also     : "See HTH Policies and Standards"
      </report>
    </else>
  </if>

</check_type>
