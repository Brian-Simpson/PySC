    request        : "listActivityLogAlertBySubscription"
    json_transform : '.[] | .subscriptionId as $id | [ .value[] | .name as $name | select(.properties.enabled == true) | .properties.condition.allOf[] | select(.equals == "Microsoft.Network/publicIPAddresses/write") | $name ] as $names | "Subscription ID: \($id), Names: \($names)"'
    regex          : "Subscription ID:"
    expect         : "Names: \[.+\]"
    match_all      : YES
  </custom_item>

  <custom_item>
    description    : "1.0049 - MSAZ - Ensure that Azure Monitor Resource Logging is Enabled for All Services that Support it"
    info           : "Resource Logs capture activity to the data access plane while the Activity log is a subscription-level log for the control plane."
    reference      : "NIST 800-53r5|AU-3 AU-3(1) AU-6(3) AU-7 AU-12"
    see_also       : "See HTH Policies and Standards"
    request        : "listResourceDiagnosticSettings"
    json_transform : '.[] | .subscriptionId as $id | .value[] | if (has("error") | not) and (.value | length == 0) then "\(.type) - \(.name) - diagnostic settings not configured" else "" end'
    regex          : ".+"
    expect         : "^Manual Review Required$"
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0050 - MSAZ - Ensure that RDP access from the Internet is evaluated and restricted"
    info           : "Network security groups should be periodically evaluated for port misconfigurations."
    reference      : "NIST 800-53r5|CA-9 SC-7"
    see_also       : "See HTH Policies and Standards"
    request        : "listNetworkSecurityGroups"
    json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Network Security Group Name: \($name), Rule Name: \(.name), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Direction: \(.properties.direction), Protocol: \(.properties.protocol), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
    not_expect     : 'Access: Allow, Destination Port Range: (3389|\*|(([0-9]|[0-9][0-9]|[0-9][0-9][0-9]|[1-2][0-9][0-9][0-9]|3[0-2][0-9][0-9]|33[0-8][0-9])-(3389|339[0-9]|3[4-9][0-9][0-9]|[4-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9]))), Direction: Inbound, Protocol: (TCP|\*), Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
  </custom_item>

  <custom_item>
    description    : "1.0051 - MSAZ - Ensure subnets are associated with network security groups"
    info           : "Protect subnet resources by ensuring subnets are associated with network security groups, which can filter inbound and outbound traffic using security rules."
    reference      : "NIST 800-53r5|CA-9 SC-7"
    see_also       : "See HTH Policies and Standards"
    request        : "listVirtualNetworks"
    json_transform : '[.[] | .subscriptionId as $id | .value[] | .name as $virtualNetwork | .properties.subnets[] | .name as $subnet | .properties | if (has("networkSecurityGroup") | not) and ($subnet != "GatewaySubnet") and ($subnet != "AzureFirewallSubnet") then "Subscription ID: \($id), Virtual Network \($virtualNetwork), Subnet: \($subnet) - does not have a Network Security Group attached" else empty end] | unique| .[]'
    not_expect     : "does not have a Network Security Group attached$"
  </custom_item>

  <custom_item>
    description    : "1.0052 - MSAZ - Ensure the SSL policy's 'Min protocol version' is set to 'TLSv1_2' or higher on Azure Application Gateway"
    info           : "The TLS (Transport Layer Security) protocol secures the transmission of data over the internet using standard encryption technology."
    reference      : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
    see_also       : "See HTH Policies and Standards"
    request        : "listApplicationGateways"
    json_transform : '.[] | .subscriptionId as $id | .value[] | .name as $appGw | "Subscription ID: \($id), Application Gateway: \($appGw)"'
    expect         : "^Manual Review Required$"
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0053 - MSAZ - Ensure 'HTTP2' is set to 'Enabled' on Azure Application Gateway"
    info           : "Enable HTTP/2 for improved performance, efficiency, and security."
    reference      : "NIST 800-53r5|SA-22"
    see_also       : "See HTH Policies and Standards"
    request        : "listApplicationGateways"
    json_transform : '.[] | .subscriptionId as $id | .value[] | .name as $appGw | "Subscription ID: \($id), Application Gateway: \($appGw), enableHttp2: \(.properties.enableHttp2)"'
    not_expect     : "enableHttp2: false$"
  </custom_item>

  <custom_item>
    description    : "1.0054 - MSAZ - Ensure that SSH access from the Internet is evaluated and restricted"
    info           : "Network security groups should be periodically evaluated for port misconfigurations."
    reference      : "NIST 800-53r5|CA-9 SC-7"
    see_also       : "See HTH Policies and Standards"
    request        : "listNetworkSecurityGroups"
    json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Network Security Group Name: \($name), Rule Name: \(.name), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Direction: \(.properties.direction), Protocol: \(.properties.protocol), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
    not_expect     : 'Access: Allow, Destination Port Range: (22|\*|(([0-9]|1[0-9]|2[0-2])-(2[2-9][3-9][0-9]|[1-9][0-9][0-9]|[1-9][0-9][0-9][0-9]|[1-6][0-9][0-9][0-9][0-9]))), Direction: Inbound, Protocol: (TCP|\*), Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
  </custom_item>

  <if>
    <condition auto:"FAILED" type:"AND">
      <custom_item>
        description    : "port 53"
        request        : "listNetworkSecurityGroups"
        json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Name: \(.name), Protocol: \(.properties.protocol), Direction: \(.properties.direction), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
        not_expect     : 'Protocol: (UDP|\*), Direction: Inbound, Access: Allow, Destination Port Range: (53|([0-4]?[0-9]|5[0-3])-(5[3-9]|[6-9][0-9]|[1-9][0-9]{2,})), Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
      </custom_item>

      <custom_item>
        description    : "port 123"
        request        : "listNetworkSecurityGroups"
        json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Name: \(.name), Protocol: \(.properties.protocol), Direction: \(.properties.direction), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
        not_expect     : 'Protocol: (UDP|\*), Direction: Inbound, Access: Allow, Destination Port Range: (123|([0-9]{1,2}|1[0-1][0-9]|12[0-3])-(12[3-9]|1[3-9][0-9]|[2-9][0-9]{2,})), Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
      </custom_item>

      <custom_item>
        description    : "port 161"
        request        : "listNetworkSecurityGroups"
        json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Name: \(.name), Protocol: \(.properties.protocol), Direction: \(.properties.direction), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
        not_expect     : 'Protocol: (UDP|\*), Direction: Inbound, Access: Allow, Destination Port Range: (161|([0-9]{1,2}|1[0-5][0-9]|16[0-1])-(16[1-9]|1[7-9][0-9]|[2-9][0-9]{2,})), Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
      </custom_item>

      <custom_item>
        description    : "port 389"
        request        : "listNetworkSecurityGroups"
        json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Name: \(.name), Protocol: \(.properties.protocol), Direction: \(.properties.direction), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
        not_expect     : 'Protocol: (UDP|\*), Direction: Inbound, Access: Allow, Destination Port Range: (389|([0-9]{1,2}|[1-2][0-9]{2}|3[0-7][0-9]|38[0-9])-(389|39[0-9]|[4-9][0-9]{2,})), Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
      </custom_item>

      <custom_item>
        description    : "port 1900"
        request        : "listNetworkSecurityGroups"
        json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Name: \(.name), Protocol: \(.properties.protocol), Direction: \(.properties.direction), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
        not_expect     : 'Protocol: (UDP|\*), Direction: Inbound, Access: Allow, Destination Port Range: (1900|([0-9]{1,3}|1[0-8][0-9]{2}|1900)-(1900|190[1-9]|19[1-9][0-9]|[2-9][0-9]{3,})), Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
      </custom_item>

      <custom_item>
        description    : "any port"
        request        : "listNetworkSecurityGroups"
        json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Name: \(.name), Protocol: \(.properties.protocol), Direction: \(.properties.direction), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
        not_expect     : 'Protocol: (UDP|\*), Direction: Inbound, Access: Allow, Destination Port Range: \*, Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
      </custom_item>
    </condition>

    <then>
      <report type:"PASSED">
        description    : "1.0055 - MSAZ - Ensure that UDP access from the Internet is evaluated and restricted"
        info           : "Network security groups should be periodically evaluated for port misconfigurations."
        reference      : "NIST 800-53r5|CA-9 SC-7"
        see_also       : "See HTH Policies and Standards"
        show_output    : YES
      </report>
    </then>
  </if>

  <custom_item>
    description    : "1.0056 - MSAZ -Ensure that HTTP(S) access from the Internet is evaluated and restricted"
    info           : "Network security groups should be periodically evaluated for port misconfigurations."
    reference      : "NIST 800-53r5|CA-9 SC-7"
    see_also       : "See HTH Policies and Standards"
    request        : "listNetworkSecurityGroups"
    json_transform : '.[]|.subscriptionId as $id|.value[]|.name as $name| .properties.securityRules[]|"Subscription ID: \($id), Network Security Group Name: \($name),  Rule Name: \(.name), Access: \(.properties.access), Destination Port Range: \(.properties.destinationPortRange), Direction: \(.properties.direction), Protocol: \(.properties.protocol), Source Address Prefix: \(.properties.sourceAddressPrefix)"'
    not_expect     : 'Access: Allow, Destination Port Range: (80|443|\*|(([0-9]|1[0-9]|80)-([8-9][0-9]|[1-9][0-9][0-9]|[1-9][0-9][0-9][0-9]|[1-6][0-9][0-9][0-9][0-9]))|(([0-9]|[1-9][0-9]|[1-3][0-9][0-9]|4[0-3][0-9]|44[0-3])-(44[3-9]|4[5-9][0-9]|[5-9][0-9][0-9]|[1-9][0-9][0-9][0-9]|[1-6][0-9][0-9][0-9][0-9]))), Direction: Inbound, Protocol: (TCP|\*), Source Address Prefix: (\*|0\.0\.0\.0|<nw>/0|/0|internet|any)'
  </custom_item>

  <report type:"WARNING">
    description    : "1.0057 - MSAZ -Ensure that Public IP addresses are Evaluated on a Periodic Basis"
    info           : "Public IP Addresses provide tenant accounts with Internet connectivity for resources contained within the tenant."
    reference      : "NIST 800-53r5|CM-8 CM-8(1)"
    see_also       : "See HTH Policies and Standards"
  </report>

  <report type:"WARNING">
    description    : "1.0058 - MSAZ -Ensure that Microsoft Defender for Cloud is configured to check VM operating systems for updates"
    info           : "Ensure that the latest OS patches for all virtual machines are applied."
    reference      : "NIST 800-53r5|RA-5 RA-7 SI-2 SI-2(2)"
    see_also       : "See HTH Policies and Standards"
  </report>

  <report type:"WARNING">
    description    : "1.0059 - MSAZ -Ensure that Microsoft Cloud Security Benchmark policies are not set to 'Disabled'"
    info           : "The Microsoft Cloud Security Benchmark (or \"MCSB\") is an Azure Policy Initiative containing many security policies to evaluate resource configuration against best practice recommendations."
    reference      : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
    see_also       : "See HTH Policies and Standards"
  </report>

  <custom_item>
    description    : "1.0060 - MSAZ -Ensure That 'All users with the following roles' is set to 'Owner'"
    info           : "Enable security alert emails to subscription owners."
    reference      : "NIST 800-53r5|IR-6 IR-6(3)"
    see_also       : "See HTH Policies and Standards"
    request        : "listSecurityContacts"
    json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name| "Subscription ID: \($id), Name: \($name), State: \(.properties.notificationsByRole.state), Roles: \(.properties.notificationsByRole.roles)"'
    regex          : "State:"
    expect         : "State: On, Roles: .*Owner"
    match_all      : YES
  </custom_item>

  <custom_item>
    description    : "1.0061 - MSAZ -Ensure 'Additional email addresses' is Configured with a Security Contact Email"
    info           : "Microsoft Defender for Cloud emails the subscription owners whenever a high-severity alert is triggered for their subscription."
    reference      : "NIST 800-53r5|IR-6 IR-6(3)"
    see_also       : "See HTH Policies and Standards"
    request        : "listSecurityContacts"
    json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name| "Subscription ID: \($id), Name: \($name), Email: \(.properties.emails)"'
    regex          : "Email:"
    expect         : "^Manual Review Required$"
    match_all      : YES
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0062 - MSAZ -Ensure that 'Notify about alerts with the following severity (or higher)' is enabled"
    info           : "Enables emailing security alerts to the subscription owner or other designated security contact."
    reference      : "NIST 800-53r5|SI-4"
    see_also       : "See HTH Policies and Standards"
    request        : "listSecurityContactSources"
    json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name | .properties.isEnabled as $isEnabled | [ .properties.notificationsSources[] | select(.sourceType == "Alert") | {"sourceType": .sourceType, "minimalSeverity": .minimalSeverity} ] | if (.[] | length) == 0 then "Subscription ID: \($id) does not have this setting enabled" else (.[] | "Subscription ID: \($id), Name: \($name), IsEnabled: \($isEnabled), Source: \(.sourceType), Minimal Severity: \(.minimalSeverity)") end'
    regex          : ".+"
    not_expect     : "does not have this setting enabled"
  </custom_item>

  <custom_item>
    description    : "1.0063 - MSAZ -Ensure that 'Notify about attack paths with the following risk level (or higher)' is enabled"
    info           : "Enables emailing attack paths to the subscription owner or other designated security contact."
    reference      : "NIST 800-53r5|SI-4"
    see_also       : "See HTH Policies and Standards"
    request        : "listSecurityContactSources"
    json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name | .properties.isEnabled as $isEnabled | [ .properties.notificationsSources[] | select(.sourceType == "AttackPath") | {"sourceType": .sourceType, "minimalRiskLevel": .minimalRiskLevel} ] | if (.[] | length) == 0 then "Subscription ID: \($id) does not have this setting enabled" else (.[] | "Subscription ID: \($id), Name: \($name), IsEnabled: \($isEnabled), Source: \(.sourceType), Minimal Risk Level: \(.minimalRiskLevel)") end'
    regex          : ".+"
    not_expect     : "does not have this setting enabled"
  </custom_item>

  <custom_item>
    description    : "1.0064 - MSAZ -Ensure that the Expiration Date is set for all Keys in RBAC Key Vaults"
    info           : "Ensure that all Keys in Role Based Access Control (RBAC) Azure Key Vaults have an expiration date set."
    reference      : "NIST 800-53r5|AC-1 AC-2 AC-2(1) AU-11 CM-12 SI-12"
    see_also       : "See HTH Policies and Standards"
    request        : "listVaultsByResourceGroup"
    json_transform : '.[]|.subscriptionId as $subid|.resourceGroups[]|.name as $rgn|.vaults[]|"Subscription ID: \($subid), Resource Group: \($rgn), Vault Name: \(.name)"'
    not_expect     : ".+"
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0065 - MSAZ -Ensure certificate 'Validity Period (in months)' is less than or equal to '12'"
    info           : "Restrict the validity period of certificates stored in Azure Key Vault to 12 months or less."
    reference      : "NIST 800-53r5|CM-7 MA-4"
    see_also       : "See HTH Policies and Standards"
    request        : "listVaultsByResourceGroup"
    json_transform : '.[]|.subscriptionId as $subid|.resourceGroups[]|.name as $rgn|.vaults[]|"Subscription ID: \($subid), Resource Group: \($rgn), Vault Name: \(.name)"'
    not_expect     : ".+"
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0066 - MSAZ -Ensure that the Expiration Date is set for all Keys in Non-RBAC Key Vaults."
    info           : "Ensure that all Keys in Non Role Based Access Control (RBAC) Azure Key Vaults have an expiration date set."
    reference      : "NIST 800-53r5|AC-1 AC-2 AC-2(1) AU-11 CM-12 SI-12"
    see_also       : "See HTH Policies and Standards"
    request        : "listVaultsByResourceGroup"
    json_transform : '.[]|.subscriptionId as $subid|.resourceGroups[]|.name as $rgn|.vaults[]|"Subscription ID: \($subid), Resource Group: \($rgn), Vault Name: \(.name)"'
    not_expect     : ".+"
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0067 - MSAZ -Ensure that the Expiration Date is set for all Secrets in RBAC Key Vaults"
    info           : "Ensure that all Secrets in Role Based Access Control (RBAC) Azure Key Vaults have an expiration date set."
    reference      : "NIST 800-53r5|AC-1 AC-2 AC-2(1) AU-11 CM-12 SI-12"
    see_also       : "See HTH Policies and Standards"
    request        : "listVaultsByResourceGroup"
    json_transform : '.[]|.subscriptionId as $subid|.resourceGroups[]|.name as $rgn|.vaults[]|"Subscription ID: \($subid), Resource Group: \($rgn), Vault Name: \(.name)"'
    not_expect     : ".+"
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0068 - MSAZ -Ensure that the Expiration Date is set for all Secrets in Non-RBAC Key Vaults"
    info           : "Ensure that all Secrets in Non Role Based Access Control (RBAC) Azure Key Vaults have an expiration date set."
    reference      : "NIST 800-53r5|AC-1 AC-2 AC-2(1) AU-11 CM-12 SI-12"
    see_also       : "See HTH Policies and Standards"
    request        : "listVaultsByResourceGroup"
    json_transform : '.[]|.subscriptionId as $subid|.resourceGroups[]|.name as $rgn|.vaults[]|"Subscription ID: \($subid), Resource Group: \($rgn), Vault Name: \(.name)"'
    not_expect     : ".+"
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0069 - MSAZ -Ensure 'Purge protection' is set to 'Enabled'"
    info           : "Key vaults contain object keys, secrets, and certificates."
    reference      : "NIST 800-53r5|CP-2 CP-10"
    see_also       : "See HTH Policies and Standards"
    request        : "listVaultDetails"
    json_transform : '.[] | .subscriptionId as $id | .resourceGroups[] | .name as $rgName | .vaults[] | "Subscription ID \($id), Resource Group: \($rgName), Key Vault: \(.name), Purge Protection Enabled: \(.properties.enablePurgeProtection)"'
    not_expect     : "Purge Protection Enabled: (false|null)"
  </custom_item>

  <custom_item>
    description    : "1.0070 - MSAZ -Ensure Public Network Access is Disabled"
    info           : "Disable public network access to prevent exposure to the internet and reduce the risk of unauthorized access."
    reference      : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
    see_also       : "See HTH Policies and Standards"
    request        : "listVaultDetails"
    json_transform : '.[] | .subscriptionId as $id | .resourceGroups[] | .name as $rgName | .vaults[] | "Subscription ID: \($id), Resource Group: \($rgName), Vault Name: \(.name), Public Network Access: \(.properties.publicNetworkAccess)"'
    not_expect     : "Public Network Access: Enabled"
  </custom_item>

  <custom_item>
    description    : "1.0071 - MSAZ -Ensure soft delete for Azure File Shares is Enabled"
    info           : "Azure Files offers soft delete for file shares, allowing you to easily recover your data when it is mistakenly deleted by an application or another storage account user."
    reference      : "NIST 800-53r5|CP-2 CP-10"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id|.value[] | "Subscription ID: \($id), Name: \(.name)"'
    not_expect     : ".+"
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0072 - MSAZ -Ensure 'SMB protocol version' is set to 'SMB 3.1.1' or higher for SMB file shares"
    info           : "Ensure that SMB file shares are configured to use the latest supported SMB protocol version."
    reference      : "NIST 800-53r5|AC-18 SC-23"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id|.value[] | "Subscription ID: \($id), Name: \(.name)"'
    not_expect     : ".+"
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0073 - MSAZ -Ensure 'SMB channel encryption' is set to 'AES-256-GCM' or higher for SMB file shares"
    info           : "Implement SMB channel encryption with AES-256-GCM for SMB file shares to ensure data confidentiality and integrity in transit."
    reference      : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id|.value[] | "Subscription ID: \($id), Name: \(.name)"'
    not_expect     : ".+"
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0074 - MSAZ -Ensure that soft delete for blobs on Azure Blob Storage storage accounts is Enabled"
    info           : "Blobs in Azure storage accounts may contain sensitive or personal data, such as ePHI or financial information."
    reference      : "NIST 800-53r5|CP-2 CP-10"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id|.value[] | "Subscription ID: \($id), Name: \(.name)"'
    not_expect     : ".+"
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0075 - MSAZ -Ensure that soft delete for containers on Azure Blob Storage storage accounts is Enabled"
    info           : "Containers in Azure storage accounts may contain sensitive or personal data, such as ePHI or financial information."
    reference      : "NIST 800-53r5|CP-2 CP-10"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id|.value[] | "Subscription ID: \($id), Name: \(.name)"'
    not_expect     : ".+"
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0076 - MSAZ -Ensure that 'Enable key rotation reminders' is enabled for each Storage Account"
    info           : "Access Keys authenticate application access requests to data contained in Storage Accounts."
    reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name| "Subscription ID: \($id), Name: \($name), Key Creation Time: \(.properties.keyCreationTime)"'
    not_expect     : "Key Creation Time: .+"
    severity       : MEDIUM
  </custom_item>

  <custom_item>
    description    : "1.0077 - MSAZ -Ensure that Storage Account access keys are periodically regenerated"
    info           : "For increased security, regenerate storage account access keys periodically."
    reference      : "NIST 800-53r5|AC-1 AC-2 AC-2(1) CM-7 MA-4"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name| if ((.properties.keyCreationTime.key1 | iso_8601_days_ago) > 90) or ((.properties.keyCreationTime.key1 | iso_8601_days_ago) > 90) then "Subscription ID: \($id), Name: \($name), Key Creation Time: key1: \(.properties.keyCreationTime.key1) key2: \(.properties.keyCreationTime.key2)" else null end'
    not_expect     : "Key Creation Time: .+"
  </custom_item>

  <custom_item>
    description    : "1.0078 - MSAZ -Ensure 'Allow storage account key access' for Azure Storage Accounts is 'Disabled'"
    info           : "Every secure request to an Azure Storage account must be authorized."
    reference      : "NIST 800-53r5|AC-1 AC-2 AC-2(1) AC-3 AC-5 AC-6 MP-2"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name| "Subscription ID: \($id), Name: \($name), Allow Shared Key Access: false"'
    not_expect     : "Allow Shared Key Access: true"
  </custom_item>

  <custom_item>
    description    : "1.0079 - MSAZ -Ensure that 'Public Network Access' is 'Disabled' for storage accounts"
    info           : "Disable public network access to prevent exposure to the internet and reduce the risk of unauthorized access."
    reference      : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id | .value[] | .name as $name |"Subscription ID: \($id), Storage account: \($name), Public Network Access: \(.properties.publicNetworkAccess)"'
    expect         : "Public Network Access: Disabled"
    match_all      : YES
  </custom_item>

  <custom_item>
    description    : "1.0080 - MSAZ -Ensure default network access rule for storage accounts is set to deny"
    info           : "Restricting default network access helps to provide a new layer of security, since storage accounts accept connections from clients on any network."
    reference      : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name| "Subscription ID: \($id), Name: \($name), Default Action: \(.properties.networkAcls.defaultAction)"'
    not_expect     : "Default Action: Allow"
  </custom_item>

  <custom_item>
    description    : "1.0081 - MSAZ -Ensure that 'Default to Microsoft Entra authorization in the Azure portal' is set to 'Enabled'"
    info           : "When this property is enabled, the Azure portal authorizes requests to blobs, files, queues, and tables with Microsoft Entra ID by default."
    reference      : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name| "Subscription ID: \($id), Name: \($name), Default to Entra Authentication: \(.properties.defaultToOAuthAuthentication)"'
    expect         : "Default to Entra Authentication: true"
    match_all      : YES
  </custom_item>

  <custom_item>
    description    : "1.0082 - MSAZ -Ensure that 'Secure transfer required' is set to 'Enabled'"
    info           : "Enable data encryption in transit."
    reference      : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name| "Subscription ID: \($id), Name: \($name), Secure Transfer Required: \(.properties.supportsHttpsTrafficOnly)"'
    not_expect     : "Secure Transfer Required: false"
  </custom_item>

  <custom_item>
    description    : "1.0083 - MSAZ -Ensure the 'Minimum TLS version' for storage accounts is set to 'Version 1.2'"
    info           : "In some cases, Azure Storage sets the minimum TLS version to be version 1."
    reference      : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name| "Subscription ID: \($id), Name: \($name), Minimum TLS Version: \(.properties.minimumTlsVersion)"'
    expect         : "Minimum TLS Version: TLS1_2"
    match_all      : YES
  </custom_item>

  <custom_item>
    description    : "1.0084 - MSAZ -Ensure 'Cross Tenant Replication' is not enabled"
    info           : "Cross Tenant Replication in Azure allows data to be replicated across multiple Azure tenants."
    reference      : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name| "Subscription ID: \($id), Name: \($name), Cross Tenant Replication: \(.properties.allowCrossTenantReplication)"'
    expect         : "Cross Tenant Replication: false"
    match_all      : YES
  </custom_item>

  <custom_item>
    description    : "1.0085 - MSAZ -Ensure that 'Allow Blob Anonymous Access' is set to 'Disabled'"
    info           : "The Azure Storage setting 'Allow Blob Anonymous Access' (aka \"allowBlobPublicAccess\") controls whether anonymous access is allowed for blob data in a storage account."
    reference      : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2"
    see_also       : "See HTH Policies and Standards"
    request        : "listStorageAccounts"
    json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name| "Subscription ID: \($id), Name: \($name), Allow Blob Anonymous Access: \(.properties.allowBlobPublicAccess)"'
    expect         : "Allow Blob Anonymous Access: false"
    match_all      : YES
  </custom_item>

  <if>
    <condition auto:"WARNING" type:"AND">
      <custom_item>
        description    : "1.0086 - MSAZ -locks"
        request        : "listManagementLocksByResourceGroup"
        json_transform : '.[]|.subscriptionId as $subid|.resourceGroups[]|.name as $rgname|.value[]|"Subscription ID: \($subid), Resource Group: \($rgname), Lock Name: \(.name), Lock Level: \(.properties.level)"'
        not_expect     : ".+"
        severity       : MEDIUM
      </custom_item>

      <custom_item>
        description    : "1.0087 - MSAZ -storage accounts"
        request        : "listStorageAccounts"
        json_transform : '.[]|.subscriptionId as $id| .value[]| .name as $name| "Subscription ID: \($id), Name: \($name)"'
        not_expect     : ".+"
        severity       : MEDIUM
      </custom_item>
    </condition>

    <then>
      <report type:"PASSED">
        description    : "1.0088 - MSAZ -Ensure Azure Resource Manager Delete locks are applied to Azure Storage Accounts"
        info           : "Azure Resource Manager CannotDelete (Delete) locks can prevent users from accidentally or maliciously deleting a storage account."
        reference      : "NIST 800-53r5|AC-6(10)"
        see_also       : "See HTH Policies and Standards"
        show_output    : YES
      </report>
    </then>
  </if>

</check_type>
