
           <check_type:"Windows" version:"2">
           <group_policy:"HTH Microsoft Windows Enterprise Workstation Baseline">

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "System/Domain Identification"
  info              : "This obtains specific user and system information that may be used for additional evaluation."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : ".*"
  powershell_args   : "(Get-ComputerInfo) |Select-Object OSDisplayVersion, CsManufacturer, CsModel, BiosBIOSVersion, BiosSeralNumber, CsUserName, OsName, OsBuildNumber, OsProductType, CsDNSHostName, CsDomain;"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "Network Information"
  info              : "This obtains relevent hosted view network information that may be used for additional evaluation."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : ".*"
  powershell_args   : "Get-NetIPConfiguration -Detailed ;(Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.2\Server');"
  check_type        : CHECK_REGEX
</custom_item>

           <if>

           <condition type:"OR">
<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "Windows 10 is installed"
  value_type        : POLICY_TEXT
  value_data        : "^[Ww][Ii][Nn][Dd][Oo][Ww][Ss] 1[0,1].+$"
  powershell_args   : "(Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows Nt\Currentversion').ProductName"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "Windows 11 is installed"
  value_type        : POLICY_TEXT
  value_data        : "22631"
  powershell_args   : "(Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows Nt\Currentversion').CurrentBuildNumber"
  check_type        : CHECK_REGEX
</custom_item>
           </condition>

           <then>

<report type:"PASSED">
  description : "PASSED - TARGET OS MATCHES BASELINE - WINWRK"
  see_also    : "See HTH Policies and Standards"
</report>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0001 - MSWRK - IA - MSWRK - Password History - 24 passwords remembered"
  info              : "This policy setting determines the number of renewed, unique passwords that have to be associated with a user account before you can reuse an old password."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "24"
  powershell_args   : "$HisPwdObj = net accounts | Select-string 'password history'; $HisPwdStr = $HisPwdObj.ToString(); $HisPwdStr -match '\d{1,2}' | out-null; $HisPwdStr -match '24' | out-null; $LO_HisPwd = $matches[0]; Write-Output $LO_HisPwd;"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0002 - MSWRK - IA - MSWRK - Password Maximum Age - 60 days"
  info              : "This policy setting defines how long a user can use their password before it expires."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "60"
  powershell_args   : "$MaxAgeObj = net accounts | Select-string 'Maximum password'; $MaxAgeStr = $MaxAgeObj.ToString(); $MaxAgeStr -match '\d{1,2}' | out-null; $MaxAgeStr -match '60' | out-null; $LO_MaxAge = $matches[0]; Write-Output $LO_MaxAge;"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0003 - MSWRK - IA - MSWRK - Password - Password Minimum Age - 1 day"
  info              : "This policy setting determines the least number of characters that make up a password for a user account."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "1"
  powershell_args   : "$MinAgeObj = net accounts | Select-string 'Minimum password age'; $MinAgeStr = $MinAgeObj.ToString(); $MinAgeStr -match '\d{1,2}' | out-null; $MinAgeStr -match '1' | out-null; $LO_MinAge = $matches[0]; Write-Output $LO_MinAge;"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0004 - MSWRK - IA - MSWRK - Password Length - 8 characters"
  info              : "This policy setting determines the least number of characters that make up a password for a user account."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "[8...20]"
  powershell_args   : "$LngthPwdObj = net accounts | Select-string 'password length'; $LngthPwdStr = $LngthPwdObj.ToString(); $LngthPwdStr -match '\d{1,2}' | out-null; $LngthPwdStr -match '8' | out-null; $LO_LngthPwd = $matches[0]; Write-Output $LO_LngthPwd;"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : PASSWORD_POLICY
  description       : "1.0005 - MSWRK - IA - MSWRK - Password - Complexity Requirements - Enabled"
  info              : "This policy setting checks all new passwords to ensure that they meet basic requirements for strong passwords."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_SET
  value_data        : "Enabled"
  password_policy   : COMPLEXITY_REQUIREMENTS
</custom_item>


<custom_item>
  type              : PASSWORD_POLICY
  description       : "1.0006 - MSWRK - IA - MSWRK - Password - Reversible Encryption - Disabled"
  info              : "This policy setting determines whether the operating system stores passwords in a way that uses reversible encryption."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_SET
  value_data        : "Disabled"
  password_policy   : REVERSIBLE_ENCRYPTION
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0007 - MSWRK - AC - MSWRK - Password - Acount Lockout Reset - 1 day"
  info              : "This policy setting determines the length of time before the Account lockout threshold resets to zero."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : ".*60"
  powershell_args   : "$LockObsObj = net accounts | Select-string 'Lockout observation'; $LockObsStr = $LockObsObj.ToString(); $LockObsStr -match '\d{1,2}' | out-null; $LockObsStr -match '60' | out-null; $LO_LockObs = $matches[0]; Write-Output $LO_LockObs;"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0008 - MSWRK - AC - MSWRK - Password - Acount Lockout Threshold - 5 invalid attempts"
  info              : "This policy setting determines the number of failed logon attempts before the account is locked."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : ".*5"
  powershell_args   : "$lockoutObj = net accounts | Select-string threshold; $lockoutStr = $lockoutObj.ToString(); $lockoutStr -match '\d{1,3}' | out-null; $lockoutStr -match 'Never' | out-null; $LO_threshold = $matches[0]; Write-Output $LO_threshold;"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : PASSWORD_POLICY
  description       : "1.0009 - MSWRK - IA - MSWRK - Password - Lockout Admins - Enabled"
  info              : "This policy setting determines whether the built-in Administrator account is subject to the HTH Account Lockout Policy settings."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_SET
  value_data        : "Enabled"
  password_policy   : LOCKOUT_ADMINS
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0010 - MSWRK - AC - MSWRK - Password - Acount Lockout Duration - 60 minutes"
  info              : "This policy setting determines the length of time that must pass before a locked account is unlocked and a user can try to log on again."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "60"
  powershell_args   : "$LockDurObj = net accounts | Select-string 'Lockout duration'; $LockDurStr = $LockDurObj.ToString(); $LockDurStr -match '\d{1,2}' | out-null; $LockDurStr -match '60' | out-null; $LO_LockDur = $matches[0]; Write-Output $LO_LockDur;"
  check_type        : CHECK_REGEX
</custom_item>







<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0011 - MSWRK - AU - MSWRK - Audit Account Lockout is set to include Failure"
  info              : "This subcategory reports when a users account is locked out as a result of too many failed logon attempts."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "Success and Failure"
  powershell_args   : "$AL = auditpol /get /Subcategory:'Account Lockout' |Select-String 'Account Lockout'; $ALStr=$AL.ToString(); $ALStr -match 'Success and Failure' | out-null; $LOAL = $matches[0]; Write-Output $LOAL;"
  check_type        : CHECK_REGEX
</custom_item>


<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0012 - MSWRK - AU - MSWRK - Audit Logoff is set to include Success"
  info              : "This subcategory reports when a user logs off from the system."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "Success"
  powershell_args   : "$LO = auditpol /get /Subcategory:'LogOff' |Select-String 'LogOff'; $LOStr=$LO.ToString(); $LOStr -match 'Success' | out-null; $LOLO = $matches[0]; Write-Output $LOLO;"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0013 - MSWRK - AU - MSWRK - Audit Logon is set to Success and Failure"
  info              : "This subcategory reports when a user attempts to log on to the system."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "Success and Failure"
  powershell_args   : "$LOn = auditpol /get /Subcategory:'LogOn' |Select-String 'LogOn'; $LOnStr=$LOn.ToString(); $LOnStr -match 'Success and Failure' | out-null; $LOLOn = $matches[0]; Write-Output $LOLOn;"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0014 - MSWRK - AU - MSWRK - Audit Other Logon/Logoff Events is set to Success and Failure"
  info              : "This subcategory reports other logon/logoff-related events, such as Remote Desktop Services session disconnects and reconnects, using RunAs to run processes under a different account, and locking and unlocking a workstation."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "Success and Failure"
  powershell_args   : "$OLO = auditpol /get /Subcategory:'Other Logon/Logoff Events' |Select-String 'Other Logon/Logoff Events'; $OLOStr=$OLO.ToString(); $OLOStr -match 'Success and Failure' | out-null; $LOOLO = $matches[0]; Write-Output $LOOLO;"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0015 - MSWRK - AU - MSWRK - Audit Special Logon is set to include Success"
  info              : "This subcategory reports when a special logon is used."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "Success"
  powershell_args   : "$SLO = auditpol /get /Subcategory:'Special Logon' |Select-String 'Special Logon'; $SLOStr=$SLO.ToString(); $SLOStr -match 'Success' | out-null; $LOSLO = $matches[0]; Write-Output $LOSLO;"
  check_type        : CHECK_REGEX
</custom_item>





<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0016 - MSWRK - AU - MSWRK - Audit Policy Change is set to include Success"
  info              : "This subcategory reports changes in audit policy including SACL changes."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "Success" || "Success and Failure"
  powershell_args   : "$APC = auditpol /get /Subcategory:'Audit Policy Change' |Select-String 'Audit Policy Change'; $APCStr=$APC.ToString(); $APCStr -match 'Success and Failure' | out-null; $LOAPC = $matches[0]; Write-Output $LOAPC"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0017 - MSWRK - AU - MSWRK - Audit Authentication Policy Change is set to include Success"
  info              : "This subcategory reports changes in authentication policy."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "Success" || "Success and Failure"
  powershell_args   : "$AuthPC = auditpol /get /Subcategory:'Authentication Policy Change' |Select-String 'Authentication Policy Change'; $AuthPCStr=$AuthPC.ToString(); $AuthPCStr -match 'Success and Failure' | out-null; $LOAuthPC = $matches[0]; Write-Output $LOAuthPC"
  check_type        : CHECK_REGEX
</custom_item>






<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0018 - MSWRK - AU - MSWRK - Audit Other System Events is set to Success and Failure"
  info              : "This subcategory reports on other system events."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "Success and Failure"
  powershell_args   : "$OSysEvent = auditpol /get /Subcategory:'Other System Events' |Select-String 'Other System Events'; $OSysEventStr=$OSysEvent.ToString(); $OSysEventStr -match 'Success and Failure' | out-null; $LOOSysEvent = $matches[0]; Write-Output $LOOSysEvent"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0019 - MSWRK - AU - MSWRK - Audit Security State Change is set to include Success"
  info              : "This subcategory reports changes in security state of the system, such as when the security subsystem starts and stops."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "Success" || "Success and Failure"
  powershell_args   : "$SecStCh = auditpol /get /Subcategory:'Security State Change' |Select-String 'Security State Change'; $SecStChStr=$SecStCh.ToString(); $SecStChStr -match 'Success and Failure' | out-null; $LOSecStCh = $matches[0]; Write-Output $LOSecStCh"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0020 - MSWRK - AU - MSWRK - Audit Security System Extension is set to include Success"
  info              : "This subcategory reports the loading of extension code such as authentication packages by the security subsystem."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "Success" || "Success and Failure"
  powershell_args   : "$SecSysExt = auditpol /get /Subcategory:'Security System Extension' |Select-String 'Security System Extension'; $SecSysExtStr=$SecSysExt.ToString(); $SecSysExtStr -match 'Success and Failure' | out-null; $LOSecSysExt = $matches[0]; Write-Output $LOSecSysExt"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0021 - MSWRK - AU - MSWRK - Audit System Integrity is set to Success and Failure"
  info              : "This subcategory reports on violations of integrity of the security subsystem."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "Success and Failure"
  powershell_args   : "$SysInt = auditpol /get /Subcategory:'System Integrity' |Select-String 'System Integrity'; $SysIntStr=$SysInt.ToString(); $SysIntStr -match 'Success and Failure' | out-null; $LOSysInt = $matches[0]; Write-Output $LOSysInt"
  check_type        : CHECK_REGEX
</custom_item>



<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0022 - MSWRK - AC - MSWRK - Enumerate administrator accounts on elevation is set to Disabled"
  info              : "This policy setting controls whether administrator accounts are displayed when a user attempts to elevate a running application."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "0"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\CredUI'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\CredUI').EnumerateAdministrators;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0023 - MSWRK - CM - MSWRK - Prevent the use of security questions for local accounts is set to Enabled"
  info              : "This policy setting controls whether security questions can be used to reset local account passwords."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\System').NoLocalPasswordResetQuestions;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>













<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0024 - MSWRK - AU - MSWRK - Application: Control Event Log behavior when the log file reaches its maximum size is set to Disabled"
  info              : "This policy setting controls Event Log behavior when the log file reaches its maximum size."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\Application'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\Application').Retention;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0025 - MSWRK - AU - MSWRK - Application: Specify the maximum log file size (KB) is set to Enabled: 32,768 or greater"
  info              : "This policy setting specifies the maximum size of the log file in kilobytes."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "[32768..MAX]"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\Application'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\Application').MaxSize;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0026 - MSWRK - AU - MSWRK - Security: Control Event Log behavior when the log file reaches its maximum size is set to Disabled"
  info              : "This policy setting controls Event Log behavior when the log file reaches its maximum size."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\Security'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\Security').Retention;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0027 - MSWRK - AU - MSWRK - Security: Specify the maximum log file size (KB) is set to Enabled: 196,608 or greater"
  info              : "This policy setting specifies the maximum size of the log file in kilobytes."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "[196608..MAX]"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\Security'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\Security').MaxSize;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0028 - MSWRK - AU - MSWRK - Setup: Control Event Log behavior when the log file reaches its maximum size is set to Disabled"
  info              : "This policy setting controls Event Log behavior when the log file reaches its maximum size."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\Setup'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\Setup').Retention;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0029 - MSWRK - AU - MSWRK - Setup: Specify the maximum log file size (KB) is set to Enabled: 32,768 or greater"
  info              : "This policy setting specifies the maximum size of the log file in kilobytes."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "[32768..MAX]"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\Setup'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\Setup').MaxSize;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0030 - MSWRK - AU - MSWRK - System: Control Event Log behavior when the log file reaches its maximum size is set to Disabled"
  info              : "This policy setting controls Event Log behavior when the log file reaches its maximum size."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\System').Retention;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0031 - MSWRK - AU - MSWRK - System: Specify the maximum log file size (KB) is set to Enabled: 32,768 or greater"
  info              : "This policy setting specifies the maximum size of the log file in kilobytes."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "[32768..MAX]"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\System').MaxSize;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>







<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0032 - MSWRK - SI - MSWRK - Ensure 'Scan all downloaded files and attachments' is set to 'Disabled'"
  info              : "This policy setting configures scanning for all downloaded files and attachments."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "1"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection').DisableIOAVProtection;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_EQUAL
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0033 - MSWRK - SI - MSWRK - Ensure 'Turn off real-time protection' is set to 'Disabled'"
  info              : "This policy setting configures real-time protection prompts for known malware detection."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "1"
