  description       : "1.0065 - MSWRK - CM - MSWRK - Turn on convenience PIN sign-in is set to Disabled"
  info              : "This policy setting allows you to control whether a domain user can sign in using a convenience PIN."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\System').AllowDomainPINLogon;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>


<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0066 - MSWRK - CM - MSWRK - Allow network connectivity during connected-standby (on battery) is set to Disabled"
  info              : "This policy setting allows you to control the network connectivity state in standby on modern standby-capable systems."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Power\PowerSettings\f15576e8-98b7-4186-b944-eafa664402d9'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Power\PowerSettings\f15576e8-98b7-4186-b944-eafa664402d9').DCSettingIndex;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0067 - MSWRK - CM - MSWRK - Allow network connectivity during connected-standby (plugged in) is set to Disabled"
  info              : "This policy setting allows you to control the network connectivity state in standby on modern standby-capable systems."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Power\PowerSettings\f15576e8-98b7-4186-b944-eafa664402d9'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Power\PowerSettings\f15576e8-98b7-4186-b944-eafa664402d9').ACSettingIndex;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>




<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0068 - MSWRK - CM - MSWRK - Configure Solicited Remote Assistance is set to Disabled"
  info              : "This policy setting allows you to turn on or turn off Solicited (Ask for) Remote Assistance on this computer."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\policies\Microsoft\Windows NT\Terminal Services'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\policies\Microsoft\Windows NT\Terminal Services').fAllowToGetHelp;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>





<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0069 - MSWRK - SI - MSWRK - Turn On Virtualization Based Security is set to Enabled"
  info              : "This policy setting specifies whether Virtualization Based Security is enabled."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\DeviceGuard'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\DeviceGuard').EnableVirtualizationBasedSecurity;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>



<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0070 - MSWRK - SI - MSWRK - Turn On Virtualization Based Security: Select Platform Security Level is set to Secure Boot or higher"
  info              : "This policy setting specifies whether Virtualization Based Security (VBS) is enabled."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^3$" || "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\DeviceGuard'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\DeviceGuard').RequirePlatformSecurityFeatures;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>
















<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0071 - MSWRK - AC - MSWRK - Access Credential Manager as a trusted caller is set to No One"
  info              : "This security setting is used by Credential Manager during Backup and Restore."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : ""
  right_type        : SeTrustedCredManAccessPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0072 - MSWRK - AC - MSWRK - Ensure Create a pagefile is set to Administrators"
  info              : "This policy setting allows users to change the size of the pagefile."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "administrators"
  right_type        : SeCreatePagefilePrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0073 - MSWRK - AC - MSWRK - Create a token object is set to No One"
  info              : "This policy setting allows a process to create an access token, which may provide elevated rights to access sensitive data."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : ""
  right_type        : SeCreateTokenPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0074 - MSWRK - AC - MSWRK - Create global objects is set to Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE"
  info              : "This policy setting determines whether users can create global objects that are available to all sessions."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators" && "LOCAL SERVICE" && "NETWORK SERVICE" && "SERVICE"
  right_type        : SeCreateGlobalPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0075 - MSWRK - AC - MSWRK - Create permanent shared objects is set to No One"
  info              : "This user right is useful to kernel-mode components that extend the object namespace."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : ""
  right_type        : SeCreatePermanentPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0076 - MSWRK - AC - MSWRK - Configure Create symbolic links"
  info              : "This policy setting determines which users can create symbolic links."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : ("Administrators" || ("Administrators" && "Virtual Machines") || ("Administrators" && "NT VIRTUAL MACHINE\Virtual Machines"))
  right_type        : SeCreateSymbolicLinkPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0077 - MSWRK - AC - MSWRK - Debug programs is set to Administrators"
  info              : "This policy setting determines which user accounts will have the right to attach a debugger to any process or to the kernel, which provides complete access to sensitive and critical operating system components."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators"
  right_type        : SeDebugPrivilege
</custom_item>



<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0078 - MSWRK - AC - MSWRK - Deny log on as a service to include Guests"
  info              : "This security setting determines which service accounts are prevented from registering a process as a service."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Guests"
  right_type        : SeDenyServiceLogonRight
  check_type        : CHECK_SUPERSET
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0079 - MSWRK - AC - MSWRK - Ensure Deny log on locally to include Guests"
  info              : "This security setting determines which users are prevented from logging on at the computer."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "domain guests" && "guests"
  right_type        : SeDenyInteractiveLogonRight
  check_type        : CHECK_SUPERSET
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0080 - MSWRK - AC - MSWRK - Access this computer from the network is set to Administrators, Remote Desktop Users"
  info              : "This policy setting allows other users on the network to connect to the computer and is required by various network protocols that include Server Message Block (SMB)-based protocols, NetBIOS, Common Internet File System (CIFS), and Component Object Model Plus (COM+)."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators" && "Remote Desktop Users"
  right_type        : SeNetworkLogonRight
  check_type        : CHECK_SUPERSET
</custom_item>


<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0081 - MSWRK - AC - MSWRK - Enable computer and user accounts to be trusted for delegation is set to No One"
  info              : "This policy setting allows users to change the Trusted for Delegation setting on a computer object in Active Directory."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : ""
  right_type        : SeEnableDelegationPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0082 - MSWRK - AC - MSWRK - Force shutdown from a remote system is set to Administrators"
  info              : "This policy setting allows users to shut down Windows Vista-based or newer computers from remote locations on the network."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators"
  right_type        : SeRemoteShutdownPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0083 - MSWRK - AC - MSWRK - Generate security audits is set to LOCAL SERVICE, NETWORK SERVICE"
  info              : "This policy setting determines which users or processes can generate audit records in the Security log."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "LOCAL SERVICE" && "NETWORK SERVICE"
  right_type        : SeAuditPrivilege
  check_type        : CHECK_SUPERSET
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0084 - MSWRK - AC - MSWRK - Impersonate a client after authentication is set to Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE"
  info              : "The policy setting allows programs that run on behalf of a user to impersonate that user (or another specified account) so that they can act on behalf of the user."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators" && "LOCAL SERVICE" && "NETWORK SERVICE" && "SERVICE"
  right_type        : SeImpersonatePrivilege
  check_type        : CHECK_SUPERSET
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0085 - MSWRK - AC - MSWRK - Increase scheduling priority is set to Administrators, Window Manager\Window Manager Group"
  info              : "This policy setting determines whether users can increase the base priority class of a process."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : ("Administrators" && "Window Manager Group") || ("Administrators" && "Window Manager\Window Manager Group")
  right_type        : SeIncreaseBasePriorityPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0086 - MSWRK - AC - MSWRK - Load and unload device drivers is set to Administrators"
  info              : "This policy setting allows users to dynamically load a new device driver on a system."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators"
  right_type        : SeLoadDriverPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0087 - MSWRK - AC - MSWRK - Lock pages in memory is set to No One"
  info              : "This policy setting allows a process to keep data in physical memory, which prevents the system from paging the data to virtual memory on disk."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : ""
  right_type        : SeLockMemoryPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0088 - MSWRK - AC - MSWRK - Act as part of the operating system is set to No One"
  info              : "This policy setting allows a process to assume the identity of any user and thus gain access to the resources that the user is authorized to access."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : ""
  right_type        : SeTcbPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0089 - MSWRK - AC - MSWRK - Manage auditing and security log is set to Administrators"
  info              : "This policy setting determines which users can change the auditing options for files and directories and clear the Security log."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators"
  right_type        : SeSecurityPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0090 - MSWRK - AC - MSWRK - Modify an object label is set to No One"
  info              : "This privilege determines which user accounts can modify the integrity label of objects, such as files, registry keys, or processes owned by other users."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : ""
  right_type        : SeReLabelPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0091 - MSWRK - AC - MSWRK - Modify firmware environment values is set to Administrators"
  info              : "This policy setting allows users to configure the system-wide environment variables that affect hardware configuration."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators"
  right_type        : SeSystemEnvironmentPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0092 - MSWRK - AC - MSWRK - Perform volume maintenance tasks is set to Administrators"
  info              : "This policy setting allows users to manage the systems volume or disk configuration, which could allow a user to delete a volume and cause data loss as well as a denial-of-service condition."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators"
  right_type        : SeManageVolumePrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0093 - MSWRK - AC - MSWRK - Profile single process is set to Administrators"
  info              : "This policy setting determines which users can use tools to monitor the performance of non-system processes."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators"
  right_type        : SeProfileSingleProcessPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0094 - MSWRK - AC - MSWRK - Profile system performance is set to Administrators, NT SERVICE\WdiServiceHost"
  info              : "This policy setting allows users to use tools to view the performance of different system processes, which could be abused to allow attackers to determine a systems active processes and provide insight into the potential attack surface of the computer."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators" && ("NT SERVICE\WdiServiceHost" || "WdiServiceHost")
  right_type        : SeSystemProfilePrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0095 - MSWRK - AC - MSWRK - Replace a process level token is set to LOCAL SERVICE, NETWORK SERVICE"
  info              : "This policy setting allows one process or service to start another service or process with a different security access token, which can be used to modify the security access token of that sub-process and result in the escalation of privileges."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "LOCAL SERVICE" && "NETWORK SERVICE"
  right_type        : SeAssignPrimaryTokenPrivilege
  check_type        : CHECK_SUPERSET
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0096 - MSWRK - AC - MSWRK - Restore files and directories is set to Administrators"
  info              : "This policy setting determines which users can bypass file, directory, registry, and other persistent object permissions when restoring backed up files and directories on computers that run Windows Vista (or newer) in your environment."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators"
  right_type        : SeRestorePrivilege
  check_type        : CHECK_SUPERSET
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0097 - MSWRK - AC - MSWRK - Shut down the system is set to Administrators, Users"
  info              : "This policy setting determines which users who are logged on locally to the computers in your environment can shut down the operating system with the Shut Down command."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Users" && "Administrators"
  right_type        : SeShutdownPrivilege
  check_type        : CHECK_SUPERSET
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0098 - MSWRK - AC - MSWRK - Take ownership of files or other objects is set to Administrators"
  info              : "This policy setting allows users to take ownership of files, folders, registry keys, processes, or threads."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators"
  right_type        : SeTakeOwnershipPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0099 - MSWRK - AC - MSWRK - Adjust memory quotas for a process is set to Administrators, LOCAL SERVICE, NETWORK SERVICE"
  info              : "This policy setting allows a user to adjust the maximum amount of memory that is available to a process."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators" && "LOCAL SERVICE" && "NETWORK SERVICE"
  right_type        : SeIncreaseQuotaPrivilege
  check_type        : CHECK_SUPERSET
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0100 - MSWRK - AC - MSWRK - Allow log on locally is set to Administrators, Users"
  info              : "This policy setting determines which users can interactively log on to computers in your environment."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators" && "Users"
  right_type        : SeInteractiveLogonRight
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0101 - MSWRK - AC - MSWRK - Allow log on through Remote Desktop Services is set to Administrators, Remote Desktop Users"
  info              : "This policy setting determines which users or groups have the right to log on as a Remote Desktop Services client."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators" && "Remote Desktop Users"
  right_type        : SeRemoteInteractiveLogonRight
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0102 - MSWRK - AC - MSWRK - Back up files and directories is set to Administrators"
  info              : "This policy setting allows users to circumvent file and directory permissions to back up the system."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "Administrators"
  right_type        : SeBackupPrivilege
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0103 - MSWRK - AC - MSWRK - Ensure Change the system time is set to Administrators, LOCAL SERVICE'"
  info              : "This policy setting determines which users and groups can change the time and date on the internal clock of the computers in your environment."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "administrators" && "local service"
  right_type        : SeSystemTimePrivilege
  check_type        : CHECK_EQUAL_ANY
</custom_item>

<custom_item>
  type              : USER_RIGHTS_POLICY
  description       : "1.0104 - MSWRK - AC - MSWRK - Ensure Change the time zone is set to Administrators, LOCAL SERVICE'"
  info              : "This setting determines which users can change the time zone of the computer."
  see_also          : "See HTH Policies and Standards"
  value_type        : USER_RIGHT
  value_data        : "administrators" && "local service"
  right_type        : SeTimeZonePrivilege
  check_type        : CHECK_EQUAL_ANY
</custom_item>

<custom_item>
  type              : ANONYMOUS_SID_SETTING
  description       : "1.0105 - MSWRK - AC - MSWRK - Network access: Allow anonymous SID/Name translation is set to Disabled"
  info              : "This policy setting determines whether an anonymous user can request security identifier (SID) attributes for another user, or use a SID to obtain its corresponding user name."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_SET
  value_data        : "Disabled"
</custom_item>


<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0106 - MSWRK - AC - MSWRK - Network access: Shares that can be accessed anonymously is set to None"
  info              : "This policy setting determines which network shares can be accessed by anonymous users."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : ""
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters').NullSessionShares;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
  powershell_option : CAN_BE_NULL
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0107 - MSWRK - CM - MSWRK - Network access: Sharing and security model for local accounts is set to Classic - local users authenticate as themselves"
  info              : "This policy setting determines how network logons that use local accounts are authenticated."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Lsa').ForceGuest;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0108 - MSWRK - AC - MSWRK - Network access: Do not allow anonymous enumeration of SAM accounts is set to Enabled"
  info              : "This policy setting controls the ability of anonymous users to enumerate the accounts in the Security Accounts Manager (SAM)."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Lsa').RestrictAnonymousSAM;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>



<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0109 - MSWRK - AC - MSWRK - Network access: Let Everyone permissions apply to anonymous users is set to Disabled"
  info              : "This policy setting determines what additional permissions are assigned for anonymous connections to the computer."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Lsa').EveryoneIncludesAnonymous;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0110 - MSWRK - IA - MSWRK - Network access: Named Pipes that can be accessed anonymously is set to None"
  info              : "This policy setting determines which communication sessions, or pipes, will have attributes and permissions that allow anonymous access."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : ""
  powershell_args   : "if(Test-Path -Path 'HKLM:\SYSTEM\CurrentControlSet\Services\LanManServer\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Services\LanManServer\Parameters').NullSessionPipes;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  powershell_option : CAN_BE_NULL
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0111 - MSWRK - AC - MSWRK - Network access: Remotely accessible registry paths is configured"
  info              : "This policy setting determines which registry paths will be accessible over the network, regardless of the users or groups listed in the access control list (ACL) of the winreg registry key."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "System\\CurrentControlSet\\Control\\ProductOptions" && "System\\CurrentControlSet\\Control\\Server Applications" && "Software\\Microsoft\\Windows NT\\CurrentVersion"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedExactPaths'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedExactPaths').Machine;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0112 - MSWRK - AC - MSWRK - Network access: Remotely accessible registry paths and sub-paths is configured"
  info              : "This policy setting determines which registry paths and sub-paths will be accessible over the network, regardless of the users or groups listed in the access control list (ACL) of the winreg registry key."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "System\\CurrentControlSet\\Control\\Print\\Printers" && "System\\CurrentControlSet\\Services\\Eventlog" && "Software\\Microsoft\\OLAP Server" && "Software\\Microsoft\\Windows NT\\CurrentVersion\\Print" && "Software\\Microsoft\\Windows NT\\CurrentVersion\\Windows" && "System\\CurrentControlSet\\Control\\ContentIndex" && "System\\CurrentControlSet\\Control\\Terminal Server" && "System\\CurrentControlSet\\Control\\Terminal Server\\UserConfig" && "System\\CurrentControlSet\\Control\\Terminal Server\\DefaultUserConfiguration" && "Software\\Microsoft\\Windows NT\\CurrentVersion\\Perflib" && "System\\CurrentControlSet\\Services\\Sysmonlog"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedPaths'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\SecurePipeServers\Winreg\AllowedPaths').Machine;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0113 - MSWRK - AC - MSWRK - Network access: Restrict anonymous access to Named Pipes and Shares is set to Enabled"
  info              : "When enabled, this policy setting restricts anonymous access to only those shares and pipes that are named in the Network access: Named pipes that can be accessed anonymously and Network access: Shares that can be accessed anonymously settings."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters').RestrictNullSessAccess;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>









<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0114 - MSWRK - IA - MSWRK - Network security: Do not store LAN Manager hash value on next password change is set to Enabled"
  info              : "This policy setting determines whether the LAN Manager (LM) hash value for the new password is stored when the password is changed."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Lsa').NoLMHash;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>


<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0115 - MSWRK - AC - MSWRK - Network security: LAN Manager authentication level is set to Send NTLMv2 response only. Refuse LM & NTLM"
  info              : "LAN Manager (LM) was a family of early Microsoft client/server software (predating Windows NT) that allowed users to link personal computers together on a single network."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^5$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Lsa').LMCompatibilityLevel;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0116 - MSWRK - AC - MSWRK - Network security: LDAP client signing requirements is set to Negotiate signing or higher"
  info              : "This policy setting determines the level of data signing that is requested on behalf of clients that issue LDAP BIND requests."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$" || "^2$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\LDAP'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\LDAP').LDAPClientIntegrity;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>


<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0117 - MSWRK - IA - MSWRK - Account - Guest Account Disabled"
  info              : "The built-in local guest account should be disabled."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "False"
  powershell_args   : "$noutput = Get-LocalUser | Where-Object { $_.SID -Match '^S-1-5-21.*-501$' } | Select-Object Name, Enabled; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0118 - MSWRK - IA - MSWRK - Accounts: Limit local account use of blank passwords to console logon only is set to Enabled"
  info              : "This policy setting determines whether local accounts that are not password protected can be used to log on from locations other than the physical computer console."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Lsa').LimitBlankPasswordUse;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0119 - MSWRK - IA - MSWRK - Account - Local Admin Account Enabled"
  info              : "The built-in local admin account should be disabled."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "False"
  powershell_args   : "$noutput = Get-LocalUser | Where-Object { $_.SID -Match '^S-1-5-21.*-500$' } | Select-Object Name, Enabled; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0120 - MSWRK - IA - MSWRK - Account - Rename Local Admin"
  info              : "The built-in local admin account should be renamed."
  value_type        : POLICY_TEXT
  value_data        : "Administrator" || "Admin"
  powershell_args   : "$noutput = Get-LocalUser | Where-Object { $_.SID -Match '^S-1-5-21.*-500$' } | Select-Object Name; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
  check_type        : CHECK_NOT_EQUAL
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0121 - MSWRK - IA - MSWRK - Account - Rename Guest Account"
  info              : "The built-in local guest account should be reset."
  value_type        : POLICY_TEXT
  value_data        : "Guest"
  powershell_args   : "$noutput = (Get-LocalUser | Where-Object { $_.SID -Match '^S-1-5-21.*-501$' }).Name; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
  check_type        : CHECK_NOT_EQUAL
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0122 - MSWRK - CM - MSWRK - System objects: Require case insensitivity for non-Windows subsystems is set to Enabled"
  info              : "This policy setting determines whether case insensitivity is enforced for all subsystems."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Session Manager\Kernel'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Session Manager\Kernel').ObCaseInsensitive;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0123 - MSWRK - CM - MSWRK - System objects: Strengthen default permissions of internal system objects (e.g. Symbolic Links) is set to Enabled"
  info              : "This policy setting determines the strength of the default discretionary access control list (DACL) for objects."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Session Manager'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Session Manager').ProtectionMode;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>





<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0124 - MSWRK - AC - MSWRK - User Account Control: Only elevate UIAccess applications that are installed in secure locations is set to Enabled"
  info              : "This policy setting controls whether applications that request to run with a User Interface Accessibility (UIAccess) integrity level must reside in a secure location in the file system."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').EnableSecureUIAPaths;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0125 - MSWRK - AC - MSWRK - User Account Control: Run all administrators in Admin Approval Mode is set to Enabled"
  info              : "This policy setting controls the behavior of all User Account Control (UAC) policy settings for the computer."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').EnableLUA;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>


<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0126 - MSWRK - SC - MSWRK - User Account Control: Virtualize file and registry write failures to per-user locations is set to Enabled"
  info              : "This policy setting controls whether application write failures are redirected to defined registry and file system locations."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').EnableVirtualization;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>


<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0127 - MSWRK - AU - MSWRK - Audit: Shut down system immediately if unable to log security audits is set to Disabled"
  info              : "This policy setting determines whether the system shuts down if it is unable to log Security events."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Lsa').CrashOnAuditFail;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0128 - MSWRK - AC - MSWRK - Domain member: Digitally encrypt or sign secure channel data (always) is set to Enabled"
  info              : "This policy setting determines whether all secure channel traffic that is initiated by the domain member must be signed or encrypted."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters').RequireSignOrSeal;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0129 - MSWRK - AC - MSWRK - Domain member: Digitally encrypt secure channel data (when possible) is set to Enabled"
  info              : "This policy setting determines whether a domain member should attempt to negotiate encryption for all secure channel traffic that it initiates."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters').SealSecureChannel;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0130 - MSWRK - AC - MSWRK - Domain member: Digitally sign secure channel data (when possible) is set to Enabled"
  info              : "This policy setting determines whether a domain member should attempt to negotiate whether all secure channel traffic that it initiates must be digitally signed."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters').SignSecureChannel;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0131 - MSWRK - AC - MSWRK - Domain member: Disable machine account password changes is set to Disabled"
  info              : "This policy setting determines whether a domain member can periodically change its computer account password."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters').DisablePasswordChange;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>



<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0132 - MSWRK - IA - MSWRK - Domain member: Maximum machine account password age is set to 30 or fewer days, but not 0"
  info              : "This policy setting determines the maximum allowable age for a computer account password."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "[1..30]"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters').MaximumPasswordAge;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0133 - MSWRK - AC - MSWRK - Domain member: Require strong (Windows 2000 or later) session key is set to Enabled"
  info              : "When this policy setting is enabled, a secure channel can only be established with Domain Controllers that are capable of encrypting secure channel data with a strong (128-bit) session key."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters').RequireStrongKey;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0134 - MSWRK - CM - MSWRK - Interactive logon: Do not require CTRL+ALT+DEL is set to Disabled"
  info              : "This policy setting determines whether users must press CTRL+ALT+DEL before they log on."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').DisableCAD;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>


<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0135 - MSWRK - AC - MSWRK - Screensaver - Timeout is set to 900 seconds or fewer"
  info              : "This setting ensures that the screensaver will autmatically start after 900 seconds or lesss of inactivity."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "900"
  powershell_args   : "$noutput = (Get-ItemProperty 'registry::hkey_users\S-1-5-21*\Software\Policies\Microsoft\Windows\Control Panel\Desktop').ScreenSaveTimeOut; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
  check_type        : CHECK_EQUAL
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0136 - MSWRK - IA - MSWRK - Interactive logon Prompt user to change password before expiration is set to between 5 and 14 days"
  info              : "This policy setting determines how far in advance users are warned that their password will expire."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "[5..14]"
  powershell_args   : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon').PasswordExpiryWarning;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>


<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0137 - MSWRK - AC - MSWRK - Microsoft network client: Digitally sign communications (always) is set to Enabled"
  info              : "This policy setting determines whether packet signing is required by the SMB client component."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\LanmanWorkstation\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\LanmanWorkstation\Parameters').RequireSecuritySignature;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0138 - MSWRK - AC - MSWRK - Microsoft network client: Digitally sign communications (if server agrees) is set to Enabled"
  info              : "This policy setting determines whether the SMB client will attempt to negotiate SMB packet signing."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\LanmanWorkstation\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\LanmanWorkstation\Parameters').EnableSecuritySignature;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>

<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0139 - MSWRK - AC - MSWRK - Microsoft network client: Send unencrypted password to third-party SMB servers is set to Disabled"
  info              : "This policy setting determines whether the SMB redirector will send plaintext passwords during authentication to third-party SMB servers that do not support password encryption."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^0$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\LanmanWorkstation\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\LanmanWorkstation\Parameters').EnablePlainTextPassword;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>


<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0140 - MSWRK - AC - MSWRK - Microsoft network server: Digitally sign communications (always) is set to Enabled"
  info              : "This policy setting determines whether packet signing is required by the SMB server component."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
  powershell_args   : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters').RequireSecuritySignature;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
  check_type        : CHECK_REGEX
</custom_item>


<custom_item>
  type              : AUDIT_POWERSHELL
  description       : "1.0141 - MSWRK - AC - MSWRK - Microsoft network server: Disconnect clients when logon hours expire is set to Enabled"
  info              : "This security setting determines whether to disconnect users who are connected to the local computer outside their user accounts valid logon hours and should be implemented in conjunction with Network Security Force Logoff."
  see_also          : "See HTH Policies and Standards"
  value_type        : POLICY_TEXT
  value_data        : "^1$"
