           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Allow widgets is set to Disabled"
                       info : "This policy setting specifies whether the Widgets feature is allowed on the device. The Widgets feature provides information such as, weather, news, sports, stocks, traffic, and entertainment (not an inclusive list)."
                  reference : "NIST 800-53r5|CM-6 "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^0$"
            powershell_args : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Dsh'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Dsh').AllowNewsAndInterests;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
