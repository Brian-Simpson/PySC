           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "RA - MSWRK - Ensure 'Configure Automatic Updates' is set to 'Disabled'"
                       info : "This policy setting specifies whether computers in your environment will receive security updates from Windows Update or WSUS."
                  reference : "NIST 800-53r5|RA-5 SI-2(2)"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "1"
            powershell_args : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\WindowsUpdate\AU'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\WindowsUpdate\AU').NoAutoUpdate;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_EQUAL
           </custom_item>

