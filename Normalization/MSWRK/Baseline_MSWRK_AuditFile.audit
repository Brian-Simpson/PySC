                 value_data : "Running"
            powershell_args : "$noutput = (Get-Service -name 'ir_agent').status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

