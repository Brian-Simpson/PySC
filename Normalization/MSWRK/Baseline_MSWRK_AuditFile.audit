           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AC - MSWRK - Ensure Sign-in and lock last interactive user automatically after a restart is set to Disabled."
                       info : "This policy setting controls whether a device will automatically sign-in the last interactive user after Windows Update restarts the system."
                  reference : "NIST 800-53r5|AC-11"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "1"
            powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').DisableAutomaticRestartSignOn;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_EQUAL
           </custom_item>

