           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "SI - MSWRK - Ensure 'Always prompt for password upon connection' is set to 'Disabled'"
                       info : "This policy setting specifies whether Remote Desktop Services always prompts the client computer for a password upon connection."
                  reference : "NIST 800-53r5|SI-4"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "1"
            powershell_args : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows NT\Terminal Services'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows NT\Terminal Services').fPromptForPassword;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_EQUAL
           </custom_item>

