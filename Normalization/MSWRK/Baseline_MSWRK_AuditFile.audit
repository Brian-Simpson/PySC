           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "SC - MSWRK - Enable Certificate Padding is set to Enabled"
                       info : "This policy setting configures whether the"
                  reference : "NIST 800-53r5|SC-8 "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^1$"
            powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Cryptography\Wintrust\Config'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Cryptography\Wintrust\Config').EnableCertPaddingCheck;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

