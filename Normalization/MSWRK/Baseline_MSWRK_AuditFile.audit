           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "SC - MSWRK - MSS: (DisableIPSourceRouting IPv6) IP source routing protection level is set to Enabled: Highest protection, source routing is completely disabled"
                       info : "IP source routing is a mechanism that allows the sender to determine the IP route that a datagram should follow through the network."
                  reference : "NIST 800-53r5|SC-7(12) "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^2$"
            powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Tcpip6\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Tcpip6\Parameters').DisableIPSourceRouting;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "SC - MSWRK - MSS: (DisableIPSourceRouting) IP source routing protection level is set to Enabled: Highest protection, source routing is completely disabled"
                       info : "IP source routing is a mechanism that allows the sender to determine the IP route that a datagram should take through the network. It is recommended to configure this setting to Not Defined for enterprise environments and to Highest Protection for high security environments to completely disable source routing."
                  reference : "NIST 800-53r5|SC-7(12) "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^2$"
            powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Tcpip\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Tcpip\Parameters').DisableIPSourceRouting;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

