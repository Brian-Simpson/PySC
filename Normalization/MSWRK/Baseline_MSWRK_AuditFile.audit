           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - NetBT NodeType configuration is set to Enabled: P-node (recommended)"
                       info : "This setting determines which method NetBIOS over TCP/IP (NetBT) uses to register and resolve names. The available methods are:"
                  reference : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^2$"
            powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\NetBT\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\NetBT\Parameters').NodeType;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

