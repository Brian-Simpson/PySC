           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Ensure Only display the private store within the Microsoft Store is set to 'Disabled'"
                       info : "This policy setting denies access to the retail catalog in the Microsoft Store, but displays the private store."
                  reference : "NIST 800-53r5|CM-7(5)CM-10"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "0"
            powershell_args : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\WindowsStore'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\WindowsStore').RequirePrivateStoreOnly;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_EQUAL
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "RA - MSWRK - Ensure Turn off Automatic Download and Install of updates is set to Disabled."
