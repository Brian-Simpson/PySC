           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Minimize the number of simultaneous connections to the Internet or a Windows Domain is set to Enabled: 3 = Prevent Wi-Fi when on Ethernet"
                       info : "This policy setting prevents computers from establishing multiple simultaneous connections to either the Internet or to a Windows domain."
                  reference : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^3$"
            powershell_args : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\WcmSvc\GroupPolicy'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\WcmSvc\GroupPolicy').fMinimizeConnections;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

