           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AC - MSWRK - MSS: (ScreenSaverGracePeriod) The time in seconds before the screen saver grace period expires is set to Enabled: 5 or fewer seconds"
                       info : "Windows includes a grace period between when the screen saver is launched and when the console is actually locked automatically when screen saver locking is enabled."
                  reference : "NIST 800-53r5|AC-2(5) AC-11 AC-11(1) "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "[0..5]"
            powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon').ScreenSaverGracePeriod;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AC - MSWRK - Screensaver - Enabled"
                       info : "This ensures that the screen saver is enabled."
                  reference : "NIST 800-53r5|AC-2(5) AC-11(1) AC-12"
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "1"
            powershell_args : "$noutput = (Get-ItemProperty 'registry::hkey_users\S-1-5-21*\Software\Policies\Microsoft\Windows\Control Panel\Desktop').ScreenSaveActive; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                 check_type : CHECK_EQUAL
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AC - MSWRK - Screensaver - Password protect the screen saver- Enabled"
                       info : "This setting ensures that the user is prompteed fror a password whne the screensaver is enabled."
                  reference : "NIST 800-53r5|AC-2(5) AC-11(1) AC-12"
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "1"
            powershell_args : "$noutput = (Get-ItemProperty 'registry::hkey_users\S-1-5-21*\Software\Policies\Microsoft\Windows\Control Panel\Desktop').ScreenSaverIsSecure; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                 check_type : CHECK_EQUAL
           </custom_item>

