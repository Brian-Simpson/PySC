           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AC - MSWRK - User Account Control: Only elevate UIAccess applications that are installed in secure locations is set to Enabled"
                       info : "This policy setting controls whether applications that request to run with a User Interface Accessibility (UIAccess) integrity level must reside in a secure location in the file system. Secure locations are limited to the following:"
                  reference : "NIST 800-53r5|AC-6(8) "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^1$"
            powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').EnableSecureUIAPaths;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AC - MSWRK - User Account Control: Run all administrators in Admin Approval Mode is set to Enabled"
                       info : "This policy setting controls the behavior of all User Account Control (UAC) policy settings for the computer. If you change this policy setting, you must restart your computer."
                  reference : "NIST 800-53r5|AC-6(1) "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^1$"
            powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').EnableLUA;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

