                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Services - SentinelOne Agent Log Processing Service"
                       info : "Manage logs for SentinelOne Endpoint Protection"
                  reference : "NIST 800-53r5|CM-6"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Running"
            powershell_args : "$noutput = (Get-Service -name 'LogProcessorService').status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Services - SentinelOne Static Service"
                       info : "Manage static engines for SentinelOne Endpoint Protection."
                  reference : "NIST 800-53r5|CM-6"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Running"
            powershell_args : "$noutput = (Get-Service -name 'SentinelStaticEngine').status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Services - Xbox Live Auth Manager"
                       info : "The Xbox Live Auth Manager Service is disabled."
                  reference : "NIST 800-53r5|CM-6"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Stopped" || "Service Not Found"
            powershell_args : "$noutput = (Get-Service -name 'XblAuthManager').status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Services - Xbox Live Game Save Service"
                       info : "The Xbox Live Game Save Service is disabled."
                  reference : "NIST 800-53r5|CM-6"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Stopped" || "Service Not Found"
            powershell_args : "$noutput = (Get-Service -name 'XblGameSave').status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Services - Xbox Live Networking Service"
                       info : "The Xbox Live Networking Service is disabled."
                  reference : "NIST 800-53r5|CM-6"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Stopped" || "Service Not Found"
            powershell_args : "$noutput = (Get-Service -name 'XboxNetApiSvc').status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Simple TCP/IP Services (simptcp) is Not Installed"
                       info : "The Simple TCP/IP Services have very little purpose in a modern enterprise environment."
                  reference : "NIST 800-53r5|CM-6 CM-7"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Service Not Found"
            powershell_args : "$noutput = (Get-Service -name 'simpt*').status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - SMB v1 server is set to Disabled"
                       info : "This setting configures the server-side processing of the Server Message Block version 1 (SMBv1) protocol."
                  reference : "NIST 800-53r5|CM-6 CM-7"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Disabled"
            powershell_args : "$noutput = (Get-WindowsOptionalFeature -Online -FeatureName SMB1Protocol).State; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                 check_type : CHECK_EQUAL
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Turn off multicast name resolution"
                       info : "LLMNR is a secondary name resolution protocol."
                  reference : "NIST 800-53r5|CM-6 CM-7"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "0"
            powershell_args : "if(Test-Path -Path 'HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\DNSClient'){$noutput = (Get-ItemProperty -Path 'HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\DNSClient').EnableMulticast;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_EQUAL
           </custom_item>

           </then>

           <else>

           <report type: "WARNING">
                description : "MSWRK - WARNING - TARGET OS DOESNT MATCH BASELINE - WINWRK"
                       info : "NOTE: Nessus has identified that the chosen audit does not apply to the target device."
                   see_also : "Link to Controls"
           </report>

           </else>

           </if>

           </group_policy>

           </check_type>