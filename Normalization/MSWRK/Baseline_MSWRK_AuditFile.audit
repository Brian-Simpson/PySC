                 value_data : "1"
            powershell_args : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows Defender\Real-Time Protection').DisableIOAVProtection;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
