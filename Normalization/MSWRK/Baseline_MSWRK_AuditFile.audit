           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AC - MSWRK - Microsoft network server: Disconnect clients when logon hours expire is set to Enabled"
                       info : "This security setting determines whether to disconnect users who are connected to the local computer outside their user accounts valid logon hours and should be implemented in conjunction with Network Security Force Logoff. This setting affects the Server Message Block (SMB) component."
                  reference : "NIST 800-53r5|AC-2(12) "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^1$"
            powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\LanManServer\Parameters').EnableForcedLogoff;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

