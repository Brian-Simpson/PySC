           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Turn off multicast name resolution is set to Enabled"
                       info : "LLMNR is a secondary name resolution protocol. With LLMNR, queries are sent using multicast over a local network link on a single subnet from a client computer to another client computer on the same subnet that also has LLMNR enabled. LLMNR does not require a DNS server or DNS client configuration, and provides name resolution in scenarios in which conventional DNS name resolution is not possible."
                  reference : "NIST 800-53r5|CM-6 "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^0$"
            powershell_args : "if(Test-Path -Path 'HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\DNSClient'){$noutput = (Get-ItemProperty -Path 'HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\DNSClient').EnableMulticast;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

