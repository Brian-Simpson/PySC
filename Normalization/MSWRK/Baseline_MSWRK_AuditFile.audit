           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "IA - MSWRK - Account - Guest Account Disabled"
                       info : "The built-in local guest account should be disabled."
                  reference : "NIST 800-53r5|IA-5"
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "False"
            powershell_args : "$noutput = Get-LocalUser | Where-Object { $_.SID -Match '^S-1-5-21.*-501$' } | Select-Object Name, Enabled; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "IA - MSWRK - Accounts: Limit local account use of blank passwords to console logon only is set to Enabled"
                       info : "This policy setting determines whether local accounts that are not password protected can be used to log on from locations other than the physical computer console. If you enable this policy setting, local accounts that have blank passwords will not be able to log on to the network from remote client computers. Such accounts will only be able to log on at the keyboard of the computer."
                  reference : "NIST 800-53r5|IA-5(1) "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^1$"
            powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Lsa').LimitBlankPasswordUse;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "IA - MSWRK - Account - Local Admin Account Enabled"
                       info : "The built-in local admin account should be disabled"
                  reference : "NIST 800-53r5|IA-5"
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "False"
            powershell_args : "$noutput = Get-LocalUser | Where-Object { $_.SID -Match '^S-1-5-21.*-500$' } | Select-Object Name, Enabled; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "IA - MSWRK - Account - Rename Local Admin"
                       info : "The built-in local admin account should be renamed."
                  reference : "NIST 800-53r5|IA-5"
                 value_type : POLICY_TEXT
                 value_data : "Administrator" || "Admin"
            powershell_args : "$noutput = Get-LocalUser | Where-Object { $_.SID -Match '^S-1-5-21.*-500$' } | Select-Object Name; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                 check_type : CHECK_NOT_EQUAL
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "IA - MSWRK - Account - Rename Guest Account"
                       info : "The built-in local guest account should be reset"
                  reference : "NIST 800-53r5|IA-5"
                 value_type : POLICY_TEXT
                 value_data : "Guest"
            powershell_args : "$noutput = (Get-LocalUser | Where-Object { $_.SID -Match '^S-1-5-21.*-501$' }).Name; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                 check_type : CHECK_NOT_EQUAL
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - System objects: Require case insensitivity for non-Windows subsystems is set to Enabled"
                       info : "This policy setting determines whether case insensitivity is enforced for all subsystems. The Microsoft Win32 subsystem is case insensitive. However, the kernel supports case sensitivity for other subsystems, such as the Portable Operating System Interface for UNIX (POSIX). Because Windows is case insensitive (but the POSIX subsystem will support case sensitivity), failure to enforce this policy setting makes it possible for a user of the POSIX subsystem to create a file with the same name as another file by using mixed case to label it. Such a situation can block access to these files by another user who uses typical Win32 tools, because only one of the files will be available."
                  reference : "NIST 800-53r5|CM-6b. "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^1$"
            powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Session Manager\Kernel'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Session Manager\Kernel').ObCaseInsensitive;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - System objects: Strengthen default permissions of internal system objects (e.g. Symbolic Links) is set to Enabled"
                       info : "This policy setting determines the strength of the default discretionary access control list (DACL) for objects. Active Directory maintains a global list of shared system resources, such as DOS device names, mutexes, and semaphores. In this way, objects can be located and shared among processes. Each type of object is created with a default DACL that specifies who can access the objects and what permissions are granted."
                  reference : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^1$"
            powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Session Manager'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Session Manager').ProtectionMode;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

