           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "SC - MSWRK - Services - Windows Firewall is enabled"
                       info : "The Windows Firewall service should be automatically enabled on startup."
                  reference : "NIST 800-53r5|CM-6"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Running"
            powershell_args : "$noutput = (Get-Service -name 'MpsSvc').status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Services - Windows Defender"
                       info : "The Windows Defender service should be automatically enabled on startup."
                  reference : "NIST 800-53r5|CM-6"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Running"
            powershell_args : "$noutput = (Get-Service -name 'Sense').status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Services - BitLocker Drive Encryption Service"
                       info : "The BitLocker Drive Encryption service should be manually enabled on startup."
                  reference : "NIST 800-53r5|CM-6"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Running"
            powershell_args : "$noutput = (Get-Service -name 'BDESVC').status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Services - Security Accounts Manager"
                       info : "The Security Accounts Manager service should be automatically enabled on startup."
                  reference : "NIST 800-53r5|CM-6"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Running"
            powershell_args : "$noutput = (Get-Service -name 'SamSs').Status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Services - Cisco VPN Secure Client"
                       info : "The Cisco VPN Secure Client service should be automatically enabled on startup."
                  reference : "NIST 800-53r5|CM-6"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Running"
            powershell_args : "$noutput = (Get-Service -Name csc_vpnagent).status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Services - Windows Event Log"
                       info : "The Windows Event Log service should be automatically enabled on startup."
                  reference : "NIST 800-53r5|CM-6"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Running"
            powershell_args : "$noutput = (Get-Service -Name EventLog).status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : USER_RIGHTS_POLICY
                description : "AC - MSWRK - Create a pagefileallowed for Administrators"
                       info : "This policy setting allows users to change the size of the pagefile."
                  reference : "NIST 800-53r5|AC-2 AC-3 AC-6 AC-6(1) AC-6(7) AU-9(4)"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : USER_RIGHT
                 value_data : "Administrators"
                 right_type : SeCreatePagefilePrivilege
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - TCPIP6 is disabled"
                       info : "This setting determines if TCPIPV6 is disabled"
                  reference : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "255"
            powershell_args : "if(Test-Path -Path 'HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip6\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip6\Parameters').DisabledComponents;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_EQUAL
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Check if WinRM service is running"
                       info : "Windows Remote Management (WinRM) is the Microsoft implementation of the WS-Management protocol."
                  reference : "NIST 800-53r5|CM-6 CM-7"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Running"
            powershell_args : "$noutput = (Get-Service -name 'WinRM').status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Computer Browser (Browser) is not Installed"
                       info : "Maintains an updated list of computers on the network and supplies this list to computers designated as browsers."
                  reference : "NIST 800-53r5|CM-6 CM-7"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Disabled"
            powershell_args : "$noutput = (Get-WindowsOptionalFeature -Online -FeatureName SMB1Protocol).State; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                 check_type : CHECK_EQUAL
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Disable SMB v1 client driver."
                       info : "This setting configures the start type for the Server Message Block version 1 (SMBv1) client driver service ( MRxSmb10 )."
                  reference : "NIST 800-53r5|CM-6 CM-7"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "4"
            powershell_args : "if(Test-Path -Path 'HKLM:\SYSTEM\CurrentControlSet\Services\mrxsmb10'){$noutput = (Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Services\mrxsmb10').Start; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_EQUAL
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Services - BitLocker Drive Encryption Management Service"
                       info : "The BitLocker Management Client Service is automatically enabled on startup."
                  reference : "NIST 800-53r5|CM-6"
                   see_also : "See corresponding HTH Policy or Standard"
                 value_type : POLICY_TEXT
                 value_data : "Running"
            powershell_args : "$noutput = (Get-Service -name 'MBAMAgent').status; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Services - Rapid7 Insight Agent Service"
