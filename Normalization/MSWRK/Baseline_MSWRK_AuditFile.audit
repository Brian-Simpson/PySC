           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Turn on convenience PIN sign-in is set to Disabled"
                       info : "This policy setting allows you to control whether a domain user can sign in using a convenience PIN. In Windows 10, convenience PIN was replaced with Passport, which has stronger security properties. To configure Passport for domain users, use the policies under Computer Configuration\Administrative Templates\Windows Components\Microsoft Passport for Work."
                  reference : "NIST 800-53r5|CM-6 "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^0$"
            powershell_args : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\System').AllowDomainPINLogon;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

