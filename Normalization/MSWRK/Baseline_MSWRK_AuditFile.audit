           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AC - MSWRK - Prevent enabling lock screen slide show is set to Enabled"
                       info : "Disables the lock screen slide show settings in PC Settings and prevents a slide show from playing on the lock screen."
                  reference : "NIST 800-53r5|AC-11 "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^1$"
            powershell_args : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\Personalization'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\Personalization').NoLockScreenSlideshow;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "CM - MSWRK - Allow users to enable online speech recognition services is set to Disabled"
                       info : "This policy enables the automatic learning component of input personalization that includes speech, inking, and typing. Automatic learning enables the collection of speech and handwriting patterns, typing history, contacts, and recent calendar information. It is required for the use of Cortana. Some of this collected information may be stored on the users OneDrive, in the case of inking and typing; some of the information will be uploaded to Microsoft to personalize speech."
                  reference : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "^0$"
            powershell_args : "if(Test-Path -Path 'HKLM:\SOFTWARE\Policies\Microsoft\InputPersonalization'){$noutput = (Get-ItemProperty -Path 'HKLM:\SOFTWARE\Policies\Microsoft\InputPersonalization').AllowInputPersonalization;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
                 check_type : CHECK_REGEX
           </custom_item>

