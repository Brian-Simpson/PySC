           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AU - MSWRK - Audit Policy Change is set to include Success"
                       info : "This subcategory reports changes in audit policy including SACL changes. Events for this subcategory include:"
                  reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "Success" || "Success and Failure"
            powershell_args : "$APC = auditpol /get /Subcategory:'Audit Policy Change' |Select-String 'Audit Policy Change'; $APCStr=$APC.ToString(); $APCStr -match 'Success and Failure' | out-null; $LOAPC = $matches[0]; Write-Output $LOAPC"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AU - MSWRK - Audit Authentication Policy Change is set to include Success"
                       info : "This subcategory reports changes in authentication policy. Events for this subcategory include:"
                  reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "Success" || "Success and Failure"
            powershell_args : "$AuthPC = auditpol /get /Subcategory:'Authentication Policy Change' |Select-String 'Authentication Policy Change'; $AuthPCStr=$AuthPC.ToString(); $AuthPCStr -match 'Success and Failure' | out-null; $LOAuthPC = $matches[0]; Write-Output $LOAuthPC"
                 check_type : CHECK_REGEX
           </custom_item>

#            <custom_item>
#                        type : AUDIT_POWERSHELL
#                 description : "QQAU - MSWRK - Audit Authorization Policy Change is set to include Success"
#                        info : "This subcategory reports changes in authorization policy. Events for this subcategory include:"
#                   reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 "
