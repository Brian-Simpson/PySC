
<check_type:"Unix">

<if>
  <condition type:"AND">
<custom_item>
  type            : FILE_CONTENT_CHECK
  description     : "1.0000 - RHEL - Red Hat Enterprise Linux 10 is installed"
  expect          : "^[\\s]*Red Hat Enterprise Linux.*release 10"
  regex           : "^[\\s]*Red Hat Enterprise Linux.*release"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description     : "CIS_Red_Hat_Enterprise_Linux_10_v1.0.1_L1_Server.audit from CIS Red Hat Enterprise Linux 10 1.0.1"
  see_also        : "See HTH Policies and Standards"
  show_output     : "YES"
</report>

    <if>
      <condition type:"AND">
<custom_item>
  type            : CMD_EXEC
  description     : "1.0001 - RHEL - check if cramfs is available"
  expect          : "^pass$"
  cmd             : "#!/bin/bash { l_mod_name=\"cramfs\" l_mod_type=\"fs\" while IFS= read -r l_mod_path; do if [ -d \"$l_mod_path/${l_mod_name//-/\\/}\" ] &&  \\ [ -n \"$(ls -A \"$l_mod_path/${l_mod_name//-/\\/}\")\" ]; then printf '%s\\n' \"$l_mod_name exists in $l_mod_path\" fi done < <(readlink -e /usr/lib/modules/**/kernel/$l_mod_type \\ || readlink -e /lib/modules/**/kernel/$l_mod_type) } | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
</custom_item>
      </condition>

      <then>
<report type:"PASSED">
  description     : "1.1.1.1 Ensure cramfs kernel module is not available"
  info            : "The cramfs filesystem type is a compressed read-only Linux filesystem embedded in small footprint systems."
  solution        : "Unload and disable the cramfs kernel module. - Run the following commands to unload the cramfs kernel module: # modprobe -r cramfs 2>/dev/null # rmmod cramfs 2>/dev/null - Perform the following to disable the cramfs kernel module: Create a file ending in .conf with install cramfs /bin/false in the /etc/modprobe.d/ directory."
  reference       : "NIST 800-53r5|CM-6 CM-7 CM-7a."
  see_also        : "See HTH Policies and Standards"
</report>
      </then>

      <else>
        <if>
          <condition auto:"FAILED" type:"AND">
<custom_item>
  type            : CMD_EXEC
  description     : "1.0002 - RHEL - lsmod cramfs"
  expect          : "^pass$"
  cmd             : "/sbin/lsmod | /bin/grep -P -- 'cramfs' | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
</custom_item>

<custom_item>
  type            : CMD_EXEC
  description     : "1.0003 - RHEL - modprobe cramfs blacklist"
  expect          : "^[\\s]*blacklist[\\s]+cramfs[\\s]*$"
  cmd             : "/sbin/modprobe --showconfig | /bin/grep -P -- '\\b(install|blacklist)\\h+cramfs\\b' "
</custom_item>

<custom_item>
  type            : CMD_EXEC
  description     : "1.0004 - RHEL - modprobe cramfs true/false"
  expect          : "^[\\s]*install[\\s]+cramfs[\\s]+/bin/(true|false)[\\s]*$"
  cmd             : "/sbin/modprobe --showconfig | /bin/grep -P -- '\\b(install|blacklist)\\h+cramfs\\b' "
</custom_item>
          </condition>

          <then>
<report type:"PASSED">
  description     : "1.1.1.1 Ensure cramfs kernel module is not available"
  info            : "The cramfs filesystem type is a compressed read-only Linux filesystem embedded in small footprint systems."
  solution        : "Unload and disable the cramfs kernel module. - Run the following commands to unload the cramfs kernel module: # modprobe -r cramfs 2>/dev/null # rmmod cramfs 2>/dev/null - Perform the following to disable the cramfs kernel module: Create a file ending in .conf with install cramfs /bin/false in the /etc/modprobe.d/ directory."
  reference       : "NIST 800-53r5|CM-6 CM-7 CM-7a."
  see_also        : "See HTH Policies and Standards"
  show_output     : "YES"
</report>
          </then>
        </if>
      </else>
    </if>

    <if>
      <condition type:"AND">
<custom_item>
  type            : CMD_EXEC
  description     : "1.0005 - RHEL - check if usb-storage is available"
  expect          : "^pass$"
  cmd             : "#!/bin/bash { l_mod_name=\"usb-storage\" l_mod_type=\"fs\" while IFS= read -r l_mod_path; do if [ -d \"$l_mod_path/${l_mod_name//-/\\/}\" ] &&  \\ [ -n \"$(ls -A \"$l_mod_path/${l_mod_name//-/\\/}\")\" ]; then printf '%s\\n' \"$l_mod_name exists in $l_mod_path\" fi done < <(readlink -e /usr/lib/modules/**/kernel/$l_mod_type \\ || readlink -e /lib/modules/**/kernel/$l_mod_type) } | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
</custom_item>
      </condition>

      <then>
<report type:"PASSED">
  description     : "1.1.1.10 Ensure usb-storage kernel module is not available"
  info            : "USB storage provides a means to transfer and store files ensuring persistence and availability of the files independent of network connection status."
  solution        : "Unload and disable the usb-storage kernel module. - Run the following commands to unload the usb-storage kernel module: # modprobe -r usb-storage 2>/dev/null # rmmod usb-storage 2>/dev/null - Perform the following to disable the usb-storage kernel module: Create a file ending in .conf with install usb_storage /bin/false in the /etc/modprobe.d/ directory"
  reference       : "NIST 800-53r5|CM-7(9)"
  see_also        : "See HTH Policies and Standards"
</report>
      </then>

      <else>
        <if>
          <condition auto:"FAILED" type:"AND">
<custom_item>
  type            : CMD_EXEC
  description     : "1.0006 - RHEL - lsmod usb-storage"
  expect          : "^pass$"
  cmd             : "/sbin/lsmod | /bin/grep -P -- 'usb(_|-)storage' | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
</custom_item>

<custom_item>
  type            : CMD_EXEC
  description     : "1.0007 - RHEL - modprobe usb-storage blacklist"
  expect          : "^[\\s]*blacklist[\\s]+usb(_|-)storage[\\s]*$"
  cmd             : "/sbin/modprobe --showconfig | /bin/grep -P -- '\\b(install|blacklist)\\h+usb(_|-)storage\\b' "
</custom_item>

<custom_item>
  type            : CMD_EXEC
  description     : "1.0008 - RHEL - modprobe usb-storage true/false"
  expect          : "^[\\s]*install[\\s]+usb(_|-)storage[\\s]+/bin/(true|false)[\\s]*$"
  cmd             : "/sbin/modprobe --showconfig | /bin/grep -P -- '\\b(install|blacklist)\\h+usb(_|-)storage\\b' "
</custom_item>
          </condition>

          <then>
<report type:"PASSED">
  description     : "1.1.1.10 Ensure usb-storage kernel module is not available"
  info            : "USB storage provides a means to transfer and store files ensuring persistence and availability of the files independent of network connection status."
  solution        : "Unload and disable the usb-storage kernel module. - Run the following commands to unload the usb-storage kernel module: # modprobe -r usb-storage 2>/dev/null # rmmod usb-storage 2>/dev/null - Perform the following to disable the usb-storage kernel module: Create a file ending in .conf with install usb_storage /bin/false in the /etc/modprobe.d/ directory"
  reference       : "NIST 800-53r5|CM-7(9)"
  see_also        : "See HTH Policies and Standards"
  show_output     : "YES"
</report>
          </then>
        </if>
      </else>
    </if>

<report type:"WARNING">
  description     : "1.0009 - RHEL - Ensure unused filesystems kernel modules are not available"
  info            : "Filesystem kernel modules are pieces of code that can be dynamically loaded into the Linux kernel to extend its filesystem capabilities, or so-called base kernel, of an operating system."
  solution        : "- IF - the module is available in the running kernel: - Unload the filesystem kernel module from the kernel - Create a file ending in .conf with install filesystem kernel modules /bin/false in the /etc/modprobe.d/ directory - Create a file ending in .conf with deny list filesystem kernel modules in the /etc/modprobe.d/ directory"
  reference       : "NIST 800-53r5|CM-6 CM-7"
  see_also        : "See HTH Policies and Standards"
</report>

    <if>
      <condition type:"AND">
<custom_item>
  type            : CMD_EXEC
  description     : "1.0010 - RHEL - check if freevxfs is available"
  expect          : "^pass$"
  cmd             : "#!/bin/bash { l_mod_name=\"freevxfs\" l_mod_type=\"fs\" while IFS= read -r l_mod_path; do if [ -d \"$l_mod_path/${l_mod_name//-/\\/}\" ] &&  \\ [ -n \"$(ls -A \"$l_mod_path/${l_mod_name//-/\\/}\")\" ]; then printf '%s\\n' \"$l_mod_name exists in $l_mod_path\" fi done < <(readlink -e /usr/lib/modules/**/kernel/$l_mod_type \\ || readlink -e /lib/modules/**/kernel/$l_mod_type) } | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
</custom_item>
      </condition>

      <then>
