<custom_item>
  type            : CMD_EXEC
  description     : "1.0052 - RHEL - Ensure GPG keys are configured"
  info            : "The RPM Package Manager implements GPG key signing to verify package integrity during and after installation."
  solution        : "Update your package manager GPG keys in accordance with site policy."
  reference       : "NIST 800-53r5|SI-2"
  see_also        : "See HTH Policies and Standards"
  expect          : "^Manual Review Required$"
  cmd             : "rpm -q gpg-pubkey --queryformat '%{name}-%{version}-%{release} --> %{summary}\\n'"
  severity        : MEDIUM
</custom_item>

    <if>
      <condition auto:"FAILED" type:"AND">
<custom_item>
  type            : FILE_CONTENT_CHECK
  description     : "1.0053 - RHEL - global configuration for gpgcheck"
  expect          : "^\\h*gpgcheck\\h*=(?i)\\h*(1|true|yes)\\b"
  regex           : "^\\h*gpgcheck\\h*="
</custom_item>

<custom_item>
  type            : FILE_CONTENT_CHECK_NOT
  description     : "1.0054 - RHEL - no instances of gpgcheck in repos"
  expect          : "^\\h*gpgcheck\\h*=(?i)\\h*(0|[2-9]|[1-9][0-9]+|false|no)\\b"
  regex           : "^\\h*gpgcheck\\h*="
</custom_item>
      </condition>

      <then>
<report type:"PASSED">
  description     : "1.2.1.2 Ensure gpgcheck is configured"
  info            : "The gpgcheck option controls verifying package signatures after download."
  solution        : "Edit /etc/dnf/dnf.conf and set gpgcheck=1 in the [main] section. Example [main] gpgcheck=1 Edit any failing files in /etc/yum.repos.d/* and set all instances starting with gpgcheck to 1."
  reference       : "NIST 800-53r5|CM-14"
  see_also        : "See HTH Policies and Standards"
  show_output     : "YES"
</report>
      </then>
    </if>

<custom_item>
  type            : CMD_EXEC
  description     : "1.0055 - RHEL - Ensure package manager repositories are configured"
  info            : "Systems need to have the respective package manager repositories configured to ensure that the system is able to receive the latest patches and updates."
  solution        : "Configure your package manager repositories according to site policy."
  reference       : "NIST 800-53r5|SI-2"
  see_also        : "See HTH Policies and Standards"
  expect          : "^Manual Review Required$"
  cmd             : "/bin/dnf repolist"
  severity        : MEDIUM
</custom_item>

    <if>
      <condition auto:"FAILED" type:"AND">
<custom_item>
  type            : CMD_EXEC
  description     : "1.0056 - RHEL - Check to make sure no system reboot is required"
  expect          : "Reboot should not be necessary."
  cmd             : "/bin/dnf needs-restarting -r"
</custom_item>

<custom_item>
  type            : CMD_EXEC
  description     : "1.0057 - RHEL - Ensure updates, patches, and additional security software are installed"
  expect          : "^0$"
  cmd             : "/bin/dnf check-update; /bin/echo $?"
</custom_item>
      </condition>

      <then>
<report type:"PASSED">
  description     : "1.2.2.1 Ensure updates, patches, and additional security software are installed"
  info            : "Security vulnerabilities and functional improvements are regularly addressed through software updates and patches."
  solution        : "Use your package manager to update all packages on the system according to site policy. The following command will install all available updates: # dnf update Once the update process is complete, verify if reboot is required to load changes. dnf needs-restarting -r"
  reference       : "NIST 800-53r5|SI-2"
  see_also        : "See HTH Policies and Standards"
  show_output     : "YES"
</report>
      </then>
    </if>

<custom_item>
  type            : RPM_CHECK
  description     : "1.0058 - RHEL - Ensure SELinux is installed"
  info            : "SELinux provides Mandatory Access Control."
  solution        : "Run the following command to install SELinux : # dnf install libselinux"
  reference       : "NIST 800-53r5|AC-3 MP-2"
  see_also        : "See HTH Policies and Standards"
  rpm             : "libselinux-0.0.0-0"
  operator        : "gt"
</custom_item>

    <if>
      <condition auto:"FAILED" type:"AND">
<custom_item>
  type            : CMD_EXEC
  description     : "1.0059 - RHEL - Running configuration"
  expect          : "^pass$"
  cmd             : "/sbin/grubby --info=ALL | /bin/grep -Po '(selinux|enforcing)=0' | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
</custom_item>

<custom_item>
  type            : CMD_EXEC
  description     : "1.0060 - RHEL - Grub configuration"
  expect          : "^pass$"
  cmd             : "/bin/grep -Prs -- '\\h*([^#\\n\\r]+\\h+)?kernelopts=([^#\\n\\r]+\\h+)?(selinux|enforcing)=0\\b' /boot/grub2 /boot/efi | /bin/awk '{print} END {if (NR == 0) print \"pass\" ; else print \"fail\"}'"
</custom_item>
      </condition>

      <then>
<report type:"PASSED">
  description     : "1.3.1.2 Ensure SELinux is not disabled in bootloader configuration"
  info            : "Configure SELINUX to be enabled at boot time and verify that it has not been overwritten by the grub boot parameters."
  solution        : "Run the following command to remove the selinux=0 and enforcing=0 parameters: grubby --update-kernel ALL --remove-args \"selinux=0 enforcing=0\" Run the following command to remove the selinux=0 and enforcing=0 parameters if they were created by the deprecated grub2-mkconfig command: # grep -Prsq -- '^\\h*([^#\\n\\r]+\\h+)?kernelopts=([^#\\n\\r]+\\h+)?(selinux|enforcing)=0\\b' /boot/grub2 /boot/efi && grub2-mkconfig -o \"$(grep -Prl -- '\\h*([^#\\n\\r]+\\h+)?kernelopts=([^#\\n\\r]+\\h+)?(selinux|enforcing)=0\\b' /boot/grub2 /boot/efi)\\"
  reference       : "NIST 800-53r5|AC-3 MP-2"
  see_also        : "See HTH Policies and Standards"
  show_output     : "YES"
</report>
      </then>
    </if>

<custom_item>
  type            : FILE_CONTENT_CHECK
  description     : "1.0061 - RHEL - Ensure SELinux policy is configured"
  info            : "Configure SELinux to meet or exceed the default targeted policy, which constrains daemons and system software only."
  solution        : "Edit /etc/selinux/config and add set the SELINUXTYPE line to targeted or mls :"
  reference       : "NIST 800-53r5|AC-3 MP-2"
  see_also        : "See HTH Policies and Standards"
  expect          : "(?i)^[\\s]*SELINUXTYPE[\\s]*=[\\s]*(targeted|mls)[\\s]*$"
  regex           : "(?i)^[\\s]*SELINUXTYPE[\\s]*="
</custom_item>

    <if>
      <condition auto:"FAILED" type:"AND">
<custom_item>
  type            : FILE_CONTENT_CHECK
  description     : "1.0062 - RHEL - /etc/selinux/config"
  expect          : "(?i)^[\\s]*SELINUX[\\s]*=[\\s]*(enforcing|permissive)[\\s]*$"
  regex           : "(?i)^[\\s]*SELINUX[\\s]*="
</custom_item>

<custom_item>
  type            : CMD_EXEC
  description     : "1.0063 - RHEL - getenforce"
  expect          : "(?i)^[\\s]*(Enforcing|Permissive)[\\s]*$"
  cmd             : "/sbin/getenforce"
</custom_item>
      </condition>

      <then>
<report type:"PASSED">
  description     : "1.3.1.4 Ensure the SELinux mode is not disabled"
  info            : "SELinux can run in one of three modes: disabled, permissive, or enforcing: - Enforcing - Is the default, and recommended, mode of operation; in enforcing mode SELinux operates normally, enforcing the loaded security policy on the entire system."
  solution        : "- Edit /etc/selinux/config and update the SELINUX parameter to either SELINUX=enforcing or SELINUX=permissive :"
  reference       : "NIST 800-53r5|AC-3 AC-5 AC-6 MP-2 SC-3"
  see_also        : "See HTH Policies and Standards"
  show_output     : "YES"
</report>
      </then>
    </if>

<custom_item>
  type            : RPM_CHECK
  description     : "1.0064 - RHEL - Ensure the MCS Translation Service (mcstrans) is not installed"
  info            : "The mcstransd daemon provides category label information to client processes requesting information."
  solution        : "Run the following command to uninstall mcstrans : # dnf remove mcstrans"
  reference       : "NIST 800-53r5|AC-3 MP-2"
  see_also        : "See HTH Policies and Standards"
  rpm             : "mcstrans-0.0.0-0"
  operator        : "lt"
</custom_item>

<custom_item>
  type            : RPM_CHECK
  description     : "1.0065 - RHEL - Ensure SETroubleshoot is not installed"
  info            : "The SETroubleshoot service notifies desktop users of SELinux denials through a user-friendly interface."
  solution        : "Run the following command to uninstall setroubleshoot : # dnf remove setroubleshoot"
  reference       : "NIST 800-53r5|AC-3 MP-2"
  see_also        : "See HTH Policies and Standards"
  rpm             : "setroubleshoot-0.0.0-0"
  operator        : "lt"
</custom_item>

<custom_item>
  type            : CMD_EXEC
  description     : "1.0066 - RHEL - Ensure bootloader password is set"
  info            : "Setting the boot loader password will require that anyone rebooting the system must enter a password before being able to set command line boot parameters."
  solution        : "Create an encrypted password with grub2-setpassword : # grub2-setpassword Enter password: <password> Confirm password: <password>"
  reference       : "NIST 800-53r5|AC-3"
  see_also        : "See HTH Policies and Standards"
  expect          : "GRUB2_PASSWORD=grub.pbkdf2.sha512"
  cmd             : "#!/bin/bash { l_grub_password_file=\"$(find /boot -type f -name 'user.cfg' ! -empty)\" if [ -f \"$l_grub_password_file\" ]; then awk -F. '/^\\s*GRUB2_PASSWORD=\\S+/ {print $1\".\"$2\".\"$3}' \"$l_grub_password_file\" fi } | /bin/awk '{print} END {if (NR == 0) print \"fail - GRUB2_PASSWORD configuration or user.cfg file not found\"}'"
</custom_item>

<custom_item>
  type            : CMD_EXEC
  description     : "1.0067 - RHEL - Ensure access to bootloader config is configured"
  info            : "The grub files contain information on boot settings and passwords for unlocking boot options."
  solution        : "Run the following command to set owner and group owner on the grub configuration files: # find -L /boot/grub2/ -mindepth 1 -maxdepth 1 \\ -type f \\( ! -user root -o ! -group root \\) -exec chown root:root {} + Run the following command to set mode on the grub configuration files to 0600 or more restrictive: # find -L /boot/grub2/ -mindepth 1 -maxdepth 1 -type f \\ -perm /0177 -exec chmod u-x,go-rwx {} +"
  reference       : "NIST 800-53r5|AC-3 AC-5 AC-6 CM-6b. MP-2"
  see_also        : "See HTH Policies and Standards"
  expect          : "^[^#\\n\\r]+:0[046]00:root:root"
  cmd             : "/bin/find -L /boot/grub2/ -mindepth 1 -maxdepth 1 -type f -exec stat -Lc '%n:%#a:%U:%G' {} +"
</custom_item>

<custom_item>
  type            : FILE_CONTENT_CHECK
  description     : "1.0068 - RHEL - Ensure core file size is configured"
  info            : "core - limits the core file size hard - for enforcing hard resource limits."
  solution        : "- Run the following command to comment out any entries that include a hard value for core greater than 0 in /etc/security/limits.conf and any file(s) in the /etc/security/limits.d/ directory."
  reference       : "NIST 800-53r5|CM-6b."
  see_also        : "See HTH Policies and Standards"
  expect          : "^[\\s]*\\*[\\s]+hard[\\s]+core[\\s]+0[\\s]*$"
  regex           : "^[\\s]*\\*[\\s]+hard[\\s]+core"
  min_occurrences : "1"
</custom_item>

<custom_item>
  type            : CMD_EXEC
  description     : "1.0069 - RHEL - Ensure systemd-coredump Storage is configured"
  info            : "A core dump is the memory of an executable program."
  solution        : "- Review all files ending in .conf in the /etc/systemd/coredump.conf.d/ directory and comment out or remove all Storage= lines in the [Coredump] block that are not Storage=none. Example script: #!/usr/bin/env bash { l_block=\"Coredump\" l_option=\"Storage\" l_value=\"none\" while IFS= read -r -d $'\\0' l_file; do awk '/\\['\"$l_block\"'\\]/{a=1;next}/\\[/{a=0}a' \"$l_file\" 2>/dev/null | \\ grep -Poi '\\h*'\"$l_option\"'\\h*=\\h*\\H+\\b' | \\ grep -Pivq '^\\h*'\"$l_option\"'\\h*=\\h*'\"$l_value\"'\\b' && \\ sed -ri '/^\\s*[Ss]torage\\s*=/s/^/# /' \"$l_file\" done < <(find /etc/systemd/coredump.conf.d/ -type f -name '*.conf' -print0) } - Create or edit a file in the /etc/systemd/coredump.conf.d directory ending in .conf and edit or add the following line to the [Coredump] section: Storage=none"
  reference       : "NIST 800-53r5|CM-6b."
  see_also        : "See HTH Policies and Standards"
  expect          : "^Pass$"
  cmd             : "#!/bin/bash { l_analyze_cmd=\"$(readlink -e /bin/systemd-analyze || \\ readlink -e /usr/bin/systemd-analyze)\" l_conf_file=\"systemd/coredump.conf\" l_block=\"Coredump\" l_option=\"Storage\" l_option_value=\"\" a_output=() while IFS= read -r l_file; do l_file=\"${l_file//# /}\" l_opt=\"$(awk '/\\['\"$l_block\"'\\]/{a=1;next}/\\[/{a=0}a' \"$l_file\" \\ 2>/dev/null | grep -Poi '^\\h*'\"$l_option\"'\\h*=\\h*\\H+\\b' | tail -n 1)\" l_option_value=\"$(cut -d= -f2 <<< \"$l_opt\" | xargs)\" [ -n \"$l_option_value\" ] && \\ a_output+=(\" - \\\"$l_option\\\" is set to: \\\"$l_option_value\\\"\" \\ \"    in: \\\"$l_file\\\"\") done < <(\"$l_analyze_cmd\" cat-config \"$l_conf_file\" | tac | \\ grep -Pio '^\\h*#\\h*\\/[^#\\n\\r\\h]+\\.conf\\b') if [ \"${#a_output[@]}\" -le \"0\" ]; then l_file=\"$(readlink -e /etc/\"$l_conf_file\" || \\ readlink -e /usr/lib/\"$l_conf_file\")\" l_opt=\"$(awk '/\\['\"$l_block\"'\\]/{a=1;next}/\\[/{a=0}a' \"$l_file\" \\ 2>/dev/null | grep -Poim 1 '^(\\h*#)?\\h*'\"$l_option\"'\\h*=\\h*\\H+\\b')\" l_option_value=\"$(cut -d= -f2 <<< \"${l_opt//# /}\" | xargs)\" [ -n \"$l_option_value\" ] && \\ a_output+=(\" - The default value: \\\"${l_opt//#/}\\\"\" \\ \"    is being used in the configuration\") fi [ \"${#a_output[@]}\" -gt \"0\" ] && printf '%s\\n' \"\" \"${a_output[@]}\" \"\" } | /bin/awk 'NR == 2 { if (/\"Storage\" is set to: \"none\"/) { print \"Pass\" } else { print \"Fail\" } } { print }'"
</custom_item>

