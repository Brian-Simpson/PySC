<if>
  <condition type:"AND">
<custom_item>
  type                 : AUDIT_POWERSHELL
  description          : "1.0149 - MSSRV - Check if server is Domain Controller"
  solution             : ""
  reference            : ""
  see_also             : "See HTH Policies and Standards"
  value_type           : POLICY_TEXT
  value_data           : "(?s)^(?:4|5)$"
  powershell_args      : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $W = Get-WmiObject -Namespace ''root/CIMV2'' -Query ''select DomainRole from Win32_ComputerSystem'' -ErrorAction SilentlyContinue; if($null -eq $W){ Write-Output ''__NON_COMPLIANT__''; return }; $V = $W.DomainRole; if($null -eq $V -or [string]::IsNullOrWhiteSpace([string]$V)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output $V }; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
</custom_item>
  </condition>

  <then>

<custom_item>
  type                 : AUDIT_POWERSHELL
  description          : "1.0150 - MSSRV - MSSRV.DC - Services - Print Spooler disabled (DC only)"
  info                 : "In the past, the Print Spooler had a critical vulnerability, referred to as PrintNightmare (CVE-2021-34527), which allowed attackers to execute code with administrator privileges."
  solution             : ""
  reference            : "NIST 800-53|CM-6 CM-7"
  see_also             : "See HTH Policies and Standards"
  value_type           : POLICY_TEXT
  value_data           : "4"
  powershell_args      : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { if (Test-Path -Path ''HKLM:\System\Currentcontrolset\Services\Spooler'') {(Get-ItemProperty -Path ''HKLM:\System\Currentcontrolset\Services\Spooler'').Start } else {Write-Output ''NON_COMPLIANT PATH'' }  } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type           : CHECK_REGEX
</custom_item>

<custom_item>
  type                 : AUDIT_POWERSHELL
  description          : "1.0151 - MSSRV - MSSRV.DC - Ensure Audit Computer Account Management is set to include Success (DC only)"
  info                 : "This subcategory reports each event of computer account management, such as when a computer account is created, changed, deleted, renamed, disabled, or enabled."
  solution             : ""
  reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also             : "See HTH Policies and Standards"
  value_type           : POLICY_TEXT
  value_data           : "Success"
  powershell_args      : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $rows = auditpol /get /Subcategory:''Computer Account Management'' /r 2>$null | ConvertFrom-Csv; $row = if($rows){ $rows | Where-Object { $_.Subcategory -eq ''Computer Account Management'' } | Select-Object -First 1 } else { $null }; $inc = if($row){ [string]$row.''Inclusion Setting'' } else { '''' }; if(-not [string]::IsNullOrWhiteSpace($inc)){ Write-Output $inc.Trim(); return }; $AP = auditpol /get /Subcategory:''Computer Account Management'' 2>$null | ForEach-Object { $_.ToString() }; $line = $AP | Where-Object { $_ -match ''^\s*Computer\ Account\ Management\s{2,}'' } | Select-Object -First 1; if(-not $line){ Write-Output ''Not Found''; return }; if($line -match ''Success and Failure''){ Write-Output ''Success and Failure''; return }; if($line -match ''No Auditing''){ Write-Output ''No Auditing''; return }; if($line -match ''Success''){ Write-Output ''Success''; return }; if($line -match ''Failure''){ Write-Output ''Failure''; return }; Write-Output $line; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type           : CHECK_REGEX
</custom_item>

<custom_item>
  type                 : AUDIT_POWERSHELL
  description          : "1.0152 - MSSRV - MSSRV.DC - Ensure Audit Distribution Group Management is set to include Success (DC only)"
  info                 : "This subcategory reports each event of distribution group management, such as when a distribution group is created, changed, or deleted or when a member is added to or removed from a distribution group."
  solution             : ""
  reference            : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
  see_also             : "See HTH Policies and Standards"
  value_type           : POLICY_TEXT
  value_data           : "Success"
  powershell_args      : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $rows = auditpol /get /Subcategory:''Distribution Group Management'' /r 2>$null | ConvertFrom-Csv; $row = if($rows){ $rows | Where-Object { $_.Subcategory -eq ''Distribution Group Management'' } | Select-Object -First 1 } else { $null }; $inc = if($row){ [string]$row.''Inclusion Setting'' } else { '''' }; if(-not [string]::IsNullOrWhiteSpace($inc)){ Write-Output $inc.Trim(); return }; $AP = auditpol /get /Subcategory:''Distribution Group Management'' 2>$null | ForEach-Object { $_.ToString() }; $line = $AP | Where-Object { $_ -match ''^\s*Distribution\ Group\ Management\s{2,}'' } | Select-Object -First 1; if(-not $line){ Write-Output ''Not Found''; return }; if($line -match ''Success and Failure''){ Write-Output ''Success and Failure''; return }; if($line -match ''No Auditing''){ Write-Output ''No Auditing''; return }; if($line -match ''Success''){ Write-Output ''Success''; return }; if($line -match ''Failure''){ Write-Output ''Failure''; return }; Write-Output $line; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type           : CHECK_REGEX
</custom_item>

<custom_item>
  type                 : AUDIT_POWERSHELL
