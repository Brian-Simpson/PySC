<custom_item>
  type                 : AUDIT_POWERSHELL
  description          : "1.0156 - MSSRV - MSSRV.DC - Ensure Create symbolic links is set to Administrators (DC only)"
  info                 : "This policy setting determines which users can create symbolic links."
  solution             : ""
  reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also             : "See HTH Policies and Standards"
  value_type           : POLICY_TEXT
  value_data           : "(?s)^(?:Administrators|'?NO_MEMBERS'?)$"
  powershell_args      : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match ''^\s*SeCreateSymbolicLinkPrivilege\s*='' } | Select-Object -Last 1); $m=if($l){ ($l -replace ''.*='', '''').Split('','') | ForEach-Object { $s=$_.Trim(); $s=$s -replace ''^\*'', ''''; if($s -match ''^S-1-5-''){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split(''\\'')[-1]}catch{$s} } else { if($s -match ''\\''){ $s.Split(''\\'')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join '','' } else { ''NO_MEMBERS'' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
</custom_item>

<custom_item>
  type                 : AUDIT_POWERSHELL
  description          : "1.0157 - MSSRV - MSSRV.DC - Ensure Enable computer and user accounts to be trusted for delegation is set to Administrators (DC only)"
  info                 : "This policy setting allows users to change the Trusted for Delegation setting on a computer object in Active Directory."
  solution             : ""
  reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also             : "See HTH Policies and Standards"
  value_type           : POLICY_TEXT
  value_data           : "(?s)^(?:Administrators|'?NO_MEMBERS'?)$"
  powershell_args      : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match ''^\s*SeEnableDelegationPrivilege\s*='' } | Select-Object -Last 1); $m=if($l){ ($l -replace ''.*='', '''').Split('','') | ForEach-Object { $s=$_.Trim(); $s=$s -replace ''^\*'', ''''; if($s -match ''^S-1-5-''){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split(''\\'')[-1]}catch{$s} } else { if($s -match ''\\''){ $s.Split(''\\'')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join '','' } else { ''NO_MEMBERS'' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
</custom_item>

<custom_item>
  type                 : AUDIT_POWERSHELL
  description          : "1.0158 - MSSRV - MSSRV.DC - Ensure Impersonate a client after authentication is set to Administrators, LOCAL SERVICE, NETWORK SERVICE, SERVICE (DC only)"
  info                 : "The policy setting allows programs that run on behalf of a user to impersonate that user (or another specified account) so that they can act on behalf of the user."
  solution             : ""
  reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also             : "See HTH Policies and Standards"
  value_type           : POLICY_TEXT
  value_data           : "^(?:Administrators,LOCAL SERVICE,NETWORK SERVICE,SERVICE|'?NO_MEMBERS'?)$"
  powershell_args      : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match ''^\s*SeImpersonatePrivilege\s*='' } | Select-Object -Last 1); $m=if($l){ ($l -replace ''.*='', '''').Split('','') | ForEach-Object { $s=$_.Trim(); $s=$s -replace ''^\*'', ''''; if($s -match ''^S-1-5-''){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split(''\\'')[-1]}catch{$s} } else { if($s -match ''\\''){ $s.Split(''\\'')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join '','' } else { ''NO_MEMBERS'' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
</custom_item>

<custom_item>
  type                 : AUDIT_POWERSHELL
  description          : "1.0159 - MSSRV - MSSRV.DC - Ensure Act as part of the operating system is set to No One"
  info                 : "This policy setting allows a process to assume the identity of any user and thus gain access to the resources that the user is authorized to access."
  solution             : ""
  reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also             : "See HTH Policies and Standards"
  value_type           : POLICY_TEXT
  value_data           : "^NO_MEMBERS$"
  powershell_args      : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match ''^\s*SeTcbPrivilege\s*='' } | Select-Object -Last 1); $m=if($l){ ($l -replace ''.*='', '''').Split('','') | ForEach-Object { $s=$_.Trim(); $s=$s -replace ''^\*'', ''''; if($s -match ''^S-1-5-''){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split(''\\'')[-1]}catch{$s} } else { if($s -match ''\\''){ $s.Split(''\\'')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join '','' } else { ''NO_MEMBERS'' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
</custom_item>

<custom_item>
  type                 : AUDIT_POWERSHELL
  description          : "1.0160 - MSSRV - MSSRV.DC - Ensure Synchronize directory service data is set to No One (DC only)"
  info                 : "This security setting determines which users and groups have the authority to synchronize all directory service data."
  solution             : ""
  reference            : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
  see_also             : "See HTH Policies and Standards"
  value_type           : POLICY_TEXT
  value_data           : "^NO_MEMBERS$"
  powershell_args      : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $t=[IO.Path]::GetTempFileName(); $ok=$false; try { secedit /export /cfg $t /areas USER_RIGHTS /mergedpolicy /quiet | Out-Null; $ok=$true } catch {} ; if(-not $ok){ secedit /export /cfg $t /areas USER_RIGHTS /quiet | Out-Null }; $l=(Get-Content $t | Where-Object { $_ -match ''^\s*SeSyncAgentPrivilege\s*='' } | Select-Object -Last 1); $m=if($l){ ($l -replace ''.*='', '''').Split('','') | ForEach-Object { $s=$_.Trim(); $s=$s -replace ''^\*'', ''''; if($s -match ''^S-1-5-''){ try{([Security.Principal.SecurityIdentifier]$s).Translate([Security.Principal.NTAccount]).Value.Split(''\\'')[-1]}catch{$s} } else { if($s -match ''\\''){ $s.Split(''\\'')[-1] } else { $s } } } | Where-Object { $_ } | Sort-Object -Unique }else{ @() }; Remove-Item $t -Force -ErrorAction SilentlyContinue; if($m){ $m -join '','' } else { ''NO_MEMBERS'' } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
</custom_item>

<custom_item>
  type                 : AUDIT_POWERSHELL
  description          : "1.0161 - MSSRV - MSSRV.DC - Ensure Domain controller: Refuse machine account password changes is set to Disabled (DC only)"
  info                 : "This security setting determines whether Domain Controllers will refuse requests from member computers to change computer account passwords."
  solution             : ""
  reference            : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also             : "See HTH Policies and Standards"
  value_type           : POLICY_TEXT
  value_data           : "0"
  powershell_args      : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $p=''HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters''; $k=''RefusePasswordChange''; $d=''0''; if(-not (Test-Path -Path $p)){ Write-Output $d; return }; $r=Get-ItemProperty -Path $p -ErrorAction SilentlyContinue; $pr=$r.PSObject.Properties[$k]; if($null -eq $pr -or $null -eq $pr.Value){ Write-Output $d } else { Write-Output $pr.Value } } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
  check_type           : CHECK_REGEX
</custom_item>

  </then>

</if>

</group_policy>
</check_type>
