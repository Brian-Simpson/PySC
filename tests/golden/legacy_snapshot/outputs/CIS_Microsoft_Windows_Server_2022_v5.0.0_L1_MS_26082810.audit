<custom_item>
  type            : AUDIT_POWERSHELL
  description     : "1.0281 - MSSRV - Ensure Network security: Force logoff when logon hours expire is set to Enabled"
  info            : "This policy setting determines whether to disconnect users who are connected to the local computer outside their user account's valid logon hours."
  solution        : "To establish the recommended configuration via GP, set the following UI path to Enabled. Computer Configuration\Policies\Windows Settings\Security Settings\Local Policies\Security Options\Network security: Force logoff when logon hours expire"
  reference       : "NIST 800-53r5|AC-2(12)"
  see_also        : "See HTH Policies and Standards"
  value_type      : POLICY_TEXT
  value_data      : "6"
  powershell_args : "-NoProfile -ExecutionPolicy Bypass -Command '$__pysc_result = (& { $LogoffObj = net accounts | Select-string ''Force user logoff''; $LogoffStr = $LogoffObj.ToString(); $LogoffStr -match ''\d{1,4}|Never'' | out-null; $LO_Logoff = $matches[0]; Write-Output $LO_Logoff; } | Out-String); if([string]::IsNullOrWhiteSpace([string]$__pysc_result)){ Write-Output ''__NON_COMPLIANT__'' } else { Write-Output ($__pysc_result.Trim()) }'"
</custom_item>

