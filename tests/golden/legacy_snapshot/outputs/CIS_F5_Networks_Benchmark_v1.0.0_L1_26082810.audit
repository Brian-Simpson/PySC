
<check_type:"F5">

<report type:"WARNING">
  description    : "1.0000 - F5 - Ensure default password of root is not allowed"
  info           : "To assist users in changing default password for \"root\" account Using Default passwords for 'root' access could cause a compromise to the overall system security."
  solution       : "- Log in to the Configuration utility. - For System, select Platform. - Under User Administration, choose the Password box for either Root Account or Admin Account. - Enter the new password. - Enter the same password in the Confirm box for the account that you chose in step 3. - Select Update. - If you have updated the password for Admin Account, the system logs you out of the Configuration utility, and you must log in again using the new password."
  reference      : "NIST 800-53r5|IA-5(1)"
  see_also       : "See HTH Policies and Standards"
</report>

<report type:"WARNING">
  description    : "1.0001 - F5 - Ensure default password of admin is not used"
  info           : "To assist users in changing default password for 'admin' account Using Default passwords for 'admin' access could cause a compromise to the overall system security."
  solution       : "- Log in to the Configuration utility. - For System, select Platform. - Under User Administration, choose the Password box for either Root Account or Admin Account. - Enter the new password. - Enter the same password in the Confirm box for the account that you chose in step 3. - Select Update. - If you have updated the password for Admin Account, the system logs you out of the Configuration utility, and you must log in again using the new password."
  reference      : "NIST 800-53r5|IA-5(1)"
  see_also       : "See HTH Policies and Standards"
</report>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0002 - F5 - Check offline config for required special"
  expect         : "required-special \b[^0]+\b"
  regex          : "required-special"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0003 - F5 - Check offline config for lockout duration"
  expect         : "lockout-duration \b(30\d|3[1-9]\d|[4-9]\d{2}|[1-9]\d{3,5}|0)\b"
  regex          : "lockout-duration"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0004 - F5 - Check offline config for required numeric"
  expect         : "required-numeric \b[^0]+\b"
  regex          : "required-numeric"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0005 - F5 - Check offline config for policy-enforcement"
  expect         : "policy-enforcement enabled"
  regex          : "policy-enforcement"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0006 - F5 - Check offline config for expiration warning"
  expect         : "expiration-warning \b(1[4-9]|[2-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\b"
  regex          : "expiration-warning"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0007 - F5 - Check offline config for required uppercase"
  expect         : "required-uppercase \b[^0]+\b"
  regex          : "required-uppercase"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0008 - F5 - Check offline config for minimum length"
  expect         : "minimum-length \b(1[2-9]|[2-9][0-9]|[1-9]\d{2,})\b"
  regex          : "minimum-length"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0009 - F5 - Check offline config for max login failures"
  expect         : "max-login-failures \b([1-3])\b"
  regex          : "max-login-failures"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0010 - F5 - Check offline config for password memory"
  expect         : "password-memory \b(2[4-9]|[3-9][0-9]|1[01][0-9]|12[0-7])\b"
  regex          : "password-memory"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0011 - F5 - Check offline config for required lowercase"
  expect         : "required-lowercase \b[^0]+\b"
  regex          : "required-lowercase"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0012 - F5 - Check offline config for max duration"
  expect         : "max-duration \b([1-9]|[1-9][0-9]|1[0-7][0-9]|180)\b"
  regex          : "max-duration"
</custom_item>

<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0013 - F5 - Check offline config for min duration"
  expect         : "min-duration \b([1-9]|[1-8][0-9]|90)\b"
  regex          : "min-duration"
</custom_item>

<custom_item>
  description    : "1.0014 - F5 - Check REST API for required special"
  expect         : "\b[^0]+\b"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".requiredSpecial"
</custom_item>

<custom_item>
  description    : "1.0015 - F5 - Check REST API for lockout duration"
  expect         : "\b(30\d|3[1-9]\d|[4-9]\d{2}|[1-9]\d{3,5}|0)\b"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".lockoutDuration"
</custom_item>

<custom_item>
  description    : "1.0016 - F5 - Check REST API for required numeric"
  expect         : "\b[^0]+\b"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".requiredNumeric"
</custom_item>

<custom_item>
  description    : "1.0017 - F5 - Check REST API for policy-enforcement"
  expect         : "^enabled$"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".policyEnforcement"
</custom_item>

<custom_item>
  description    : "1.0018 - F5 - Check REST API for expiration warning"
  expect         : "\b(1[4-9]|[2-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\b"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".expirationWarning"
</custom_item>

<custom_item>
  description    : "1.0019 - F5 - Check REST API for required uppercase"
  expect         : "\b[^0]+\b"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".requiredUppercase"
</custom_item>

<custom_item>
  description    : "1.0020 - F5 - Check REST API for minimum length"
  expect         : "\b(1[2-9]|[2-9][0-9]|[1-9]\d{2,})\b"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".minimumLength"
</custom_item>

<custom_item>
  description    : "1.0021 - F5 - Check REST API for max login failures"
  expect         : "\b([1-3])\b"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".maxLoginFailures"
</custom_item>

<custom_item>
  description    : "1.0022 - F5 - Check REST API for password memory"
  expect         : "\b(2[4-9]|[3-9][0-9]|1[01][0-9]|12[0-7])\b"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".passwordMemory"
</custom_item>

<custom_item>
  description    : "1.0023 - F5 - Check REST API for required lowercase"
  expect         : "\b[^0]+\b"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".requiredLowercase"
</custom_item>

<custom_item>
  description    : "1.0024 - F5 - Check REST API for max duration"
  expect         : "\b([1-9]|[1-9][0-9]|1[0-7][0-9]|180)\b"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".maxDuration"
</custom_item>

<custom_item>
  description    : "1.0025 - F5 - Check REST API for max duration"
  expect         : "\b([1-9]|[1-8][0-9]|90)\b"
  f5_command     : "/tm/auth/password-policy"
  json_transform : ".minDuration"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "1.1.3 Configure Secure Password Policy"
  info           : "To assist users in maintaining strong passwords ,ensure that passwords are changed at appropriate intervals and new passwords to be used Having a weak or non-existant password policy will allow users to use weak or easily cracked passwords."
  solution       : "Configuring the password policy using the Configuration utility 1.Log in to the Configuration utility. 2. Navigate to System > Users > Authentication. 3. Under Password Policy, locate the Secure Password Enforcement setting and set it to meet below minimum requirements : Configuring the password policy using tmsh 1. Log in to tmsh by typing the following command:"
  reference      : "NIST 800-53r5|IA-5(1)"
  tmsh           : "modify /auth password-policy The minimum requirements : - Secure Password Enforcement : Enabled - Minimum Password Length is 12 - Required Loweredcase is 1 - Required Upperedcase is 1 - Required Numericis 1 - Required Special Charecters is 1 - Maxmimum Durtaion (in Days): 180 - Minimum Duration (in Days): 90 - Expiration Warning ( in days):14 - EnsurePassword Memory is 24 - Ensure Maximum Login Failuresis 3 - User Lockout : Automatically enable locked-out users after : 300 seconds **Notice: Some settings can be done through Configuration Utility only while others are done through tmsh only.**"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0026 - F5 - Check offline config for default partition"
  regex          : "default-partition"
  not_expect     : "default-partition Common"
</custom_item>

<custom_item>
  description    : "1.0027 - F5 - Check REST API for default partition"
  expect         : "Common"
  f5_command     : "/tm/auth/remote-user"
  json_transform : ".defaultPartition"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "2.5 Ensure External Users' has access to needed Partitions only"
  info           : "To limit access for remote users to needed partitions only granting a user access to \"All Partitions\" might provide the users unauthorized access."
  solution       : "1. Log in to the Configuration utility. 2. Go to System > Users > Authentication. 3. Under External Users , click \"Change\". 4. For Partition Access , specify which partitions are allowed for External Users."
  reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0028 - F5 - Check offline config for remote console access"
  expect         : "remote-console-access disabled"
  regex          : "remote-console-access"
</custom_item>

<custom_item>
  description    : "1.0029 - F5 - Check REST API for remote console access"
  expect         : "disabled"
  f5_command     : "/tm/auth/remote-user"
  json_transform : ".remoteConsoleAccess"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "2.6 Ensure External Users' Terminal Access is Disabled"
  info           : "To prevent remote users from gaining terminal access."
  solution       : "1. Log in to the Configuration utility. 2. Go to System > Users > Authentication. 3. Under External Users , click \"Change\". 4. Set Terminal Access as \"Disabled\\"
  reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0030 - F5 - Check offline config for idle timeout"
  expect         : "auth-pam-idle-timeout ([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
  regex          : "auth-pam-idle-timeout"
</custom_item>

<custom_item>
  description    : "1.0031 - F5 - Check REST API for idle timeout"
  expect         : "^[\s]*Configuration Utility Timeout:[\s]*([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
  f5_command     : "/tm/sys/httpd"
  json_transform : "\"Configuration Utility Timeout: \(.authPamIdleTimeout)\""
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "3.1 Ensure 'Idle timeout' is less than or equal to 10 minutes for Configuration utility sessions"
  info           : "To set an idle timeout for GUI sessions Unattended administrative sessions may provide illegal access to the device."
  solution       : "On Configuration utility: System > Preferences, Under Security settings...set the value of Idle Time Before Automatic Logout to 600 seconds"
  reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0032 - F5 - Check offline config for tls version"
  expect         : "ssl-protocol TLSv1.(2|3)[\s]*$"
  regex          : "ssl-protocol"
</custom_item>

<custom_item>
  description    : "1.0033 - F5 - Check REST API for tls version"
  expect         : "^[\s]*SSL[\s]*Protocol:[\s]*TLSv1.(2|3)[\s]*$"
  f5_command     : "/tm/sys/httpd"
  json_transform : "\"SSL Protocol: \(.sslProtocol)\""
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "3.2 Ensure access to Configuration utility by clients using TLS version 1.2 or later"
  info           : "TLSv1."
  solution       : "If the value is different, execute the following command to modify the protocol used to access GUI: tmsh modify /sys httpd ssl-protocol \"TLSv1.2\" tmsh save sys config"
  reference      : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0034 - F5 - Check offline config for access"
  expect         : "allow { 192.168.0.1 }"
  regex          : "allow"
</custom_item>

<custom_item>
  description    : "1.0035 - F5 - Check REST API for access"
  expect         : "^192.168.0.1$"
  f5_command     : "/tm/sys/httpd"
  json_transform : ".allow | join(\" \")"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "3.3 Ensure access to Configuration utility is restrcited to needed IP addresses only"
  info           : "It is recommended to maintain secure access to the GUI by allowing only trusted IP addresses or range of IP addresses Any compromised network device within enterprise network would gain illegal access to F5 configuration utility abusing existing unresolved vulnerabilities."
  solution       : "If the output of the above command show ALL, the following command would be executed to modify the settings: modify modify /sys httpd allow replace-all-with { <IP address or IP address range> }"
  reference      : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0036 - F5 - Check offline config for Banner Enabled"
  expect         : "banner enabled"
  regex          : "banner "
</custom_item>

<custom_item>
  type           : OFFLINE_BANNER_CHECK
  description    : "1.0037 - F5 - Check offline config for Banner Text"
  item           : "banner-text"
</custom_item>

<custom_item>
  description    : "1.0038 - F5 - Check REST API for Banner Text"
  expect         : "All unauthorized activity is monitored and logged."
  f5_command     : "/tm/sys/sshd"
  json_transform : ".bannerText"
</custom_item>

<custom_item>
  description    : "1.0039 - F5 - Check REST API for Banner Enabled"
  expect         : "enabled"
  f5_command     : "/tm/sys/sshd"
  json_transform : ".banner"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "4.1 Ensure Prelogin 'Login Banner' is set"
  solution       : "1-Log in to the Configuration utility. 2-Navigate to System > Configuration > Device 3-Click SSHD. 4-Enter the desired pre-login message banner in the text box and enable appropriate options. 5-To enable this banner message, check the Show The Security Banner On The Login Screen option. To disable this message banner, clear the Show The Security Banner On The Login Screen option. 6-Click Update."
  reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0040 - F5 - Check offline config for inactivity timeout"
  expect         : "inactivity-timeout ([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
  regex          : "inactivity-timeout"
</custom_item>

<custom_item>
  description    : "1.0041 - F5 - Check REST API for inactivity timeout"
  expect         : "^[\s]*SSH Idle Timeout:[\s]*([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
  f5_command     : "/tm/sys/sshd"
  json_transform : "\"SSH Idle Timeout: \(.inactivityTimeout)\""
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "4.2 Ensure 'Idle timeout' is less than or equal to 10 minutes for SSH connections"
  info           : "To set an idel timeout for SSH sessions."
  solution       : "1-Log in to tmsh by typing the following command: tmsh 2-To configure an automatic logout idle time (10 minutes) for SSH sessions, use the following command syntax: modify /sys sshd inactivity-timeout 600 3-Save the change by typing the following command: save /sys config"
  reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0042 - F5 - Check offline config for idle timeout"
  expect         : "idle-timeout ([1-9]|10)[\s]*$"
  regex          : "idle-timeout"
</custom_item>

<custom_item>
  description    : "1.0043 - F5 - Check REST API for idle timeout"
  expect         : "^TMSH Timeout:[\s]*([1-9]|10)[\s]*$"
  f5_command     : "/tm/cli/global-settings"
  json_transform : "\"TMSH Timeout: \(.idleTimeout)\""
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "4.3 Ensure 'Idle timeout' is less than or equal to 10 minutes for tmsh sessions"
  info           : "To set an idel timeout for tmsh sessions."
  solution       : "1.Log in to tmsh by typing the following command: tmsh 2.To configure an automatic logout idle time for tmsh sessions, use the following command syntax: modify /cli global-settings idle-timeout 10 3.Save the change by typing the following command: save /sys config"
  reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0044 - F5 - Check offline config for console inactivity timeout"
  expect         : "console-inactivity-timeout ([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
  regex          : "console-inactivity-timeout"
</custom_item>

<custom_item>
  description    : "1.0045 - F5 - Check REST API for console inactivity timeout"
  expect         : "^[\s]*Console Idle Timeout:[\s]*([1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)[\s]*$"
  f5_command     : "/tm/sys/global-settings"
  json_transform : "\"Console Idle Timeout: \(.consoleInactivityTimeout)\""
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "4.4 Ensure 'Idle timeout' is less than or equal to 10 minutes for serial console sessions"
  info           : "To set an idel timeout for serial console sessions."
  solution       : "- Log in to tmsh by typing the following command: tmsh - To configure an automatic logout idle time for serial console sessions, use the following command : modify /sys global-settings console-inactivity-timeout 600 - Save the change by typing the following command: save /sys config"
  reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0046 - F5 - Check offline config for aes128-cbc"
  expect         : "aes128-cbc"
  regex          : "Ciphers"
</custom_item>

<custom_item>
  description    : "1.0047 - F5 - Check REST API for aes128-cbc"
  expect         : "^[\s]*Ciphers.*aes128-cbc.*$"
  f5_command     : "/tm/sys/sshd"
  json_transform : ".include"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "4.5 Ensure minimum SSH Encryption algorithm is set to aes128-cbc"
  info           : "To set strong SSH Encryption algorithm."
  solution       : "1-Log in to tmsh by typing the following command:tmsh 2-To modify the sshd configuration, type the following command to start the vi editor:edit /sys sshd all-properties 3-To change the list of ciphers, you can navigate to the line that starts with the include statement, and use the keyword Ciphers : include \"Ciphers aes128-cbc,aes128-ctr,aes192-ctr,aes256-ctr,arcfour128,arcfour256,arcfour\\"
  reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0048 - F5 - Check offline config for hmac-sha2-256"
  expect         : "hmac-sha2-256"
  regex          : "MACs"
</custom_item>

<custom_item>
  description    : "1.0049 - F5 - Check REST API for hmac-sha2-256"
  expect         : "^[\s]*Ciphers.*MACs.*hmac-sha2-256.*$"
  f5_command     : "/tm/sys/sshd"
  json_transform : ".include"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "4.6 Ensure to set SSH MAC algorithm to hmac-sha2-256"
  info           : "To set strong Hashing algorithm."
  solution       : "1-Log in to tmsh by typing the following command:tmsh 2-To modify the sshd configuration, type the following command to start the vi editor:edit /sys sshd all-properties 3-To change the list of ciphers, you can navigate to the line that starts with the include statement, and use the keyword MACs ,and adding the list of desired MACs to the 2-line include statement: include \"Ciphers aes128-cbc,aes128-ctr,aes192-ctr,aes256-ctr,arcfour128,arcfour256,arcfour MACs hmac-sha2-256\\"
  reference      : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"WARNING" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0050 - F5 - Check offline config for kex algorithms"
  expect         : "^Manual Review Required$"
  regex          : "KexAlgorithms"
  severity       : MEDIUM
</custom_item>

<custom_item>
  description    : "1.0051 - F5 - Check REST API for kex algorithms"
  expect         : "^Manual Review Required$"
  f5_command     : "/tm/sys/sshd"
  json_transform : ".include"
  severity       : MEDIUM
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "4.7 Ensure to set Strong SSH KEY Exchange algorithm"
  info           : "To set strong Key Exchange algorithm."
  solution       : "1-Log in to tmsh by typing the following command:tmsh 2-To modify the sshd configuration, type the following command to start the vi editor:edit /sys sshd all-properties3-Set a Key-Exchange algorthem with key of size 256 or longer example diffie-hellman-group14-sha256)4-To change the list of ciphers, you can navigate to the line that starts with the include statement, and use the keyword KexAlgorithms ,and adding the list of desired KexAlgorithms to the 2-line include statement:include \"Ciphers aes128-cbc,aes128-ctr,aes192-ctr,aes256-ctr,arcfour128,arcfour256,arcfourMACs hmac-sha2-256KexAlgorithms diffie-hellman-group14-sha256"
  reference      : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0052 - F5 - Check offline config for access"
  regex          : "allow"
  not_expect     : "\bALL\b"
</custom_item>

<custom_item>
  description    : "1.0053 - F5 - Check REST API for access"
  f5_command     : "/tm/sys/sshd"
  json_transform : ".allow"
  not_expect     : "All"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "4.8 Ensure access SSH to CLI interface is restricted to needed IP addresses only"
  info           : "To limit ssh access to trusted IPs only."
  solution       : "1-Log in to the Configuration utility. 2-Go to System > Platform. 3-For SSH IP Allow, select Specify Range and then enter the IP addresses or address ranges for the remote systems allowed to use SSH to communicate with this system."
  reference      : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0054 - F5 - Check offline config for NTP servers"
  expect         : "servers.*[0-9.]+"
  regex          : "servers"
</custom_item>

<custom_item>
  description    : "1.0055 - F5 - Check REST API for NTP servers"
  expect         : "[0-9.]+"
  f5_command     : "/tm/sys/ntp"
  json_transform : ".servers"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "5.1 Ensure redundant NTP servers are configured appropriately"
  info           : "To ensure redundant NTP servers are configured."
  solution       : "1-Log in to the Configuration utility. 2-Navigate to System > Configuration > Device 3-Click NTP : add trusted NTP servers IP addresses ."
  reference      : "NIST 800-53r5|AU-7 AU-8"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0056 - F5 - Check offline config for inode information"
  expect         : "include \"FileETag MTime Size\""
  regex          : "include"
</custom_item>

<custom_item>
  description    : "1.0057 - F5 - Check REST API for inode information"
  expect         : "^[\s]*FileETag[\s]*MTime[\s]*Size[\s]*$"
  f5_command     : "/tm/sys/httpd"
  json_transform : ".include"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "5.2 Ensure to exclude inode information from ETags HTTP Header"
  info           : "To prevent the disclosure of inode information when accessing Configuration utility (GUI)."
  solution       : "1-Log in to tmsh by entering the following command: tmsh 2-To specify the format to be used for the Etag header, enter the following command: 3-modify /sys httpd include \"FileETag MTime Size\" Save the configuration change by entering the following command: 4-save /sys config 5-To restart the httpd service, enter the following command: restart /sys service httpd"
  reference      : "NIST 800-53r5|AC-18 AC-18(1) AC-18(3) CM-2 CM-6 CM-7 CM-7(1) CM-9"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0058 - F5 - Check offline config for port lockdown"
  regex          : "allow-service"
  not_expect     : "\ball\b"
</custom_item>

<custom_item>
  description    : "1.0059 - F5 - Check REST API for port lockdown"
  f5_command     : "/tm/net/self"
  json_transform : ".items[] | \"Name: \(.name) - Port Lockdown: \(.allowService) \""
  not_expect     : "all"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "5.3 Ensure port lockdown for self IP is set"
  info           : "to secure the BIG-IP system from unwanted connection attempts on self-IP."
  solution       : "1-Log in to the Configuration utility. 2-Go to Network > Self IPs. 3-Select the relevant self IP address. 4-If the specified interface does not need to listen to incoming connections ( Example BGP ,BDF ..etc) , set \"Port Lockdown\" to \"Allow None\" 5-If the specified interface need to listen for incoming connections , set \"Port Lockdown\" to \"Allow Custom\". Then in the \"Custom List\" add needed ports only."
  reference      : "NIST 800-53r5|CM-6 CM-7 SC-23"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<custom_item>
  description    : "1.0060 - F5 - Ensure to disable unused services in BIG-IP configuration"
  info           : "To disable unused BIG-IP system daemons."
  solution       : "1- Log in to the Configuration utility. 2- Go to System > Services > Services List 3-Select the unnecessary services you want to disable , then click \"stop\" 4-Click OK"
  reference      : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
  see_also       : "See HTH Policies and Standards"
  expect         : "^Manual Review Required$"
  f5_command     : "/tm/sys/service"
  json_transform : ".items[] | \"Service Name: \(.name)\""
  severity       : MEDIUM
</custom_item>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0061 - F5 - Check offline config for snmp access"
  expect         : "allowed-addresses { 192.168.0.1 }"
  regex          : "allowed-addresses"
</custom_item>

<custom_item>
  description    : "1.0062 - F5 - Check REST API for snmp access"
  expect         : "^192.168.0.1$"
  f5_command     : "/tm/sys/snmp"
  json_transform : ".allowedAddresses | join(\" \")"
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "6.1 Ensure that SNMP access is allowed to trusted agents IPs only"
  info           : "To limit access to trusted SNMP agents only."
  solution       : "1-Login to Configuration utility 2- Go to System > SNMP > Agent > Configuration 3- Add trusted IP addresses in \"Client Allow List\\"
  reference      : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

<report type:"WARNING">
  description    : "1.0063 - F5 - Ensure minimum SNMP version is set to V3 for agent access"
  info           : "To disable the usage of weak SNMP protocols."
  solution       : "1-Login to Configuration utility 2- Go to System > SNMP > Agent > SNMP Access (v1, v2c) : Select all listed entries and click \"Delete\" 3-Go to System > SNMP > Agent > SNMP Access (v3) : Make sure there is one entry at least , otherwise create one."
  reference      : "NIST 800-53r5|CM-7 CP-6 CP-7 PL-8 PM-7 SA-8 SC-7"
  see_also       : "See HTH Policies and Standards"
</report>

<report type:"WARNING">
  description    : "1.0064 - F5 - Ensure to lockdown access logs to \"Administrator , Resource Administrator and Auditor \" roles only"
  info           : "To restrict access to the system logs."
  solution       : "1-Login to Configuration utility 2-Go to System > Logs > Configuration > Options 3- Under Log Access : select \"Allow\" for: Administrator Resource Administaor Auditor Select \"Deny\" for other users ."
  reference      : "NIST 800-53r5|AU-1 AU-2"
  see_also       : "See HTH Policies and Standards"
</report>

<report type:"WARNING">
  description    : "1.0065 - F5 - Ensure that audit logging for \"MCP, tmsh and GUI\" is set to enabled"
  info           : "To enable audit logging on configuration changes that users or services make to the BIG-IP system."
  solution       : "1-Login to Configuration utility 2-Go to System > Logs > Configuration > Options 3- Under Audit Logging : Select \"Enable\" for all items : \"MCP\" , \"tmsh\" and \"GUI\\"
  reference      : "NIST 800-53r5|AU-1 AU-2"
  see_also       : "See HTH Policies and Standards"
</report>

<if>
  <condition auto:"FAILED" type:"AND">
<custom_item>
  type           : OFFLINE_CONFIG_CHECK
  description    : "1.0066 - F5 - Check offline config for remote syslog servers"
  expect         : "host \b192.168.0.2\b"
  regex          : "host"
</custom_item>

<custom_item>
  description    : "1.0067 - F5 - Check REST API for remote syslog servers"
  expect         : "^[\s]*Remote Syslog Server:[\s]*192.168.0.2[\s]*$"
  f5_command     : "/tm/sys/syslog"
  json_transform : ".remoteServers[] | \"Remote Syslog Server: \(.host)\""
</custom_item>
  </condition>

  <then>
<report type:"PASSED">
  description    : "6.5 Ensure that Remote Syslog Servers are configured"
  info           : "To ensure that logs are sent to external servers."
  solution       : "1-Log in to the Configuration utility. 2-Go to System > Logs > Configuration > Remote Logging. 3-For Remote IP, enter the destination syslog server IP address, or FQDN. (DNS server configuration required) 4-For Remote Port, enter the remote syslog server UDP port (default is 514). 5-Select Add. 6-Select Update."
  reference      : "NIST 800-53r5|AU-6(3)"
  see_also       : "See HTH Policies and Standards"
  show_output    : "YES"
</report>
  </then>
</if>

</check_type>
