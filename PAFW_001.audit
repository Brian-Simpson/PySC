<custom_item>
  type             : AUDIT_XML
  description      : "1.0046 - PAFW - NetPAFW - Services - NTP"
  info             : "These settings enable use of primary and secondary NTP servers to provide redundancy in case of a failure involving the primary NTP server."
  solution         : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference        : "NIST 800-53r5|AU-7 AU-8"
  see_also         : "See HTH Policies and Standards"
  api_request_type : "op"
  request          : "<show><config><merged></merged></config></show>"
  xsl_stmt         : "</xsl:choose>"
  regex            : "(Passed|Failed)"
  not_expect       : "Failed"
</custom_item>

<custom_item>
  type             : AUDIT_XML
  description      : "1.0047 - PAFW - NetPAFW - Services - NTP"
  info             : "These settings enable use of primary and secondary NTP servers to provide redundancy in case of a failure involving the primary NTP server."
  solution         : "Configure this setting to the expected baseline value shown in the control description and value_data."
  reference        : "NIST 800-53r5|AU-7 AU-8"
  see_also         : "See HTH Policies and Standards"
  api_request_type : "op"
  request          : "<show><config><merged></merged></config></show>"
  xsl_stmt         : "</xsl:choose>"
  regex            : "(Passed|Failed)"
  not_expect       : "Failed"
</custom_item>

