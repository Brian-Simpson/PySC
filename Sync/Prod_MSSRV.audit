          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "IA - MSSRV - Interactive logon: Prompt user to change password before expiration is set to between 5 and 14 days"
                      info : "This policy setting determines how far in advance users are warned that their password will expire. It is recommended that you configure this policy setting to at least 5 days but no more than 14 days to sufficiently warn users when their passwords will expire."
                 reference : "NIST 800-53r5|IA-5(1)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "[5..14]"
           powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows NT\CurrentVersion\Winlogon').PasswordExpiryWarning; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
