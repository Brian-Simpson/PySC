        #    powershell_args : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\WindowsFirewall\PublicProfile\Logging'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\WindowsFirewall\PublicProfile\Loggin\Software\Policies\Microsoft\WindowsFirewall\PublicProfile\Logging').LogSuccessfulConnections; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
        #         check_type : CHECK_REGEX
        #        </custom_item>

       <custom_item>
                         type : AUDIT_POWERSHELL
                  description : "CM - MSSRV - Routing and Remote Access (RemoteAccess) is Disabled"
                         info : "Offers routing services to businesses in local area and wide area network environments."
                    reference : "NIST 800-53r5|CM-6 CM-7"
                     see_also : "See corresponding HTH Policy or Standard"
                   value_type : POLICY_TEXT
                   value_data : "Stopped"
              powershell_args : "$noutput = (Get-wmiobject win32_service | where-object {$_.name -eq 'RemoteAccess'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                   check_type : CHECK_REGEX
        </custom_item>

        <custom_item>
                         type : AUDIT_POWERSHELL
                  description : "CM - MSSRV - Check if WinRM service is running"
                         info : "Windows Remote Management (WinRM) is the Microsoft implementation of the WS-Management protocol."
                    reference : "NIST 800-53r5|CM-6 CM-7"
                     see_also : "See corresponding HTH Policy or Standard"
                   value_type : POLICY_TEXT
                   value_data : "Running"
              powershell_args : "$noutput = (Get-wmiobject win32_service | where-object {$_.name -eq 'WinRM'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                   check_type : CHECK_REGEX
        </custom_item>

        <custom_item>
                         type : AUDIT_POWERSHELL
                  description : "CM - MSSRV - Services - Rapid7 Insight Agent Service"
                         info : "The Rapid7 Insight Agent Service is running."
                    reference : "NIST 800-53r5|CM-6"
                     see_also : "See corresponding HTH Policy or Standard"
                   value_type : POLICY_TEXT
                   value_data : "Running"
              powershell_args : "$noutput = (Get-wmiobject win32_service | where-object {$_.name -eq 'ir_agent'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                   check_type : CHECK_REGEX
        </custom_item>

         <custom_item>
                         type : AUDIT_POWERSHELL
                  description : "CM - MSSRV - Services - Base Filtering Engine is running"
                         info : "The Base Filtering Engine service is running."
                    reference : "NIST 800-53r5|CM-6"
                     see_also : "See corresponding HTH Policy or Standard"
                   value_type : POLICY_TEXT
                   value_data : "Running"
              powershell_args : "$noutput = (Get-wmiobject win32_service | where-object {$_.name -eq 'BFE'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                   check_type : CHECK_REGEX
        </custom_item>

         <custom_item>
                         type : AUDIT_POWERSHELL
                  description : "CM - MSSRV - TCPIP6 is disabled"
                         info : "This setting determines if TCPIPV6 is disabled."
                    reference : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
                     see_also : "See corresponding HTH Policy or Standard"
                   value_type : POLICY_TEXT
                   value_data : "255"
              powershell_args : "$noutput = (Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip6\Parameters').DisabledComponents; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                   check_type : CHECK_REGEX
               </custom_item>

               <custom_item>
                        type : AUDIT_POWERSHELL
                 description : "IA - MSSRV - Account - Local Admin Account Enabled"
                        info : "The built-in local admin account should be disabled"
                   reference : "NIST 800-53r5|IA-5"
                    see_also : "HTH"
                  value_type : POLICY_TEXT
                  value_data : "True"
             powershell_args : "$noutput = Get-LocalUser | Where-Object { $_.SID -Match '^S-1-5-21.*-500$' } | Select Name, Enabled; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                  check_type : CHECK_REGEX
              </custom_item>
     
           <custom_item>
                          type : AUDIT_POWERSHELL
                   description : "SC - MSSRV - Services - Windows Firewall is enabled"
                          info : "This policy setting determines if the Windows Firewall service is automatically started during startup. Registry key = HKLM\Software\Policies\Microsoft\Windows\EventLog\Application"
                     reference : "NIST 800-53|CM-6"
                      see_also : "See corresponding HTH Policy or Standard"
                    value_type : POLICY_TEXT
                     value_data: "Running"
               powershell_args : "$noutput = (get-wmiobject win32_service | where-object {$_.name -eq 'MpsSvc' -and $_.state -eq 'Running'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                    check_type : CHECK_EQUAL
           </custom_item>
     
           <custom_item>
                          type : AUDIT_POWERSHELL
                   description : "CM - MSSRV - Services - Security Accounts Manager"
                          info : "This policy setting determines if the Security Accounts Manager service is automatically started during startup. Registry key = HKLM\Software\Policies\Microsoft\Windows\EventLog\Application"
                     reference : "NIST 800-53|CM-6"
                      see_also : "See corresponding HTH Policy or Standard"
                    value_type : POLICY_TEXT
                     value_data: "Running"
               powershell_args : "$noutput = (get-wmiobject win32_service | where-object {$_.name -eq 'SamSs' -and $_.state -eq 'Running'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                    check_type : CHECK_EQUAL
           </custom_item>

           <custom_item>
                          type : AUDIT_POWERSHELL
                   description : "CM - MSSRV - Services - Windows Event Log"
                          info : "NIST 800-53|CM-6"
                      see_also : "See corresponding HTH Policy or Standard"
                    value_type : POLICY_TEXT
                     value_data: "Running"
                powershell_args: "(get-wmiobject win32_service | where-object {$_.name -eq 'EventLog' -and $_.state -eq 'Running'}).state"
                    check_type : CHECK_EQUAL
           </custom_item>

           <custom_item>
                          type : AUDIT_POWERSHELL
                   description : "CM - MSSRV - Services - SentinelAgent"
                          info : "This policy setting determines if the Sentinel One Agent service is actively running."
                     reference : "NIST 800-53|CM-6"
                      see_also : "See corresponding HTH Policy or Standard"
                    value_type : POLICY_TEXT
                     value_data: "Running"
               powershell_args : "$noutput = (get-wmiobject win32_service | where-object {$_.name -eq 'SentinelAgent' -and $_.state -eq 'Running'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                    check_type : CHECK_EQUAL
           </custom_item>
     
           <custom_item>
                          type : AUDIT_POWERSHELL
                   description : "CM - MSSRV - Services - Sentinel One Helper Service"
                          info : "This policy setting determines if the SentinelHelperService service is  actively running."
                     reference : "NIST 800-53|CM-6"
                      see_also : "See corresponding HTH Policy or Standard"
                    value_type : POLICY_TEXT
                     value_data: "Running"
               powershell_args : "$noutput = (get-wmiobject win32_service | where-object {$_.name -eq 'SentinelHelperService' -and $_.state -eq 'Running'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                    check_type : CHECK_EQUAL
           </custom_item>
     
           <custom_item>
                          type : AUDIT_POWERSHELL
                   description : "CM - MSSRV - Services - Sentinel Static Engine"
                          info : "This policy setting determines if the Sentinel Static Engine is actively running."
                     reference : "NIST 800-53|CM-6"
                      see_also : "See corresponding HTH Policy or Standard"
                    value_type : POLICY_TEXT
                     value_data: "Running"
               powershell_args : "$noutput = (get-wmiobject win32_service | where-object {$_.name -eq 'SentinelStaticEngine' -and $_.state -eq 'Running'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                    check_type : CHECK_EQUAL
           </custom_item>
     
           <custom_item>
                          type : AUDIT_POWERSHELL
                   description : "CM - MSSRV - Services - Sentinel One Log Processor Service"
                          info : "This policy setting determines if the Sentinel One Log Processor Service is actively running"
                     reference : "NIST 800-53|CM-6"
                      see_also : "See corresponding HTH Policy or Standard"
                    value_type : POLICY_TEXT
                     value_data: "Running"
               powershell_args : "$noutput = (get-wmiobject win32_service | where-object {$_.name -eq 'LogProcessorService' -and $_.state -eq 'Running'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                    check_type : CHECK_EQUAL
           </custom_item>  
     
           <custom_item>
                          type : AUDIT_POWERSHELL
                   description : "AC - MSSRV - Microsoft network client: Digitally sign communications (if server agrees) is set to Enabled"
                          info : "This policy setting determines whether the SMB client will attempt to negotiate SMB packet signing."
                     reference : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
                      see_also : "See corresponding HTH Policy or Standard"
                    value_type : POLICY_TEXT
                    value_data : "1"
               powershell_args : "$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\LanmanWorkstation\Parameters').EnableSecuritySignature; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                    check_type : CHECK_EQUAL
           </custom_item>

            <custom_item>
                          type : AUDIT_POWERSHELL
                   description : "CM - MSSRV - Services - Update Orchestrator Service"
                          info : "This policy setting determines if the Update Orchestrator Service, which is responsible for Windows updates is actively running."
                     reference : "NIST 800-53|CM-6"
                      see_also : "See corresponding HTH Policy or Standard"
                    value_type : POLICY_TEXT
                     value_data: "Running"
               powershell_args : "$noutput = (get-wmiobject win32_service | where-object {$_.name -eq 'UsoSvc' -and $_.state -eq 'Running'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                    check_type : CHECK_EQUAL
           </custom_item>

           <custom_item>
                          type : AUDIT_POWERSHELL
                   description : "CM - MSSRV - Services - TermService"
                          info : "This policy setting determines if the TermService Remote Desktop Services is actively running."
                     reference : "NIST 800-53|CM-6"
                      see_also : "See corresponding HTH Policy or Standard"
                    value_type : POLICY_TEXT
                     value_data: "Running"
               powershell_args : "$noutput = (get-wmiobject win32_service | where-object {$_.name -eq 'TermService' -and $_.state -eq 'Running'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                    check_type : CHECK_EQUAL
           </custom_item>


           <custom_item>
                          type : AUDIT_POWERSHELL
                   description : "CM - MSSRV - Services - Lanman Server"
                          info : "This policy setting determines if the The LanmanServer service which allows your computer to share files and printers with other devices on your network, is actively running."
                     reference : "NIST 800-53|CM-6"
                      see_also : "See corresponding HTH Policy or Standard"
                    value_type : POLICY_TEXT
                     value_data: "Running"
               powershell_args : "$noutput = (get-wmiobject win32_service | where-object {$_.name -eq 'LanmanServer' -and $_.state -eq 'Running'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                    check_type : CHECK_EQUAL
           </custom_item>

           <custom_item>
                          type : AUDIT_POWERSHELL
                   description : "CM - MSSRV - Services - Lanmanworkstation"
                          info : "This policy setting determines if the Lanmanworkstation that manages network connections and access to network resources, is actively running."
                     reference : "NIST 800-53|CM-6"
                      see_also : "See corresponding HTH Policy or Standard"
                    value_type : POLICY_TEXT
                     value_data: "Running"
               powershell_args : "$noutput = (get-wmiobject win32_service | where-object {$_.name -eq 'Lanmanworkstation' -and $_.state -eq 'Running'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                    check_type : CHECK_EQUAL
           </custom_item>

           <custom_item>
                          type : AUDIT_POWERSHELL
                   description : "CM - MSSRV - Services - Sentinel Static Engine"
                          info : "This policy setting determines if the WPNService Windows Push Notification Services WNS enable third-party developers to send toast, tile, badge, and raw updates from their own cloud service, is actively running."
                     reference : "NIST 800-53|CM-6"
                      see_also : "See corresponding HTH Policy or Standard"
                    value_type : POLICY_TEXT
                     value_data: "Running"
               powershell_args : "$noutput = (get-wmiobject win32_service | where-object {$_.name -eq 'WpnService' -and $_.state -eq 'Running'}).state; if ($noutput -eq $Null) {write-host 'Service Not Found'} else {$noutput}"
                    check_type : CHECK_EQUAL
           </custom_item>
 
  </then>
 
  <else>
    <report type:"WARNING">
      description     : "WARNING - TARGET OS DOESNT MATCH BASELINE - WINSRV"
      info            : "NOTE: Nessus has identified that the chosen audit does not apply to the target device."
      see_also        : "Link to Controls"
    </report>
  </else>
</if>

#########################################################################################################################################
########################################################### DOMAIN CONTROLLER ###########################################################
#########################################################################################################################################


<if>
  <condition type:"AND">
    <custom_item>
      type          : WMI_POLICY
      description   : "Check if server is Domain Controller"
      value_type    : POLICY_DWORD
      value_data    : 4 || 5
      wmi_namespace : "root/CIMV2"
      wmi_request   : "select DomainRole from Win32_ComputerSystem"
      wmi_attribute : "DomainRole"
      wmi_key       : "DomainRole"
    </custom_item>
  </condition>
 
  <then>

               <custom_item>
                     type : AUDIT_POWERSHELL
              description : "CM - MSSRV.DC - Services - Print Spooler disabled (DC only)"
                     info : "In the past, the Print Spooler had a critical vulnerability, referred to as PrintNightmare (CVE-2021-34527), which allowed attackers to execute code with administrator privileges. While patched, it highlights the need for careful security configuration."
                reference : "NIST 800-53|CM-6 CM-7"
                 see_also : "HTH"
               value_type : POLICY_TEXT
               value_data : "4"
          powershell_args : "if (Test-Path -Path 'HKLM:\System\Currentcontrolset\Services\Spooler') {(Get-ItemProperty -Path 'HKLM:\System\Currentcontrolset\Services\Spooler').Start } else {Write-Output 'NON_COMPLIANT PATH' } "
               check_type : CHECK_REGEX
              </custom_item>

        #       <custom_item>
        #             type : AUDIT_POWERSHELL
        #      description : "AC - MSSRV.DC - Network access: Restrict clients allowed to make remote calls to SAM(MS only)"
        #             info : "Network access: Restrict clients allowed to make remote calls to SAM"
        #        reference : "NIST 800-53|AC-6(3),800-53r5|AC-6(3),CN-L3|7.1.3.2(b)"
        #         see_also : "See HTH Polocies and Standards"
        #       value_type : POLICY_TEXT
        #       value_data : "O:BAG:BAD:(A;;RC;;;BA)"
        #  powershell_args : "if (Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa') {(Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Lsa').RestrictRemoteSAM } else {Write-Output 'NON_COMPLIANT PATH' } "
        #       check_type : CHECK_REGEX
        #     </custom_item>


        #      <custom_item>
        #             type : USER_RIGHTS_POLICY
        #      description : "AC - MSSRV.DC - Access this computer from the network (Administrators && Authenticated Users && Enterprise Domain Controllers) (DC only)"
        #             info : "Access this computer from the network"
        #        reference : "NIST 800-53|AC-6(7)(b),800-53r5|AC-6(7)(b)"
        #         see_also : "See HTH Polocies and Standards"
        #       value_type : USER_RIGHT
        #       value_data : "Administrators" && "Authenticated Users" 
        #       right_type : SeNetworkLogonRight
        #     </custom_item>

        #      <custom_item>
        #             type : USER_RIGHTS_POLICY
        #      description : "AC - MSSRV.DC - Deny access to this computer from the network(NOT DC)"
        #             info : "Deny access to this computer from the network"
        #        reference : "NIST 800-53|AC-6(7)(b),800-53r5|AC-6(7)(b)"
        #         see_also : "See HTH Polocies and Standards"
        #       value_type : USER_RIGHT
        #       value_data : "NT AUTHORITY\Local account and member of Administrators group" || "Local account and member of Administrators group"
        #       right_type : SeDenyNetworkLogonRight
        #       check_type : CHECK_SUPERSET
        #     </custom_item>

        #      <custom_item>
        #             type : USER_RIGHTS_POLICY
        #      description : "AC - MSSRV.DC - Deny log on through Remote Desktop Services(NOT DC)"
        #             info : "Deny log on through Remote Desktop Services"
        #        reference : "NIST 800-53|AC-6(7)(b),800-53r5|AC-6(7)(b)"
        #         see_also : "See HTH Polocies and Standards"
        #       value_type : USER_RIGHT
        #       value_data : "NT AUTHORITY\Local account" || "Local account"
        #       right_type : SeDenyRemoteInteractiveLogonRight
        #       check_type : CHECK_SUPERSET
        #     </custom_item>

        #      <custom_item>
        #             type : AUDIT_POWERSHELL
        #      description : "AU - MSSRV.DC - Ensure 'Audit Kerberos Authentication Service' is set to 'Success and Failure' (DC Only)"
        #             info : "This subcategory reports the results of events generated after a Kerberos authentication TGT request. This helps mitigate an attacker or server from impersonating a user."
        #        reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        #         see_also : "See HTH Policies and Standards"
        #       value_type : POLICY_TEXT
        #       value_data : "Success and Failure"
        #  powershell_args : "$KAS = auditpol /get /Subcategory:'Kerberos Authentication Service' |Select-String 'Kerberos Authentication Service'; $KASStr=$KAS.ToString(); $KASStr -match 'Success' | out-null; $LOKAS = $matches[0]; Write-Output $LOKAS;"
        #       check_type : CHECK_REGEX
        #     </custom_item>

        #      <custom_item>
        #             type : AUDIT_POWERSHELL
        #      description : "AU - MSSRV.DC - Ensure 'Audit Kerberos Service Ticket Operations' is set to 'Success and Failure' (DC Only)"
        #             info : "This subcategory reports the results of events generated by Kerberos authentication ticket-granting ticket (TGT) requests. Kerberos Service Ticket requests (TGS requests) occur as part of service use and access requests by specific accounts. Auditing these events will record the IP address from which the account requested TGS, when TGS was requested, and which encryption type was used."
        #        reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        #         see_also : "See HTH Policies and Standards"
        #       value_type : POLICY_TEXT
        #       value_data : "Success and Failure"
        #  powershell_args : "$KSTO = auditpol /get /Subcategory:'Kerberos Service Ticket Operations' |Select-String 'Kerberos Service Ticket Operations'; $KSTOStr=$KSTO.ToString(); $KSTOStr -match 'Success' | out-null; $LOKSTO = $matches[0]; Write-Output $LOKSTO;"
        #       check_type : CHECK_REGEX
        #     </custom_item>

             <custom_item>
                    type : AUDIT_POWERSHELL
             description : "AU - MSSRV.DC - Ensure 'Audit Computer Account Management' is set to include 'Success' (DC only)"
                    info : "This subcategory reports each event of computer account management, such as when a computer account is created, changed, deleted, renamed, disabled, or enabled."
               reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                see_also : "See HTH Policies and Standards"
              value_type : POLICY_TEXT
              value_data : "Success"
         powershell_args : "$CAM = auditpol /get /Subcategory:'Computer Account Management' |Select-String 'Computer Account Management'; $CAMStr=$CAM.ToString(); $CAMStr -match 'Success' | out-null; $LOCAM = $matches[0]; Write-Output $LOCAM;"
              check_type : CHECK_REGEX
            </custom_item>

             <custom_item>
                    type : AUDIT_POWERSHELL
             description : "AU - MSSRV.DC - Ensure 'Audit Distribution Group Management' is set to include 'Success' (DC only)"
                    info : "This subcategory reports each event of distribution group management, such as when a distribution group is created, changed, or deleted or when a member is added to or removed from a distribution group. If you enable this Audit policy setting, administrators can track events to detect malicious, accidental, and authorized creation of group accounts."
               reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                see_also : "See HTH Policies and Standards"
              value_type : POLICY_TEXT
              value_data : "Success"
         powershell_args : "$DGM = auditpol /get /Subcategory:'Distribution Group Management' |Select-String 'Distribution Group Management'; $DGMStr=$DGM.ToString(); $DGMStr -match 'Success' | out-null; $LODGM = $matches[0]; Write-Output $LODGM;"
               check_type : CHECK_REGEX
            </custom_item>

             <custom_item>
                    type : AUDIT_POWERSHELL
             description : "AU - MSSRV.DC - Ensure 'Audit Other Account Management Events' is set to include 'Success' (DC only)"
                    info : "This subcategory reports other account management events."
               reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                see_also : "See HTH Policies and Standards"
              value_type : POLICY_TEXT
              value_data : "Success"
         powershell_args : "$OAME = auditpol /get /Subcategory:'Other Account Management Events' |Select-String 'Other Account Management Events'; $OAMEStr=$OAME.ToString(); $OAMEStr -match 'Success' | out-null; $LOAME = $matches[0]; Write-Output $LOAME;"
              check_type : CHECK_REGEX
            </custom_item>

             <custom_item>
                    type : AUDIT_POWERSHELL
             description : "AU - MSSRV.DC - Ensure 'Audit Directory Service Access' is set to include 'Failure' (DC only)"
                    info : "This subcategory reports when an AD DS object is accessed. Only objects with SACLs cause audit events to be generated, and only when they are accessed in a manner that matches their SACL. These events are similar to the directory service access events in previous versions of Windows Server. This subcategory applies only to Domain Controllers."
               reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                see_also : "See HTH Policies and Standards"
              value_type : POLICY_TEXT
              value_data : "Failure"
         powershell_args : "$DSA = auditpol /get /Subcategory:'Directory Service Access' |Select-String 'Directory Service Access'; $DSAStr=$DSA.ToString(); $DSAStr -match 'Failure' | out-null; $LODSA = $matches[0]; Write-Output $LODSA;"
              check_type : CHECK_REGEX
            </custom_item>

             <custom_item>
                    type : AUDIT_POWERSHELL
             description : "AU - MSSRV.DC - Ensure 'Audit Directory Service Changes' is set to include 'Success' (DC only)"
                    info : "This subcategory reports changes to objects in Active Directory Domain Services (AD DS). The types of changes that are reported are create, modify, move, and undelete operations that are performed on an object. DS Change auditing, where appropriate, indicates the old and new values of the changed properties of the objects that were changed. Only objects with SACLs cause audit events to be generated, and only when they are accessed in a manner that matches their SACL. Some objects and properties do not cause audit events to be generated due to settings on the object class in the schema."
               reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                see_also : "See HTH Policies and Standards"
              value_type : POLICY_TEXT
              value_data : "Success"
         powershell_args : "$DSC = auditpol /get /Subcategory:'Directory Service Changes' |Select-String 'Directory Service Changes'; $DSCStr=$DSC.ToString(); $DSCStr -match 'Success' | out-null; $LODSC = $matches[0]; Write-Output $LODSC;"
              check_type : CHECK_REGEX
            </custom_item>


             <custom_item>
                    type : USER_RIGHTS_POLICY
             description : "AC - MSSRV.DC - Ensure 'Create symbolic links' is set to 'Administrators' (DC only)"
                    info : "This policy setting determines which users can create symbolic links. In Windows Vista, existing NTFS file system objects, such as files and folders, can be accessed by referring to a new kind of file system object called a symbolic link. A symbolic link is a pointer (much like a shortcut or .lnk file) to another file system object, which can be a file, folder, shortcut or another symbolic link. The difference between a shortcut and a symbolic link is that a shortcut only works from within the Windows shell. To other programs and applications, shortcuts are just another file, whereas with symbolic links, the concept of a shortcut is implemented as a feature of the NTFS file system."
               reference : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
                see_also : "See HTH Policies and Standards"
              value_type : USER_RIGHT
              value_data : "Administrators"
              right_type : SeCreateSymbolicLinkPrivilege
            </custom_item>

          #    <custom_item>
          #           type : USER_RIGHTS_POLICY
          #    description : "AC - MSSRV.DC - Ensure Access this computer from the network is set to Administrators, Authenticated Users, ENTERPRISE DOMAIN CONTROLLERS (DC only)"
          #           info : "This policy setting allows other users on the network to connect to the computer and is required by various network protocols that include Server Message Block (SMB)-based protocols, NetBIOS, Common Internet File System (CIFS), and Component Object Model Plus (COM+)."
          #      reference : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
          #       see_also : "See HTH Policies and Standards"
          #     value_type : USER_RIGHT
