          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "CM - MSSRV - Configure SMB v1 client driver is set to Enabled: Disable driver (recommended)"
                      info : "This setting configures the start type for the Server Message Block version 1 (SMBv1) client driver service ( MRxSmb10 ), which is recommended to be disabled."
                 reference : "NIST 800-53r5|CM-6 CM-7"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "4"
           powershell_args : "if(Test-Path -Path 'HKLM:\SYSTEM\CurrentControlSet\Services\mrxsmb10'){$noutput = (Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Services\mrxsmb10').Start;if($noutput -eq $Null) {write-host 'Path Not Found'} else {$noutput}}else {write-host 'Value Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "CM - MSSRV - Configure SMB v1 server is set to Disabled"
                      info : "This setting configures the server-side processing of the Server Message Block version 1 (SMBv1) protocol."
