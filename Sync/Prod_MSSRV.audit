            <custom_item>
                        type : CHECK_ACCOUNT
                 description : "IA - MSSRV - Accounts: Guest account status is configured correctly.(MS only)"
                        info : "This policy setting determines whether the Guest account is enabled or disabled. The Guest account allows unauthenticated network users to gain access to the system."
                   reference : "NIST 800-53r5|IA-5"
                    see_also : "See HTH Policies and Standards"
                  value_type : POLICY_SET
                  value_data : "Disabled"
                account_type : GUEST_ACCOUNT
            </custom_item>
  
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "IA - MSSRV - Accounts: Limit local account use of blank passwords to console logon only is set to Enabled"
                      info : "This policy setting determines whether local accounts that are not password protected can be used to log on from locations other than the physical computer console. If you enable this policy setting, local accounts that have blank passwords will not be able to log on to the network from remote client computers. Such accounts will only be able to log on at the keyboard of the computer."
                 reference : "NIST 800-53r5|IA-5(1)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Lsa').LimitBlankPasswordUse;if($noutput -eq $Null) {write-host 'Path Not Found'} else {$noutput}}else {write-host 'Value Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - Shutdown: Allow system to be shut down without having to log on is set to Disabled"
                      info : "This policy setting determines whether a computer can be shut down when a user is not logged on. If this policy setting is enabled, the shutdown command is available on the Windows logon screen. It is recommended to disable this policy setting to restrict the ability to shut down the computer to users with credentials on the system."
                 reference : "NIST 800-53r5|AC-6(10)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "0"
           powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').ShutdownWithoutLogon;if($noutput -eq $Null) {write-host 'Path Not Found'} else {$noutput}}else {write-host 'Value Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
               <custom_item>
                      type : CHECK_ACCOUNT
               description : "IA - MSSRV - Account - Rename Guest Account"
                      info : "The built-in local guest account is another well-known name to attackers."
                 reference : "NIST 800-53r5|IA-5"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Guest"
              account_type : GUEST_ACCOUNT
                check_type : CHECK_NOT_EQUAL
               </custom_item>
 
                <custom_item>
                      type : CHECK_ACCOUNT
               description : "IA - MSSRV - Account - Rename Local Admin"
                      info : "The built-in local administrator account is a well-known account name that attackers will target. It is recommended to choose another name for this account, and to avoid names that denote administrative or elevated access accounts. Be sure to also change the default des for the local administrator (through the Computer Management console). On Domain Controllers, since they do not have their own local accounts, this rule refers to the built-in Administrator account that was established when the domain was first created."
                 reference : "NIST 800-53r5|IA-5"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "\b[Aa]dmin(istrator)?"
              account_type : ADMINISTRATOR_ACCOUNT
                check_type : CHECK_NOT_REGEX
               </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "CM - MSSRV - System objects: Require case insensitivity for non-Windows subsystems is set to Enabled"
                      info : "This policy setting determines whether case insensitivity is enforced for all subsystems."
                 reference : "NIST 800-53r5|CM-6b."
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Session Manager\Kernel'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Session Manager\Kernel').ObCaseInsensitive;if($noutput -eq $Null) {write-host 'Path Not Found'} else {$noutput}}else {write-host 'Value Not Found'}"
                check_type : CHECK_REGEX
        </custom_item>

          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "CM - MSSRV - System objects: Strengthen default permissions of internal system objects (e.g. Symbolic Links) is set to Enabled"
                      info : "This policy setting determines the strength of the default discretionary access control list (DACL) for objects."
                 reference : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Session Manager'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Session Manager').ProtectionMode;if($noutput -eq $Null) {write-host 'Path Not Found'} else {$noutput}}else {write-host 'Value Not Found'}"
                check_type : CHECK_REGEX
            </custom_item>
 
