                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "0"
           powershell_args : "if(Test-Path -Path 'HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters').SMB1;if($noutput -eq $Null) {write-host 'Path Not Found'} else {$noutput}}else {write-host 'Value Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
