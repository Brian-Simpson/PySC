                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Cryptography\Wintrust\Config'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Cryptography\Wintrust\Config').EnableCertPaddingCheck;if($noutput -eq $Null) {write-host 'Path Not Found'} else {$noutput}}else {write-host 'Value Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "SI - MSSRV - Enable Structured Exception Handling Overwrite Protection (SEHOP) is set to Enabled"
