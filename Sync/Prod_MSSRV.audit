          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - Network security: Do not store LAN Manager hash value on next password change is configured correctly."
                      info : "This policy setting determines whether the LAN Manager (LM) hash value for the new password is stored when the password is changed. The LM hash is relatively weak and prone to attack compared to the cryptographically stronger Microsoft Windows NT hash. Since LM hashes are stored on the local computer in the security database, passwords can then be easily compromised if the database is attacked."
                 reference : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Lsa').NoLMHash;if($noutput -eq $Null) {write-host 'Path Not Found'} else {$noutput}}else {write-host 'Value Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
