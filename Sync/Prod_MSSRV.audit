          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - Require user authentication for remote connections by using Network Level Authentication is set to Enabled"
                      info : "This policy setting allows you to specify whether to require user authentication for remote connections to the RD Session Host server by using Network Level Authentication."
                 reference : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows NT\Terminal Services'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows NT\Terminal Services').UserAuthentication;if($noutput -eq $Null) {write-host 'Path Not Found'} else {$noutput}}else {write-host 'Value Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - Set client connection encryption level is set to Enabled: High Level"
                      info : "This policy setting specifies whether to require the use of a specific encryption level to secure communications between client computers and RD Session Host servers during Remote Desktop Protocol (RDP) connections. This policy only applies when you are using native RDP encryption. However, native RDP encryption (as opposed to SSL encryption) is not recommended. This policy does not apply to SSL encryption."
                 reference : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "3"
           powershell_args : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows NT\Terminal Services'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows NT\Terminal Services').MinEncryptionLevel;if($noutput -eq $Null) {write-host 'Path Not Found'} else {$noutput}}else {write-host 'Value Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
