#########################################################################################################################################
########################################################## HTH_SERVER_BASELINE ##########################################################
#########################################################################################################################################

<check_type:"Windows" version:"2">
<group_policy:"HTH Windows Server Baseline">
 

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "System/Domain Identification"
                       info : "This obtains specific user and system information that may be used for additional evaluation."
                  reference : "NIST 800-53r5|"
                   see_also : "HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : ".*"
            powershell_args : "(Get-ComputerInfo) |Select-Object OSDisplayVersion, CsManufacturer, CsModel, BiosBIOSVersion, BiosSeralNumber, CsUserName, OsName, OsBuildNumber, OsProductType, CsDNSHostName, CsDomain;"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "Network Information"
                       info : "This obtains relevent hosted view network information that may be used for additional evaluation."
                  reference : "NIST 800-53r5|"
                   see_also : "HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : ".*"
            powershell_args : "Get-NetIPConfiguration -Detailed ;(Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.2\Server');"
                 check_type : CHECK_REGEX
           </custom_item>

#########################################################################################################################################
############################################################# MEMBER SERVER #############################################################
#########################################################################################################################################

<if>
  <condition type:"AND">
    <custom_item>
      type        : REGISTRY_SETTING
      description : "Windows Server is installed"
      value_type  : POLICY_TEXT
      value_data  : "^[Ww][Ii][Nn][Dd][Oo][Ww][Ss].+[Ss][Ee][Rr][Vv][Ee][Rr].+$"
      reg_key     : "HKLM\Software\Microsoft\Windows Nt\Currentversion"
      reg_item    : "ProductName"
      check_type  : CHECK_REGEX
    </custom_item>
  </condition>    
 
  <then>
    <report type:"PASSED">
      description : "PASSED - TARGET OS MATCHES BASELINE - WINSRV"
      see_also    : "Link to Controls"
    </report>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "IA - MSSRV - Password - History - 24 passwords remembered"
                       info : "This policy setting determines the number of renewed, unique passwords that have to be associated with a user account before you can reuse an old password."
                  reference : "NIST 800-53r5|IA-5(1)"
                   see_also : "See HTH Polices and Standards"
                 value_type : POLICY_TEXT
                 value_data : "24"
            powershell_args : "$HisPwdObj = net accounts | Select-string 'password history'; $HisPwdStr = $HisPwdObj.ToString(); $HisPwdStr -match '\d{1,2}' | out-null; $HisPwdStr -match '24' | out-null; $LO_HisPwd = $matches[0]; Write-Output $LO_HisPwd;"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "IA - MSSRV - Password - Maximum Age - 60 days"
                       info : "This policy setting defines how long a user can use their password before it expires."
                  reference : "NIST 800-53r5|IA-5(1)"
                   see_also : "See HTH Polices and Standards"
                 value_type : POLICY_TEXT
                 value_data : "60"
            powershell_args : "$MaxAgeObj = net accounts | Select-string 'Maximum password'; $MaxAgeStr = $MaxAgeObj.ToString(); $MaxAgeStr -match '\d{1,2}' | out-null; $MaxAgeStr -match '60' | out-null; $LO_MaxAge = $matches[0]; Write-Output $LO_MaxAge;"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "IA - MSSRV - Password - Minimum Age - 1 day"
                       info : "This policy setting determines the least number of characters that make up a password for a user account."
                  reference : "NIST 800-53r5|IA-5(1)"
                   see_also : "See HTH Polices and Standards"
                 value_type : POLICY_TEXT
                 value_data : "1"
            powershell_args : "$MinAgeObj = net accounts | Select-string 'Minimum password age'; $MinAgeStr = $MinAgeObj.ToString(); $MinAgeStr -match '\d{1,2}' | out-null; $MinAgeStr -match '1' | out-null; $LO_MinAge = $matches[0]; Write-Output $LO_MinAge;"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "IA - MSSRV - Password - Length - 8 characters"
                       info : "This policy setting determines the least number of characters that make up a password for a user account."
                  reference : "NIST 800-53r5|IA-5(1)"
                   see_also : "See HTH Polices and Standards"
                 value_type : POLICY_TEXT
                 value_data : "[8...20]"
            powershell_args : "$LngthPwdObj = net accounts | Select-string 'password length'; $LngthPwdStr = $LngthPwdObj.ToString(); $LngthPwdStr -match '\d{1,2}' | out-null; $LngthPwdStr -match '8' | out-null; $LO_LngthPwd = $matches[0]; Write-Output $LO_LngthPwd;"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : PASSWORD_POLICY
                description : "IA - MSSRV - Password - Complexity Requirements - Enabled"
                       info : "This policy setting checks all new passwords to ensure that they meet basic requirements for strong passwords."
                  reference : "NIST 800-53r5|IA-5(1)"
                   see_also : "See HTH Polices and Standards"
                 value_type : POLICY_SET
                 value_data : "Enabled"
            password_policy : COMPLEXITY_REQUIREMENTS
           </custom_item>

#            <custom_item>
#                        type : AUDIT_POWERSHELL
#                 description : "IA - MSSRV - Relax minimum password length limits is set to Enabled"
#                        info : "This policy setting determines whether the minimum password length setting can be increased beyond the legacy limit of 14 characters. For more information, please see the following"
#                   reference : "NIST 800-53r5|IA-5(1)"
#                    see_also : "See HTH Policies and Standards"
#                  value_type : POLICY_TEXT
#                  value_data : "^1$"
#             powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\SAM'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\SAM').RelaxMinimumPasswordLengthLimits;if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}}else {write-host 'Path Not Found'}"
#                  check_type : CHECK_REGEX
#            </custom_item>

           <custom_item>
                       type : PASSWORD_POLICY
                description : "IA - MSSRV - Password - Reversible Encryption - Disabled"
                       info : "This policy setting determines whether the operating system stores passwords in a way that uses reversible encryption."
                  reference : "NIST 800-53r5|IA-5(1) SC-28 SC-28(1)"
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_SET
                 value_data : "Disabled"
            password_policy : REVERSIBLE_ENCRYPTION
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AC - MSSRV - Password - Account Lockout Reset - 1 day"
                       info : "This policy setting determines the length of time before the Account lockout threshold resets to zero."
                  reference : "NIST 800-53r5|AC-7 AC-19"
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : ".*60"
            powershell_args : "$LockObsObj = net accounts | Select-string 'Lockout observation'; $LockObsStr = $LockObsObj.ToString(); $LockObsStr -match '\d{1,2}' | out-null; $LockObsStr -match '60' | out-null; $LO_LockObs = $matches[0]; Write-Output $LO_LockObs;"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AC - MSSRV - Password - Account Lockout Threshold - 5 invalid attempts"
                       info : "This policy setting determines the number of failed logon attempts before the account is locked."
                  reference : "NIST 800-53r5|AC-7 AC-19"
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : ".*5"
            powershell_args : "$lockoutObj = net accounts | Select-string threshold; $lockoutStr = $lockoutObj.ToString(); $lockoutStr -match '\d{1,3}' | out-null; $lockoutStr -match 'Never' | out-null; $LO_threshold = $matches[0]; Write-Output $LO_threshold;"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : PASSWORD_POLICY
                description : "IA - MSSRV - Password - Lockout Admins - Enabled"
                       info : "This policy setting determines whether the built-in Administrator account is subject to the HTH Account Lockout Policy settings."
                  reference : "NIST 800-53r5|IA-5(1)"
                   see_also : "HTH Password Standard"
                 value_type : POLICY_SET
                 value_data : "Enabled"
            password_policy : LOCKOUT_ADMINS
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AC - MSSRV - Password - Account Lockout Duration - 60 minutes"
                       info : "This policy setting determines the length of time that must pass before a locked account is unlocked and a user can try to log on again."
                  reference : "NIST 800-53r5|AC-7 AC-19"
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "60"
            powershell_args : "$LockDurObj = net accounts | Select-string 'Lockout duration'; $LockDurStr = $LockDurObj.ToString(); $LockDurStr -match '\d{1,2}' | out-null; $LockDurStr -match '60' | out-null; $LO_LockDur = $matches[0]; Write-Output $LO_LockDur;"
                 check_type : CHECK_REGEX
           </custom_item>

           <custom_item>
                       type : AUDIT_POWERSHELL
                description : "AU - MSSRV - Audit Credential Validation is set to Success and Failure"
                       info : "This subcategory reports the results of validation tests on credentials submitted for a user account logon request. These events occur on the computer that is authoritative for the credentials. For domain accounts, the Domain Controller is authoritative, whereas for local accounts, the local computer is authoritative. In domain environments, most of the Account Logon events occur in the Security log of the Domain Controllers that are authoritative for the domain accounts. However, these events can occur on other computers in the organization when local accounts are used to log on. Events for this subcategory include:"
                  reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 "
                   see_also : "See HTH Policies and Standards"
                 value_type : POLICY_TEXT
                 value_data : "Success and Failure"
            powershell_args : "$CV = auditpol /get /Subcategory:'Credential Validation' |Select-String 'Credential Validation'; $CVStr=$CV.ToString(); $CVStr -match 'Success and Failure' | out-null; $LOCV = $matches[0]; Write-Output $LOCV;"
                 check_type : CHECK_REGEX
           </custom_item>

          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit Application Group Management is set to Success and Failure"
                      info : "This policy setting allows you to audit events generated by changes to application groups such as the following: "
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Success and Failure"
           powershell_args : "$AGM = auditpol /get /Subcategory:'Application Group Management'|Select-String 'Credential Validation'; $AGMtr=$AGM.ToString(); $AGMStr -match 'Success and Failure' | out-null; $LOAGM = $matches[0]; Write-Output $LOAGM;"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit Security Group Management is set to include Success"
                      info : "This subcategory reports each event of security group management, such as when a security group is created, changed, or deleted or when a member is added to or removed from a security group. If you enable this Audit policy setting, administrators can track events to detect malicious, accidental, and authorized creation of security group accounts. Events for this subcategory include: "
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Success" ||"Success and Failure"
           powershell_args : "$SGM = auditpol /get /Subcategory:'Security Group Management' |Select-String 'Credential Validation'; $SGMtr=$SGM.ToString(); $SGMStr -match 'Success and Failure' | out-null; $LOSGM = $matches[0]; Write-Output $LOSGM;"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit User Account Management is set to Success and Failure"
                      info : "This subcategory reports each event of user account management, such as when a user account is created, changed, or deleted; a user account is renamed, disabled, or enabled; or a password is set or changed. If you enable this Audit policy setting, administrators can track events to detect malicious, accidental, and authorized creation of user accounts. Events for this subcategory include: "
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Success and Failure"
           powershell_args : "$UAM = auditpol /get /Subcategory:'User Account Management'|Select-String 'Credential Validation'; $UAMtr=$UAM.ToString(); $UAMStr -match 'Success and Failure' | out-null; $LOUAM = $matches[0]; Write-Output $LOUAM;"
                check_type : CHECK_REGEX
           </custom_item>
 
               <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit PNP Activity is set to include Success"
                      info : "This policy setting allows you to audit when plug and play detects an external device."
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Success" ||"Success and Failure"
           powershell_args : "$PNPE = auditpol /get /Subcategory:'Plug and Play Events'|Select-String 'Credential Validation'; $PNPEtr=$PNPE.ToString(); $PNPEStr -match 'Success and Failure' | out-null; $LOPNPE = $matches[0]; Write-Output $LOPNPE;"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit Process Creation is set to include Success"
                      info : "This subcategory reports the creation of a process and the name of the program or user that created it."
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Success" || "Success and Failure"
           powershell_args : "$PC = auditpol /get /Subcategory:'Process Creation'| Select-String 'Credential Validation'; $PCtr=$PC.ToString(); $PCStr -match 'Success and Failure' | out-null; $LOPC = $matches[0]; Write-Output $LOPC;"
                check_type : CHECK_REGEX
          </custom_item>
 
         <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit Account Lockout is set to include Failure"
                      info : "This subcategory reports when a user s account is locked out as a result of too many failed logon attempts. Events for this subcategory include: "
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Failure" ||"Success and Failure"
           powershell_args : "$ALO = auditpol /get /Subcategory:'Account Lockout'| Select-String 'Credential Validation'; $ALOtr=$ALO.ToString(); $ALOStr -match 'Success and Failure' | out-null; $LOALO = $matches[0]; Write-Output $LOALO;"
                check_type : CHECK_REGEX
          </custom_item>
 
        #        <custom_item>
        #               type : AUDIT_POWERSHELL
        #        description : "AU - MSSRV - Audit Group Membership is set to include Success"
        #               info : "This policy allows you to audit the group membership information in the user s logon token. Events in this subcategory are generated on the computer on which a logon session is created. For an interactive logon, the security audit event is generated on the computer that the user logged on to. For a network logon, such as accessing a shared folder on the network, the security audit event is generated on the computer hosting the resource."
        #          reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        #           see_also : "See HTH Policies and Standards"
        #         value_type : POLICY_TEXT
        #         value_data : "Success" ||"Success and Failure"
        #    powershell_args : "$noutput = auditpol /get /Subcategory:'Group Membership'; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
        #         check_type : CHECK_REGEX
        #   </custom_item>

               <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit Logoff is set to include Success"
                      info : "This subcategory reports when a user logs off from the system. These events occur on the accessed computer. For interactive logons, the generation of these events occurs on the computer that is logged on to. If a network logon takes place to access a share, these events generate on the computer that hosts the accessed resource. If you configure this setting to No auditing, it is difficult or impossible to determine which user has accessed or attempted to access organization computers. Events for this subcategory include: "
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Success" ||"Success and Failure"
           powershell_args : "$noutput = auditpol /get /Subcategory:'Logoff'; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                check_type : CHECK_REGEX
          </custom_item>

               <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit Logon is set to Success and Failure"
                      info : "This subcategory reports when a user attempts to log on to the system. These events occur on the accessed computer. For interactive logons, the generation of these events occurs on the computer that is logged on to. If a network logon takes place to access a share, these events generate on the computer that hosts the accessed resource. If you configure this setting to No auditing, it is difficult or impossible to determine which user has accessed or attempted to access organization computers. Events for this subcategory include: "
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Success and Failure"
           powershell_args : "$noutput = auditpol /get /Subcategory:'Logon'; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                check_type : CHECK_REGEX
          </custom_item>

               <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit Other Logon/Logoff Events is set to Success and Failure"
                      info : "This subcategory reports other logon/logoff-related events, such as Remote Desktop Services session disconnects and reconnects, using RunAs to run processes under a different account, and locking and unlocking a workstation. Events for this subcategory include: "
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Success and Failure"
           powershell_args : "$noutput = auditpol /get /Subcategory:'Other Logon/Logoff Events'; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                check_type : CHECK_REGEX
          </custom_item>

               <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit Special Logon is set to include Success"
                      info : "This subcategory reports when a special logon is used. A special logon is a logon that has administrator-equivalent privileges and can be used to elevate a process to a higher level. Events for this subcategory include: "
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Success" ||"Success and Failure"
           powershell_args : "$noutput = auditpol /get /Subcategory:'Special Logon'; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                check_type : CHECK_REGEX
          </custom_item>

        #        <custom_item>
        #               type : AUDIT_POWERSHELL
        #        description : "AU - MSSRV - Audit Detailed File Share is set to include Failure"
        #               info : "This subcategory allows you to audit attempts to access files and folders on a shared folder. Events for this subcategory include: "
        #          reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        #           see_also : "See HTH Policies and Standards"
        #         value_type : POLICY_TEXT
        #         value_data : "Failure" ||"Success and Failure"
