          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - User Account Control: Detect application installations and prompt for elevation is set to Enabled"
                      info : "This policy setting controls the behavior of application installation detection for the computer."
                 reference : "NIST 800-53r5|AC-6(8)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').EnableInstallerDetection; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - User Account Control: Only elevate UIAccess applications that are installed in secure locations is set to Enabled"
                      info : "This policy setting controls whether applications that request to run with a User Interface Accessibility (UIAccess) integrity level must reside in a secure location in the file system. Secure locations are limited to the following: "
                 reference : "NIST 800-53r5|AC-6(8)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').EnableSecureUIAPaths; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
        #   <custom_item>
        #               type : AUDIT_POWERSHELL
        #        description : "AC - MSSRV - User Account Control: Run all administrators in Admin Approval Mode is set to Enabled"
        #               info : "This policy setting controls the behavior of all User Account Control (UAC) policy settings for the computer. If you change this policy setting, you must restart your computer."
        #          reference : "NIST 800-53r5|AC-6(1)"
        #           see_also : "See HTH Policies and Standards"
        #         value_type : POLICY_TEXT
        #         value_data : "1"
        #    powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').EnableLUA; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
        #         check_type : CHECK_REGEX
        #   </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - User Account Control: Switch to the secure desktop when prompting for elevation is set to Enabled"
                      info : "This policy setting controls whether the elevation request prompt is displayed on the interactive user s desktop or the secure desktop."
                 reference : "NIST 800-53r5|AC-6(1)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').PromptOnSecureDesktop; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "SC - MSSRV - User Account Control: Virtualize file and registry write failures to per-user locations is set to Enabled"
                      info : "This policy setting controls whether application write failures are redirected to defined registry and file system locations. This policy setting mitigates applications that run as administrator and write run-time application data to: "
                 reference : "NIST 800-53r5|SC-29(1)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').EnableVirtualization; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit: Force audit policy subcategory settings (Windows Vista or later) to override audit policy category settings is set to Enabled"
                      info : "This policy setting allows administrators to enable the more precise auditing capabilities present in Windows Vista."
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Lsa'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\LSA').SCENoApplyLegacyAuditPolicy; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit: Shut down system immediately if unable to log security audits is set to Disabled"
                      info : "This policy setting determines whether the system shuts down if it is unable to log Security events. It is a requirement for Trusted Computer System Evaluation Criteria (TCSEC)-C2 and Common Criteria certification to prevent auditable events from occurring if the audit system is unable to log them. Microsoft has chosen to meet this requirement by halting the system and displaying a stop message if the auditing system experiences a failure. When this policy setting is enabled, the system will be shut down if a security audit cannot be logged for any reason."
                 reference : "NIST 800-53r5|AU-4"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "0"
           powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\LSA'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\LSA').CrashOnAuditFail; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - Devices: Prevent users from installing printer drivers is set to Enabled"
                      info : "For a computer to print to a shared printer, the driver for that shared printer must be installed on the local computer. This security setting determines who is allowed to install a printer driver as part of connecting to a shared printer."
                 reference : "NIST 800-53r5|AC-2 AC-5 AC-6 AC-6(1) AC-6(7) AU-9(4)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Control\Print\Providers\LanMan Print Services\Servers'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Print\Providers\LanMan Print Services\Servers').AddPrinterDrivers; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - Domain member: Digitally encrypt or sign secure channel data (always) is set to Enabled"
                      info : "This policy setting determines whether all secure channel traffic that is initiated by the domain member must be signed or encrypted."
                 reference : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters').RequireSignOrSeal; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - Domain member: Digitally encrypt secure channel data (when possible) is set to Enabled"
                      info : "This policy setting determines whether a domain member should attempt to negotiate encryption for all secure channel traffic that it initiates."
                 reference : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters').SealSecureChannel; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - Domain member: Digitally sign secure channel data (when possible) is set to Enabled"
                      info : "This policy setting determines whether a domain member should attempt to negotiate whether all secure channel traffic that it initiates must be digitally signed. Digital signatures protect the traffic from being modified by anyone who captures the data as it traverses the network."
                 reference : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters').SignSecureChannel; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - Domain member: Disable machine account password changes is set to Disabled"
                      info : "This policy setting determines whether a domain member can periodically change its computer account password. Computers that cannot automatically change their account passwords are potentially vulnerable, because an attacker might be able to determine the password for the system s domain account."
                 reference : "NIST 800-53r5|AC-2(1)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "0"
           powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters').DisablePasswordChange; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "IA - MSSRV - Domain member: Maximum machine account password age is set to 30 or fewer days, but not 0"
                      info : "This policy setting determines the maximum allowable age for a computer account password. By default, domain members automatically change their domain passwords every 30 days."
                 reference : "NIST 800-53r5|IA-5(1)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "[1..30]"
           powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters').MaximumPasswordAge; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - Domain member: Require strong (Windows 2000 or later) session key is set to Enabled"
                      info : "When this policy setting is enabled, a secure channel can only be established with Domain Controllers that are capable of encrypting secure channel data with a strong (128-bit) session key."
                 reference : "NIST 800-53r5|AC-17(2) IA-5 IA-5(1) SC-8 SC-8(1)"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "1"
           powershell_args : "if(Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters'){$noutput = (Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameter').RequireStrongKey; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AC - MSSRV - Interactive logon: Do not require CTRL+ALT+DEL is set to Disabled"
                      info : "This policy setting determines whether users must press CTRL+ALT+DEL before they log on."
                 reference : "NIST 800-53r5|AC-7 AC-19"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "0"
           powershell_args : "if(Test-Path -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System'){$noutput = (Get-ItemProperty -Path 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System').DisableCAD; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
