                    type : AUDIT_POWERSHELL
             description : "CM - MSSRV.DC - Ensure 'Domain controller: Refuse machine account password changes' is set to 'Disabled' (DC only)"
                    info : "This security setting determines whether Domain Controllers will refuse requests from member computers to change computer account passwords."
               reference : "NIST 800-53r5|CM-1 CM-2 CM-6 CM-7 CM-7(1) CM-9 SA-3 SA-8 SA-10"
                see_also : "See HTH Policies and Standards"
              value_type : POLICY_TEXT
              value_data : "0"
         powershell_args : "if (Test-Path -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters') {(Get-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Services\Netlogon\Parameters').RefusePasswordChange} else {Write-Output 'NON-COMPLIANT PATH' }"
