          <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - System: Specify the maximum log file size (KB) is set to Enabled: 32,768 or greater"
                      info : "This policy setting specifies the maximum size of the log file in kilobytes. The maximum log file size can be configured between 1 megabyte (1,024 kilobytes) and 4 terabytes (4,194,240 kilobytes) in kilobyte increments."
                 reference : "NIST 800-53r5|AU-4"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "[32768..MAX]"
           powershell_args : "if(Test-Path -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\System'){$noutput = (Get-ITEMProperty -Path 'HKLM:\Software\Policies\Microsoft\Windows\EventLog\System').MaxSize; if($noutput -eq $Null) {write-host 'Value Not Found'} else {$noutput}} else {write-host 'Path Not Found'}"
                check_type : CHECK_REGEX
          </custom_item>
 
