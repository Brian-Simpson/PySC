        #         check_type : CHECK_REGEX
        #   </custom_item>

        #        <custom_item>
        #               type : AUDIT_POWERSHELL
        #        description : "AU - MSSRV - Audit File Share is set to Success and Failure"
        #               info : "This policy setting allows you to audit attempts to access a shared folder."
        #          reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        #           see_also : "See HTH Policies and Standards"
        #         value_type : POLICY_TEXT
        #         value_data : "Success and Failure"
        #    powershell_args : "$noutput = auditpol /get /Subcategory:'File Share'; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
        #         check_type : CHECK_REGEX
        #   </custom_item>

        #        <custom_item>
        #               type : AUDIT_POWERSHELL
        #        description : "AU - MSSRV - Audit Other Object Access Events is set to Success and Failure"
        #               info : "This policy setting allows you to audit events generated by the management of task scheduler jobs or COM+ objects."
        #          reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        #           see_also : "See HTH Policies and Standards"
        #         value_type : POLICY_TEXT
        #         value_data : "Success and Failure"
        #    powershell_args : "$noutput = auditpol /get /Subcategory:'Other Object Access Events'; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
        #         check_type : CHECK_REGEX
        #   </custom_item>

               <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit Removable Storage is set to Success and Failure"
                      info : "This policy setting allows you to audit user attempts to access file system objects on a removable storage device. A security audit event is generated only for all objects for all types of access requested. If you configure this policy setting, an audit event is generated each time an account accesses a file system object on a removable storage. Success audits record successful attempts and Failure audits record unsuccessful attempts. If you do not configure this policy setting, no audit event is generated when an account accesses a file system object on a removable storage."
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Success and Failure"
           powershell_args : "$noutput = auditpol /get /Subcategory:'Removable Storage'; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                check_type : CHECK_REGEX
          </custom_item>

               <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit Audit Policy Change is set to include Success"
                      info : "This subcategory reports changes in audit policy including SACL changes. Events for this subcategory include: "
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Success" ||"Success and Failure"
           powershell_args : "$noutput = auditpol /get /Subcategory:'Audit Policy Change'; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                check_type : CHECK_REGEX
          </custom_item>

               <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit Authentication Policy Change is set to include Success"
                      info : "This subcategory reports changes in authentication policy. Events for this subcategory include: "
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Success" ||"Success and Failure"
           powershell_args : "$noutput = auditpol /get /Subcategory:'Authentication Policy Change'; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                check_type : CHECK_REGEX
          </custom_item>

               <custom_item>
                      type : AUDIT_POWERSHELL
               description : "AU - MSSRV - Audit Authorization Policy Change is set to include Success"
                      info : "This subcategory reports changes in authorization policy. Events for this subcategory include: "
                 reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
                  see_also : "See HTH Policies and Standards"
                value_type : POLICY_TEXT
                value_data : "Success" ||"Success and Failure"
           powershell_args : "$noutput = auditpol /get /Subcategory:'Authorization Policy Change'; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
                check_type : CHECK_REGEX
          </custom_item>

        #        <custom_item>
        #               type : AUDIT_POWERSHELL
        #        description : "AU - MSSRV - Audit MPSSVC Rule-Level Policy Change is set to Success and Failure"
        #               info : "This subcategory determines whether the operating system generates audit events when changes are made to policy rules for the Microsoft Protection Service (MPSSVC.exe). Events for this subcategory include: "
        #          reference : "NIST 800-53r5|AU-3 AU-3(1) AU-7 AU-12"
        #           see_also : "See HTH Policies and Standards"
        #         value_type : POLICY_TEXT
        #         value_data : "Success and Failure"
        #    powershell_args : "$noutput = auditpol /get /Subcategory:'MPSSVC Rule-Level Policy Change'; if ($noutput -eq $Null) {write-host 'Not Found'} else {$noutput}"
        #         check_type : CHECK_REGEX
